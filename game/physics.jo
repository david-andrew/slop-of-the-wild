use 'gfx.jo'
use 'terrain.jo'

# Static collision: vertical cylinders (trunks, pillars) and boxes turned about y (walls,
# buildings, platforms) in a grid, plus the terrain. Queries for standing, pushing out of
# solids, ray casts and wall probes (climbing).

enum Surf: grass, rock, wood, stone, snow, metal, water, sand

struct Collider:
    kind = 0                  # 0 cylinder, 1 box
    pos = vec3(0, 0, 0)       # base center (bottom of the shape)
    half = vec3(0.5, 0.5, 0.5) # box: half extents; cylinder: x radius, y half height
    yaw = 0.0
    climbable = true
    surf = Surf.stone
    active = true
    tag = 0                   # who owns it (doors, lifts...)

struct Hit:
    hit = false
    dist = 0.0
    pos = vec3(0, 0, 0)
    normal = vec3(0, 1, 0)
    collider = -1             # -1 terrain

# Optional static surface supplied by structures; default world behavior is unchanged.
surface_ray: (vec3, vec3, f64) -> Hit = (o: vec3, d: vec3, distance: f64) -> Hit: Hit()
surface_push: (vec3, f64, f64) -> vec3 = (p: vec3, radius: f64, height: f64) -> vec3: vec3(0, 0, 0)

const COL_CELL = 16.0
use_terrain = true            # false inside underground places (only built walls and floors count)
colliders: Collider[]
__col_grid: {int: int[]} = {}
__col_seen: int[]
__col_query = 0

__cell_key = (cx: int, cz: int) -> int: cx * 100003 + cz

__col_bounds = (c: Collider) -> vec4:
    r = if c.kind == 0: f64(c.half.x) else: f64(length(vec2(c.half.x, c.half.z)))
    vec4(f32(f64(c.pos.x) - r), f32(f64(c.pos.z) - r), f32(f64(c.pos.x) + r), f32(f64(c.pos.z) + r))

add_collider = (c: Collider) -> int:
    id = colliders.len()
    colliders.push(c)
    b = __col_bounds(c)
    loop cz in [int(floor(f64(b.y) / COL_CELL))..int(floor(f64(b.w) / COL_CELL))]:
        loop cx in [int(floor(f64(b.x) / COL_CELL))..int(floor(f64(b.z) / COL_CELL))]:
            k = __cell_key(cx, cz)
            ids = __col_grid.get(k) ?? []
            ids.push(id)
            __col_grid[k] = ids
    id

add_box = (center_base: vec3, half: vec3, yaw: f64 = 0.0, climbable: bool = true, surf: Surf = .stone) -> int:
    add_collider(Collider(kind = 1, pos = center_base, half = half, yaw = yaw, climbable = climbable, surf = surf))

add_cyl = (base: vec3, radius: f64, height: f64, climbable: bool = true, surf: Surf = .wood) -> int:
    add_collider(Collider(kind = 0, pos = base, half = v3(radius, height / 2.0, radius), climbable = climbable, surf = surf))

# Reindex a freely moving log only when its occupied cells change. Remove old
# memberships so long downhill/water travel cannot grow the grid without bound.
collider_relocate = (id: int, pos: vec3, half: vec3, yaw: f64):
    old=__col_bounds(colliders[id])
    colliders[id].pos=pos
    colliders[id].half=half
    colliders[id].yaw=yaw
    now=__col_bounds(colliders[id])
    bounds: int[]
    loop b in [old,now]:
        bounds.push(int(floor(f64(b.x)/COL_CELL)))
        bounds.push(int(floor(f64(b.y)/COL_CELL)))
        bounds.push(int(floor(f64(b.z)/COL_CELL)))
        bounds.push(int(floor(f64(b.w)/COL_CELL)))
    if bounds[0]==bounds[4] and bounds[1]==bounds[5] and bounds[2]==bounds[6] and bounds[3]==bounds[7]: return
    loop cz in [bounds[1]..bounds[3]]:
        loop cx in [bounds[0]..bounds[2]]:
            key=__cell_key(cx,cz)
            ids=__col_grid.get(key) ?? []
            kept: int[]
            loop i in ids:
                if i!=id: kept.push(i)
            if kept.len()==0: __col_grid.remove(key)
            else: __col_grid[key]=kept
    loop cz in [bounds[5]..bounds[7]]:
        loop cx in [bounds[4]..bounds[6]]:
            key=__cell_key(cx,cz)
            ids=__col_grid.get(key) ?? []
            ids.push(id)
            __col_grid[key]=ids

# colliders whose cells touch a circle
nearby = (x: f64, z: f64, r: f64) -> int[]:
    out: int[]
    # A moving Talus registers hundreds of sections across its entire arena.
    # Linear out.contains made every lens/blade/foot probe quadratic in that
    # population. Generation stamps visit each membership once, preserving the
    # original first-cell order (including equal-height support tie breaking).
    if __col_seen.len() != colliders.len(): __col_seen = fill(0, colliders.len())
    __col_query += 1
    if __col_query >= 1000000000:
        __col_seen = fill(0, colliders.len())
        __col_query = 1
    loop cz in [int(floor((z - r) / COL_CELL))..int(floor((z + r) / COL_CELL))]:
        loop cx in [int(floor((x - r) / COL_CELL))..int(floor((x + r) / COL_CELL))]:
            if let ids = __col_grid.get(__cell_key(cx, cz)):
                loop id in ids:
                    if __col_seen[id] != __col_query:
                        __col_seen[id] = __col_query
                        out.push(id)
    out

# a point in a box's local frame (x, z rotated by -yaw; y from the base)
__to_local = (c: Collider, p: vec3) -> vec3:
    d = p - c.pos
    cs = cos(c.yaw)
    sn = sin(c.yaw)
    v3(f64(d.x) * cs - f64(d.z) * sn, f64(d.y), f64(d.x) * sn + f64(d.z) * cs)

__to_world_dir = (c: Collider, d: vec3) -> vec3:
    cs = cos(c.yaw)
    sn = sin(c.yaw)
    v3(f64(d.x) * cs + f64(d.z) * sn, f64(d.y), -f64(d.x) * sn + f64(d.z) * cs)

# ground under (x, z) for feet at y: the terrain, or the top of a collider within `step` above
struct Ground:
    y = 0.0
    normal = vec3(0, 1, 0)
    collider = -1
    surf = Surf.grass

# Foot probes need collider heights without repeating terrain normals and materials.
ground_at = (x: f64, z: f64, feet: f64, step: f64 = 0.5, radius: f64 = 0.0, details: bool = true) -> Ground:
    g = Ground(y = -10000.0, normal = vec3(0, 1, 0), surf = .stone)
    if use_terrain:
        g.y = height_at(x, z)
        if details:
            g.normal = normal_at(x, z)
            m = material_at(x, z)
            g.surf = .grass
            if m.y > 0.5 or g.normal.y < 0.7: g.surf = .rock
            if m.z > 0.5: g.surf = .snow
            if m.w > 0.5: g.surf = .sand
    loop id in nearby(x, z, radius + 0.1):
        c = colliders[id]
        if not c.active: continue
        top = f64(c.pos.y) + 2.0 * f64(c.half.y)
        if top > feet + step or top < g.y: continue
        inside = false
        if c.kind == 0: inside = hypot(x - f64(c.pos.x), z - f64(c.pos.z)) < f64(c.half.x) + radius * 0.5
        else:
            l = __to_local(c, v3(x, feet, z))
            inside = abs(f64(l.x)) < f64(c.half.x) + radius * 0.5 and abs(f64(l.z)) < f64(c.half.z) + radius * 0.5
        if inside:
            g.y = top
            g.normal = vec3(0, 1, 0)
            g.collider = id
            g.surf = c.surf
    if use_terrain:
        h = surface_ray(v3(x, feet + step + 0.001, z), vec3(0, -1, 0), max(0.0, feet + step + 0.001 - g.y))
        if h.hit and h.pos.y > g.y: g = Ground(f64(h.pos.y), h.normal, -1, .rock)
    g

# push a vertical capsule (feet position, radius, height) out of colliders; returns the push
push_out = (p: mut vec3, radius: f64, height: f64) -> vec3:
    total = vec3(0, 0, 0)
    loop id in nearby(f64(p.x), f64(p.z), radius + 1.0):
        c = colliders[id]
        if not c.active: continue
        top = f64(c.pos.y) + 2.0 * f64(c.half.y)
        # standing on it, low enough to step onto (ground_at lifts the feet), or above/below
        if f64(p.y) >= top - 0.45 or f64(p.y) + height <= f64(c.pos.y): continue
        if top <= f64(p.y) + 0.3 and radius < 0.5: continue
        if c.kind == 0:
            d = vec2(p.x - c.pos.x, p.z - c.pos.z)
            l = f64(length(d))
            r = f64(c.half.x) + radius
            if l < r and l > 0.0001:
                k = f32(r - l)
                n = d / f32(l)
                p.x += n.x * k
                p.z += n.y * k
                total += vec3(n.x, 0, n.y) * k
        else:
            l = __to_local(c, p)
            hx = f64(c.half.x) + radius
            hz = f64(c.half.z) + radius
            if abs(f64(l.x)) < hx and abs(f64(l.z)) < hz:
                # out through the nearest side
                ox = hx - abs(f64(l.x))
                oz = hz - abs(f64(l.z))
                dl = vec3(0, 0, 0)
                if ox < oz: dl = v3(sign(f64(l.x)) * ox, 0.0, 0.0)
                else: dl = v3(0.0, 0.0, sign(f64(l.z)) * oz)
                dw = __to_world_dir(c, dl)
                p += dw
                total += dw
    if use_terrain:
        delta = surface_push(p, radius, height)
        p += delta
        total += delta
    total

# ray against one collider (slab test in its frame)
__ray_collider = (c: Collider, o: vec3, d: vec3, maxd: f64) -> Hit:
    h = Hit()
    if c.kind == 0:
        # infinite cylinder in xz, clipped by its height
        ox = f64(o.x - c.pos.x)
        oz = f64(o.z - c.pos.z)
        dx = f64(d.x)
        dz = f64(d.z)
        a = dx * dx + dz * dz
        r = f64(c.half.x)
        if a < 1e-9: return h
        b = ox * dx + oz * dz
        cc = ox * ox + oz * oz - r * r
        disc = b * b - a * cc
        if disc < 0.0: return h
        t = (-b - sqrt(disc)) / a
        if t < 0.0 or t > maxd: return h
        y = f64(o.y) + f64(d.y) * t
        if y < f64(c.pos.y) or y > f64(c.pos.y) + 2.0 * f64(c.half.y): return h
        h.hit = true
        h.dist = t
        h.pos = o + d * f32(t)
        h.normal = normalize(v3(ox + dx * t, 0.0, oz + dz * t))
        return h
    lo = __to_local(c, o)
    ld = __to_local(c, c.pos + d)
    lo2 = lo - vec3(0, c.half.y, 0)
    tmin = -1e30
    tmax = 1e30
    nax = 0
    loop ax in [0..3):
        oo = f64(lo2[ax])
        dd = f64(ld[ax])
        hh = f64(c.half[ax])
        if abs(dd) < 1e-9:
            if abs(oo) > hh: return h
            continue
        t1 = (-hh - oo) / dd
        t2 = (hh - oo) / dd
        if t1 > t2:
            tt = t1
            t1 = t2
            t2 = tt
        if t1 > tmin:
            tmin = t1
            nax = ax
        tmax = min(tmax, t2)
        if tmin > tmax: return h
    if tmin < 0.0 or tmin > maxd: return h
    nl = vec3(0, 0, 0)
    nl[nax] = f32(-sign(f64(ld[nax])))
    h.hit = true
    h.dist = tmin
    h.pos = o + d * f32(tmin)
    h.normal = __to_world_dir(c, nl)
    h

# a ray against the terrain: march, then refine
ray_terrain = (o: vec3, d: vec3, maxd: f64, step: f64 = 1.0) -> Hit:
    h = Hit()
    t = 0.0
    prev = 0.0
    loop t <= maxd:
        p = o + d * f32(t)
        if not in_bounds(f64(p.x), f64(p.z)): return h
        if f64(p.y) < height_at(f64(p.x), f64(p.z)):
            lo = prev
            hi = t
            loop k in [0..10):
                mid = (lo + hi) * 0.5
                q = o + d * f32(mid)
                if f64(q.y) < height_at(f64(q.x), f64(q.z)): hi = mid
                else: lo = mid
            h.hit = true
            h.dist = hi
            h.pos = o + d * f32(hi)
            h.normal = normal_at(f64(h.pos.x), f64(h.pos.z))
            return h
        prev = t
        t += step * (1.0 + t * 0.02)
    h

raycast = (o: vec3, d0: vec3, maxd: f64, colliders_too: bool = true, terrain_too: bool = true) -> Hit:
    d = normalize(d0)
    best = if use_terrain and terrain_too: ray_terrain(o, d, maxd, 0.5) else: Hit()
    if not colliders_too: return best
    lim = if best.hit: best.dist else: maxd
    mid = o + d * f32(lim * 0.5)
    loop id in nearby(f64(mid.x), f64(mid.z), lim * 0.5 + 1.0):
        c = colliders[id]
        if not c.active: continue
        hc = __ray_collider(c, o, d, lim)
        if hc.hit and hc.dist < lim:
            lim = hc.dist
            hc.collider = id
            best = hc
    if use_terrain:
        h = surface_ray(o, d, lim)
        if h.hit: best = h
    best

# what is in front of the chest: for climbing and ledges
struct WallProbe:
    hit = false
    pos = vec3(0, 0, 0)
    normal = vec3(0, 0, 0)
    climbable = false
    collider = -1

wall_probe = (from: vec3, dir: vec3, dist: f64) -> WallProbe:
    w = WallProbe()
    h = raycast(from, dir, dist)
    if not h.hit: return w
    w.hit = true
    w.pos = h.pos
    w.normal = h.normal
    w.collider = h.collider
    if h.collider >= 0: w.climbable = colliders[h.collider].climbable and abs(f64(h.normal.y)) < 0.7
    # Match the player's steep-ground threshold: the old 50-degree cutoff left
    # a 45..50-degree band that slid but could not be climbed while holding uphill.
    else: w.climbable = f64(h.normal.y) < cos(0.78)
    w

# Upward faces of the built world, including roofs without walking colliders.
struct RainFace:
    origin: vec3
    u: vec2
    v: vec2
    slope: vec2
    owner: int

__rain_faces: RainFace[]
__rain_grid: {int: int[]} = {}
struct RainCell:
    heights: f32[]
    moving: int[]

__rain_visual: {int: RainCell} = {}
__rain_names: str[]
__rain_owners: {str: int} = {}
__rain_hidden: bool[]
__rain_lift: f64[]

rain_sync = (hidden: {str: bool}, lift: {str: f64}):
    loop i in [0..__rain_names.len()):
        __rain_hidden[i] = hidden.get(__rain_names[i], false)
        __rain_lift[i] = lift.get(__rain_names[i], 0.0)

add_rain_face = (a: vec3, b: vec3, c: vec3, name: str):
    ab = b - a
    ac = c - a
    det = f64(ab.x) * f64(ac.z) - f64(ab.z) * f64(ac.x)
    if abs(det) < 0.04: return
    owner = -1
    if name != "":
        if not __rain_owners.has(name):
            __rain_owners[name] = __rain_names.len()
            __rain_names.push(name)
            __rain_hidden.push(false)
            __rain_lift.push(0.0)
        owner = __rain_owners.get(name, -1)
    u = vec2(f32(f64(ac.z) / det), f32(-f64(ac.x) / det))
    v = vec2(f32(-f64(ab.z) / det), f32(f64(ab.x) / det))
    id = __rain_faces.len()
    __rain_faces.push(RainFace(a, u, v, u * ab.y + v * ac.y, owner))
    lo = min(min(a, b), c)
    hi = max(max(a, b), c)
    loop z in [int(floor(f64(lo.z) / 4.0))..int(floor(f64(hi.z) / 4.0))]:
        loop x in [int(floor(f64(lo.x) / 4.0))..int(floor(f64(hi.x) / 4.0))]:
            k = __cell_key(x, z)
            ids = __rain_grid.get(k) ?? []
            ids.push(id)
            __rain_grid[k] = ids
            cell = __rain_visual.get(k) ?? RainCell(fill(f32(-10000), 64), [])
            if owner >= 0: cell.moving.push(id)
            else:
                loop iz in [0..8):
                    loop ix in [0..8):
                        d = vec2(f32(f64(x) * 4.0 + (f64(ix) + 0.5) * 0.5) - a.x, f32(f64(z) * 4.0 + (f64(iz) + 0.5) * 0.5) - a.z)
                        bu = dot(d, u)
                        bv = dot(d, v)
                        if bu < 0.0 or bv < 0.0 or bu + bv > 1.0: continue
                        y = a.y + dot(d, u * ab.y + v * ac.y)
                        j = iz * 8 + ix
                        cell.heights[j] = max(cell.heights[j], y)
            __rain_visual[k] = cell

# Static roof heights are baked in half-meter cells; moving roofs keep their exact faces.
rain_streak_height = (x: f64, z: f64) -> f64:
    cx = int(floor(x / 4.0))
    cz = int(floor(z / 4.0))
    if let cell = __rain_visual.get(__cell_key(cx, cz)):
        ix = clamp(int(floor((x - f64(cx) * 4.0) * 2.0)), 0, 7)
        iz = clamp(int(floor((z - f64(cz) * 4.0) * 2.0)), 0, 7)
        top = f64(cell.heights[iz * 8 + ix])
        if cell.moving.len() > 0: top = max(top, __rain_height(x, z, cell.moving))
        return top
    -10000.0

const RAIN_VIEW_N = 224
__rain_view: f32[]
__rain_empty = fill(f32(-10000), 64)
__rain_origin = vec2(0, 0)
__rain_cam = vec2(0, 0)
__rain_frame = -100

# A nearby sheet of roof heights: refresh every quarter second or 0.75 m of travel.
rain_view_prepare = (cam: vec3, frame: int):
    d = cam.xz - __rain_cam
    if frame - __rain_frame < 15 and dot(d, d) < 0.5625: return
    if __rain_view.len() == 0: __rain_view = fill(f32(-10000), RAIN_VIEW_N * RAIN_VIEW_N)
    cx = int(floor(f64(cam.x) / 4.0)) - RAIN_VIEW_N / 16
    cz = int(floor(f64(cam.z) / 4.0)) - RAIN_VIEW_N / 16
    __rain_origin = vec2(f32(cx * 4), f32(cz * 4))
    __rain_cam = cam.xz
    __rain_frame = frame
    loop z in [0..RAIN_VIEW_N / 8):
        loop x in [0..RAIN_VIEW_N / 8):
            cell = __rain_visual.get(__cell_key(cx + x, cz + z)) ?? RainCell(__rain_empty, [])
            loop row in [0..8):
                dest = (z * 8 + row) * RAIN_VIEW_N + x * 8
                mem_copy((data(__rain_view) as *u8) + dest * 4, (data(cell.heights) as *u8) + row * 32, 32)
                if cell.moving.len() > 0:
                    loop col in [0..8):
                        wx = f64((cx + x) * 4) + (f64(col) + 0.5) * 0.5
                        wz = f64((cz + z) * 4) + (f64(row) + 0.5) * 0.5
                        __rain_view[dest + col] = max(__rain_view[dest + col], f32(__rain_height(wx, wz, cell.moving)))

rain_view_height = (x: f64, z: f64) -> f64:
    ix = int(floor((x - f64(__rain_origin.x)) * 2.0))
    iz = int(floor((z - f64(__rain_origin.y)) * 2.0))
    if __rain_view.len() == 0 or ix < 0 or iz < 0 or ix >= RAIN_VIEW_N or iz >= RAIN_VIEW_N: return rain_streak_height(x, z)
    f64(__rain_view[iz * RAIN_VIEW_N + ix])

__rain_height = (x: f64, z: f64, ids: int[]) -> f64:
    top = -10000.0
    loop id in ids:
        f = __rain_faces[id]
        if f.owner >= 0 and __rain_hidden[f.owner]: continue
        dx = x - f64(f.origin.x)
        dz = z - f64(f.origin.z)
        u = dx * f64(f.u.x) + dz * f64(f.u.y)
        v = dx * f64(f.v.x) + dz * f64(f.v.y)
        if u < 0.0 or v < 0.0 or u + v > 1.0: continue
        y = f64(f.origin.y) + dx * f64(f.slope.x) + dz * f64(f.slope.y)
        if f.owner >= 0: y += __rain_lift[f.owner]
        top = max(top, y)
    top

rain_cover_height = (x: f64, z: f64) -> f64:
    if let ids = __rain_grid.get(__cell_key(int(floor(x / 4.0)), int(floor(z / 4.0)))): return __rain_height(x, z, ids)
    -10000.0

rain_exposed = (p: vec3) -> bool: rain_cover_height(f64(p.x), f64(p.z)) < f64(p.y) + 0.1

use 'gfx.jo'
use 'shade.jo'
use 'env.jo'
use 'shadows.jo'
use 'terrain.jo'

# Per-frame scene values shared by every shader, and a generic painterly shader for props
# (items, weapons, rocks, placeholders): a mesh with a model matrix and a color.

struct Scene:
    vp = mat4()
    view = mat4()
    proj = mat4()
    cam = vec3(0, 0, 0)
    fwd = vec3(0, 0, 1)
    fov = 50.0
    near = 0.3
    far = 20000.0
    shadow = false          # inside a shadow pass
    shadow_k = 0

sc = Scene()
sc_lp = vec4(0, 0, 0, 0)
sc_lc = vec3(0, 0, 0)

struct PropU:
    vp: mat4
    model: mat4
    color: vec4
    cam: vec3
    sun_dir: vec3
    sun_color: vec3
    sky: vec3
    ground: vec3
    haze: vec3
    density: f32
    vp0: mat4
    vp1: mat4
    vp2: mat4
    sm0: Texture
    sm1: Texture
    sm2: Texture
    emissive: f32
    rim: f32
    tex: Texture
    use_tex: f32
    shadow_pass: f32
    lp = vec4(0, 0, 0, 0)
    lc = vec3(0, 0, 0)
    creature = 0.0
    opacity = 1.0

struct PropO:
    pos: vec4
    world: vec3
    normal: vec3
    uv: vec2
    color: vec4

prop_vs = (v: Vertex3D, u: PropU) -> PropO:
    w = u.model * vec4(v.pos, 1)
    n = (u.model * vec4(v.normal, 0)).xyz
    PropO(u.vp * w, w.xyz, n, v.uv, v.color * u.color)

prop_fs = (i: PropO, u: PropU) -> vec4:
    if u.shadow_pass > 0.5:
        if u.opacity < 1.0:
            glsl_discard(hash13(vec3(floor(i.world.x*180.0),floor(i.world.y*180.0),floor(i.world.z*180.0))) >= u.opacity)
        return vec4(1,1,1,1)
    alb = i.color.xyz
    if u.use_tex > 0.5:
        t = sample(u.tex, i.uv)
        glsl_discard(t.w < 0.4)
        alb = alb * t.xyz
    n = normalize(i.normal)
    l = normalize(u.sun_dir)
    v = normalize(u.cam - i.world)
    sh = cascade_shadow(i.world, dot(n, l), u.vp0, u.vp1, u.vp2, u.sm0, u.sm1, u.sm2)
    c = paint_light(alb, n, l, v, u.sun_color, u.sky, u.ground, sh, 0.25)
    c = c + point_light(alb, n, i.world, u.lp, u.lc)
    if u.creature > 0.0: c = c + creature_bounce(alb, n, u.sun_color, u.sky, u.creature)
    c = c + alb * u.emissive
    c = c + (u.sky + u.sun_color * 0.3) * pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 3.0) * u.rim
    c = atmos(c, i.world, u.cam, l, u.haze, u.sun_color, u.density, 0.004)
    vec4(c, i.color.w * f32(u.opacity))

prop_sh: Shader
__prop_ready = false

prop_u = (model: mat4, color: vec4, emissive: f64 = 0.0, rim: f64 = 0.2, creature: f64 = 0.0) -> PropU:
    vp = if sc.shadow: cascades.vps[sc.shadow_k] else: sc.vp
    PropU(vp, model, color, sc.cam, env.light_dir, env.sun_color, env.sky_amb, env.ground_amb, env.haze, f32(env.density),
        cascades.vps[0], cascades.vps[1], cascades.vps[2], shadow_tex(0), shadow_tex(1), shadow_tex(2), f32(emissive), f32(rim),
        Texture(0, 1, 1), 0.0, f32(int(sc.shadow)), sc_lp, sc_lc, f32(creature * env.wet))

draw_prop = (m: Mesh, model: mat4, color: vec4, emissive: f64 = 0.0, rim: f64 = 0.2, creature: f64 = 0.0, opacity: f64 = 1.0):
    if not __prop_ready:
        __prop_ready = true
        prop_sh = make_sh(shader(prop_vs, prop_fs))
    u = prop_u(model, color, emissive, rim, creature)
    u.opacity = f32(opacity)
    draw_fast(prop_sh, m, u)

draw_prop_tex = (m: Mesh, model: mat4, color: vec4, tex: Texture):
    if not __prop_ready:
        __prop_ready = true
        prop_sh = make_sh(shader(prop_vs, prop_fs))
    u = prop_u(model, color)
    u.tex = tex
    u.use_tex = 1.0
    draw_fast(prop_sh, m, u)

# instanced props (rocks, logs, pickups): one model matrix and color per instance
struct PropI:
    model: mat4
    color: vec4

prop_inst_vs = (v: Vertex3D, inst: PropI, u: PropU) -> PropO:
    w = inst.model * vec4(v.pos, 1)
    n = (inst.model * vec4(v.normal, 0)).xyz
    PropO(u.vp * w, w.xyz, n, v.uv, v.color * inst.color * u.color)

prop_inst_sh: Shader
__prop_inst_ready = false

draw_props = (m: Mesh, b: InstBuf, color: vec4 = vec4(1, 1, 1, 1), creature: f64 = 0.0):
    if not __prop_inst_ready:
        __prop_inst_ready = true
        prop_inst_sh = make_sh(shader(prop_inst_vs, prop_fs))
    draw_static(prop_inst_sh, m, b, prop_u(mat4(), color, creature = creature))

draw_props_tex = (m: Mesh, b: InstBuf, tex: Texture):
    if not __prop_inst_ready:
        __prop_inst_ready = true
        prop_inst_sh = make_sh(shader(prop_inst_vs, prop_fs))
    u = prop_u(mat4(), vec4(1, 1, 1, 1))
    u.tex = tex
    u.use_tex = 1.0
    draw_static(prop_inst_sh, m, b, u)

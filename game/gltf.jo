# glTF 2.0 reader: .glb (binary container) and .gltf (+ .bin / embedded PNGs), with a small
# JSON parser. Used offline by tools/bake_models.jo (the game loads the baked .mdl/.anim files).
#
#   g = load_gltf("assets/src/anim/UAL1_Standard.glb")
#   g.nodes, g.meshes (primitives with POSITION/NORMAL/TEXCOORD_0/COLOR_0/JOINTS_0/WEIGHTS_0),
#   g.materials, g.images (uri or embedded bytes), g.skins (joints + inverse bind matrices),
#   g.anims (channels: node, path, interpolation, key times and values)
#
# Accessors: every component type (u8/i8/u16/i16/u32/f32, normalized or not) and byteStride.
# Not supported: sparse accessors, morph targets, data: URIs, KHR extensions.

# ---------------- JSON ----------------
const JNULL = 0
const JBOOL = 1
const JNUM = 2
const JSTR = 3
const JARR = 4
const JOBJ = 5

struct JVal:
    kind = 0
    num = 0.0
    s = ""
    first = 0           # first child in Json.kids (arrays, objects)
    count = 0

# all values in one arena; children of a value are contiguous in `kids` (keys alongside)
struct Json:
    vals: JVal[]
    kids: int[]
    keys: str[]
    src = ""
    pos = 0
    root = 0

__jadd = (j: mut Json, v: JVal) -> int:
    j.vals.push(v)
    j.vals.len() - 1

__jws = (j: mut Json):
    n = j.src.len()
    loop j.pos < n:
        c = j.src[j.pos]
        if c == ' ' or c == '\n' or c == '\r' or c == '\t': j.pos += 1
        else: break

__hexv = (c: u8) -> int:
    if c >= '0' and c <= '9': return int(c) - 48
    if c >= 'a' and c <= 'f': return int(c) - 87
    if c >= 'A' and c <= 'F': return int(c) - 55
    0

__utf8 = (cp: int) -> str:
    if cp < 0x80: return chr(cp)
    if cp < 0x800: return chr(0xC0 | (cp >> 6)) + chr(0x80 | (cp & 0x3F))
    chr(0xE0 | (cp >> 12)) + chr(0x80 | ((cp >> 6) & 0x3F)) + chr(0x80 | (cp & 0x3F))

# a string starting at the opening quote
__jstring = (j: mut Json) -> str:
    j.pos += 1
    start = j.pos
    n = j.src.len()
    # fast path: no escapes
    loop j.pos < n and j.src[j.pos] != '"' and j.src[j.pos] != '\\': j.pos += 1
    if j.pos < n and j.src[j.pos] == '"':
        s = j.src[start..j.pos)
        j.pos += 1
        return s
    out = j.src[start..j.pos)
    loop j.pos < n:
        c = j.src[j.pos]
        if c == '"':
            j.pos += 1
            break
        if c == '\\':
            e = j.src[j.pos + 1]
            j.pos += 2
            if e == 'n': out = out + "\n"
            else if e == 't': out = out + "\t"
            else if e == 'r': out = out + "\r"
            else if e == 'b': out = out + chr(8)
            else if e == 'f': out = out + chr(12)
            else if e == 'u':
                cp = 0
                loop k in [0..4): cp = cp * 16 + __hexv(j.src[j.pos + k])
                j.pos += 4
                out = out + __utf8(cp)
            else: out = out + chr(int(e))
            continue
        # copy a run of plain bytes
        a = j.pos
        loop j.pos < n and j.src[j.pos] != '"' and j.src[j.pos] != '\\': j.pos += 1
        out = out + j.src[a..j.pos)
    out

__jvalue = (j: mut Json) -> int:
    __jws(j)
    n = j.src.len()
    if j.pos >= n: return __jadd(j, JVal())
    c = j.src[j.pos]
    if c == '{{':
        j.pos += 1
        ks: str[]
        vs: int[]
        loop j.pos < n:
            __jws(j)
            if j.src[j.pos] == '}}':
                j.pos += 1
                break
            if j.src[j.pos] == ',':
                j.pos += 1
                continue
            k = __jstring(j)
            __jws(j)
            j.pos += 1                      # ':'
            v = __jvalue(j)
            ks.push(k)
            vs.push(v)
        first = j.kids.len()
        j.kids.extend(vs)
        j.keys.extend(ks)
        return __jadd(j, JVal(kind = JOBJ, first = first, count = vs.len()))
    if c == '[':
        j.pos += 1
        vs: int[]
        loop j.pos < n:
            __jws(j)
            if j.src[j.pos] == ']':
                j.pos += 1
                break
            if j.src[j.pos] == ',':
                j.pos += 1
                continue
            vs.push(__jvalue(j))
        first = j.kids.len()
        j.kids.extend(vs)
        loop k in [0..vs.len()): j.keys.push("")
        return __jadd(j, JVal(kind = JARR, first = first, count = vs.len()))
    if c == '"': return __jadd(j, JVal(kind = JSTR, s = __jstring(j)))
    if c == 't':
        j.pos += 4
        return __jadd(j, JVal(kind = JBOOL, num = 1.0))
    if c == 'f':
        j.pos += 5
        return __jadd(j, JVal(kind = JBOOL, num = 0.0))
    if c == 'n':
        j.pos += 4
        return __jadd(j, JVal())
    start = j.pos
    loop j.pos < n:
        d = j.src[j.pos]
        if (d >= '0' and d <= '9') or d == '-' or d == '+' or d == '.' or d == 'e' or d == 'E': j.pos += 1
        else: break
    if j.pos == start:
        j.pos += 1          # skip garbage
        return __jadd(j, JVal())
    __jadd(j, JVal(kind = JNUM, num = to_float(j.src[start..j.pos)) ?? 0.0))

parse_json = (text: str) -> Json:
    j = Json(src = text)
    j.vals.reserve(text.len() / 8 + 16)
    j.root = __jvalue(j)
    j.src = ""
    j

# member of an object (-1 when missing)
jget = (j: Json, v: int, key: str) -> int:
    if v < 0: return -1
    x = j.vals[v]
    if x.kind != JOBJ: return -1
    loop k in [x.first..x.first + x.count):
        if j.keys[k] == key: return j.kids[k]
    -1

# element i of an array (or member i of an object)
jat = (j: Json, v: int, i: int) -> int:
    if v < 0: return -1
    x = j.vals[v]
    if i < 0 or i >= x.count: return -1
    j.kids[x.first + i]

jlen = (j: Json, v: int) -> int:
    if v < 0: return 0
    j.vals[v].count

jkey = (j: Json, v: int, i: int) -> str: j.keys[j.vals[v].first + i]

jnum = (j: Json, v: int, dflt: f64 = 0.0) -> f64:
    if v < 0: return dflt
    x = j.vals[v]
    if x.kind == JNUM or x.kind == JBOOL: return x.num
    dflt

jstr = (j: Json, v: int, dflt: str = "") -> str:
    if v < 0: return dflt
    x = j.vals[v]
    if x.kind == JSTR: return x.s
    dflt

jnum = (j: Json, v: int, key: str, dflt: f64) -> f64: jnum(j, jget(j, v, key), dflt)
jint = (j: Json, v: int, key: str, dflt: int) -> int: int(jnum(j, jget(j, v, key), f64(dflt)))
jstr = (j: Json, v: int, key: str, dflt: str) -> str: jstr(j, jget(j, v, key), dflt)
jbool = (j: Json, v: int, key: str, dflt: bool) -> bool:
    e = jget(j, v, key)
    if e < 0: return dflt
    j.vals[e].num != 0.0

# numbers of an array value
jnums = (j: Json, v: int) -> f64[]:
    out: f64[]
    loop i in [0..jlen(j, v)): out.push(jnum(j, jat(j, v, i)))
    out

# ---------------- glTF ----------------
struct GNode:
    name = ""
    parent = -1
    children: int[]
    t = vec3(0, 0, 0)
    r = vec4(0, 0, 0, 1)
    s = vec3(1, 1, 1)
    mesh = -1
    skin = -1

struct GPrim:
    pos: f32[]          # 3 per vertex
    nrm: f32[]          # 3 per vertex (empty if missing)
    uv: f32[]           # 2 per vertex
    col: f32[]          # 4 per vertex (COLOR_0, RGB gets alpha 1)
    joints: f32[]       # 4 per vertex (indices into the skin's joints)
    weights: f32[]      # 4 per vertex
    idx: int[]
    material = -1
    mode = 4

struct GMesh:
    name = ""
    prims: GPrim[]

struct GMaterial:
    name = ""
    color = vec4(1, 1, 1, 1)        # baseColorFactor (linear)
    image = -1                      # baseColorTexture's image
    emissive = vec3(0, 0, 0)
    emissive_image = -1
    double_sided = false
    alpha_mode = "OPAQUE"

struct GImage:
    name = ""
    uri = ""            # file name relative to the glTF (empty if embedded)
    bytes: u8[]         # embedded image file (GLB bufferView)

struct GSkin:
    name = ""
    joints: int[]       # node indices
    ibm: mat4[]

const CH_T = 0
const CH_R = 1
const CH_S = 2
const CH_W = 3

struct GChannel:
    node = 0
    path = 0            # CH_T, CH_R, CH_S, CH_W
    interp = 0          # 0 linear, 1 step, 2 cubic spline
    times: f32[]
    vals: f32[]         # comps per key (3 or 4); cubic: in-tangent, value, out-tangent per key
    comps = 3

struct GAnim:
    name = ""
    channels: GChannel[]
    duration = 0.0

struct Gltf:
    path = ""
    dir = ""
    nodes: GNode[]
    meshes: GMesh[]
    materials: GMaterial[]
    images: GImage[]
    skins: GSkin[]
    anims: GAnim[]
    roots: int[]
    ok = false

__rd_u32 = (b: u8[], off: int) -> int: int(b[off]) | (int(b[off + 1]) << 8) | (int(b[off + 2]) << 16) | (int(b[off + 3]) << 24)

__dirname = (path: str) -> str:
    k = rfind(path, "/")
    if k < 0: return ""
    path[..k + 1)

__ncomps = (ty: str) -> int:
    match ty:
        "SCALAR": 1
        "VEC2": 2
        "VEC3": 3
        "VEC4": 4
        "MAT4": 16
        "MAT3": 9
        "MAT2": 4
        _: 1

__csize = (ct: int) -> int:
    if ct == 5120 or ct == 5121: return 1
    if ct == 5122 or ct == 5123: return 2
    4

# read an accessor as floats (normalized integers become 0..1 / -1..1)
__acc_f32 = (j: Json, bufs: u8[][], ai: int) -> f32[]:
    acc = jat(j, jget(j, j.root, "accessors"), ai)
    count = jint(j, acc, "count", 0)
    nc = __ncomps(jstr(j, acc, "type", "SCALAR"))
    ct = jint(j, acc, "componentType", 5126)
    norm = jbool(j, acc, "normalized", false)
    out = fill(f32(0.0), count * nc)
    bvi = jint(j, acc, "bufferView", -1)
    if bvi < 0: return out
    bv = jat(j, jget(j, j.root, "bufferViews"), bvi)
    base = jint(j, bv, "byteOffset", 0) + jint(j, acc, "byteOffset", 0)
    cs = __csize(ct)
    stride = jint(j, bv, "byteStride", 0)
    if stride == 0: stride = cs * nc
    __acc_conv(bufs[jint(j, bv, "buffer", 0)], out, count, nc, ct, norm, base, stride)
    out

# (the buffer is a borrowed parameter: data() on a shared local copy would copy it)
__acc_conv = (b: u8[], out: mut f32[], count: int, nc: int, ct: int, norm: bool, base: int, stride: int):
    cs = __csize(ct)
    if base + (count - 1) * stride + nc * cs > b.len(): return
    p0 = data(b)
    loop i in [0..count):
        p = p0 + base + i * stride
        loop c in [0..nc):
            q = p + c * cs
            v: f32 = 0.0
            if ct == 5126: v = (q as *f32)[0]
            else if ct == 5121:
                v = f32(q[0])
                if norm: v = v / 255.0
            else if ct == 5123:
                v = f32((q as *u16)[0])
                if norm: v = v / 65535.0
            else if ct == 5125: v = f32((q as *u32)[0])
            else if ct == 5120:
                v = f32((q as *i8)[0])
                if norm: v = max(v / 127.0, -1.0)
            else if ct == 5122:
                v = f32((q as *i16)[0])
                if norm: v = max(v / 32767.0, -1.0)
            out[i * nc + c] = v

__acc_comps = (j: Json, ai: int) -> int:
    __ncomps(jstr(j, jat(j, jget(j, j.root, "accessors"), ai), "type", "SCALAR"))

__acc_int = (j: Json, bufs: u8[][], ai: int) -> int[]:
    acc = jat(j, jget(j, j.root, "accessors"), ai)
    count = jint(j, acc, "count", 0)
    ct = jint(j, acc, "componentType", 5125)
    out = fill(0, count)
    bvi = jint(j, acc, "bufferView", -1)
    if bvi < 0: return out
    bv = jat(j, jget(j, j.root, "bufferViews"), bvi)
    base = jint(j, bv, "byteOffset", 0) + jint(j, acc, "byteOffset", 0)
    stride = jint(j, bv, "byteStride", 0)
    if stride == 0: stride = __csize(ct)
    __acc_conv_int(bufs[jint(j, bv, "buffer", 0)], out, count, ct, base, stride)
    out

__acc_conv_int = (b: u8[], out: mut int[], count: int, ct: int, base: int, stride: int):
    if base + (count - 1) * stride + __csize(ct) > b.len(): return
    p0 = data(b)
    loop i in [0..count):
        q = p0 + base + i * stride
        if ct == 5125: out[i] = int((q as *u32)[0])
        else if ct == 5123: out[i] = int((q as *u16)[0])
        else: out[i] = int(q[0])

# rotation part of a 3x3 (columns, may be scaled) as a quaternion
mat3_quat = (c0: vec3, c1: vec3, c2: vec3) -> vec4:
    a = normalize(c0)
    b = normalize(c1)
    c = normalize(c2)
    m00 = f64(a.x)
    m10 = f64(a.y)
    m20 = f64(a.z)
    m01 = f64(b.x)
    m11 = f64(b.y)
    m21 = f64(b.z)
    m02 = f64(c.x)
    m12 = f64(c.y)
    m22 = f64(c.z)
    tr = m00 + m11 + m22
    q = vec4(0, 0, 0, 1)
    if tr > 0.0:
        s = sqrt(tr + 1.0) * 2.0
        q = vec4(f32((m21 - m12) / s), f32((m02 - m20) / s), f32((m10 - m01) / s), f32(0.25 * s))
    else if m00 > m11 and m00 > m22:
        s = sqrt(1.0 + m00 - m11 - m22) * 2.0
        q = vec4(f32(0.25 * s), f32((m01 + m10) / s), f32((m02 + m20) / s), f32((m21 - m12) / s))
    else if m11 > m22:
        s = sqrt(1.0 + m11 - m00 - m22) * 2.0
        q = vec4(f32((m01 + m10) / s), f32(0.25 * s), f32((m12 + m21) / s), f32((m02 - m20) / s))
    else:
        s = sqrt(1.0 + m22 - m00 - m11) * 2.0
        q = vec4(f32((m02 + m20) / s), f32((m12 + m21) / s), f32(0.25 * s), f32((m10 - m01) / s))
    normalize(q)

__mat_from = (v: f64[], at: int) -> mat4:
    m = mat4()
    loop c in [0..4):
        m[c] = vec4(f32(v[at + c * 4]), f32(v[at + c * 4 + 1]), f32(v[at + c * 4 + 2]), f32(v[at + c * 4 + 3]))
    m

# image index of a texture reference ({"index": texture})
__tex_image = (j: Json, ref: int) -> int:
    if ref < 0: return -1
    ti = jint(j, ref, "index", -1)
    if ti < 0: return -1
    tex = jat(j, jget(j, j.root, "textures"), ti)
    jint(j, tex, "source", -1)

load_gltf = (path: str) -> Gltf:
    g = Gltf(path = path, dir = __dirname(path))
    raw = read_bytes(path) ?? []
    if raw.len() < 12:
        eprint("gltf: cannot read {path}")
        return g
    text = ""
    bufs: u8[][]
    glb_bin: u8[]
    if raw[0] == 'g' and raw[1] == 'l' and raw[2] == 'T' and raw[3] == 'F':
        off = 12
        loop off + 8 <= raw.len():
            clen = __rd_u32(raw, off)
            ctype = __rd_u32(raw, off + 4)
            if ctype == 0x4E4F534A:
                tb = raw[off + 8..off + 8 + clen)
                text = str_from_bytes(tb)
            else if ctype == 0x004E4942: glb_bin = raw[off + 8..off + 8 + clen)
            off += 8 + clen
    else: text = str_from_bytes(raw)
    j = parse_json(text)
    # buffers
    jb = jget(j, j.root, "buffers")
    loop i in [0..jlen(j, jb)):
        b = jat(j, jb, i)
        uri = jstr(j, b, "uri", "")
        if uri == "": bufs.push(glb_bin)
        else: bufs.push(read_bytes(g.dir + uri) ?? [])
    # nodes
    jn = jget(j, j.root, "nodes")
    loop i in [0..jlen(j, jn)):
        n = jat(j, jn, i)
        gn = GNode(name = jstr(j, n, "name", "node{i}"), mesh = jint(j, n, "mesh", -1), skin = jint(j, n, "skin", -1))
        t = jget(j, n, "translation")
        if t >= 0:
            v = jnums(j, t)
            gn.t = vec3(f32(v[0]), f32(v[1]), f32(v[2]))
        r = jget(j, n, "rotation")
        if r >= 0:
            v = jnums(j, r)
            gn.r = normalize(vec4(f32(v[0]), f32(v[1]), f32(v[2]), f32(v[3])))
        s = jget(j, n, "scale")
        if s >= 0:
            v = jnums(j, s)
            gn.s = vec3(f32(v[0]), f32(v[1]), f32(v[2]))
        mt = jget(j, n, "matrix")
        if mt >= 0:
            m = __mat_from(jnums(j, mt), 0)
            gn.t = m[3].xyz
            gn.s = vec3(length(m[0].xyz), length(m[1].xyz), length(m[2].xyz))
            gn.r = mat3_quat(m[0].xyz, m[1].xyz, m[2].xyz)
        ch = jget(j, n, "children")
        loop k in [0..jlen(j, ch)): gn.children.push(int(jnum(j, jat(j, ch, k))))
        g.nodes.push(gn)
    loop i in [0..g.nodes.len()):
        loop c in g.nodes[i].children: g.nodes[c].parent = i
    sc = jat(j, jget(j, j.root, "scenes"), jint(j, j.root, "scene", 0))
    sn = jget(j, sc, "nodes")
    loop k in [0..jlen(j, sn)): g.roots.push(int(jnum(j, jat(j, sn, k))))
    if g.roots.len() == 0:
        loop i in [0..g.nodes.len()):
            if g.nodes[i].parent < 0: g.roots.push(i)
    # images
    ji = jget(j, j.root, "images")
    loop i in [0..jlen(j, ji)):
        im = jat(j, ji, i)
        gi = GImage(name = jstr(j, im, "name", ""), uri = jstr(j, im, "uri", ""))
        bvi = jint(j, im, "bufferView", -1)
        if bvi >= 0:
            bv = jat(j, jget(j, j.root, "bufferViews"), bvi)
            b = bufs[jint(j, bv, "buffer", 0)]
            o = jint(j, bv, "byteOffset", 0)
            gi.bytes = b[o..o + jint(j, bv, "byteLength", 0))
        g.images.push(gi)
    # materials
    jm = jget(j, j.root, "materials")
    loop i in [0..jlen(j, jm)):
        m = jat(j, jm, i)
        gm = GMaterial(name = jstr(j, m, "name", ""), double_sided = jbool(j, m, "doubleSided", false), alpha_mode = jstr(j, m, "alphaMode", "OPAQUE"))
        pbr = jget(j, m, "pbrMetallicRoughness")
        cf = jget(j, pbr, "baseColorFactor")
        if cf >= 0:
            v = jnums(j, cf)
            gm.color = vec4(f32(v[0]), f32(v[1]), f32(v[2]), f32(v[3]))
        gm.image = __tex_image(j, jget(j, pbr, "baseColorTexture"))
        ef = jget(j, m, "emissiveFactor")
        if ef >= 0:
            v = jnums(j, ef)
            gm.emissive = vec3(f32(v[0]), f32(v[1]), f32(v[2]))
        gm.emissive_image = __tex_image(j, jget(j, m, "emissiveTexture"))
        g.materials.push(gm)
    # meshes
    jme = jget(j, j.root, "meshes")
    loop i in [0..jlen(j, jme)):
        m = jat(j, jme, i)
        gm = GMesh(name = jstr(j, m, "name", "mesh{i}"))
        ps = jget(j, m, "primitives")
        loop k in [0..jlen(j, ps)):
            p = jat(j, ps, k)
            a = jget(j, p, "attributes")
            gp = GPrim(material = jint(j, p, "material", -1), mode = jint(j, p, "mode", 4))
            if jget(j, a, "POSITION") >= 0: gp.pos = __acc_f32(j, bufs, jint(j, a, "POSITION", 0))
            if jget(j, a, "NORMAL") >= 0: gp.nrm = __acc_f32(j, bufs, jint(j, a, "NORMAL", 0))
            if jget(j, a, "TEXCOORD_0") >= 0: gp.uv = __acc_f32(j, bufs, jint(j, a, "TEXCOORD_0", 0))
            if jget(j, a, "JOINTS_0") >= 0: gp.joints = __acc_f32(j, bufs, jint(j, a, "JOINTS_0", 0))
            if jget(j, a, "WEIGHTS_0") >= 0: gp.weights = __acc_f32(j, bufs, jint(j, a, "WEIGHTS_0", 0))
            ci = jint(j, a, "COLOR_0", -1)
            if ci >= 0:
                c = __acc_f32(j, bufs, ci)
                if __acc_comps(j, ci) == 3:
                    nv = c.len() / 3
                    c4 = fill(f32(1.0), nv * 4)
                    loop q in [0..nv):
                        c4[q * 4] = c[q * 3]
                        c4[q * 4 + 1] = c[q * 3 + 1]
                        c4[q * 4 + 2] = c[q * 3 + 2]
                    gp.col = c4
                else: gp.col = c
            ii = jint(j, p, "indices", -1)
            if ii >= 0: gp.idx = __acc_int(j, bufs, ii)
            else: gp.idx = range(0, gp.pos.len() / 3)
            gm.prims.push(gp)
        g.meshes.push(gm)
    # skins
    js = jget(j, j.root, "skins")
    loop i in [0..jlen(j, js)):
        s = jat(j, js, i)
        gs = GSkin(name = jstr(j, s, "name", ""))
        jj = jget(j, s, "joints")
        loop k in [0..jlen(j, jj)): gs.joints.push(int(jnum(j, jat(j, jj, k))))
        ib = jint(j, s, "inverseBindMatrices", -1)
        if ib >= 0:
            v = __acc_f32(j, bufs, ib)
            loop k in [0..gs.joints.len()):
                m = mat4()
                loop c in [0..4): m[c] = vec4(v[k * 16 + c * 4], v[k * 16 + c * 4 + 1], v[k * 16 + c * 4 + 2], v[k * 16 + c * 4 + 3])
                gs.ibm.push(m)
        else:
            loop k in [0..gs.joints.len()): gs.ibm.push(mat4())
        g.skins.push(gs)
    # animations
    ja = jget(j, j.root, "animations")
    loop i in [0..jlen(j, ja)):
        an = jat(j, ja, i)
        ga = GAnim(name = jstr(j, an, "name", "anim{i}"))
        samplers = jget(j, an, "samplers")
        chs = jget(j, an, "channels")
        loop k in [0..jlen(j, chs)):
            c = jat(j, chs, k)
            tgt = jget(j, c, "target")
            node = jint(j, tgt, "node", -1)
            if node < 0: continue
            path_ = jstr(j, tgt, "path", "")
            gc = GChannel(node = node)
            match path_:
                "translation": gc.path = CH_T
                "rotation": gc.path = CH_R
                "scale": gc.path = CH_S
                _: gc.path = CH_W
            if gc.path == CH_W: continue
            smp = jat(j, samplers, jint(j, c, "sampler", 0))
            ip = jstr(j, smp, "interpolation", "LINEAR")
            if ip == "STEP": gc.interp = 1
            else if ip == "CUBICSPLINE": gc.interp = 2
            oi = jint(j, smp, "output", 0)
            gc.times = __acc_f32(j, bufs, jint(j, smp, "input", 0))
            gc.vals = __acc_f32(j, bufs, oi)
            gc.comps = __acc_comps(j, oi)
            if gc.times.len() > 0: ga.duration = max(ga.duration, f64(gc.times[gc.times.len() - 1]))
            ga.channels.push(gc)
        g.anims.push(ga)
    g.ok = true
    g

# ---------------- transforms ----------------
trs_mat = (t: vec3, r: vec4, s: vec3) -> mat4:
    m = quat_to_mat4(r)
    m[0] = m[0] * s.x
    m[1] = m[1] * s.y
    m[2] = m[2] * s.z
    m[3] = vec4(t.x, t.y, t.z, 1)
    m

node_local = (g: Gltf, i: int) -> mat4:
    n = g.nodes[i]
    trs_mat(n.t, n.r, n.s)

# scene-space transforms of all nodes (rest pose)
node_globals = (g: Gltf) -> mat4[]:
    out = fill(mat4(), g.nodes.len())
    done = fill(false, g.nodes.len())
    loop i in [0..g.nodes.len()): __node_global(g, i, out, done)
    out

__node_global = (g: Gltf, i: int, out: mut mat4[], done: mut bool[]) -> void:
    if done[i]: return
    p = g.nodes[i].parent
    if p >= 0:
        __node_global(g, p, out, done)
        out[i] = out[p] * node_local(g, i)
    else: out[i] = node_local(g, i)
    done[i] = true

find_node = (g: Gltf, name: str) -> int:
    loop i in [0..g.nodes.len()):
        if g.nodes[i].name == name: return i
    ln = lower(name)
    loop i in [0..g.nodes.len()):
        if lower(g.nodes[i].name) == ln: return i
    -1

find_anim = (g: Gltf, name: str) -> int:
    loop i in [0..g.anims.len()):
        if g.anims[i].name == name: return i
    -1

# a channel's value at time t (vec4; translation/scale use xyz)
channel_at = (c: GChannel, t: f64) -> vec4:
    n = c.times.len()
    k = c.comps
    cub = c.interp == 2
    stride = k
    vo = 0
    if cub:
        stride = k * 3
        vo = k
    if n == 0: return vec4(0, 0, 0, 1)
    if n == 1 or t <= f64(c.times[0]): return __cv(c, vo, k)
    if t >= f64(c.times[n - 1]): return __cv(c, (n - 1) * stride + vo, k)
    # binary search for the key interval
    lo = 0
    hi = n - 1
    loop hi - lo > 1:
        mid = (lo + hi) / 2
        if f64(c.times[mid]) <= t: lo = mid
        else: hi = mid
    a = __cv(c, lo * stride + vo, k)
    if c.interp == 1: return a
    b = __cv(c, hi * stride + vo, k)
    f = f32((t - f64(c.times[lo])) / max(f64(c.times[hi] - c.times[lo]), 1e-9))
    if c.path == CH_R:
        if dot(a, b) < 0.0: b = b * -1.0
        return normalize(a + (b - a) * f)
    a + (b - a) * f

__cv = (c: GChannel, o: int, k: int) -> vec4:
    if k == 4: return vec4(c.vals[o], c.vals[o + 1], c.vals[o + 2], c.vals[o + 3])
    vec4(c.vals[o], c.vals[o + 1], c.vals[o + 2], 0)

# Game-owned signed derivative bridge for the unmodified 0.6.0 compiler.
# Tagged functions contain one OpFwidth plus a unique float constant. Replace
# only that function's derivative, and zero the tag; preserve IDs and module ABI.
game_spirv_derivatives = (src: str) -> str:
    if src == "": return src
    words = fill(u32(0), src.len() / 4)
    mem_copy(data(words) as *u8, data(src), src.len())
    tags: {u32: u32} = {}
    at = 5
    loop at < words.len():
        n = int(words[at] >> 16)
        op = words[at] & 65535
        assert(n > 0 and at + n <= words.len(), "invalid SPIR-V instruction")
        if op == 43 and n == 4:
            if words[at + 3] == u32(0x49800000): tags[words[at + 2]] = 207
            if words[at + 3] == u32(0x4A000000): tags[words[at + 2]] = 208
        at += n
    at = 5
    start = 0
    derivative = u32(0)
    loop at < words.len():
        n = int(words[at] >> 16)
        op = words[at] & 65535
        if op == 54:
            start = at
            derivative = 0
        if start > 0 and op == 129 and n == 5:
            derivative = tags.get(words[at + 4]) ?? derivative
        if op == 56 and start > 0:
            if derivative != 0:
                k = start
                count = 0
                loop k < at:
                    if words[k] & 65535 == 209:
                        words[k] = (words[k] & u32(0xFFFF0000)) | derivative
                        count += 1
                    k += int(words[k] >> 16)
                assert(count == 1, "signed derivative helper changed shape")
            start = 0
        at += n
    at = 5
    loop at < words.len():
        n = int(words[at] >> 16)
        if words[at] & 65535 == 43 and tags.has(words[at + 2]): words[at + 3] = 0
        at += n
    bytes = fill(u8(0), src.len())
    mem_copy(data(bytes), data(words) as *u8, bytes.len())
    str_from_bytes(bytes)

# Corner offsets can contract into p * 0.1031 after driver inlining. The
# resulting rounding difference is magnified by hash12's final fract, so the
# same corner approaches 1 in one vnoise cell and 0 in its neighbour. Fence
# that multiply only; retain the hash and every other shader optimization.
game_spirv_noise_precision = (src: str) -> str:
    if src == "": return src
    words = fill(u32(0), src.len() / 4)
    mem_copy(data(words) as *u8, data(src), src.len())
    scale = u32(0)
    at = 5
    loop at < words.len():
        n = int(words[at] >> 16)
        op = words[at] & 65535
        assert(n > 0 and at + n <= words.len(), "invalid SPIR-V instruction")
        if op == 43 and n == 4 and words[at + 3] == u32(0x3DD32618): scale = words[at + 2] # f32(0.1031)
        at += n
    if scale == 0: return src
    decorations: u32[]
    insert = 0
    at = 5
    loop at < words.len():
        n = int(words[at] >> 16)
        op = words[at] & 65535
        if insert == 0 and op >= 19 and op <= 39: insert = at
        if op == 142 and n == 5 and words[at + 4] == scale:
            decorations.push(u32(3 << 16) | 71) # OpDecorate
            decorations.push(words[at + 2])
            decorations.push(42) # NoContraction
        at += n
    if decorations.len() == 0: return src
    assert(insert > 0, "noise precision requires a SPIR-V type section")
    out = words[..insert) + decorations + words[insert..]
    bytes = fill(u8(0), out.len() * 4)
    mem_copy(data(bytes), data(out) as *u8, bytes.len())
    str_from_bytes(bytes)

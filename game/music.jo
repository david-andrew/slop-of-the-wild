title_cue = ():
    match env("BOTW_TITLE_THEME") ?? "a":
        "b": title_theme_b()
        "c": title_theme_c()
        _: title_theme_a()

# an enemy has seen you: a quick rising stab and a low hit (not again for a while)
__alert_t = -100.0
__was_combat = false
# Enemy slots remain stable for the loaded world. Remember actual pursuers so
# crossing the 35 m music radius does not masquerade as defeating the camp.
__combat_participants: int[]
combat_watch = (fighting: bool, foes_alive: bool):
    if fighting:
        if not __was_combat: __combat_participants.clear()
        loop i in [0..enemies.len()):
            e = enemies[i]
            hunting = e.state == .chase or e.state == .windup or e.state == .attack or e.state == .shoot or e.state == .laser or e.state == .seek_skull or e.state == .reassemble or (e.kind == .talus and e.state != .sleep)
            if hunting and enemy_alive(e) and length(e.pos-pl.pos) < 35.0 and not __combat_participants.contains(i): __combat_participants.push(i)
    else if __was_combat:
        escaped = false
        loop i in __combat_participants:
            if i < enemies.len() and enemy_alive(enemies[i]): escaped = true
        if not foes_alive and not escaped: victory_stinger()
        __combat_participants.clear()
    __was_combat = fighting
alert_stab = ():
    if elapsed() - __alert_t < 8.0: return
    __alert_t = elapsed()
    loop i in 0.. and m in [69, 72, 75, 76]: __later(f64(i) * 0.07, m, 0.7)
    __later(0.3, 45, 0.85)
    __later(0.3, 57, 0.75)
    __later(0.31, 64, 0.6)

# A 2-bar question in the chamber, enlarged to four bars as Jo stands.
# The bII is a distant shadow rather than a cadence; no bright reward chord.
wake_cue = ():
    __later(1.4, 93, 0.18, 0.65, 2.2)
    __later(3.2, 92, 0.16, 0.65, 2.1)
    __story_motif(8.1, 2.0, 0, 0.23, 2.0)
    __later(9.0, 39, 0.13, 0.55, 2.5)
    __later(9.07, 46, 0.11, 0.55, 2.43)
    __later(16.3, 76, 0.21, 0.65, 2.1)
    __later(18.5, 81, 0.23, 0.65, 2.0)
    __later(22.2, 57, 0.15, 0.55, 2.2)
    __later(23.5, 88, 0.16, 0.55, 2.0)

# Tower: fragmented motif rises with the camera, then releases at 19 s.
# Electronics answer the piano via finite glass strikes, without a pad loop.
tower_cue = ():
    quiet = if env.night > 0.5: 0.72 else: 1.0
    __glass_later(2.0, 79, 0.16 * quiet)
    __glass_later(6.4, 86, 0.15 * quiet)
    __glass_later(11.8, 93, 0.12 * quiet)
    loop n in [(0.0, 50), (2.6, 57), (5.4, 62), (8.5, 64)]: __later(n.0, n.1, 0.27 * quiet, 0.7, 2.2)
    __later(5.4, 51, 0.17 * quiet, 0.65, 2.0)
    __later(5.47, 58, 0.14 * quiet, 0.65, 1.93)
    __story_motif(10.1, 1.55, 12, 0.34 * quiet, 2.1)
    loop n in [(14.5, 78), (14.67, 81), (16.0, 50), (16.1, 57), (16.4, 88)]: __later(n.0, n.1, 0.25 * quiet, 0.75, 1.85)

# Discovery: a short open-fifth chime (not the motif); field figures wait for its release.
# (a short open-fifth chime, as BotW's place-found sting: it had been the plateau motif itself, so
# walking past three new places stated the theme three more times)
discovery_jingle = ():
    loop i in 0.. and m in [74, 81, 86, 93]: __later([0.0, 0.52, 1.5, 3.1][i], m, [0.36, 0.33, 0.3, 0.22][i], hold = 2.75)
    if seq.mood != .combat and seq.mood != .title:
        seq.events.clear()
        seq.low_events.clear()
        seq.low_rest = max(seq.low_rest, 23.3)
        seq.strike_at = seq.age + 1.3
        seq.rest = max(seq.rest, 23.3)  # 22 s after the last discovery strike
    __later(0.0, 50, 0.4)
    __later(0.01, 57, 0.35)

# Tiers include their finite release: common 4 s, discovery/puzzle 6-7 s,
# orb/key reward 8.6 s. Cells relate to the motif rather than triad ladders.
item_jingle = ():
    loop n in [(0.0, 86), (0.15, 88), (0.68, 93)]: __later(n.0, n.1, 0.45, 1.2, 2.65)

secret_jingle = ():
    __story_motif(0.0, 1.15, 12, 0.32, 1.2)
    __later(2.7, 87, 0.24, 0.6, 1.8)
    __later(2.72, 58, 0.16, 0.6, 1.78)
    __later(3.9, 93, 0.30, 0.65, 1.45)

orb_jingle = ():
    quiet = if env.night > 0.5: 0.72 else: 1.0
    __story_motif(0.0, 1.7, 12, 0.34 * quiet, 1.6)
    __later(2.0, 51, 0.20 * quiet, 0.6, 1.5)
    __later(2.07, 58, 0.16 * quiet, 0.6, 1.43)
    __later(4.25, 78, 0.30 * quiet, 0.65, 1.5)
    __later(5.6, 50, 0.27 * quiet, 0.7, 2.35)
    __later(5.68, 57, 0.22 * quiet, 0.7, 2.27)
    __later(5.95, 88, 0.25 * quiet, 0.7, 2.0)

struct Later:
    t: f64
    midi: int
    vel: f64
    vol = 0.8
    hold = 2.5
    glass = false
laters: Later[]
__later = (t: f64, midi: int, vel: f64, vol: f64 = 0.8, hold: f64 = 2.5): laters.push(Later(t, midi, vel, vol, hold))

__glass_later = (t: f64, midi: int, vol: f64): laters.push(Later(t, midi, 0.2, vol, glass = true))

jingles_update = (dt: f64):
    i = 0
    loop i < laters.len():
        laters[i].t -= dt
        if laters[i].t <= 0.0:
            if laters[i].glass:
                music_log_kind = "glass"
                music_log_note(laters[i].midi, laters[i].vel, laters[i].vol, 0.22)
                __score_play(shrine_glass, laters[i].vol * music_vol, 0.22, pow(2.0, f64(laters[i].midi - 72) / 12.0), false)
                music_log_kind = "piano"
            else: piano_play(laters[i].midi, laters[i].vel, 0.0, laters[i].vol, hold = laters[i].hold)
            laters.remove(i)
        else: i += 1

# Float export exists only for offline equivalence tools. Play never expands a bank.
piano_asset = () -> AudioAsset:
    AudioAsset([loop bank in [piano.notes, piano.soft, piano.forte, piano.short_notes, piano.short_soft, piano.short_forte, piano.restrained_soft, piano.weather_soft]: [loop s in bank: piano_expand(s)]] + [[reverse_piano], [drum_lo], [drum_hi], [combat_entry], [shrine_glass]], [])

const PIANO_ASSET_MAGIC = 0x42575049414E4F32
piano_asset_read = () -> bool:
    if env("BOTW_BAKE_ASSETS") != none or env("BOTW_NO_PREPARED_ASSETS") != none: return false
    s = asset_open("assets/prepared/piano-compact.bin")
    defer asset_close(s)
    if not s.ok or asset_int(s) != PIANO_ASSET_MAGIC or asset_int(s) != audio_asset_key(["game/music.jo"]): return false
    banks: PianoSample[][]
    loop group in [0..7):
        count = asset_int(s)
        if not s.ok or count != PIANO_COUNT: return false
        bank: PianoSample[]
        loop j in [0..count):
            n = asset_int(s)
            scale = f32(0)
            asset_read(s, (&scale) as *u8, 4)
            if not s.ok or n < 2 or n > MIX_RATE * 24 or n % 2 != 0 or n * 2 > s.left or not (scale > 0.0 and scale < 1.0): return false
            samples = fill(i16(0), n)
            asset_read(s, data(samples) as *u8, n * 2)
            if not s.ok: return false
            bank.push(PianoSample(samples, scale))
        banks.push(bank)
    cues: Sound[]
    loop i in [0..4):
        n = asset_int(s)
        if not s.ok or n < 2 or n > MIX_RATE * 24 or n % 2 != 0 or n * 4 > s.left: return false
        samples = fill(f32(0), n)
        asset_read(s, data(samples) as *u8, n * 4)
        if not s.ok: return false
        cues.push(Sound(samples))
    if s.left != 0: return false
    piano.notes = banks[0]
    piano.soft = banks[1]
    piano.forte = banks[2]
    piano.short_notes = banks[3]
    piano.short_soft = banks[4]
    piano.short_forte = banks[5]
    piano.restrained_soft = banks[6]
    drum_lo = cues[0]
    drum_hi = cues[1]
    combat_entry = cues[2]
    shrine_glass = cues[3]
    true

piano_asset_write = () -> bool:
    path = "assets/prepared/piano-compact.bin"
    temp = path + ".tmp"
    s = asset_create(temp)
    asset_put_int(s, PIANO_ASSET_MAGIC)
    asset_put_int(s, audio_asset_key(["game/music.jo"]))
    loop bank in [piano.notes, piano.soft, piano.forte, piano.short_notes, piano.short_soft, piano.short_forte, piano.restrained_soft]:
        assert(bank.len() == PIANO_COUNT)
        asset_put_int(s, bank.len())
        loop note in bank:
            asset_put_int(s, note.samples.len())
            scale = note.scale
            asset_write(s, (&scale) as *u8, 4)
            asset_write(s, data(note.samples) as *u8, note.samples.len() * 2)
    loop cue in [drum_lo, drum_hi, combat_entry, shrine_glass]:
        asset_put_int(s, cue.samples.len())
        asset_write(s, data(cue.samples) as *u8, cue.samples.len() * 4)
    asset_close(s)
    if not s.ok: return false
    when TARGET == "linux": return syscall(82, data(temp + "\0"), data(path + "\0")) == 0
    else: return false

use 'gfx.jo'
use 'audio_assets.jo'
use 'asset_stream.jo'
use 'audio_mix.jo'
use 'player.jo'
use 'env.jo'
use 'enemies.jo'
use 'combat.jo'

# Iowa Steinway pp/mf/ff, sparse field figures and piano set pieces.
# Missing recordings fall back to additive synthesis.

const PIANO_STEP = 3                  # semitones between sampled notes (the rest are pitched)
const PIANO_LO = 21                   # midi A0
const PIANO_HI = 108                  # midi C8
# Lowest Iowa recordings differ by dynamic; absent files must not be mislabeled.
piano_recording_midi = (slot: int, dynamic: str) -> int:
    if slot == 0:
        return if dynamic == "pp": 22 else: (if dynamic == "mf": 23 else: 22)
    if dynamic == "mf" and slot >= PIANO_COUNT - 2: return PIANO_LO + slot * PIANO_STEP - 1
    if slot == 1 and dynamic == "pp": return 25 # Iowa pp C1 is mislabeled; use Db1.
    PIANO_LO + slot * PIANO_STEP

const PIANO_COUNT = (PIANO_HI - PIANO_LO) / PIANO_STEP + 1

piano_slot = (midi: int, dynamic: str) -> int:
    k = clamp((midi - PIANO_LO + PIANO_STEP / 2) / PIANO_STEP, 0, PIANO_COUNT - 1)
    best = k
    loop candidate in [max(0, k - 1)..min(PIANO_COUNT, k + 2)):
        if abs(midi - piano_recording_midi(candidate, dynamic)) < abs(midi - piano_recording_midi(best, dynamic)):
            best = candidate
    best

# Per-note scaled PCM16 keeps the stereo room response and original 48 kHz
# timing. Only active voice rings expand to f32; quiet layers retain full precision
# relative to their own peak (rather than a single bank-wide quantizer).
struct PianoSample:
    samples: i16[]
    scale: f32

piano_pack = (sound: Sound) -> PianoSample:
    peak = f32(0)
    loop v in sound.samples: peak = max(peak, abs(v))
    scale = max(peak, f32(0.00000001)) / 32767.0
    PianoSample([loop v in sound.samples: i16(clamp(round(f64(v / scale)), -32767.0, 32767.0))], scale)

piano_expand = (s: PianoSample) -> Sound:
    Sound([loop v in s.samples: f32(v) * s.scale])

piano_duration = (s: PianoSample) -> f64: f64(s.samples.len()) / (2.0 * f64(MIX_RATE))

piano_sample = (s: PianoSample, i: int) -> f32: f32(s.samples[i]) * s.scale

struct PianoBank:
    notes: PianoSample[]
    soft: PianoSample[]                     # quieter, darker strikes
    forte: PianoSample[]
    short_soft: PianoSample[]
    short_notes: PianoSample[]
    short_forte: PianoSample[]
    weather_soft: PianoSample[]
    restrained_soft: PianoSample[]          # low-health bass: 45 ms body, 95 ms damper release
    ready = false

piano = PianoBank()

midi_freq = (m: f64) -> f64: 440.0 * pow(2.0, (m - 69.0) / 12.0)

# a struck note, mono
__piano_mono = (midi: int, vel: f64, seconds: f64) -> f32[]:
    sr = f64(MIX_RATE)
    n = int(seconds * sr)
    out = fill(f32(0), n)
    f0 = midi_freq(f64(midi))
    b = 0.00008 * pow(2.0, f64(midi - 48) / 18.0)        # inharmonicity grows up the keyboard
    tau = clamp(9.0 * pow(0.5, f64(midi - 36) / 16.0), 0.9, 9.0)
    bright = 0.55 + 0.45 * vel
    seed_random(midi * 7 + int(vel * 10.0))
    loop k in [1..24]:
        fk = f64(k) * f0 * sqrt(1.0 + b * f64(k * k))
        if fk > 14000.0: break
        amp = pow(f64(k), -1.15 - (1.0 - bright) * 0.9)
        # the hammer hits ~1/8 of the way along the string: those partials are weak
        amp *= 0.35 + 0.65 * abs(sin(PI * f64(k) / 8.0))
        tk = tau / (1.0 + 0.45 * f64(k - 1))
        det = 0.0006 + 0.0003 * random()
        ph1 = random() * TAU
        ph2 = random() * TAU
        w1 = TAU * fk * (1.0 + det) / sr
        w2 = TAU * fk * (1.0 - det) / sr
        # two oscillators by rotation (cheap), summed with a two-stage envelope
        c1 = cos(w1)
        s1 = sin(w1)
        c2 = cos(w2)
        s2 = sin(w2)
        x1 = cos(ph1)
        y1 = sin(ph1)
        x2 = cos(ph2)
        y2 = sin(ph2)
        fast = exp(-1.0 / (tk * 0.22 * sr))
        slow = exp(-1.0 / (tk * sr))
        ef = 0.72
        es = 0.28
        loop i in [0..n):
            v = (y1 + y2) * (ef + es)
            out[i] += f32(v * amp)
            nx1 = x1 * c1 - y1 * s1
            y1 = x1 * s1 + y1 * c1
            x1 = nx1
            nx2 = x2 * c2 - y2 * s2
            y2 = x2 * s2 + y2 * c2
            x2 = nx2
            ef *= fast
            es *= slow
            if ef + es < 0.0003: break
    # attack ramp and hammer thump (filtered noise)
    lp = 0.0
    loop i in [0..min(n, int(0.04 * sr))):
        t = f64(i) / sr
        lp += (random(-1.0, 1.0) - lp) * 0.08
        out[i] += f32(lp * exp(-t * 90.0) * 0.6 * vel)
    # the soundboard answers the blow: a few low body modes, ringing briefly
    loop bm in [(98.0, 0.12, 0.5), (176.0, 0.09, 0.4), (262.0, 0.07, 0.3), (395.0, 0.05, 0.22)]:
        w = TAU * bm.0 / sr
        a0 = bm.2 * 0.05 * vel
        cw = cos(w)
        sw = sin(w)
        x = 1.0
        y = 0.0
        e = a0
        de = exp(-1.0 / (bm.1 * sr))
        loop i in [0..min(n, int(bm.1 * 5.0 * sr))):
            out[i] += f32(y * e)
            nx = x * cw - y * sw
            y = x * sw + y * cw
            x = nx
            e *= de
    # undamped strings an octave and a twelfth up ring along faintly, long after
    loop hm in [(2.0, 0.025), (3.0, 0.015)]:
        w = TAU * f0 * hm.0 * (1.0 + 0.0012) / sr
        if f0 * hm.0 > 12000.0: continue
        # (an oscillator by rotation and an envelope by multiplication: no sin or exp per sample)
        cw = cos(w)
        sw = sin(w)
        x = 1.0
        y = 0.0
        e = hm.1
        de = exp(-1.0 / (tau * 1.4 * sr))
        rise = int(0.15 * sr)
        loop i in [0..n):
            out[i] += f32(y * e * (if i < rise: f64(i) / f64(rise) else: 1.0))
            nx = x * cw - y * sw
            y = x * sw + y * cw
            x = nx
            e *= de
            if e < 0.0005: break
    loop i in [0..min(n, int(0.003 * sr))): out[i] *= f32(f64(i) / (0.003 * sr))
    # loudness
    g = 0.11 * (0.35 + 0.65 * vel) * pow(f0 / 261.0, -0.15)
    loop mut s in out: s *= f32(g)
    out

# a Schroeder/Freeverb style reverb: mono in, stereo out (wet + dry)
reverb_stereo = (x: f32[], wet: f64, room: f64, damp: f64) -> f32[]:
    n = x.len()
    out = fill(f32(0), n * 2)
    combs = [1557, 1617, 1491, 1422, 1277, 1356, 1188, 1116]
    aps = [556, 441, 341, 225]
    loop side in [0..2):
        acc = fill(0.0, n)
        spread = side * 23
        loop d0 in combs:
            d = d0 + spread
            buf = fill(0.0, d)
            idx = 0
            store = 0.0
            loop i in [0..n):
                y = buf[idx]
                store = y * (1.0 - damp) + store * damp
                buf[idx] = f64(x[i]) + store * room
                idx += 1
                if idx >= d: idx = 0
                acc[i] += y
        loop d0 in aps:
            d = d0 + spread
            buf = fill(0.0, d)
            idx = 0
            loop i in [0..n):
                bo = buf[idx]
                inp = acc[i]
                acc[i] = -inp + bo
                buf[idx] = inp + bo * 0.5
                idx += 1
                if idx >= d: idx = 0
        loop i in [0..n): out[i * 2 + side] = f32(f64(x[i]) * (1.0 - wet * 0.5) + acc[i] * wet * 0.12)
    # (the two sides' tails drawn a little together: a room, not a phasey width)
    loop i in [0..n):
        l = out[i * 2]
        r = out[i * 2 + 1]
        m = (l + r) * 0.5
        sd = (l - r) * 0.5 * 0.62
        out[i * 2] = m + sd
        out[i * 2 + 1] = m - sd
    out

# Imported mono PCM16 at MIX_RATE; load_wav expands it to interleaved stereo.
# Two seconds after the dry tail for the room to decay.
__piano_seconds = (midi: int) -> f64: 10.0 - f64(max(0, midi - 36)) / 20.0
__piano_sample = (midi: int, dynamic: str, vel: f64) -> f32[]:
    path = "assets/audio/piano-{dynamic}-{midi}.wav"
    if let bytes = read_bytes(path):
        s = load_wav(bytes)
        mono = fill(f32(0), int(__piano_seconds(midi) * f64(MIX_RATE)))
        loop i in [0..min(mono.len(), s.samples.len() / 2)):
            mono[i] = (s.samples[i * 2] + s.samples[i * 2 + 1]) * 0.5
        return mono
    eprint("{path} missing; using synthesized piano note")
    __piano_mono(midi, vel, __piano_seconds(midi))

# Damper closes after 100 ms, with a smooth 160 ms release; prebuilt, never sliced on a frame.
__piano_short = (s: PianoSample, close: f64 = 0.10, end: f64 = 0.26) -> PianoSample:
    n = int(end * f64(MIX_RATE))
    out = fill(f32(0), n * 2)
    loop i in [0..n):
        g = f32(1.0 - smoothstep(close, end, f64(i) / f64(MIX_RATE)))
        out[i * 2] = (if i * 2 < s.samples.len(): piano_sample(s, i * 2) else: 0.0) * g
        out[i * 2 + 1] = (if i * 2 + 1 < s.samples.len(): piano_sample(s, i * 2 + 1) else: 0.0) * g
    piano_pack(Sound(out))

# A single prebuilt glass strike; the sequencer pitches it, never loops it.
shrine_glass = Sound()
__shrine_glass = () -> Sound:
    out = fill(f32(0), MIX_RATE * 4 * 2)
    loop i in [0..MIX_RATE * 4):
        t = f64(i) / f64(MIX_RATE)
        v = sin(TAU * 523.251 * t) * exp(-t / 1.1)
        v += sin(TAU * 523.251 * 2.756 * t) * 0.28 * exp(-t / 0.65)
        v += sin(TAU * 523.251 * 5.404 * t) * 0.10 * exp(-t / 0.32)
        v *= smoothstep(0.0, 0.009, t) * (1.0 - smoothstep(3.2, 4.0, t)) * 0.075
        out[i*2] = f32(v)
        out[i*2+1] = f32(v * 0.94)
    Sound(out)

drum_lo = Sound()
drum_hi = Sound()
combat_entry = Sound()

when TARGET == "wasm":
    extern __web_piano_deferred = () -> int
    @export("__web_piano_finish")
    web_piano_finish = ():
        piano_init()
        assert(piano.ready,"browser piano worker pack validated")

piano_init = ():
    if piano.ready: return
    when TARGET == "wasm":
        if __web_piano_deferred() != 0: return
    saved = __global_rng
    defer __global_rng = saved
    seed_random(12345)
    if piano_asset_read():
        piano.ready = true
        piano_reverse_init()
        return
    piano.ready = true
    keys: int[]
    m = PIANO_LO
    loop m <= PIANO_HI:
        keys.push(m)
        m += PIANO_STEP
    loud = parallel_map(keys, (k: int):
        piano_pack(Sound(reverb_stereo(__piano_sample(k, "mf", 0.75), 0.55, 0.86, 0.35)))
    )
    quiet = parallel_map(keys, (k: int):
        piano_pack(Sound(reverb_stereo(__piano_sample(k, "pp", 0.35), 0.65, 0.88, 0.45)))
    )
    forte = parallel_map(keys, (k: int):
        piano_pack(Sound(reverb_stereo(__piano_sample(k, "ff", 1.0), 0.55, 0.86, 0.35)))
    )
    piano.notes = loud
    piano.soft = quiet
    piano.forte = forte
    piano.short_notes = parallel_map(loud, (s: PianoSample): __piano_short(s))
    piano.short_soft = parallel_map(quiet, (s: PianoSample): __piano_short(s))
    piano.short_forte = parallel_map(forte, (s: PianoSample): __piano_short(s))
    piano.restrained_soft = parallel_map(quiet, (s: PianoSample): __piano_short(s, 0.045, 0.14))
    combat_drums()
    shrine_glass = __shrine_glass()
    piano_reverse_init()

music_vol = 1.0
music_logging = false
music_log = "time,midi,velocity,gain,pan,hand,phrase,kind,root\n"
music_log_hand = -1
music_log_phrase = 0
music_log_kind = "piano"
music_log_note = (midi: int, vel: f64, gain: f64, pan: f64):
    if music_logging: music_log = "{music_log}{seq.age:.6},{midi},{vel:.6},{gain:.6},{pan:.6},{music_log_hand},{music_log_phrase},{music_log_kind},{__tonic_for(seq.mood) % 12}\n"

# Reverse a finite, already reverberated pp sample; a slow entry and terminal
# damper avoid a backwards hammer click. Built once after either bank load path.
reverse_piano = Sound()
# Snow/storm high-pass preserves the upper register while thinning the body.
# Derived identically from generated and prepared banks, never added to assets.
piano_weather = (s: PianoSample) -> PianoSample:
    out = piano_expand(s)
    alpha = exp(-TAU * 350.0 / f64(MIX_RATE))
    loop side in [0..2):
        low = 0.0
        loop i in [0..out.samples.len() / 2):
            x = f64(out.samples[i * 2 + side])
            low = (1.0 - alpha) * x + alpha * low
            out.samples[i * 2 + side] = f32(x - low)
    piano_pack(out)

# Field bass through Gb2 and upper notes from A5 need the weather filter.
# MIDI bounds preserve selection when the recording bank grows at either end.
piano_weather_key = (midi: int) -> bool: midi <= 42 or midi >= 81

piano_reverse_init = ():
    source = piano.soft[(84 - PIANO_LO) / PIANO_STEP]
    n = MIX_RATE * 3
    out = fill(f32(0), n * 2)
    loop i in [0..n):
        at = n - 1 - i
        g = f32(smoothstep(0.0, 0.45, f64(i) / f64(MIX_RATE)) * (1.0 - smoothstep(2.75, 3.0, f64(i) / f64(MIX_RATE))))
        out[i * 2] = piano_sample(source, at * 2) * g
        out[i * 2 + 1] = piano_sample(source, at * 2 + 1) * g
    reverse_piano = Sound(out)
    # Only the extreme-register pp keys used in field need a derived bank;
    # other entries alias the source and add no sample storage.
    keys = [loop i in [0..piano.soft.len()): i]
    piano.weather_soft = parallel_map(keys, (i: int):
        if piano_weather_key(PIANO_LO + i * PIANO_STEP): piano_weather(piano.soft[i]) else: piano.soft[i]
    )


struct PianoBlend:
    pp: f64
    mf: f64
    ff: f64

piano_blend = (vel: f64) -> PianoBlend:
    if vel <= 0.65:
        x = smoothstep(0.35, 0.65, vel)
        return PianoBlend(cos(x * PI / 2.0), sin(x * PI / 2.0), 0.0)
    x = smoothstep(0.70, 0.95, vel)
    PianoBlend(0.0, cos(x * PI / 2.0), sin(x * PI / 2.0))

piano_gain = (vel: f64, volume: f64) -> f64: volume * (0.5 + vel * 0.6) * music_vol
piano_pan = (midi: int) -> f64: sin(f64(midi) * 1.7) * 0.16

const FIELD_GAIN = 0.65              # field sits beneath world/steps, not the old foreground score
const SHRINE_GAIN = 3.076734159       # separate chamber calibration; preserve drone/lead balance
const COMBAT_GAIN = 3.349654392       # +4.5 dB over round 65; shared live/offline gain
const LOW_HP_GAIN = 1.216186001       # +1.7 dB restores level with fewer bass strikes
const COMBAT_ENTRY_LEVEL = 0.353386   # entry accent -1.5 dB relative to the sustained fight
const TITLE_GAIN = 2.15        # story piano gain; restrained reveal, finite pedal release
const CUE_DUCK_ENGAGED = 0.113175801   # same cue margin after the combat gain change
const CUE_DUCK_LOW_HP = 0.078364611

# Night and storms yield to the world. These are piano gains, not master
# changes or normalization of an exported clip.
field_gain = (m: Mood) -> f64:
    if m == .shrine: return SHRINE_GAIN
    trim = match m:
        field_day, forest, snow: 0.794328235
        field_golden: 0.42
        ruins: 0.55
        field_night: 0.630957344
        field_rain: 1.0
        _: 1.0
    FIELD_GAIN * trim
combat_gain = (tier: CombatTier) -> f64: COMBAT_GAIN * (if tier == .low_hp: LOW_HP_GAIN else: 1.0)
# (the plateau motif heard rarely, as in BotW's field score: on its own at most every three minutes,
# arriving at a landmark (once a visit) at most every minute and a half)
const FIELD_MOTIF_GAP = 180.0
const LANDMARK_MOTIF_GAP = 90.0
const COMBAT_BPM = 152.0

# Context voices fade with the score; story cues keep their own tails. Both share
# cue ducking, so a notice sting cannot mask the first enemy wind-up.
struct ScoreVoice:
    id: int
    gain: f64
    left: f64
    context = true
    retiring = false
    source = Sound()
    packed = PianoSample()
    applied = 1.0
    ramp_from = 1.0
    ramp_at = 0.0
    ramp_frames = 1.0
    source_pos = 0.0
    mixer_pos = 0.0
    prepared_until = 0
    damper_close = -1.0
    damper_end = 0.0
score_voices: ScoreVoice[]
music_hold = 0.0
music_activity = 0.0
music_note_count = 0
music_motif_count = 0
phrase_used_motif = false
# Cue preparation runs after the sequencer but before mixing. Apply the attack to
# existing voices and new strikes alike; recover over 240 ms after the cue body.
music_duck = 1.0
music_duck_hold = 0.0
music_duck_floor = 1.0
music_cue_duck = ():
    low = pl.hp <= max(4, pl.hp_max / 4) + (if seq.combat_tier == .low_hp: 1 else: 0)
    music_duck_floor = min(music_duck_floor, (if low: CUE_DUCK_LOW_HP else: CUE_DUCK_ENGAGED))
    music_duck_hold = max(music_duck_hold, 0.18)
    music_duck = min(music_duck, music_duck_floor)
    loop v in score_voices: score_set_volume(v.id, (if v.retiring: 0.0 else: v.gain * (if v.context: seq.volume * (if seq.mood == .combat: 1.0 else: seq.sneak_gain) else: 1.0) * music_duck))

# The release mixer consumes at most 8192 output frames per update. A pitched
# ring retains that lookahead plus interpolation guards, independent of note length.
# Shared piano banks stay immutable; only this small voice-owned window is baked.
__score_play = (s: Sound, gain: f64, pan: f64, pitch: f64, score: bool) -> int:
    initial = clamp(gain * (if score: seq.volume * (if seq.mood == .combat: 1.0 else: seq.sneak_gain) else: 1.0) * music_duck, 0.0, 8.0)
    window = int(ceil(8192.0 * pitch)) + 3
    id = play(Sound(fill(f32(0), window * 2)), 1.0, pan, pitch, true)
    score_voices.push(ScoreVoice(id, gain, duration(s) / pitch, context = score, source = s, applied = initial, ramp_from = initial))
    score_set_volume(id, initial)
    id

__score_piano_play = (s: PianoSample, gain: f64, pan: f64, pitch: f64, score: bool, hold: f64 = -1.0) -> int:
    initial = clamp(gain * (if score: seq.volume * (if seq.mood == .combat: 1.0 else: seq.sneak_gain) else: 1.0) * music_duck, 0.0, 8.0)
    window = int(ceil(8192.0 * pitch)) + 3
    id = play(Sound(fill(f32(0), window * 2)), 1.0, pan, pitch, true)
    # Hold/release follows the source clock, so fractional pitches retain the
    # old duration without copying and requantizing three full piano layers.
    left = if hold >= 0.0: f64(int((hold + 0.65) * pitch * f64(MIX_RATE))) / (f64(MIX_RATE) * pitch) else: piano_duration(s) / pitch
    score_voices.push(ScoreVoice(id, gain, left, context = score, packed = s, applied = initial, ramp_from = initial,
        damper_close = (if hold >= 0.0: hold * pitch else: -1.0), damper_end = (hold + 0.65) * pitch))
    score_set_volume(id, initial)
    id

# Retarget from the envelope's current sample, preserving the 20 ms attack even
# when interrupted. Unchanged targets only fill newly consumed ring frames.
# Absolute source positions keep pitch/interpolation continuous across ring wraps.
score_set_volume = (id: int, gain: f64):
    let gain = clamp(gain, 0.0, 8.0)
    si = -1
    loop i in [0..score_voices.len()):
        if score_voices[i].id == id: si = i
    if si < 0: return
    loop vi in [0..__voices.len()):
        if __voices[vi].id != id: continue
        v = score_voices[si]
        pos = __voices[vi].pos
        window = __voices[vi].sound.samples.len() / 2
        consumed = pos - v.mixer_pos
        if consumed < 0.0: consumed += f64(window)
        absolute = v.source_pos + consumed
        start = int(floor(absolute))
        changed = abs(gain - v.applied) >= 0.00000001
        if changed:
            v.ramp_from = mix(v.ramp_from, v.applied, clamp((f64(start) - v.ramp_at) / v.ramp_frames, 0.0, 1.0))
            v.applied = gain
            v.ramp_at = f64(start)
            v.ramp_frames = max(1.0, 0.020 * f64(MIX_RATE) * __voices[vi].pitch)
        # Samples carry the complete bounded envelope; the mixer stays at unity.
        # Never divide by a target gain: a near-zero fade must not amplify old
        # ring data when the next mood raises its gain. Retarget the ENTIRE live
        # window, including the final interpolation guard. Otherwise a constant
        # suffix (or the last guard sample) retains the previous envelope.
        __voices[vi].volume = 1.0
        end = start + window
        ramp_end = int(ceil(v.ramp_at + v.ramp_frames))
        source = data(v.source.samples)
        dest = data(__voices[vi].sound.samples)
        packed = v.packed.samples.len() > 0
        compact = data(v.packed.samples)
        total = (if packed: v.packed.samples.len() else: v.source.samples.len()) / 2
        if v.damper_close >= 0.0: total = min(total, int(v.damper_end * f64(MIX_RATE)))
        release_at = int(ceil(v.damper_close * f64(MIX_RATE)))
        first = if changed: start else: max(start, v.prepared_until)
        slope = (v.applied - v.ramp_from) / v.ramp_frames
        ring = (int(floor(pos)) + first - start) % window
        # Split at ring/source/ramp boundaries so the constant suffix is a
        # contiguous multiply loop, rather than branching for every stereo frame.
        frame = first
        loop frame < end:
            last = min(end, frame + window - ring)
            if frame < total: last = min(last, total)
            if frame < ramp_end: last = min(last, ramp_end)
            if v.damper_close >= 0.0 and frame < release_at: last = min(last, release_at)
            if frame >= total:
                loop sample in [ring * 2..(ring + last - frame) * 2): dest[sample] = 0.0
            else if v.damper_close >= 0.0 and frame >= release_at:
                loop k in [frame..last):
                    damper = f32(1.0 - smoothstep(v.damper_close, v.damper_end, f64(k) / f64(MIX_RATE)))
                    g = f32(v.ramp_from + clamp((f64(k) - v.ramp_at) / v.ramp_frames, 0.0, 1.0) * (v.applied - v.ramp_from))
                    dest[ring * 2] = f32(compact[k * 2]) * v.packed.scale * damper * g
                    dest[ring * 2 + 1] = f32(compact[k * 2 + 1]) * v.packed.scale * damper * g
                    ring += 1
                ring -= last - frame
            else if frame >= ramp_end:
                g = f32(v.applied)
                offset = (frame - ring) * 2
                if packed:
                    g *= v.packed.scale
                    loop sample in [ring * 2..(ring + last - frame) * 2): dest[sample] = f32(compact[sample + offset]) * g
                else:
                    loop sample in [ring * 2..(ring + last - frame) * 2): dest[sample] = source[sample + offset] * g
            else:
                loop k in [frame..last):
                    g = f32(v.ramp_from + (f64(k) - v.ramp_at) * slope)
                    dest[ring * 2] = (if packed: f32(compact[k * 2]) * v.packed.scale else: source[k * 2]) * g
                    dest[ring * 2 + 1] = (if packed: f32(compact[k * 2 + 1]) * v.packed.scale else: source[k * 2 + 1]) * g
                    ring += 1
                ring -= last - frame
            ring = (ring + last - frame) % window
            frame = last
        v.source_pos = absolute
        v.mixer_pos = pos
        v.prepared_until = end
        score_voices[si] = v
        return

piano_play = (midi: int, vel: f64 = 0.7, pan: f64 = 0.0, volume: f64 = 1.0, short: bool = false, score: bool = false, restrained: bool = false, hold: f64 = -1.0) -> int:
    if not piano.ready: return 0
    pp_k = piano_slot(midi, "pp")
    mf_k = piano_slot(midi, "mf")
    ff_k = piano_slot(midi, "ff")
    pp_pitch = pow(2.0, f64(midi - piano_recording_midi(pp_k, "pp")) / 12.0)
    mf_pitch = pow(2.0, f64(midi - piano_recording_midi(mf_k, "mf")) / 12.0)
    ff_pitch = pow(2.0, f64(midi - piano_recording_midi(ff_k, "ff")) / 12.0)
    g = piano_gain(vel, volume)
    b = piano_blend(vel)
    music_log_note(midi, vel, volume, pan)
    music_note_count += 1
    music_hold = max(music_hold, (if short: 0.35 else: 4.0))
    soft = if restrained: piano.restrained_soft else: (if short: piano.short_soft else: piano.soft)
    notes = if short: piano.short_notes else: piano.notes
    forte = if short: piano.short_forte else: piano.forte
    if score and (seq.mood == .snow or seq.mood == .field_rain):
        soft = piano.weather_soft
    id = 0
    if b.pp > 0.000001: id = __score_piano_play(soft[pp_k], g * b.pp, pan, pp_pitch, score, hold)
    if b.mf > 0.000001: id = __score_piano_play(notes[mf_k], g * b.mf, pan, mf_pitch, score, hold)
    if b.ff > 0.000001: id = __score_piano_play(forte[ff_k], g * b.ff, pan, ff_pitch, score, hold)
    id

# ---------------- the sequencer ----------------
enum Mood: silent, field_day, field_night, ruins, shrine, combat, snow, title, forest, field_golden, field_rain

struct Ev:
    t: f64
    midi: int
    vel: f64
    accompaniment = false
    gain = 1.0
    glass = false
    pan = 0.0
    phrase = 0
    hand = 0
    reverse = false

enum CombatTier: alert, engaged, low_hp

struct PhraseMemory:
    pitches: int[]
    at: f64

struct Seq:
    mood = Mood.silent
    want = Mood.silent
    events: Ev[]
    clock = 0.0
    low_events: Ev[]
    low_clock = 0.0
    low_rest = 19.0
    reverse_rest = 97.0
    high_opened = false
    low_opened = false
    low_rng = rng(61062)
    phrase_serial = 0
    sneak_gain = 1.0
    rest = 3.0                 # seconds until the next phrase
    volume = 0.0               # fades between moods
    combat_step = 0
    combat_t = 0.0
    combat_tier = CombatTier.alert
    combat_engaged = 0.0
    combat_drop_bar = -1
    combat_clean_bar = -100
    age = 0.0
    motif_at = -100.0
    handoff_at = -100.0
    strike_at = -100.0
    landmark_t = 0.0
    motif_pending = false
    figure_times: {int: f64} = {}
    phrase_memory: PhraseMemory[]
    harmony_rng = rng(61061)
    harmony_last: {int: int} = {}
    figure_key = -1
    harmony_colour = -1

seq = Seq()

# A shared register and material make night an augmentation of day, rather
# than another tune. No field third; the b7 and #4 leave the tonic ambiguous.
__tonic_for = (m: Mood) -> int:
    match m:
        field_golden: 79
        forest: 88
        snow: 88
        ruins: 85
        shrine: 72
        _: 86

__mode_for = (m: Mood) -> int[]:
    match m:
        field_night, field_rain, forest: [0, 2, 3, 5, 7, 8, 10]
        ruins: [0, 1, 3, 5, 7, 8, 10]
        shrine: [0, 2, 3, 5, 7, 9, 10]
        _: [0, 2, 4, 6, 7, 9, 10]

__degree_midi = (m: Mood, d: int) -> int:
    scale = __mode_for(m)
    octave = if d >= 0: d / 7 else: -((-d + 6) / 7)
    __tonic_for(m) + 12 * octave + scale[d - octave * 7]

__root_for = (m: Mood) -> int: 24 + __tonic_for(m) % 12

# Twelve authored gestures. The first is always the opening: a tentative
# repeated second, a bare fifth down to the fifth. Delayed last notes are
# answers, not the last rung of an arpeggio. All endings avoid a tonic cadence.
__field_figures = [
    [(0.0, 1, 1.0), (0.16, 1, 0.62), (1.65, -3, 0.82)],
    [(0.0, 4, 0.82), (0.24, 3, 0.7), (1.8, 4, 0.65)],
    [(0.0, 7, 0.7), (1.38, 4, 0.85), (1.62, 1, 0.65)],
    [(0.0, 6, 0.8), (0.11, 7, 0.68), (1.95, 4, 0.7)],
    [(0.0, 3, 0.75), (1.7, 4, 0.85)],
    [(0.0, 1, 0.65), (0.09, 0, 0.85), (1.55, 4, 0.7)],
    [(0.0, 4, 0.85), (0.19, 4, 0.6), (0.46, 6, 0.73), (2.1, 8, 0.65)],
    [(0.0, 8, 0.7), (1.85, 4, 0.72)],
    [(0.0, -1, 0.75), (0.68, 0, 0.78), (1.72, 1, 0.67)],
    [(0.0, 6, 0.78), (0.08, 8, 0.68), (0.21, 11, 0.73), (1.95, 4, 0.6)],
    [(0.0, 0, 0.78), (0.21, 1, 0.7), (1.28, 4, 0.86), (1.66, 3, 0.68), (2.3, 4, 0.58)],
    [(0.0, 7, 0.68), (0.34, 6, 0.73), (1.9, 8, 0.6)],
]
# Snow: brittle repeated frost and a widely separated b7. Ruins: a b2
# rubbing against the root, then withdrawing to the fifth. Spot BGM, no loop.
__snow_figures = [
    [(0.0, 11, 0.65), (0.13, 11, 0.43), (0.37, 11, 0.5), (2.05, 6, 0.6)],
    [(0.0, 8, 0.65), (1.86, 7, 0.56), (2.25, 11, 0.62)],
]
__ruins_figures = [
    [(0.0, 1, 0.65), (0.17, 0, 0.72), (2.2, -3, 0.58)],
    [(0.0, 6, 0.65), (1.38, 3, 0.7), (2.36, 4, 0.58)],
]

# Own leitmotif: step, fourth, semitone sigh. Its field quotation is a
# fragment/augmentation with a fifth as an afterthought, never a cadence.
__motif_forms = [__field_figures[10],
    [(0.0, 1, 0.72), (1.4, 4, 0.85), (2.2, 3, 0.6), (3.3, 4, 0.55)]]

__stretch_for = (m: Mood) -> f64:
    match m:
        field_night: 1.45
        field_rain, snow, ruins: 1.25
        field_golden, forest: 1.12
        shrine: 1.55
        _: 1.0

phrase_n = 0
music_still = 0.0
p_phrase = (m: Mood) -> Ev[]:
    if m == .shrine: return shrine_phrase()
    phrase_n += 1
    figures = __field_figures
    if m == .snow: figures += __snow_figures
    if m == .ruins: figures += __ruins_figures
    opening = not seq.high_opened
    phrase_used_motif = not opening and seq.motif_pending and seq.age - seq.motif_at >= LANDMARK_MOTIF_GAP
    figure: (f64, int, f64)[]
    seq.figure_key = -1
    seq.harmony_colour = -1
    if opening:
        seq.high_opened = true
        figure = figures[0]
        seq.figure_key = int(m) * 32
    else if phrase_used_motif:
        seq.motif_pending = false
        seq.motif_at = seq.age
        music_motif_count += 1
        figure = __motif_forms[(music_motif_count - 1) % __motif_forms.len()]
    else:
        # The high clock can pass in silence. Timer slots remain 3..13 s,
        # while the skipped turns leave longer spaces for the world to speak.
        if random() < (if m == .field_night: 0.56 else: 0.44): return []
        available: int[]
        loop i in [0..figures.len()):
            key = int(m) * 32 + i
            if seq.age - seq.figure_times.get(key, -1000.0) >= FIELD_MOTIF_GAP: available.push(i)
        if available.len() == 0: return []
        pick = available[random_int(0, available.len())]
        figure = figures[pick]
        seq.figure_key = int(m) * 32 + pick
    dyn = 0.34 * (if m == .field_night: 0.80 else: 1.0)
    gain = pow(10.0, random(-3.0, 3.0) / 20.0)
    pan = random(-0.3, 0.3)
    stretch = __stretch_for(m) * random(0.91, 1.13)
    evs: Ev[]
    rubato = 0.0
    previous = 0.0
    loop n in figure:
        if n.0 > 0.0: rubato += (n.0 - previous) * random(0.92, 1.12)
        evs.push(Ev(rubato * stretch, __degree_midi(m, n.1), dyn * n.2, gain = gain, pan = pan))
        previous = n.0
    pitches = [loop e in evs: e.midi]
    loop old in seq.phrase_memory:
        if old.pitches == pitches and seq.age - old.at < FIELD_MOTIF_GAP: return []
    seq.phrase_memory.push(PhraseMemory(pitches, seq.age))
    seq.figure_times[seq.figure_key] = seq.age
    seq.phrase_serial += 1
    loop mut e in evs: e.phrase = seq.phrase_serial
    evs

phrase_rest = (m: Mood) -> f64:
    if m == .shrine: return random(13.0, 22.0)
    random(8.0, 13.0)

# The bass owns its RNG, countdown and queue. It never follows a high strike.
# Most timer turns are empty; the lowest root appears only in the b7 answer.
low_phrase = (m: Mood) -> Ev[]:
    opening = not seq.low_opened
    seq.low_opened = true
    if not opening and seq.low_rng.next_float() < 0.78: return []
    colour = if opening: 0 else: int(seq.low_rng.next_float() * 4.0)
    key = int(m) * 32 + 20 + colour
    if seq.age - seq.figure_times.get(key, -1000.0) < FIELD_MOTIF_GAP: return []
    seq.figure_times[key] = seq.age
    seq.phrase_serial += 1
    root = __root_for(m)
    pitches = [[root + 7, root + 2], [root + 10, root + 7], [root + 5, root + 7], [root, root + 7]][colour]
    gain = 0.25 * pow(10.0, (seq.low_rng.next_float() * 6.0 - 3.0) / 20.0)
    pan = seq.low_rng.next_float() * 0.6 - 0.3
    gap = (1.55 + seq.low_rng.next_float() * 0.75) * __stretch_for(m)
    [Ev(0.0, pitches[0], 0.25, accompaniment = true, gain = gain, pan = pan, phrase = seq.phrase_serial, hand = 1),
     Ev(gap, pitches[1], 0.21, accompaniment = true, gain = gain, pan = pan, phrase = seq.phrase_serial, hand = 1)]

# Five compatible modal layers: two piano voices, high glass, low glass,
# and a distant glass answer. Each chooses one of three variations in a
# floating six-pulse cycle; optional layers enter without a functional cadence.
shrine_phrase = () -> Ev[]:
    phrase_n += 1
    seq.phrase_serial += 1
    v = random_int(0, 3)
    evs: Ev[]
    lead = [[79, 77, 74], [74, 72, 79], [82, 79, 74]][v]
    loop i in [0..3): evs.push(Ev(f64(i) * 1.55, lead[i], 0.25, gain = 0.65, phrase = seq.phrase_serial))
    # Compatibility: b7 lead avoids the second glass layer's ninth.
    loop layer in [1..5):
        if random() < 0.40 or (v == 2 and layer == 2): continue
        variant = random_int(0, 3)
        pitch = [[48, 55, 53], [84, 86, 91], [60, 65, 67], [91, 89, 86]][layer - 1][variant]
        evs.push(Ev(0.55 + f64(layer) * 0.67, pitch, 0.2, accompaniment = true, gain = (if layer == 1: 0.16 else: 0.24), glass = layer > 1, pan = random(-0.3, 0.3), phrase = seq.phrase_serial, hand = layer))
    evs

music_mood = (m: Mood): seq.want = m

# Location checks use squared distances once a second, in the original map coordinates.
# A visit asks for the next figure, with at least 18 s of breathing room after a strike.
struct MusicLandmark:
    x: f64
    z: f64
    radius: f64
    last = -180.0
    inside = false      # (stated once per visit: re-armed only after leaving)
music_landmarks = [MusicLandmark(-818.0, 1950.0, 85.0), MusicLandmark(-560.0, 1722.0, 75.0),
    MusicLandmark(-946.0, 1883.0, 45.0), MusicLandmark(-1068.0, 1845.0, 45.0),
    MusicLandmark(-495.0, 1990.0, 85.0)]

music_landmark_update = (dt: f64):
    seq.landmark_t -= dt
    if seq.landmark_t > 0.0: return
    seq.landmark_t = 1.0
    if seq.want == .silent or seq.want == .title or seq.want == .combat or seq.want == .shrine: return
    loop mut p in music_landmarks:
        dx = f64(pl.pos.x) - p.x
        dz = f64(pl.pos.z) - p.z
        d2 = dx * dx + dz * dz
        if d2 > p.radius * p.radius * 1.69: p.inside = false
        else if d2 < p.radius * p.radius and not p.inside:
            p.inside = true
            if seq.age - p.last >= 180.0:
                p.last = seq.age
                seq.motif_pending = true
    if seq.motif_pending and seq.events.len() == 0 and seq.age - seq.strike_at >= 18.0:
        seq.rest = min(seq.rest, 8.0)

music_update = (dt: f64):
    if not piano.ready: return
    seq.age += dt
    music_hold = max(0.0, music_hold - dt)
    music_activity = approach(music_activity, (if music_hold > 0.0: 1.0 else: 0.0), (if music_hold > 0.0: 5.0 else: 0.7), dt)
    music_landmark_update(dt)
    music_duck_hold = max(0.0, music_duck_hold - dt)
    if music_duck_hold <= 0.0:
        music_duck_floor = 1.0
        music_duck = min(1.0, music_duck + dt / 0.24)
    seq.sneak_gain = approach(seq.sneak_gain, (if pl.sneaking: 0.32 else: 1.0), 2.0, dt)
    fading = seq.want != seq.mood
    if fading:
        fade_seconds = if seq.want == .combat or seq.want == .silent: 0.3 else: 0.9
        seq.volume = max(0.0, seq.volume - dt / fade_seconds)
    else: seq.volume = min(1.0, seq.volume + dt / (if seq.mood == .combat: 0.25 else: 1.2))
    i = 0
    loop i < score_voices.len():
        score_voices[i].left -= dt
        v = score_voices[i]
        if v.left <= 0.0:
            stop(v.id)
            score_voices.remove(i)
        else:
            score_set_volume(v.id, (if v.retiring: 0.0 else: v.gain * (if v.context: seq.volume * (if seq.mood == .combat: 1.0 else: seq.sneak_gain) else: 1.0) * music_duck))
            i += 1
    if fading:
        if seq.volume > 0.0: return   # no outgoing strikes during the hand-off
        old = seq.mood
        # Finish the 20 ms sample ramp before removing outgoing handles.
        # They must never inherit the incoming combat gain of 0.55.
        loop mut v in score_voices:
            if v.context:
                v.retiring = true
                v.left = min(v.left, 0.05)
        seq.mood = seq.want
        seq.events.clear()
        seq.low_events.clear()
        seq.low_clock = 0.0
        seq.low_rest = 19.0
        # Adjacent field colours continue one environmental stream. Combat,
        # chambers and story scenes begin a fresh fixed opening on return.
        continuing = old != .combat and old != .silent and old != .title and old != .shrine
        seq.high_opened = seq.high_opened and continuing
        seq.low_opened = seq.low_opened and continuing
        seq.reverse_rest = 97.0
        seq.clock = 0.0
        seq.combat_t = 0.0
        seq.combat_step = 0
        seq.combat_tier = .alert
        seq.combat_engaged = 0.0
        seq.combat_drop_bar = -1
        seq.combat_clean_bar = -100
        if seq.mood == .combat:
            seq.volume = 0.55
            seq.combat_t = 60.0 / COMBAT_BPM / 2.0
            __score_play(combat_entry, COMBAT_ENTRY_LEVEL * COMBAT_GAIN * music_vol, 0.0, 1.0, true)
        else if old == .combat:
            # Escape gets seven seconds. A victory's low piano tail can last
            # longer: leave a real 1.5 s breath after the final cue sample.
            tail = 0.0
            loop v in score_voices:
                if not v.context: tail = max(tail,v.left)
            seq.rest = max(7.0,tail+1.5)
        else: seq.rest = max(seq.rest, 2.0)
    if seq.mood == .silent or seq.mood == .title: return
    if seq.mood == .combat:
        __combat_music(dt)
        return
    seq.clock += dt
    seq.low_clock += dt
    dispatch = (events: Ev[], clock: f64) -> Ev[]:
        remaining: Ev[]
        loop e in events:
            if e.t > clock:
                remaining.push(e)
                continue
            music_log_hand = e.hand
            music_log_phrase = e.phrase
            music_log_kind = if e.glass: "glass" else: "piano"
            if e.glass:
                music_log_note(e.midi, e.vel, e.gain, e.pan)
                __score_play(shrine_glass, e.gain * music_vol, e.pan, pow(2.0, f64(e.midi - 72) / 12.0), true)
            else: piano_play(e.midi, e.vel, e.pan, field_gain(seq.mood) * e.gain, false, true)
            music_log_hand = -1
            music_log_phrase = 0
            music_log_kind = "piano"
            seq.strike_at = seq.age
        remaining
    seq.events = dispatch(seq.events, seq.clock)
    seq.low_events = dispatch(seq.low_events, seq.low_clock)
    if seq.events.len() == 0:
        seq.rest -= dt
        if seq.rest <= 0.0:
            seq.clock = 0.0
            seq.events = p_phrase(seq.mood)
            seq.rest = phrase_rest(seq.mood)
    if seq.mood != .shrine:
        if seq.low_events.len() == 0:
            seq.low_rest -= dt
            if seq.low_rest <= 0.0:
                seq.low_clock = 0.0
                seq.low_events = low_phrase(seq.mood)
                seq.low_rest = 8.0 + seq.low_rng.next_float() * 5.0
        seq.reverse_rest -= dt
        if seq.reverse_rest <= 0.0:
            midi = __degree_midi(seq.mood, 4)
            music_log_kind = "reverse"
            music_log_hand = 2
            music_log_note(midi, 0.2, 0.32, 0.2)
            __score_play(reverse_piano, 0.32 * music_vol, 0.2, pow(2.0, f64(midi - 84) / 12.0), true)
            music_log_kind = "piano"
            music_log_hand = -1
            seq.reverse_rest = 110.0 + seq.low_rng.next_float() * 100.0

# Original combat cell: A A / C ... G#, with a repeated-note pickup,
# minor-third leap and leading-note snap back to A on the next statement.
# Three full statements, an E-register answer, a climbing development and two
# partial statements share the same rhythm instead of unrelated arpeggio stabs.
__combat_melody = [[69,69,72,68],[76,76,79,75],[69,69,72,68],[72,75],
    [69,69,72,68],[71,71,74,70],[69,69,75,80],[72,68]]
__combat_basses = [45,40,45,41,45,43,44,45]
# a frame drum under the fight: a deep skin (a pitch falling as the head settles) and a dry
# slap of the hand, built once
__drum = (f0: f64, f1: f64, dur: f64, slap: f64) -> Sound:
    n = int(dur * f64(MIX_RATE))
    out: f32[]
    ph = 0.0
    loop i in [0..n):
        t = f64(i) / f64(MIX_RATE)
        f = f1 + (f0 - f1) * exp(-t / 0.04)
        ph += TAU * f / f64(MIX_RATE)
        v = sin(ph) * exp(-t / (dur * 0.35)) + sin(ph * 1.59) * 0.3 * exp(-t / (dur * 0.15))
        v += (random() * 2.0 - 1.0) * slap * exp(-t / 0.012)
        # A short skin attack and terminal release avoid broadband clicks at
        # the combat handoff and at the ends of the finite drum samples.
        edge = smooth01(t / 0.004) * smooth01(f64(n - 1 - i) / f64(MIX_RATE) / 0.025)
        smp = f32(v * 0.5 * edge)
        out.push(smp)
        out.push(smp)
    Sound(out)

# what sounds on one eighth of the fight (shared with tools/music_render.jo)
# drum: 0 a piano note, 1 the low skin, 2 the slap
struct CombatHit:
    midi: int
    vel: f64
    drum: int
    restrained = false

# 152 bpm remains underneath: sparse off-beat stabs, with whole beats left empty.
# The first engaged round has 44 strikes; later rounds thin the texture. Alert leaves more air;
# low health leaves left-hand rests and a softly damped bass under muted upper stabs.
__combat_dyn = [0.7, 0.8, 0.92, 0.55, 0.75, 0.88, 1.0, 0.6]
__combat_stabs = [[0,1,4,10],[0,1,4,10],[0,1,4,10],[4,10],
    [0,1,4,10],[2,3,6,12],[0,1,4,10],[4,10]]
combat_step_hits = (step: int, tier: CombatTier = .engaged) -> CombatHit[]:
    out: CombatHit[]
    k = step % 16
    bar = step / 16
    bi = bar % __combat_melody.len()
    round = (bar / 8) % 4
    # The first round states the cell. Each later eight-bar round changes the
    # answers' register and leaves different rests; the A pickup remains intact.
    if round == 3 and bi == 3: return out
    thin = round > 0 and (bi == 3 or bi == 7)
    dyn = __combat_dyn[bi] * (if tier == .alert: 0.68 else: 1.0)
    acc = (if k == __combat_stabs[bi][0]: 0.78 else: 0.62) * dyn
    stabs = __combat_stabs[bi]
    stab = if tier == .alert: k == stabs[0] or (stabs.len() > 2 and k == stabs[2]) else: stabs.contains(k)
    if stab and not (thin and k == 10):
        note = 0
        loop j in [0..stabs.len()):
            if stabs[j] == k: note = j
        m = __combat_melody[bi][note]
        # Last-heart answers transpose the whole cell, preserving its contour.
        higher = tier == .low_hp and bi % 2 == 1
        if bi == 1 or bi == 5 or bi == 6:
            m += (if round == 1: (if tier == .low_hp: -12 else: 12) else: (if round == 2: -12 else: 0))
        out.push(CombatHit(m + (if higher: 12 else: 0), acc * (if tier == .low_hp: 0.90 else: 1.0), 0))
    bass_step = if round == 0: 0 else: [2,3,1][round - 1]
    bass_answer = if round == 0: 9 else: [11,8,13][round - 1]
    bass_note = min(51,__combat_basses[bi] + (if round == 1: 5 else: (if round == 2: 3 else: (if round == 3: 7 else: 0))))
    if not thin and (k == bass_step or (tier == .engaged and k == bass_answer)): out.push(CombatHit(bass_note, (if tier == .low_hp: 0.28 else: 0.7) * (0.6 + 0.4 * dyn), 0, restrained = tier == .low_hp))
    if not thin and (k == (if round == 0: 0 else: 2 + round) or (tier != .alert and k == (if round == 0: 7 else: 8 + round))): out.push(CombatHit(0, 0.16 * (0.7 + 0.3 * dyn), 1))
    if tier != .alert and not thin and (k == 12 and bi % 2 == 0): out.push(CombatHit(0, 0.09 * (0.7 + 0.3 * dyn), 2))
    out

combat_drums = ():
    if drum_lo.samples.len() == 0:
        drum_lo = __drum(120.0, 62.0, 0.5, 0.25)
        drum_hi = __drum(260.0, 180.0, 0.18, 0.6)
        # A skin/low-body accent on the hand-off, rather than another piano chord.
        combat_entry = mix([__drum(190.0, 58.0, 0.55, 0.48), tone(61.7, 0.45, .sine, 0.16, 0.002, 0.30)])

# Distance/strikes sustain engagement for four seconds, so circling or a recovery
# does not flutter the score. Low HP has one quarter-heart of release hysteresis.
combat_close_threat = () -> bool:
    loop e in enemies:
        if e.hp <= 0.0: continue
        hunting = e.state == .chase or e.state == .windup or e.state == .attack or e.state == .recover or e.state == .shoot or e.state == .laser
        range = if e.state == .shoot or e.state == .laser: 35.0 else: 12.0
        if hunting and f64(length(e.pos - pl.pos)) < range: return true
    false

combat_tier_want = (dt: f64) -> CombatTier:
    engaged = fight.act == .swing or fight.act == .spin or fight.act == .jump_attack or fight.act == .flurry or pl.state == .hurt or combat_close_threat()
    seq.combat_engaged = if engaged: 4.0 else: max(0.0, seq.combat_engaged - dt)
    threshold = max(4, pl.hp_max / 4)
    if pl.hp <= threshold or (seq.combat_tier == .low_hp and pl.hp <= threshold + 1): return .low_hp
    if seq.combat_engaged > 0.0: return .engaged
    .alert

# A clean player blow buys one bar of space, at most once every eight bars.
# Called by the production impact dispatcher, never by enemy wind-ups/player hurt.
music_clean_hit = ():
    if seq.mood != .combat or pl.events.contains("hurt"): return
    bar = seq.combat_step / 16
    if bar - seq.combat_clean_bar < 8: return
    seq.combat_clean_bar = bar
    seq.combat_drop_bar = bar + 1

__combat_music = (dt: f64):
    want = combat_tier_want(dt)
    seq.combat_t += dt
    step = 60.0 / COMBAT_BPM / 2.0
    loop seq.combat_t >= step:
        seq.combat_t -= step
        # Change colour on the next beat; preserve the phrase and all sounding tails.
        if seq.combat_step % 2 == 0: seq.combat_tier = want
        hits = if seq.combat_step / 16 == seq.combat_drop_bar: [] else: combat_step_hits(seq.combat_step, seq.combat_tier)
        loop h in hits:
            match h.drum:
                1: __score_play(drum_lo, h.vel * music_vol * combat_gain(seq.combat_tier), -0.1, 1.0, true)
                2: __score_play(drum_hi, h.vel * music_vol * combat_gain(seq.combat_tier), 0.1, 1.0, true)
                _: piano_play(h.midi, h.vel, (if h.midi < 52: -0.2 else: 0.15), (if h.midi < 52: 0.55 else: 0.5) * combat_gain(seq.combat_tier), true, true, h.restrained)
        seq.combat_step += 1

# the fight is over: a falling run that lands on a bright open chord
victory_stinger = ():
    # Another 4 dB below the previous 0.5 gain: a quiet release beside field piano.
    loop i in 0.. and m in [81, 79, 76, 74, 72, 69]: __later(f64(i) * 0.08, m, 0.5, 0.315479)
    __later(0.55, 45, 0.55, 0.315479)
    __later(0.56, 64, 0.45, 0.315479)
    __later(0.57, 69, 0.45, 0.315479)
    __later(0.58, 73, 0.5, 0.315479)

# ---------------- set pieces ----------------
# Motif family in 3/4: two bars become a four-bar question, an eight-bar
# sentence, then a sixteen-bar call/answer. The title compresses that growth
# into the 20-second reveal. Minor F becomes a borrowed F# only at the wide
# view. Eb/Bb is the bII shadow. A real damper-bounded breath precedes the
# octave-widened answer; the last D/A/E voicing contains no third.
__story_motif = (at: f64, stretch: f64, octave: int, vel: f64, hold: f64 = 1.1):
    loop n in [(0.0, 74), (0.28, 76), (1.12, 81), (1.82, 80)]:
        __later(at + n.0 * stretch, n.1 + octave, vel * (if n.1 == 81: 1.08 else: 0.9), 0.8 * TITLE_GAIN, hold)

# Scores/tools can audition the family independently; no stock Zelda melody.
story_theme = (bars: int):
    # 3/4, quarter = 0.35 s, bar = 1.05 s. Pedal releases may extend
    # beyond a barline. The 16-bar version gives bar nine to the breath.
    __story_motif(0.0, 1.0, 0, 0.32)
    if bars >= 4:
        loop n in [(2.1, 76), (2.8, 77), (3.5, 81)]: __later(n.0, n.1, 0.29, hold = 0.8)
    if bars >= 8:
        __story_motif(4.2, 1.0, 0, 0.34, 0.65)
        __later(4.2, 39, 0.21, hold = 1.5)
        __later(4.27, 46, 0.17, hold = 1.43)
        __later(6.65, 76, 0.28, hold = 0.35)
        __later(7.0, 78, 0.31, hold = 0.35)
        __later(7.45, 81, 0.28, hold = 0.3)
    if bars >= 16:
        __story_motif(9.45, 2.0, 12, 0.37, 1.0)
        loop n in [(13.65, 76), (14.35, 78), (15.4, 88)]: __later(n.0, n.1, 0.29, hold = 1.0)
        __later(16.1, 50, 0.26, hold = 2.45)
        __later(16.17, 57, 0.22, hold = 2.38)
        __later(16.45, 88, 0.23, hold = 2.1)

# Title-only performance helpers. Beat durations and melody are documented in
# docs/TITLE_THEME.md; do not reuse the unmetered field/story fragment scheduler.
const TITLE_THEME_LEVEL = 0.75  # -2.5 dB: reveal above field, with wind still present
__title_line = (at: f64, beat: f64, notes: (f64, int, f64, f64)[], octaves: bool = false):
    loop n in notes:
        # The 650ms damper tail supplies 150ms of legato beyond the written value.
        hold = max(0.12, n.2 * beat - 0.50)
        __later(at + n.0 * beat, n.1, n.3, 1.50 * TITLE_THEME_LEVEL, hold)
        if octaves: __later(at + n.0 * beat + 0.025, n.1 - 12, n.3 * 0.78, 0.90 * TITLE_THEME_LEVEL, hold)

# One gently spread open voicing per harmony, with a bass octave only at reveal.
# The left hand leads by 55ms; octave strikes are 25ms apart. This human roll
# avoids preparing two piano notes in the same 60Hz frame. Pedal
# clears before each new harmony rather than smearing consecutive voicings.
__title_chord = (at: f64, bass: int, fifth: int, colour: int, vel: f64, hold: f64, octave: bool = false):
    __later(at - 0.055, bass, vel, 1.10 * TITLE_THEME_LEVEL, hold)
    if octave: __later(at - 0.030, bass + 12, vel * 0.80, 0.90 * TITLE_THEME_LEVEL, hold)
    __later(at + 0.065, fifth, vel * 0.86, 0.90 * TITLE_THEME_LEVEL, max(0.12, hold - 0.065))
    __later(at + 0.14, colour, vel * 0.78, 0.82 * TITLE_THEME_LEVEL, max(0.12, hold - 0.14))

title_theme_a = ():
    # D minor, 3/4, quarter=80. Four-bar question / expanded four-bar answer.
    q = 0.75
    __title_line(0.25, q, [(0.0,69,0.5,0.38), (0.5,74,1.5,0.43), (2.0,76,0.5,0.40), (2.5,72,0.5,0.36),
        (3.0,69,1.0,0.37), (4.0,67,0.5,0.35), (4.5,65,0.5,0.34), (5.0,64,1.0,0.32),
        (6.0,69,0.5,0.42), (6.5,74,1.5,0.47), (8.0,77,0.5,0.46), (8.5,76,0.5,0.41),
        (9.0,75,1.0,0.38), (10.0,70,1.0,0.31)])
    __title_chord(0.25,50,57,65,0.29,1.05)
    __title_chord(2.50,46,53,62,0.27,1.05)
    __title_chord(4.75,43,50,58,0.32,1.05)
    __title_chord(7.00,51,58,67,0.26,1.00)
    # The opening fourth becomes a fifth, one register higher, at the lettering.
    __title_line(9.25, q, [(0.0,74,0.5,0.48), (0.5,81,1.5,0.56), (2.0,79,0.5,0.49), (2.5,76,0.5,0.45)], true)
    __title_chord(9.25,38,57,64,0.43,1.05,true)
    __title_line(11.50, q, [(0.0,78,1.0,0.43), (1.0,76,0.5,0.39), (1.5,74,0.5,0.37), (2.0,69,1.0,0.34),
        (3.0,70,1.0,0.36), (4.0,72,1.0,0.35), (5.0,74,1.0,0.33), (6.0,76,3.0,0.28)])
    __title_chord(11.50,42,57,62,0.30,1.05)
    loop n in [(13.75,46,53), (14.50,48,55), (15.25,50,57)]:

# ---------------- loading ----------------
t0 = time()
# (BOTW_LOADTIME=1: how long each part of the load takes)
__lt = time()
hitstop = 0.0

__lap = (name: str):
    if env("BOTW_LOADTIME") != none: eprint("  {name} {time() - __lt:.2}s")
    __lt = time()
worldgen_load()
__lap("worldgen_load")
structures_pads()
__lap("structures_pads")
sor_pads()
__lap("sor_pads")
worldgen_finish()
__lap("worldgen_finish")
terrain_asset_load()
__lap("terrain_read")
window("The Legend of Jo: Slop of the Wild", 1280, 720)
terrain_stream_begin()
__lap("terrain_upload")
water_build()
__lap("water_build")
grass_init()
__lap("grass_init")
farland_build()
__lap("farland_build")
if not architecture_load():
    farland_castle_prepare()
    sor_interior()
    __lap("sor_interior")
    structures_build()
__lap("structures_build")

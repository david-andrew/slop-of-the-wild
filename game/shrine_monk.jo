use 'charshade.jo'
use 'gfx.jo'
use 'items.jo'
use 'skel.jo'

__ascetic = Model()
__ascetic_skin = Skin()

# Smooth row interpolation is shared by skin and linen, evaluated only when
# the cached monk mesh is built. No per-frame procedural geometry.
monk_curve = (rows: vec4[], t: f64) -> vec4:
    i=min(int(floor(t)),rows.len()-2)
    u=f32(t-f64(i))
    a=rows[max(0,i-1)]
    b=rows[i]
    c=rows[i+1]
    d=rows[min(rows.len()-1,i+2)]
    (b*2.0+(c-a)*u+(a*2.0-b*5.0+c*4.0-d)*u*u+(-a+b*3.0-c*3.0+d)*u*u*u)*0.5

monk_smooth = (b: mut MeshB, start: int):
    sums: {str: vec3} = {}
    key = (p: vec3) -> str: "{int(round(f64(p.x)*100000))},{int(round(f64(p.y)*100000))},{int(round(f64(p.z)*100000))}"
    loop i in [start..b.vs.len()):
        v=b.vs[i]
        k=key(v.pos)
        sums[k]=(sums.get(k) ?? vec3(0,0,0))+v.normal
    loop i in [start..b.vs.len()):
        n=sums[key(b.vs[i].pos)]
        if length(n)>0.000001: b.vs[i].normal=normalize(n)

# A swept arm includes the shoulder, elbow and wrist in one skin surface.
monk_arm = (b: mut MeshB, side: f64, skin_: vec4):
    rows=[vec4(f32(side*0.15),0.837,-0.018,0.045),vec4(f32(side*0.215),0.803,-0.010,0.066),vec4(f32(side*0.248),0.69,0.044,0.047),vec4(f32(side*0.285),0.51,0.120,0.032),vec4(f32(side*0.267),0.459,0.153,0.034),vec4(f32(side*0.16),0.394,0.236,0.028),vec4(f32(side*0.065),0.366,0.280,0.021)]
    start=b.vs.len()
    steps=(rows.len()-1)*4
    point = (j: int, k: int) -> vec3:
        t=f64(j)/4.0
        row=monk_curve(rows,t)
        tangent=normalize(monk_curve(rows,min(f64(rows.len()-1),t+0.03)).xyz-monk_curve(rows,max(0.0,t-0.03)).xyz)
        right=normalize(cross(tangent,vec3(0,0,1)))
        up=normalize(cross(right,tangent))
        a=TAU*f64(k%16)/16.0
        row.xyz+(right*f32(cos(a))+up*f32(sin(a)*0.88))*row.w
    loop j in [0..steps):
        loop k in [0..16):
            ps=[point(j,k),point(j,k+1),point(j+1,k+1),point(j+1,k)]
            n=normalize(cross(ps[3]-ps[0],ps[1]-ps[0]))
            base=u32(b.vs.len())
            loop p in ps: b.vs.push(Vertex3D(p,n,vec2(0,0),skin_))
            loop index in [base,base+3,base+2,base,base+2,base+1]: b.idx.push(index)
    monk_smooth(b,start)

monk_row = (x: f64, y: f64, z: f64, radius: f64) -> vec4:
    vec4(f32(x),f32(y),f32(z),f32(radius))

# Curled fingers have continuous knuckles and rounded tips, not intersecting
# capped cylinders. These are built once with the palms in the seated mudra.
monk_digit = (b: mut MeshB, rows: vec4[], skin_: vec4):
    start=b.vs.len()
    point = (j: int, k: int) -> vec3:
        t=f64(j)/3.0
        r=monk_curve(rows,t)
        d=normalize(monk_curve(rows,min(f64(rows.len()-1),t+0.03)).xyz-monk_curve(rows,max(0.0,t-0.03)).xyz)
        right=normalize(cross(d,vec3(1,0,0)))
        up=normalize(cross(right,d))
        a=TAU*f64(k%10)/10.0
        r.xyz+(right*f32(cos(a))+up*f32(sin(a)))*r.w
    loop j in [0..(rows.len()-1)*3):
        loop k in [0..10):
            ps=[point(j,k),point(j,k+1),point(j+1,k+1),point(j+1,k)]
            n=normalize(cross(ps[3]-ps[0],ps[1]-ps[0]))
            base=u32(b.vs.len())
            loop p in ps: b.vs.push(Vertex3D(p,n,vec2(0,0),skin_))
            loop v in [base,base+3,base+2,base,base+2,base+1]: b.idx.push(v)
    monk_smooth(b,start)

# The bowed rib cage rises into the neck through the same surface. Low relief
# ribs belong to the chest instead of cylinders laid over a separate torso.
monk_torso = (b: mut MeshB, skin_: vec4):
    rows=[vec4(0.38,0.11,0.085,-0.05),vec4(0.53,0.145,0.092,-0.055),vec4(0.71,0.154,0.095,-0.063),vec4(0.82,0.173,0.080,-0.035),vec4(0.862,0.137,0.068,-0.019),vec4(0.90,0.056,0.044,0.003),vec4(0.98,0.043,0.046,0.036),vec4(1.025,0.043,0.046,0.055)]
    start=b.vs.len()
    point = (j: int, k: int) -> vec3:
        r=monk_curve(rows,f64(j)/3.0)
        a=TAU*f64(k%32)/32.0
        ribs=sin((f64(r.x)-0.56)*TAU/0.047)*0.003
        ribs*=smoothstep(0.53,0.59,f64(r.x))*(1.0-smoothstep(0.77,0.82,f64(r.x)))*max(0.0,sin(a))
        v3(cos(a)*f64(r.y),f64(r.x),f64(r.w)+sin(a)*(f64(r.z)+ribs))
    loop j in [0..(rows.len()-1)*3):
        loop k in [0..32):
            ps=[point(j,k),point(j,k+1),point(j+1,k+1),point(j+1,k)]
            n=normalize(cross(ps[3]-ps[0],ps[1]-ps[0]))
            base=u32(b.vs.len())
            loop p in ps: b.vs.push(Vertex3D(p,n,vec2(0,0),skin_))
            loop index in [base,base+3,base+2,base,base+2,base+1]: b.idx.push(index)
    monk_smooth(b,start)

# The lap and knee folds belong to one robe surface, with no raised applique
# edge or shadow seam. Shoulder drapes sample this same supporting cloth.
monk_robe_row = (t: f64) -> vec4:
    monk_curve([vec4(0,0.055,0.03,0.60),vec4(0,0.085,0.025,0.65),vec4(0,0.14,0.02,0.65),vec4(0,0.28,0,0.52),vec4(0,0.43,-0.015,0.27),vec4(0,0.54,-0.025,0.15)],t)

monk_robe_point = (t: f64, a: f64) -> vec3:
    rr=monk_robe_row(t)
    h=f64(rr.y)
    front=pow(max(0.0,sin(a)),2.0)
    # Unequal long folds spread from the lap, then hang over the knees. Keep
    # the lower outline continuous instead of stacking two rounded hems.
    fold=cos(a*7.0+h*3.0)*(0.016+(0.54-h)*0.035)
    lap=sin(a*9.0+h*13.0)*0.020+sin(a*4.0-h*8.0)*0.012
    fold+=lap*front*(1.0-smoothstep(0.33,0.48,h))
    knee=pow(abs(cos(a)),5.0)*(1.0-smoothstep(0.14,0.43,h))
    hem=(1.0-smoothstep(0.10,0.21,h))*front*(0.008*sin(a*7.0)+0.005*sin(a*11.0))
    v3(cos(a)*(f64(rr.w)+fold+knee*0.022),h+hem,f64(rr.z)+sin(a)*(f64(rr.w)*0.64+fold))

monk_robe_front = (x: f64, y: f64) -> f64:
    low=0.0
    high=5.0
    loop i in [0..14):
        mid=(low+high)*0.5
        if monk_robe_row(mid).y<y: low=mid
        else: high=mid
    t=(low+high)*0.5
    low=0.0
    high=PI
    loop i in [0..14):
        mid=(low+high)*0.5
        if monk_robe_point(t,mid).x>x: low=mid
        else: high=mid
    f64(monk_robe_point(t,(low+high)*0.5).z)

# A continuous cloth surface with shallow pleats, rather than separate round cords.
monk_drape = (b: mut MeshB, rows: vec4[], col: vec4, clearance: f64 = 0.0):
    start=b.vs.len()
    loop r in [1..(rows.len()-1)*4+1):
        loop k in [0..24):
            ps: vec3[]
            loop q in [(r - 1, k), (r - 1, k + 1), (r, k + 1), (r, k)]:
                row = monk_curve(rows,f64(q.0)/4.0) # centre x, y, z, half-width
                u = f64(q.1) / 24.0
                pleat = sin(u * TAU * 3.0 + f64(row.y) * 4.5) * (0.005 + (1.0 - f64(row.y)) * 0.018)
                pleat += sin(u*TAU*1.5-f64(row.y)*3.0)*0.006
                x=f64(row.x)+(u*2.0-1.0)*f64(row.w)
                z=f64(row.z)+pleat
                if clearance>0.0 and row.y<0.54:
                    z=max(z,monk_robe_front(x,f64(row.y))+clearance+pleat*0.35)
                ps.push(v3(x,f64(row.y),z))
            normal = normalize(cross(ps[1] - ps[0], ps[3] - ps[0]))
            base = u32(b.vs.len())
            loop i in [0..4):
                u=f64(k+(if i==1 or i==2:1 else:0))/24.0
                p=ps[i]
                fold=0.90+0.10*sin(u*TAU*3.0+f64(p.y)*4.5)
                edge=max(1.0-smoothstep(0.0,0.055,min(u,1.0-u)),smoothstep(f64((rows.len()-1)*4)-1.5,f64((rows.len()-1)*4),f64(r-(if i<2:1 else:0))))
                pigment=mix(col,col*vec4(1.35,1.27,1.12,1),f32(edge*0.65))*vec4(f32(fold),f32(fold),f32(fold),1)
                b.vs.push(Vertex3D(p,normal,vec2(0,0),pigment))
            loop j in [base, base + 1, base + 2, base, base + 2, base + 3]: b.idx.push(j)

    monk_smooth(b,start)

# Closed, sculpted head: brow, sockets, nose, lips and cheek planes are all
# deformations of this surface, so the side camera never sees floating rods.
monk_face_point = (y: f64, angle: f64) -> vec3:
    rings = [vec4(0.955,0.035,0.043,0.100),vec4(0.985,0.058,0.054,0.096),vec4(1.025,0.085,0.067,0.075),vec4(1.065,0.110,0.087,0.057),vec4(1.105,0.106,0.099,0.048),vec4(1.145,0.115,0.109,0.041),vec4(1.200,0.118,0.108,0.034),vec4(1.253,0.084,0.078,0.032),vec4(1.282,0.003,0.003,0.032)]
    r=monk_curve(rings,y)
    h=f64(r.x)
    x=cos(angle)*f64(r.y)
    z=sin(angle)*f64(r.z)+f64(r.w)
    front=pow(max(0.0,sin(angle)),4.0)
    g = (cx: f64, cy: f64, wx: f64, wy: f64) -> f64:
        exp(-pow((abs(x)-cx)/wx,2.0)-pow((h-cy)/wy,2.0))
    socket=g(0.055,1.115,0.029,0.021)
    brow=g(0.054,1.143,0.042,0.016)
    cheek=g(0.077,1.070,0.036,0.023)
    hollow=g(0.075,1.029,0.031,0.024)
    bridge=g(0.0,1.114,0.028,0.055)*0.018
    nose=g(0.0,1.079,0.032,0.030)*0.014+g(0.021,1.068,0.014,0.013)*0.005
    lip=(g(0.0,1.034,0.034,0.006)*0.009+g(0.0,1.021,0.030,0.007)*0.012)
    mouth=g(0.0,1.028,0.035,0.0035)*0.008
    # Shallow closed lids sit inside the socket, with heavy upper brow planes.
    lid=g(0.056,1.111,0.026,0.004)*0.007
    z+=front*(brow*0.012+cheek*0.008-socket*0.008-hollow*0.004+bridge+nose+lip-mouth+lid)
    v3(x,h,z)

monk_head = (b: mut MeshB, skin_: vec4):
    start=b.vs.len()
    loop row in [0..64):
        loop k in [0..48):
            ps=[monk_face_point(f64(row)/8.0,TAU*f64(k)/48.0),monk_face_point(f64(row)/8.0,TAU*f64((k+1)%48)/48.0),monk_face_point(f64(row+1)/8.0,TAU*f64((k+1)%48)/48.0),monk_face_point(f64(row+1)/8.0,TAU*f64(k)/48.0)]
            n=normalize(cross(ps[3]-ps[0],ps[1]-ps[0]))
            base=u32(b.vs.len())
            loop p in ps:
                x=abs(f64(p.x))
                y=f64(p.y)
                front=smoothstep(0.08,0.13,f64(p.z))
                lid=exp(-pow((x-0.056)/0.026,4.0)-pow((y-1.111)/0.0038,2.0))
                mouth=exp(-pow(x/0.032,4.0)-pow((y-1.028)/0.0035,2.0))
                nostril=exp(-pow((x-0.017)/0.007,2.0)-pow((y-1.065)/0.004,2.0))
                shade_=1.0-front*(lid*0.22+mouth*0.30+nostril*0.20)
                b.vs.push(Vertex3D(p,n,vec2(0,0),skin_*vec4(f32(shade_),f32(shade_),f32(shade_),1)))
            loop index in [base,base+3,base+2,base,base+2,base+1]: b.idx.push(index)
    monk_smooth(b,start)

shrine_monk_model = () -> Model:
    if __ascetic.ok: return __ascetic
    b = MeshB()
    skin_ = rgb(0.43, 0.39, 0.33)
    bone = rgb(0.58, 0.54, 0.46)
    shadow = rgb(0.17, 0.12, 0.08)
    cloth = rgb(0.34, 0.255, 0.16)
    hem = rgb(0.60, 0.40, 0.17)
    # The folded legs support a narrow, bowed torso; the hands rest together in the lap.
    # Continuous pleated robe spreads over crossed knees. The angular lower
    # hem and long folds read from the side as well as from the talking camera.
    robe_start=b.vs.len()
    point = (j: int, row: int) -> vec3:
        monk_robe_point(f64(row)/4.0,TAU*f64(j%64)/64.0)
    loop row in [0..20):
        loop j in [0..64):
            ps=[point(j,row),point(j+1,row),point(j+1,row+1),point(j,row+1)]
            nn=normalize(cross(ps[3]-ps[0],ps[1]-ps[0]))
            base=u32(b.vs.len())
            loop k in [0..4):
                p=ps[k]
                a=TAU*f64((j+(if k==1 or k==2:1 else:0))%64)/64.0
                fold=0.84+0.16*cos(a*7.0+f64(p.y)*3.0)
                edge=1.0-smoothstep(0.065,0.095,f64(p.y))
                pigment=mix(cloth,hem,f32(edge))*vec4(f32(fold),f32(fold),f32(fold),1)
                b.vs.push(Vertex3D(p,nn,vec2(0,0),pigment))
            loop k in [base,base+3,base+2,base,base+2,base+1]: b.idx.push(k)
    monk_smooth(b,robe_start)
    # The continuous robe covers both folded feet; its lap folds are sculpted above.
    monk_torso(b,skin_)
    loop s in [-1.0, 1.0]:
        mb_cyl(b, v3(0.0, 0.87, 0.035), v3(s * 0.17, 0.838, 0.009), 0.010, 0.008, skin_, 12)
        monk_arm(b,s,skin_)
        # Dhyana mudra: cupped palms overlap and the thumbs touch above them.
        yhand = if s < 0.0: 0.345 else: 0.367
        mb_sphere(b, v3(s * 0.023, yhand, 0.28), v3(0.066, 0.022, 0.048), skin_, 16)
        loop f in [0..4):
            x=s*(0.012+f64(f)*0.017)
            z=0.34-f64(f)*0.006
            monk_digit(b,[monk_row(x,yhand,0.286,0.0075),monk_row(x,yhand+0.003,z-0.010,0.0078),monk_row(x-s*0.003,yhand+0.017,z+0.005,0.0065),monk_row(x-s*0.011,yhand+0.025,z+0.006,0.0045),monk_row(x-s*0.015,yhand+0.025,z+0.002,0.0005)],skin_)
        monk_digit(b,[monk_row(s*0.057,yhand+0.010,0.272,0.011),monk_row(s*0.045,0.397,0.284,0.010),monk_row(s*0.026,0.419,0.295,0.008),monk_row(s*0.006,0.423,0.298,0.005),monk_row(0,0.420,0.298,0.0005)],skin_)
    # One continuous robe falls from the shoulder, across the hollow torso and
    # into the lap; its widening hem meets the cloth draped over crossed knees.
    monk_drape(b, [vec4(-0.14, 0.865, 0.018, 0.075), vec4(-0.10, 0.74, 0.095, 0.075), vec4(-0.035, 0.52, 0.095, 0.085), vec4(0.025, 0.38, 0.18, 0.12), vec4(0.0, 0.24, 0.3, 0.22)], cloth,0.060)
    monk_drape(b, [vec4(-0.20, 0.855, -0.025, 0.075), vec4(-0.24, 0.73, 0.045, 0.083), vec4(-0.22, 0.59, 0.083, 0.068), vec4(-0.13, 0.43, 0.15, 0.095), vec4(-0.10, 0.28, 0.28, 0.17)], cloth * vec4(0.93,0.93,0.93,1),0.085)
    monk_head(b, skin_)
    loop s in [-1.0, 1.0]:
        mb_sphere(b, v3(s * 0.128, 1.045, 0.06), v3(0.032, 0.096, 0.038), bone, 10)
        mb_sphere(b, v3(s * 0.137, 0.982, 0.065), v3(0.019, 0.032, 0.025), skin_, 12)
    # A broad folded ochre cap above the temples separates head from halo.
    mb_cyl(b, v3(0.0, 1.23, 0.025), v3(0.0, 1.28, 0.025), 0.27, 0.23, hem, 16)
    mb_cyl(b, v3(0.0, 1.225, 0.025), v3(0.0, 1.245, 0.025), 0.235, 0.27, shadow, 16)
    # Linen wraps, a tapered crown, and a pierced bronze nimbus.
    loop k in [0..7):
        y = 1.23 + f64(k) * 0.043
        radius = 0.15 - f64(k) * 0.014
        mb_cyl(b, v3(0.0, y, 0.025), v3(0.0, y + 0.038, 0.02), radius, radius - 0.005, (if k % 2 == 0: bone else: hem), 14)
    mb_cyl(b, v3(0.0, 1.53, 0.02), v3(0.0, 1.66, 0.01), 0.055, 0.003, hem, 12)
    loop k in [0..40):
        a = f64(k) * TAU / 40.0
        b_ = f64(k + 1) * TAU / 40.0
        mb_cyl(b, v3(cos(a) * 0.31, 1.23 + sin(a) * 0.31, -0.105), v3(cos(b_) * 0.31, 1.23 + sin(b_) * 0.31, -0.105), 0.018, 0.018, hem, 6)
        if k % 4 == 0:
            mb_sphere(b, v3(cos(a) * 0.31, 1.23 + sin(a) * 0.31, -0.105), v3(0.026, 0.026, 0.019), bone, 7)
        if k % 4 == 0: mb_cyl(b, v3(cos(a) * 0.16, 1.23 + sin(a) * 0.16, -0.105), v3(cos(a) * 0.3, 1.23 + sin(a) * 0.3, -0.105), 0.012, 0.008, cloth, 6)
    mb_sphere(b, v3(0.0, 1.295, 0.17), v3(0.035, 0.045, 0.012), hem, 8)
    mb_sphere(b, v3(0.0, 1.295, 0.183), v3(0.018, 0.026, 0.006), rgb(0.17, 0.3, 0.33), 8)
    loop k in [0..16):
        a = f64(k) * PI / 15.0
        mb_sphere(b, v3(cos(a) * 0.14, 0.78 - sin(a) * 0.22, 0.11), v3(0.018, 0.021, 0.017), shadow, 6)
    vs: ChVert[]
    loop v in b.vs:
        # Broad sunken planes and warm-grey wear are baked once into the same
        # mesh. Head, folds and bronze retain their separate value families.
        p=v.pos
        y=f64(p.y)
        x=abs(f64(p.x))
        patina=0.5+0.5*sin(f64(p.x)*18.0+y*13.0+sin(f64(p.z)*21.0))
        underside=1.0-smoothstep(-0.4,0.5,f64(v.normal.y))
        temple=exp(-pow((x-0.090)/0.04,2.0)-pow((y-1.14)/0.07,2.0))
        neck=exp(-pow((y-0.94)/0.045,2.0))
        wash=0.93+0.10*patina-0.17*underside-0.035*temple-0.16*neck
        col=vec4(v.color.xyz*f32(wash),v.color.w)
        vs.push(ChVert(v.pos, v.normal, v.uv, col, vec4(0, 0, 0, 0), vec4(1, 0, 0, 0)))
    m = Model(name = "ascetic", ok = true, bmin = v3(-0.72, 0.0, -0.45), bmax = v3(0.72, 1.7, 0.5))
    m.bones = ["root"]
    m.parent = [-1]
    m.canon = [-1]
    m.use_t = [false]
    m.rest_t = [vec3(0, 0, 0)]
    m.rest_r = [QUAT_ID]
    m.rest_s = [vec3(1, 1, 1)]
    m.ibm = [mat4()]
    m.textures = [bytes_texture(1, 1, [u8(255), 255, 255, 0], false, true)]
    m.parts = [ModelPart(name = "ascetic", mesh = mesh(vs, b.idx), slot = 0, two_sided = true, verts = vs.len(), tris = b.idx.len() / 3)]
    __ascetic = m
    m

# The ascetic never changes pose. The renderer refreshes this immutable skin's
# palette row per frame and reuses it across the shadow and color passes.
shrine_monk_skin = () -> Skin:
    if __ascetic_skin.mats.len()==0:
        __ascetic_skin=skin_cpu(shrine_monk_model(),Pose())
    __ascetic_skin

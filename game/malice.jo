use 'gfx.jo'
use 'env.jo'
use 'shade.jo'
use 'fx.jo'
use 'malice_shape.jo'

# Overlapping, eroded density parcels, with real world depth around the keep.
# No connected tube or luminous centreline: the silhouette belongs to smoke.
struct MaliceV:
    phase: f32
    cross_section: vec2
struct MaliceU:
    vp: mat4
    center: vec3
    cam: vec3
    time: f32
    night: f32
    amount: f32
    side: f32
struct MaliceO:
    pos: vec4
    phase: f32
    cross_section: vec2
    facing: f32
    surface: f32

malice_vs = (v: MaliceV, u: MaliceU) -> MaliceO:
    phase = fract(v.phase + u.time * 0.018)
    q = malice_spine(phase, u.time)
    toward = normalize(vec3(u.cam.x - u.center.x, 0, u.cam.z - u.center.z))
    right = vec3(toward.z, 0, -toward.x)
    seed = v.phase * 731.0
    # Unequal radial eddies break the spiral into overlapping rising banks.
    outward = normalize(vec3(q.x, 0, q.z))
    q += outward * (sin(seed * 1.7) * 23.0)
    radius = malice_thickness(phase) * (0.80 + 0.20 * sin(seed * 2.3))
    world = u.center + q + (right * v.cross_section.x + vec3(0, v.cross_section.y, 0)) * radius
    MaliceO(u.vp * vec4(world, 1), phase, v.cross_section, dot(outward, toward), seed)

malice_fs = (i: MaliceO, u: MaliceU) -> vec4:
    side = step(0.0, i.facing * u.side)
    ends = smoothstep(0.0, 0.09, i.phase) * (1.0 - smoothstep(0.84, 1.0, i.phase))
    p = i.cross_section
    flow = p * 2.1 + vec2(i.surface, -u.time * 0.11)
    broad = vnoise(flow)
    fine = vnoise(flow * 2.7 + vec2(broad, broad) * 1.3)
    density = broad * 0.68 + fine * 0.32
    # Soft lobes dissolve well inside the quad; noise erodes unequal holes.
    edge = 1.0 - smoothstep(0.18, 0.95, length(p) + (density - 0.5) * 0.48)
    cloud = smoothstep(0.23, 0.73, density) * edge
    color = mix(vec3(0.042, 0.010, 0.039), vec3(0.13, 0.028, 0.084), density)
    night_color = mix(vec3(0.10, 0.014, 0.075), vec3(0.26, 0.04, 0.18), density)
    vec4(mix(color, night_color, u.night), u.amount * side * ends * cloud * 0.42)

__malice_ready = false
__malice_mesh: Mesh
__malice_sh: Shader

draw_malice = (vp: mat4, cam: vec3, amount: f64):
    if amount <= 0.0: return
    if not __malice_ready:
        __malice_ready = true
        vs: MaliceV[]
        idx: u32[]
        loop k in [0..MALICE_SEGMENTS):
            a = u32(vs.len())
            loop corner in [vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(1,1)]:
                vs.push(MaliceV(f32(k) / f32(MALICE_SEGMENTS), corner))
            loop n in [a,a+1,a+2,a+2,a+1,a+3]: idx.push(n)
        __malice_mesh = mesh(vs, idx)
        __malice_sh = make_sh(shader(malice_vs, malice_fs))
    glEnable(GL_DEPTH_TEST)
    glDepthMask(0)
    glDisable(GL_CULL_FACE)
    glEnable(GL_BLEND)
    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
    u = MaliceU(vp, malice_center, cam, f32(elapsed()), f32(smoothstep(0.3, 0.85, env.night)), f32(amount), -1)
    draw_fast(__malice_sh, __malice_mesh, u)
    u.side = 1.0
    draw_fast(__malice_sh, __malice_mesh, u)
    glDepthMask(1)
    glDisable(GL_BLEND)

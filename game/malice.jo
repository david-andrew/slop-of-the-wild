use 'gfx.jo'
use 'env.jo'
use 'shade.jo'
use 'fx.jo'
use 'malice_shape.jo'

# Overlapping, soft density parcels, with real world depth around the keep.
# No connected tube or luminous centreline: the silhouette belongs to smoke.
struct MaliceV:
    phase: f32
    cross_section: vec2
struct MaliceU:
    vp: mat4
    center: vec3
    cam: vec3
    time: f32
    night: f32
    amount: f32
    side: f32
struct MaliceO:
    pos: vec4
    phase: f32
    cross_section: vec2
    facing: f32
    world: vec3

malice_vs = (v: MaliceV, u: MaliceU) -> MaliceO:
    phase = fract(v.phase + u.time * 0.018)
    q = malice_parcel(v.phase, u.time)
    toward = normalize(vec3(u.cam.x - u.center.x, 0, u.cam.z - u.center.z))
    right = vec3(toward.z, 0, -toward.x)
    seed = v.phase * 731.0
    # Parcels fill the core and wind-sheared crown with independent lifetimes.
    outward = normalize(vec3(q.x, 0, q.z))
    radius = malice_thickness(v.phase) * (0.80 + 0.20 * sin(seed * 2.3))
    world = u.center + q + (right * v.cross_section.x + vec3(0, v.cross_section.y, 0)) * radius
    MaliceO(u.vp * vec4(world, 1), phase, v.cross_section, dot(outward, toward), world - u.center)

malice_fs = (i: MaliceO, u: MaliceU) -> vec4:
    side = step(0.0, i.facing * u.side)
    ends = smoothstep(0.0, 0.09, i.phase) * (1.0 - smoothstep(0.84, 1.0, i.phase))
    p = i.cross_section
    # One advected field spans all parcels, rather than unrelated noisy spots.
    # Tilted curls carry crimson through a darker underside.
    w = i.world
    # Cartesian warped curls have no angle seam or mirrored polar lobes.
    warp = vnoise(vec2(w.x*0.010+w.z*0.004,w.y*0.014-u.time*0.028))
    eddy = sin(w.x*0.035+w.z*0.023+w.y*0.032+warp*5.0)*0.5+0.5
    density = vnoise(vec2(w.x+w.z*0.65,w.y-w.z*0.25)*0.019+vec2(eddy*1.8,-u.time*0.035))
    edge = 1.0-smoothstep(0.05,0.94,length(p))
    cloud = edge*edge*(0.42+density*0.58)
    underside = smoothstep(105.0,235.0,w.y)
    crimson = smoothstep(0.20,0.85,eddy)*0.70+density*0.22
    color = mix(vec3(0.075,0.009,0.028),vec3(0.48,0.020,0.040),crimson)*(0.64+underside*0.36)
    night_color = color*vec3(1.35,1.1,1.25)
    vec4(mix(color,night_color,u.night),u.amount*side*ends*cloud*(0.15+(1.0-underside)*0.06))

__malice_ready = false
__malice_mesh: Mesh
__malice_sh: Shader

draw_malice = (vp: mat4, cam: vec3, amount: f64):
    if amount <= 0.0: return
    if not __malice_ready:
        __malice_ready = true
        vs: MaliceV[]
        idx: u32[]
        loop k in [0..MALICE_SEGMENTS):
            a = u32(vs.len())
            loop corner in [vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(1,1)]:
                vs.push(MaliceV(f32(k) / f32(MALICE_SEGMENTS), corner))
            loop n in [a,a+1,a+2,a+2,a+1,a+3]: idx.push(n)
        __malice_mesh = mesh(vs, idx)
        __malice_sh = make_sh(shader(malice_vs, malice_fs))
    glEnable(GL_DEPTH_TEST)
    glDepthMask(0)
    glDisable(GL_CULL_FACE)
    glEnable(GL_BLEND)
    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA)
    u = MaliceU(vp, malice_center, cam, f32(elapsed()), f32(smoothstep(0.3, 0.85, env.night)), f32(amount), -1)
    draw_fast(__malice_sh, __malice_mesh, u)
    u.side = 1.0
    draw_fast(__malice_sh, __malice_mesh, u)
    glDepthMask(1)
    glDisable(GL_BLEND)

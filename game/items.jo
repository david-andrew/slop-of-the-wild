use 'gfx.jo'
use 'terrain.jo'
use 'physics.jo'
use 'water.jo'
use 'scene.jo'
use 'matter.jo'

# Items: what exists (weapons, shields, bows, arrows, food, materials, key items), what the
# player carries, and the items lying in the world (they fall, roll, float and burn).
# Attack values follow the original (see docs/MOVEMENT_REFERENCE.md); weapons do not break.

enum IKind: weapon, shield, bow, arrows, food, material, key

enum IShape:
    branch, club, sword, axe, torch, spear, broadsword, claymore, lid, boko_shield, shield, bow, arrows,
    apple, baked_apple, mushroom, pepper, meat, steak, herb, ore, orb, glider, cloth, roasted, fish, drumstick, rock, frog, lizard, firefly, acorn, skewer, dish, trousers, roasted_pepper, firewood

enum Ingredient: none, fruit, mushroom, meat, fish, greens, nut, stone, invalid

struct ItemDef:
    id: str
    name: str
    kind: IKind
    shape: IShape
    power = 0                  # attack (weapons, bows) or guard (shields)
    heal = 0                   # quarter hearts restored by eating
    two_handed = false
    spear = false
    wood = false               # burns
    metal = false              # conducts, attracts lightning
    color = vec4(1, 1, 1, 1)   # icon / tint
    warm = 0.0                 # cold resistance from eating (seconds)
    ingredient = Ingredient.none
    cooks_to = ""              # what fire turns it into

idefs: ItemDef[]
__idx: {str: int} = {}

__def = (d: ItemDef):
    __idx[d.id] = idefs.len()
    idefs.push(d)

item = (id: str) -> ItemDef: idefs[__idx.get(id) ?? 0]

# what an item is made of, for the element rules
matter_of = (id: str) -> Matter:
    d = item(id)
    if id == "torch": return TORCH
    if len(d.cooks_to) > 0: return FOOD
    if d.wood: return WOOD
    if d.metal: return METAL
    STONE
has_item_def = (id: str) -> bool: __idx.has(id)

items_init = ():
    __def(ItemDef("branch", "Tree Branch", .weapon, .branch, power = 2, wood = true, color = rgb(0.5, 0.36, 0.2)))
    __def(ItemDef("torch", "Torch", .weapon, .torch, power = 2, wood = true, color = rgb(0.6, 0.4, 0.2)))
    __def(ItemDef("axe", "Woodcutter's Axe", .weapon, .axe, power = 3, two_handed = true, metal = true, color = rgb(0.6, 0.55, 0.5)))
    __def(ItemDef("boko_club", "Bonko Club", .weapon, .club, power = 4, wood = true, color = rgb(0.45, 0.32, 0.22)))
    __def(ItemDef("spiked_club", "Spiked Bonko Club", .weapon, .club, power = 12, wood = true, color = rgb(0.4, 0.3, 0.25)))
    __def(ItemDef("boko_spear", "Bonko Spear", .weapon, .spear, power = 2, spear = true, wood = true, color = rgb(0.5, 0.4, 0.3)))
    __def(ItemDef("travelers_sword", "Wanderer's Sword", .weapon, .sword, power = 5, metal = true, color = rgb(0.75, 0.75, 0.78)))
    __def(ItemDef("rusty_broadsword", "Rusty Broadsword", .weapon, .broadsword, power = 6, metal = true, color = rgb(0.6, 0.4, 0.3)))
    __def(ItemDef("soldiers_broadsword", "Soldier's Broadsword", .weapon, .broadsword, power = 14, metal = true, color = rgb(0.8, 0.82, 0.88)))
    __def(ItemDef("travelers_claymore", "Wanderer's Claymore", .weapon, .claymore, power = 10, two_handed = true, metal = true, color = rgb(0.72, 0.72, 0.76)))
    __def(ItemDef("travelers_spear", "Wanderer's Spear", .weapon, .spear, power = 3, spear = true, metal = true, color = rgb(0.7, 0.7, 0.72)))

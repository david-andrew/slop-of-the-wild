use 'gfx.jo'
use 'shade.jo'
use 'scene.jo'
use 'fx.jo'

# Pose-bound tongues use unequal heights and a world-space limb/motion trail.
# Keeping their roots on the limbs preserves the body and the running gesture.
struct BodyFireU:
    vp: mat4
    right: vec3
    time: f32
    cam = vec3(0, 0, 1000)
struct BodyFireO:
    pos: vec4
    uv: vec2
    seed: f32
    strength: f32

# Pull a rig socket to its visible surface along the viewing ray. Keeping
# its projected position avoids sliding chest/leg roots down under the mesh.
body_fire_surface = (root: vec3, cam: vec3, extent: f32) -> vec3:
    toward = cam-root
    root+toward*(extent/max(length(toward),0.001))

# Sample the moving bone segment before pulling it onto the visible surface.
# Two overlapping roots follow both ends of a limb instead of one flame badge.
body_fire_limb_root = (root: vec3, end: vec3, along: f32, cam: vec3, extent: f32) -> vec3:
    body_fire_surface(mix(root,end,along),cam,extent)

body_fire_vs = (v: QuadV, i: PInst, u: BodyFireU) -> BodyFireO:
    y = (v.corner.y + 1.0) * 0.5
    flicker = 0.82 + sin(u.time * 16.0 + i.data.z) * 0.18
    # color.xyz carries the projected limb direction and locomotion wake. The
    # root stays fixed; only the upper tongue curves away from the moving limb.
    height = i.data.w * flicker
    drift = i.color.xyz
    drift.xz *= min(1.0,height*0.32/max(length(drift.xz),0.001))
    wake = drift * (y * y)
    point = i.pos.xyz + wake + u.right * (v.corner.x * i.pos.w * (1.0 + 0.13 * sin(i.data.z)) + sin(u.time * 9.0 + i.data.z) * y * y * height * 0.06) + vec3(0, y * height, 0)
    enemy = i.data.y > 0.5
    strength = i.color.w * smoothstep((if enemy: 1.5 else: 3.0),(if enemy: 2.5 else: 4.5),length(i.pos.xyz-u.cam))
    if length(vec3(u.vp[0].w,u.vp[1].w,u.vp[2].w)) > 0.1:
        point = flame_card_bound(point,i.pos.xyz,u.vp)
    BodyFireO(u.vp * vec4(point,1),vec2(v.corner.x,y),i.data.z,strength)

# Yellow fuel grades into orange sheets and red tips without a white cutout.
# Shared by ground/body fire; transparent shoulders retain warm pigment.
flame_ink = (y: f32, core: f32, density: f32) -> vec3:
    sheet = mix(vec3(1.65,0.48,0.045),vec3(0.68,0.075,0.018),smoothstep(0.28,0.96,y))
    sheet = mix(vec3(0.22,0.045,0.018),sheet,smoothstep(0.04,0.72,density))
    mix(sheet,vec3(2.35,1.70,0.10),clamp(core,0.0,1.0))

body_fire_fs = (i: BodyFireO, u: BodyFireU) -> vec4:
    y = i.uv.y
    if y<=0.0 or y>=1.0 or i.strength<=0.0:
        glsl_discard(true)
        return vec4(0, 0, 0, 0)
    # A sqrt envelope contains both the >=0.85 crown taper and its trail.
    # Empty body-card margins need no noise or colour work.
    envelope = sqrt(1.0-y)*0.811
    limit = max(envelope+0.081+y*0.20,envelope*0.65+0.041+y*0.36)
    if abs(i.uv.x)>limit:
        glsl_discard(true)
        return vec4(0, 0, 0, 0)
    flow = y * 8.0 - u.time * 12.0
    bend = sin(flow + i.seed * 0.23) * y * 0.20
    x = abs(i.uv.x + bend)
    width = pow(max(1.0-y,0.0),0.85) * (0.69 + sin(i.seed * 1.7) * 0.12)
    width = width * (0.82 + 0.18 * sin(y * 17.0 - u.time * 14.0 + i.seed))
    edge = 1.0-smoothstep(width*0.25,width+0.08,x)
    holes = vnoise(vec2(i.uv.x*3.0+i.seed,y*6.0-u.time*3.0))
    # Dense connected roots feed the rising sheet. Gaps advect upward; a
    # delayed narrow shoulder carries a short flow trail behind each tongue.
    trail_x = abs(i.uv.x + sin(flow-0.8+i.seed*0.23)*y*0.20 + y*0.16)
    trail = (1.0-smoothstep(width*0.15,width*0.65+0.04,trail_x))*0.36*smoothstep(0.15,0.45,y)
    alpha = max(edge,trail) * smoothstep(0.0,0.08,y) * (1.0-smoothstep(0.72,1.0,y)) * (0.78+holes*0.22) * (1.0-smoothstep(0.38,0.80,y)*smoothstep(0.55,0.78,holes)*0.85)
    core = pow(max(1.0-y,0.0),2.4) * (1.0-smoothstep(0.0,max(width*0.68,0.02),x))
    color = flame_ink(y,core,edge)
    vec4(color,alpha*i.strength)

__body_fire_ready = false
__body_fire_sh: Shader
__body_fire_quad: Mesh
__body_fire_buf: InstBuf
body_fire_draw = (instances: PInst[], time: f64):
    if sc.shadow or instances.len()==0: return
    if not __body_fire_ready:
        __body_fire_ready = true
        __body_fire_sh = make_sh(shader(body_fire_vs,body_fire_fs))
        __body_fire_quad = mesh([QuadV(vec2(-1,-1)),QuadV(vec2(1,-1)),QuadV(vec2(-1,1)),QuadV(vec2(1,1))],[u32(0),1,2,2,1,3])
        __body_fire_buf = inst_buffer(instances)
    glEnable(GL_DEPTH_TEST)
    glDepthMask(0)
    glDisable(GL_CULL_FACE)
    glEnable(GL_BLEND)
    glBlendFuncSeparate(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA,GL_ONE,GL_ONE_MINUS_SRC_ALPHA)
    right = vec3(sc.view[0].x,sc.view[1].x,sc.view[2].x)
    inst_stream(__body_fire_buf,instances)
    draw_static(__body_fire_sh,__body_fire_quad,__body_fire_buf,BodyFireU(sc.vp,right,f32(time),sc.cam))
    glDisable(GL_BLEND)
    glDepthMask(1)

# Draw the exact combat fire state offscreen before a camp's first burning actor.
# No actor/particle mutation or random sampling is needed for pipeline readiness.
body_fire_warmup = ():
    body_fire_draw([PInst(vec4(sc.cam + vec3(0,0,-4),0.25),vec4(0,0,0,0.5),vec4(0,0,0,1))],0.0)

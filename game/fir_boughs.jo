use 'gfx.jo'

# Closed needle sprays follow the kit's authored boughs, replacing flat alpha
# sheets without changing tree bounds, placement, RNG or material/draw buckets.
struct FirCrown:
    vertices: Vertex3D[]
    indices: u32[]
    shadow: u32[]

__fir_root = (parents: int[], i0: int) -> int:
    i = i0
    loop parents[i] != i: i = parents[i]
    i

fir_crown = (source: Vertex3D[], indices: u32[]) -> FirCrown:
    out = FirCrown()
    parents: int[]
    loop i in [0..source.len()): parents.push(i)
    # Weld UV/normal seams before finding connected boughs. The source has only
    # 800–1900 vertices; this runs once per model at loading, never per frame.
    loop i in [0..source.len()):
        loop j in [0..i):
            if length(source[i].pos - source[j].pos) < 0.0002:
                parents[__fir_root(parents, i)] = __fir_root(parents, j)
                break
    loop k in [0..indices.len() / 3):
        a = __fir_root(parents, int(indices[k * 3]))
        loop j in [1..3): parents[__fir_root(parents, int(indices[k * 3 + j]))] = a
    groups: {int: vec3[]} = {}
    used: {int: bool} = {}
    loop index in indices:
        i = int(index)
        if used.get(i) != none: continue
        used[i] = true
        root = __fir_root(parents, i)
        if groups.get(root) == none: groups[root] = []
        groups[root].push(source[i].pos)
    loop root, points in groups:
        near = 1e9
        far = 0.0
        loop p in points:
            near = min(near, f64(length(p.xz)))
            far = max(far, f64(length(p.xz)))
        base = vec3(0, 0, 0)
        tip = vec3(0, 0, 0)
        nb = 0
        nt = 0
        loop p in points:
            r = f64(length(p.xz))
            if r <= near + (far - near) * 0.12:
                base += p
                nb += 1
            if r >= far - (far - near) * 0.10:
                tip += p
                nt += 1
        base /= f32(max(1, nb))
        tip /= f32(max(1, nt))
        axis = tip - base
        reach = f64(length(axis))
        if reach < 0.04: continue
        direction = normalize(axis)
        side = if length(direction.xz) > 0.001: normalize(cross(direction, vec3(0, 1, 0))) else: vec3(1, 0, 0)
        up = normalize(cross(side, direction))
        width = 0.0
        loop p in points: width = max(width, abs(f64(dot(p - base, side))))
        width = min(width * 0.82, reach * 0.40)
        # Three overlapping tufts give each bough rounded, unequal lobes instead
        # of one giant oval leaf. All stay inside the authored spray envelope.
        __fir_spray(out, base, tip, width * 0.52, reach * 0.130)
        loop sign in [-1.0, 1.0]:
            child_base = mix(base, tip, 0.15)
            child_tip = mix(base, tip, f32(0.74 + sign * 0.045)) + side * f32(sign * width * 0.65)
            __fir_spray(out, child_base, child_tip, width * 0.48, reach * 0.115)
    out

__fir_spray = (out: mut FirCrown, base: vec3, tip: vec3, width: f64, thickness: f64):
    axis = tip - base
    reach = f64(length(axis))
    direction = normalize(axis)
    side = if length(direction.xz) > 0.001: normalize(cross(direction, vec3(0, 1, 0))) else: vec3(1, 0, 0)
    up = normalize(cross(side, direction))
    first = out.vertices.len()
    # Rounded terminal shoulders, an arched upper cushion and a descending
    # spine keep the silhouette thick at oblique angles. No alpha-cut edge.
    stations = [0.0, 0.18, 0.46, 0.74, 0.92, 1.0]
    loop u in stations:
        bulge = sqrt(max(0.0, 4.0 * u * (1.0 - u)))
        spine = mix(base, tip, f32(u)) + up * f32(reach * 0.07 * sin(PI * u))
        loop k in [0..8):
            angle = TAU * f64(k) / 8.0
            p = spine + side * f32(width * bulge * cos(angle)) + up * f32(thickness * bulge * sin(angle) * (if sin(angle) > 0.0: 1.15 else: 0.65))
            n = normalize(side * f32(cos(angle) / max(width, 0.01)) + up * f32(sin(angle) / (thickness * (if sin(angle) > 0.0: 1.15 else: 0.65))) + direction * f32(-cos(PI * u) * 3.0 / reach))
            shade = f32(0.86 + 0.14 * sin(angle))
            out.vertices.push(Vertex3D(p, n, vec2(0.5, 0.5), vec4(shade, shade, shade, 1.0)))
    loop station in [0..stations.len() - 1):
        loop k in [0..8):
            a = u32(first + station * 8 + k)
            b = u32(first + station * 8 + (k + 1) % 8)
            c = a + 8
            d = b + 8
            if station > 0: out.indices.extend([a, c, b])
            if station < stations.len() - 2: out.indices.extend([b, c, d])
    # Keep all exterior boughs in the distant shadow. Fewer longitudinal
    # rings suffice there; retain the same poles and widest cross sections.
    rings = [0, 2, 4, 5]
    loop station in [0..rings.len() - 1):
        loop k in [0..8):
            a = u32(first + rings[station] * 8 + k)
            b = u32(first + rings[station] * 8 + (k + 1) % 8)
            c = u32(first + rings[station + 1] * 8 + k)
            d = u32(first + rings[station + 1] * 8 + (k + 1) % 8)
            if station > 0: out.shadow.extend([a, c, b])
            if station < rings.len() - 2: out.shadow.extend([b, c, d])

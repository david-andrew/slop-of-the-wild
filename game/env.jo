use 'gfx.jo'
use 'shade.jo'

# Time of day and weather: the sun and moon, sky and haze colors, clouds, rain.
# One in-game hour passes in one real minute (a day is 24 minutes), as in the original.

struct Keyframe:
    hour: f64
    zenith: vec3
    horizon: vec3
    sun: vec3          # direct light color * intensity
    sky: vec3          # ambient from above
    ground: vec3       # ambient from below
    haze: vec3
    density: f64

__keys = [
    Keyframe(0.0, v3(0.015, 0.03, 0.08), v3(0.05, 0.09, 0.17), v3(0.38, 0.48, 0.74), v3(0.15, 0.2, 0.34), v3(0.05, 0.06, 0.1), v3(0.06, 0.09, 0.17), 0.0009),
    Keyframe(4.6, v3(0.02, 0.035, 0.09), v3(0.07, 0.1, 0.18), v3(0.15, 0.2, 0.33), v3(0.06, 0.09, 0.17), v3(0.025, 0.03, 0.05), v3(0.06, 0.08, 0.14), 0.0009),
    Keyframe(5.6, v3(0.12, 0.19, 0.43), v3(0.78, 0.48, 0.64), v3(1.25, 0.72, 1.0), v3(0.27, 0.32, 0.53), v3(0.13, 0.12, 0.18), v3(0.58, 0.49, 0.66), 0.0011),
    Keyframe(6.4, v3(0.15, 0.28, 0.62), v3(0.90, 0.59, 0.72), v3(1.85, 1.27, 1.48), v3(0.32, 0.38, 0.60), v3(0.15, 0.14, 0.20), v3(0.68, 0.59, 0.76), 0.001),
    Keyframe(7.0, v3(0.16, 0.36, 0.78), v3(0.62, 0.72, 0.84), v3(2.4, 1.85, 1.35), v3(0.504, 0.644, 0.924), v3(0.34, 0.289, 0.204), v3(0.66, 0.74, 0.86), 0.00085),
    Keyframe(12.0, v3(0.12, 0.33, 0.8), v3(0.55, 0.72, 0.92), v3(2.9, 2.6, 2.2), v3(0.56, 0.728, 1.036), v3(0.408, 0.374, 0.272), v3(0.62, 0.76, 0.93), 0.0007),
    Keyframe(16.5, v3(0.14, 0.34, 0.76), v3(0.66, 0.74, 0.86), v3(2.7, 2.2, 1.6), v3(0.56, 0.672, 0.924), v3(0.408, 0.34, 0.238), v3(0.7, 0.76, 0.86), 0.00075),
    Keyframe(17.6, v3(0.16, 0.3, 0.64), v3(0.98, 0.7, 0.48), v3(2.5, 1.55, 0.8), v3(0.6, 0.56, 0.74), v3(0.28, 0.2, 0.12), v3(0.84, 0.68, 0.54), 0.0009),
    Keyframe(18.4, v3(0.25, 0.19, 0.40), v3(1.15, 0.38, 0.20), v3(2.45, 0.88, 0.34), v3(0.68, 0.52, 0.78), v3(0.24, 0.12, 0.08), v3(0.90, 0.42, 0.32), 0.001),
    Keyframe(18.9, v3(0.20, 0.14, 0.34), v3(1.08, 0.29, 0.20), v3(1.9, 0.55, 0.28), v3(0.54, 0.4, 0.66), v3(0.18, 0.08, 0.08), v3(0.75, 0.31, 0.30), 0.001),
    # Twilight ambient falls over nearly an hour; snow made the old half-hour drop conspicuous.
    Keyframe(19.8, v3(0.07, 0.09, 0.24), v3(0.42, 0.24, 0.3), v3(0.6, 0.32, 0.3), v3(0.12, 0.12, 0.22), v3(0.05, 0.04, 0.05), v3(0.24, 0.2, 0.28), 0.001),
    Keyframe(20.5, v3(0.015, 0.03, 0.08), v3(0.05, 0.09, 0.17), v3(0.38, 0.48, 0.74), v3(0.15, 0.2, 0.34), v3(0.05, 0.06, 0.1), v3(0.06, 0.09, 0.17), 0.0009),
    Keyframe(24.0, v3(0.015, 0.03, 0.08), v3(0.05, 0.09, 0.17), v3(0.38, 0.48, 0.74), v3(0.15, 0.2, 0.34), v3(0.05, 0.06, 0.1), v3(0.06, 0.09, 0.17), 0.0009),
]

enum Weather: clear, cloudy, rain, storm

struct Env:
    hour = 6.6
    day = 1
    zenith = vec3(0, 0, 0)
    horizon = vec3(0, 0, 0)
    sun_color = vec3(0, 0, 0)
    sky_amb = vec3(0, 0, 0)
    ground_amb = vec3(0, 0, 0)
    haze = vec3(0, 0, 0)
    density = 0.001
    sun_dir = vec3(0, 1, 0)       # toward the sun
    moon_dir = vec3(0, 1, 0)
    light_dir = vec3(0, 1, 0)     # the light that casts shadows (sun, or the moon at night)
    night = 0.0                   # 1 at full night
    weather = Weather.clear
    weather_t = 40.0              # time until the weather may change (the first morning is clear)
    clouds = 0.42                 # coverage 0..1
    rain = 0.0                    # 0..1
    wet = 0.0                     # surfaces stay wet a while
    dark = 0.0                    # overcast darkening
    wind = vec2(1.0, 0.35)
    storm_k = 0.0                 # a storm's own darkening, eased in and out with it
    gust = 1.0                    # how hard the wind blows (rain 1.7, storm 2.8): sways trees, slants rain
    lightning = 0.0
    storm_time = 0.0              # simulated seconds, independent of the day clock
    bolt_wait = -1.0              # sample one 10–20 s interval per discharge
    time_scale = 1.0
    bolt = false                  # a lightning bolt was just struck (the game draws and sounds it)
    valley_mist = 0.0             # dawn-only low pools; drawn with the sky after opaque land
    indoor = 0.0                  # 1 deep inside the shrines (their own dim blue light)

env = Env()
# the weather's own random numbers, seeded from the clock: each session's sky is different
__wrng = rng(time_ns())
# Save the weather/strike generator so imminent transitions resume unchanged.
weather_rng_capture = () -> Rng: __wrng
weather_rng_restore = (r: Rng): __wrng = r

__lerp3 = (a: vec3, b: vec3, t: f64) -> vec3: a + (b - a) * f32(t)

# the air underground (set by the game: each shrine its own)
indoor_haze = vec3(0.05, 0.1, 0.17)

# A strike always begins with its full pulse; subsequent pulses die with the bolt.
lightning_pulse = (remaining: f64) -> f64:
    age = 1.0 - remaining
    first = 1.0 - smoothstep(0.10, 0.16, age)
    second = smoothstep(0.22, 0.26, age) * (1.0 - smoothstep(0.36, 0.42, age))
    third = smoothstep(0.49, 0.53, age) * (1.0 - smoothstep(0.65, 0.71, age))
    remaining * remaining * max(first, max(second * 0.78, third * 0.65))

env_update = (dt: f64, cold: bool):
    env.hour += dt / 60.0 * env.time_scale
    if env.hour >= 24.0:
        env.hour -= 24.0
        env.day += 1
    h = env.hour
    i = 0
    loop i < __keys.len() - 2 and __keys[i + 1].hour <= h: i += 1
    a = __keys[i]
    b = __keys[i + 1]
    t = smooth01((h - a.hour) / max(b.hour - a.hour, 0.001))
    env.zenith = __lerp3(a.zenith, b.zenith, t)
    env.horizon = __lerp3(a.horizon, b.horizon, t)
    env.sun_color = __lerp3(a.sun, b.sun, t)
    env.sky_amb = __lerp3(a.sky, b.sky, t)
    # (night lower in value: moonlight is a dim blue, but the land readable in it, as in BotW)
    nf = smoothstep(20.5, 22.5, h) + 1.0 - smoothstep(3.5, 5.0, h)
    env.sky_amb = env.sky_amb * f32(1.0 - 0.1 * clamp(nf, 0.0, 1.0))
    env.ground_amb = __lerp3(a.ground, b.ground, t)
    env.haze = __lerp3(a.haze, b.haze, t)
    env.density = lerp(a.density, b.density, t)
    # the sun rises in the east (+x), crosses the southern sky (+z) and sets in the west
    # Hold the evening sun above the horizon through the saturated sunset keys.
    # At 18.6 the old arc had already substituted the moon's steep, cool shadows.
    dawn_delay = 0.2 * smoothstep(4.6, 6.2, h) * (1.0 - smoothstep(6.2, 7.5, h))
    solar_hour = if h <= 12.0: h - dawn_delay else if h <= 19.2: 12.0 + (h - 12.0) * 6.0 / 7.2 else: 18.0 + (h - 19.2) * 6.0 / 4.8
    ang = (solar_hour - 6.0) / 12.0 * PI
    elev = sin(ang)
    env.sun_dir = normalize(v3(cos(ang), elev * 0.88, 0.42 * sqrt(max(1.0 - elev * elev, 0.0)) + 0.35 * max(elev, 0.0)))
    mang = ang + PI
    melev = sin(mang)
    env.moon_dir = normalize(v3(cos(mang), melev * 0.55 + 0.1, 0.45))
    env.night = 1.0 - smooth01((f64(env.sun_dir.y) + 0.12) / 0.3)
    # The shadows' light hands over between moon and sun with the sun just under the horizon,
    # the direct light faded out across the hand-over (switched at full strength, every shadow
    # swung round at once and the land jumped in brightness, at dawn and at dusk)
    sy = f64(env.sun_dir.y)
    if sy < -0.04: env.light_dir = env.moon_dir
    else: env.light_dir = env.sun_dir
    # (in the morning over the first few degrees of the sun's climb, the land warming in gradually;
    # in the evening across the last low arc: white snow exposed a rapid dusk fade)
    moon = smoothstep(0.16, 0.35, -sy) * clamp(nf, 0.0, 1.0)
    env.sun_color = (env.sun_color + vec3(0.055, 0.085, 0.16) * f32(moon)) * f32(smoothstep(0.0, 0.16, abs(sy + 0.04)))
    if env.light_dir.y < 0.08: env.light_dir = normalize(vec3(env.light_dir.x, 0.08, env.light_dir.z))
    # weather: a slow random walk between states
    env.weather_t -= dt
    if dt > 0.0 and env.weather_t <= 0.0:
        env.weather_t = __wrng.next_float() * 250.0 + 150.0
        r = __wrng.next_float()
        if r < 0.45: env.weather = .clear
        else if r < 0.72: env.weather = .cloudy
        else if r < 0.92: env.weather = .rain
        else: env.weather = .storm
    tc = 0.3
    tr = 0.0
    match env.weather:
        clear: tc = 0.42
        cloudy:
            tc = 0.74
        rain:
            tc = 0.85
            tr = 0.75
        storm:
            tc = 0.95
            tr = 1.0
    env.clouds = approach(env.clouds, tc, 0.05, dt)
    tg = if env.weather == .storm: 2.8 else: (if env.weather == .rain: 1.7 else: 1.0)
    env.gust = approach(env.gust, tg * (1.0 + 0.25 * sin(env.hour * 300.0) * sin(env.hour * 731.0)), 0.6, dt)
    env.rain = approach(env.rain, tr, 0.08, dt)
    if env.rain > 0.05: env.wet = min(1.0, env.wet + dt * 0.05 * env.rain)
    else: env.wet = max(0.0, env.wet - dt * 0.01)
    # (overcast, not night: a storm greys the day but never blacks it out)
    env.dark = clamp((env.clouds - 0.45) * 1.6, 0.0, 0.68)
    # (a storm: heavier still, the light gone grey-green)
    # (eased in and out with the weather: switched on its state, the light jumped as a storm ended)
    env.storm_k = approach(env.storm_k, (if env.weather == .storm: 1.0 else: 0.0), 0.08, dt)
    env.dark = min(env.dark + 0.14 * env.rain * env.storm_k, 0.84)
    env.storm_time = mod(env.storm_time + dt, 6283.185307179586)
    # overcast: less direct sun, grayer sky and haze
    k = f32(env.dark)
    gray_h = vec3(luma(env.horizon), luma(env.horizon), luma(env.horizon)) * 0.85
    env.horizon = mix(env.horizon, gray_h, k)
    env.zenith = mix(env.zenith, gray_h * 0.8, k)
    # Ordinary cloudy skies retain directional value separation. Dense wet
    # decks remove it, easing with rain so clearing never snaps the sun back.
    closed_deck = (1.0 - shadow_direct(f32(env.clouds))) * f32(smoothstep(0.0, 0.75, env.rain))
    env.sun_color = env.sun_color * (1.0 - k * 0.92) * f32(1.0 - closed_deck)
    env.haze = mix(env.haze, gray_h, k)
    env.sky_amb = mix(env.sky_amb, gray_h * 0.9, k * 0.7)
    # Rain keeps a pale overcast. The denser storm deck absorbs skylight and
    # bounce together; reflected sky and pond-bed light inherit the same values.
    # (with the storm and its rain, not the clouds' last tenth: those take half a minute more)
    storm = env.storm_k * env.rain
    # (a blue-violet storm, not a grey one)
    storm_tint = mix(vec3(1, 1, 1), vec3(0.45, 0.5, 0.66), f32(storm))
    env.zenith = env.zenith * storm_tint
    env.horizon = env.horizon * storm_tint
    env.haze = env.haze * storm_tint
    # A dense deck still supplies diffuse light through canopy gaps. Keep the
    # storm's cool sky/bounce contrast while avoiding double-darkened litter.
    env.sky_amb = env.sky_amb * f32(1.0 - storm * 0.07)
    env.ground_amb = env.ground_amb * f32(1.0 - storm * 0.12)
    env.sun_color = env.sun_color * f32(1.0 - storm * 0.3)
    # Slow overlapping cloud banks continuously admit and absorb skylight.
    # Use simulation time, not the accelerated/frozen day clock or render time.
    # Form the dense deck before its banks pulse; early storm/clearing ramps
    # retain their broad brightness contrast instead of riding a bright crest.
    banks = smoothstep(0.8, 1.0, storm)
    breathing = 1.0 + banks * (0.10 * sin(env.storm_time * 0.3) + 0.045 * sin(env.storm_time * 0.7))
    env.zenith *= f32(breathing)
    env.horizon *= f32(breathing)
    env.haze *= f32(breathing)
    env.sky_amb *= f32(breathing)
    env.ground_amb *= f32(breathing)
    env.sun_color *= f32(breathing)
    env.density *= 1.0 + env.dark * 2.5
    # early morning: mist lying in the low ground, pale and warm, burning off by mid-morning
    dawn = smoothstep(4.6, 5.6, h) * (1.0 - smoothstep(6.2, 7.0, h)) * (1.0 - env.rain)
    env.valley_mist = dawn * 1.65 * (1.0 - env.indoor)
    if dawn > 0.0:
        env.density *= 1.0 + dawn * 0.25
        env.haze = mix(env.haze, vec3(0.86, 0.84, 0.8), f32(dawn * 0.25))
    if env.indoor > 0.0:
        k2 = f32(env.indoor)
        env.sun_color = env.sun_color * (1.0 - k2)
        # (the light underground takes the color of its air)
        env.sky_amb = mix(env.sky_amb, vec3(0.27, 0.33, 0.42) * 0.55 + indoor_haze * 2.6, k2)
        env.ground_amb = mix(env.ground_amb, vec3(0.12, 0.15, 0.2) * 0.5 + indoor_haze * 1.2, k2)
        # (underground the air itself glows faintly blue: the far end of a room fades into it)
        env.haze = mix(env.haze, indoor_haze, k2)
        env.density = lerp(env.density, 0.014, env.indoor)
    env.lightning = max(0.0, env.lightning - dt * 2.2)
    if dt > 0.0:
        if env.weather == .storm and env.rain > 0.6:
            if env.bolt_wait < 0.0: env.bolt_wait = 10.0 + __wrng.next_float() * 10.0
            env.bolt_wait -= dt
            if env.bolt_wait <= 0.0:
                env.lightning = 1.0
                env.bolt = true
                env.bolt_wait += 10.0 + __wrng.next_float() * 10.0
        else: env.bolt_wait = -1.0
    if env.lightning > 0.0:
        # (a bolt flickers: two or three pulses as it dies)
        f = f32(lightning_pulse(env.lightning))
        # (bright enough to light the land for that instant: it had barely shown by day)
        f = f * 1.6
        # (the colours the storm already has, brightened, with a little cold white: added as plain
        # white, the flash washed the whole view to a flat pastel)
        env.sky_amb = env.sky_amb * (1.0 + 3.0 * f) + vec3(0.10, 0.12, 0.17) * f
        env.ground_amb = env.ground_amb * (1.0 + 2.8 * f) + vec3(0.035, 0.04, 0.05) * f
        env.zenith = env.zenith * (1.0 + 2.8 * f) + vec3(0.14, 0.17, 0.24) * f
        env.horizon = env.horizon * (1.0 + 2.3 * f) + vec3(0.12, 0.14, 0.19) * f
        env.sun_color = env.sun_color * (1.0 + 1.2 * f) + vec3(0.3, 0.33, 0.45) * f

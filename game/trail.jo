use 'gfx.jo'

# The blade's trail: a ribbon swept between the blade's base and tip over the last moment of a
# swing, smoothed through the recorded positions, bright at the edge and fading behind.

struct TrailV:
    pos: vec3
    k: vec2             # x: age 0 (now) .. 1 (oldest), y: across 0 (hilt side) .. 1 (tip)

struct TrailU:
    vp: mat4

struct TrailO:
    pos: vec4
    k: vec2

trail_vs = (v: TrailV, u: TrailU) -> TrailO: TrailO(u.vp * vec4(v.pos, 1), v.k)

trail_fs = (i: TrailO, u: TrailU) -> vec4:
    age = i.k.x
    # (a thin bright edge along the blade's path, the rest only a breath)
    edge = smoothstep(0.80, 1.0, i.k.y)
    a = pow(1.0 - age, 2.8) * edge * 0.32
    vec4(vec3(0.95, 0.97, 1.0) * (0.7 + 0.25 * edge), a)

struct TrailS:
    tip: vec3
    base: vec3
    t: f64

const TRAIL_LIFE = 0.075
trail_samples: TrailS[]
__trail_sh = Shader()
__trail_mesh = Mesh()
__trail_ready = false
__trail_n = 0

# Prepare the blade program and dynamic mesh before the first player swing.
trail_init = ():
    if not __trail_ready:
        __trail_ready = true
        __trail_sh = make_sh(shader(trail_vs, trail_fs))
        __trail_mesh = mesh([TrailV(vec3(0, 0, 0), vec2(0, 0))])

# record where the blade is now (call every frame while it cuts; a jump of the hand starts over)
trail_add = (tip: vec3, base: vec3, now: f64):
    if trail_samples.len() > 0 and f64(length(trail_samples[trail_samples.len() - 1].tip - tip)) > 0.9: trail_samples.clear()
    trail_samples.push(TrailS(tip, base, now))

__cr = (p0: vec3, p1: vec3, p2: vec3, p3: vec3, t: f32) -> vec3:
    t2 = t * t
    t3 = t2 * t
    (p1 * 2.0 + (p2 - p0) * t + (p0 * 2.0 - p1 * 5.0 + p2 * 4.0 - p3) * t2 + (p1 * 3.0 - p0 - p2 * 3.0 + p3) * t3) * 0.5

trail_update = (now: f64):
    loop trail_samples.len() > 0 and now - trail_samples[0].t > TRAIL_LIFE: trail_samples.remove(0)

trail_draw = (vp: mat4, now: f64):
    n = trail_samples.len()
    if n < 2: return
    trail_init()
    # a smooth strip: 4 steps between recorded samples
    tips: vec3[]
    bases: vec3[]
    ages: f32[]
    loop i in [0..n - 1):
        i0 = max(i - 1, 0)
        i3 = min(i + 2, n - 1)
        loop s in [0..4):
            t = f32(f64(s) / 4.0)
            tips.push(__cr(trail_samples[i0].tip, trail_samples[i].tip, trail_samples[i + 1].tip, trail_samples[i3].tip, t))
            bases.push(__cr(trail_samples[i0].base, trail_samples[i].base, trail_samples[i + 1].base, trail_samples[i3].base, t))
            tm = lerp(trail_samples[i].t, trail_samples[i + 1].t, f64(t))
            ages.push(f32(clamp((now - tm) / TRAIL_LIFE, 0.0, 1.0)))
    tips.push(trail_samples[n - 1].tip)
    bases.push(trail_samples[n - 1].base)
    ages.push(f32(clamp((now - trail_samples[n - 1].t) / TRAIL_LIFE, 0.0, 1.0)))
    vs: TrailV[]
    loop k in [0..tips.len() - 1):
        a = TrailV(bases[k], vec2(ages[k], 0))
        b = TrailV(tips[k], vec2(ages[k], 1))
        c = TrailV(bases[k + 1], vec2(ages[k + 1], 0))
        d = TrailV(tips[k + 1], vec2(ages[k + 1], 1))
        loop v in [a, b, d, a, d, c]: vs.push(v)
    update_mesh(__trail_mesh, vs)
    gl_blend_state(true)
    glDisable(GL_CULL_FACE)
    draw_fast(__trail_sh, __trail_mesh, TrailU(vp))
    glDepthMask(1)
    glDisable(GL_BLEND)

# Exercise the same draw specialization during the offscreen startup warmup.
# Restore samples so the artificial ribbon can never enter the player's swing.
trail_warmup = (vp: mat4, p: vec3):
    saved = trail_samples
    trail_samples = [TrailS(p + vec3(0.2, 0.3, 0), p + vec3(-0.2, 0, 0), 0.0),
                     TrailS(p + vec3(0.25, 0.4, 0), p + vec3(-0.15, 0.1, 0), 0.01)]
    trail_draw(vp, 0.01)
    trail_samples = saved

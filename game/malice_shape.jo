# Rising smoke parcels share one irregular circulation around the keep.
const MALICE_SEGMENTS = 192
malice_spine = (phase: f32, time: f32) -> vec3:
    angle = phase * 10.8 + sin(phase * 17.0 + 0.8) * 0.52 + time * 0.045
    radius = 134.0 - phase * 32.0 + sin(phase * 23.0 + 0.6) * 15.0
    vec3(cos(angle) * radius, 75.0 + phase * 385.0, sin(angle) * radius * 0.85)

malice_thickness = (phase: f32) -> f32:
    # Wide banks overlap vertically; unequal eddies leave torn, thinning edges.
    76.0 + sin(phase * 19.0 + 0.8) * 22.0 + sin(phase * 41.0) * 12.0

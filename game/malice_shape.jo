# Overlapping turbulent banks: a filled low core and unequal higher wisps.
# Azimuth and height are independent, with no drawn centreline.
use 'shade.jo'
const MALICE_SEGMENTS = 288
malice_parcel = (phase: f32, time: f32) -> vec3:
    id = phase * f32(MALICE_SEGMENTS)
    band = floor(fract(phase) * 3.0)
    seed = id * 2.399963
    angle = seed + time * (0.045 + band * 0.012)
    flow = vec2(cos(angle),sin(angle))
    warp = vnoise(flow * 2.3 + vec2(band * 13.7,time * 0.022)) - 0.5
    radius = 72.0 + band * 43.0 + warp * 62.0 + sin(seed * 3.7) * 24.0
    height = 142.0 + band * 76.0 + sin(angle + band * 1.8) * 39.0
    height += sin(seed * 5.3) * 53.0 + warp * 60.0
    # Wind draws the crown to one side without duplicating two matching lobes.
    vec3(flow.x * radius + band * band * 17.0, height, flow.y * radius * 0.86 - band * 15.0)

malice_thickness = (phase: f32) -> f32:
    64.0 + sin(phase * 731.0) * 15.0 + cos(phase * 359.0) * 10.0

# Shared world-space vortex for the mesh and its drifting density cards.
# Keeping both layers on one spine prevents the smoke overlay drawing old rings.
const MALICE_SEGMENTS = 192
malice_spine = (phase: f32, time: f32) -> vec3:
    # 2.65 turns climb the keep's full height; the narrowing radius gives
    # diagonal climbs much more screen height than the former broad rings.
    angle = phase * 16.650441 + sin(phase * 16.650441 + 0.8) * 0.20 + time * 0.025
    radius = 154.0 - phase * 55.0 + sin(angle * 2.0 + 0.6) * 9.0
    vec3(cos(angle) * radius, 75.0 + phase * 385.0 + sin(angle + 0.25) * 24.0 + sin(angle * 2.0 + 1.4) * 10.0, sin(angle) * radius * 0.85)

malice_thickness = (phase: f32) -> f32:
    (30.0 + sin(phase * 19.0 + 0.8) * 10.0 + sin(phase * 41.0) * 4.0) * (0.55 + 0.45 * smoothstep(0.0, 0.06, phase) * (1.0 - smoothstep(0.94, 1.0, phase)))

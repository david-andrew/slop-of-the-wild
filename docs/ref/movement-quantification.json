      "commit": "656ceeb6ab2dd0eb0d6fa352cd1a3adddf0ec10b",
      "sha256": "acd29b08e73ef11ef8f4fc13e45bb5249622355bac50ec3414f44446ad111a30",
      "gives": "24-frame run loop: 2.963 m at rate 1.5 => 5.556 m/s; sprint 3.703 m at rate 1.75 => 8.10 m/s. Reversal Brake clips: walk 9 frames at rate 0.9; run 8; sprint 18. Wait uses separate 18-frame stop clips and a blend.",
      "limitations": "Clip/research evidence, not a synchronized retail trajectory. Brake duration is not physical heading time; Wait is not an 8-frame release stop.",
      "accessed": "2026-10-11"
    },
    {
      "id": "tas-input",
      "title": "Published BotW TAS input script",

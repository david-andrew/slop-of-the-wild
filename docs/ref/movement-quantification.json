      "id": "wiiu-root-report",
      "title": "Published Wii U v208 root-motion research",
      "url": "https://github.com/ntngel1/botw-renderer/blob/656ceeb6ab2dd0eb0d6fa352cd1a3adddf0ec10b/docs/research/wiiu-as-frame-ctrl.md",

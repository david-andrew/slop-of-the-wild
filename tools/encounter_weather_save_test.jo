# Run: tools/encounter_weather_save_check.sh (both phases); direct usage: sloppy/bin/sloppy tools/encounter_weather_save_test.jo write|read fixture-directory.
# Two independent processes, production save codec/restore and enemy simulation.
use '../game/save.jo'
use '../game/player.jo'
use '../game/env.jo'
use '../game/gfx.jo'
use '../game/items.jo'
use '../game/worldgen.jo'
use '../game/enemies.jo'

weather_signature = () -> str:
    "{env.hour:.9}|{env.day}|{env.weather}|{env.weather_t:.9}|{env.clouds:.9}|{env.rain:.9}|{env.wet:.9}|{env.storm_k:.9}|{env.gust:.9}|{env.wind}|{env.lightning:.9}|{env.storm_time:.9}|{env.bolt_wait:.9}|{env.dark:.9}|{env.zenith}|{env.horizon}|{env.sun_color}|{env.sky_amb}|{env.ground_amb}|{env.haze}|{env.density:.9}|{env.sun_dir}|{env.moon_dir}|{env.light_dir}|{env.night:.9}|{env.valley_mist:.9}"

run = ():
    if args().len() != 3:
        print("Usage: tools/encounter_weather_save_check.sh runs both phases; direct fixture: sloppy/bin/sloppy tools/encounter_weather_save_test.jo write|read fixture-directory")
        exit(if args().len() == 1: 0 else: 2)
    writing = args()[1] == "write"
    if not writing and args()[1] != "read":
        print("Usage: tools/encounter_weather_save_check.sh; fixture mode must be write or read")
        exit(2)
    path = args()[2]
    items_init()
    worldgen_load()
    worldgen_finish()
    # Reordering live placement must not change which encounter stays cleared.
    if not writing: spawn_enemy(.blue_bokoblin, vec3(-970, 230, 1800), "boko_club")
    defeated = spawn_enemy(.bokoblin, vec3(-980, 230, 1800), "boko_club")
    if writing: spawn_enemy(.blue_bokoblin, vec3(-970, 230, 1800), "boko_club")
    survivor = spawn_enemy(.bokoblin, vec3(-982, 230, 1800), "boko_club")
    pl.pos = vec3(-980, 230, 1800)
    if writing:
        enemy_damage(enemies[defeated], 13.0, enemies[defeated].pos)
        assert(enemies[defeated].hp == 0.0 and enemies[defeated].state == .dead)
        s = save_capture()
        s.activated = fill(false, 4)
        s.completed = fill(false, 4)
        s.pos = pl.pos
        s.awake = true
        s.progress.title_done = true
        assert(s.defeated.len() == 1 and save_write(path + "/encounter", s))
        enemies[defeated].state = .gone
        enemies[defeated].respawn_t = 231.5
        s = save_capture()
        s.activated = fill(false, 4)
        s.completed = fill(false, 4)
        s.pos = pl.pos
        assert(save_write(path + "/timer", s))
    else:
        assert(enemies[defeated].hp == 13.0 and enemies[defeated].state == .idle)
        s = save_decode(read_file(path + "/encounter")!)!
        save_apply(s)
        assert(enemies[defeated].hp == 0.0 and enemies[defeated].state == .gone and enemies[defeated].respawn_t == 600.0)
        assert(enemies[survivor].hp == 13.0 and enemies[survivor].state != .gone)
        enemies[defeated].pos.x -= 150.0 # Death location does not define whether the camp is away.
        loop i in [0..120): enemies_update(1.0 / 60.0, false)
        assert(enemies[defeated].state == .gone and enemies[defeated].respawn_t == 600.0, "remaining near camp cannot respawn it")
        s = save_decode(read_file(path + "/timer")!)!
        save_apply(s)
        assert(enemies[defeated].respawn_t == 231.5)
        pl.pos.x -= 300.0
        enemies_update(1.0, false)
        assert(enemies[defeated].state == .gone and enemies[defeated].respawn_t == 230.5, "time away ticks even outside AI range")
        enemies[defeated].respawn_t = 0.01
        pl.pos = enemies[defeated].home
        enemies_update(1.0, false)
        assert(enemies[defeated].state == .gone, "nearly expired timer cannot respawn beside Link")
        pl.pos.x -= 300.0
        enemies_update(0.02, false)
        assert(enemies[defeated].state == .idle and enemies[defeated].hp == 13.0, "only elapsed time away revives camp")
        # Legacy saves, malformed and duplicate records.
        raw = read_file(path + "/encounter")!
        record = "defeated=0,-980.000000,230.000000,1800.000000,600.000000\n"
        assert(contains(raw, record))
        assert(save_decode(replace(raw, record, "")) != none)
        assert(save_decode(replace(raw, record, record + record)) == none)
        loop bad in ["0,-980,230,1800,-1", "0,-980,230,1800,601", "nan,0,0,0,1", "7,0,0,0,1", "2,0,0,0,1", "0,0,0,0"]:
            assert(save_decode(replace(raw, record, "defeated=" + bad + "\n")) == none)
    loop phase in [0..5):
        file = path + "/weather-{phase}"
        if writing:
            env = Env(hour = 11.25, day = 4, weather = (if phase == 2: Weather.clear else: Weather.storm), weather_t = (if phase == 4: 0.0 else: 73.5),
                clouds = 0.9375, rain = 0.875, wet = 0.75, storm_k = (if phase == 0: 1.0 else: 0.625),
                storm_time = 17.375, bolt_wait = (if phase == 1: 0.005 else: 13.25), gust = 2.8, wind = vec2(0.75, 0.25), lightning = (if phase == 3: 0.25 else: 0.0))
            env_update(0.0, false)
            s = save_capture()
            s.activated = fill(false, 4)
            s.completed = fill(false, 4)
            s.pos = vec3(-980, 230, 1800)
            s.awake = true
            assert(save_write(file, s))
            assert(write_file(file + ".light", weather_signature()))
            # A different game RNG must not affect the weather/strike continuation.
            seed_random(31)
            env_update(1.0 / 60.0, false)
            assert(write_file(file + ".next", weather_signature()))
        else:
            assert(env.storm_k != 1.0 or phase != 0, "fresh process has no inherited storm state")
            s = save_decode(read_file(file)!)!
            save_apply(s)
            assert(weather_signature() == read_file(file + ".light")!, "first restored atmosphere exactly matches uninterrupted lighting")
            seed_random(911)
            env_update(1.0 / 60.0, false)
            assert(weather_signature() == read_file(file + ".next")!, "first resumed simulation frame matches uninterrupted storm/clearing/flash")
            raw = read_file(file)!
            rng_record = [loop line in split(raw, "\n"): if starts_with(line, "weather_rng="): line][0] + "\n"
            assert(save_decode(replace(raw, rng_record, rng_record + rng_record)) == none)
            assert(save_decode(replace(raw, rng_record, "weather_rng=0,0,0,0\n")) == none)
            assert(save_decode(replace(raw, rng_record, "weather_rng=1,2,3\n")) == none)
            assert(save_decode(replace(raw, rng_record, "weather_rng=nan,2,3,4\n")) == none)
            record = "weather_transition={s.storm_k:.9},{s.gust:.9},{s.wind.x:.9},{s.wind.y:.9},{s.lightning:.9}\n"
            assert(save_decode(replace(raw, record, record + record)) == none)
            assert(save_decode(replace(raw, record, "")) != none, "legacy weather saves migrate")
            loop bad in ["nan,1,1,1,0", "1.1,1,1,1,0", "0,4.1,1,1,0", "0,1,1,1,1.1", "0,1,1,1"]:
                assert(save_decode(replace(raw, record, "weather_transition=" + bad + "\n")) == none)
            clock = "storm_clock={s.storm_time:.9},{s.bolt_wait:.9}\n"
            assert(save_decode(replace(raw, clock, "")) != none, "legacy saves initialize the storm clock")
            assert(save_decode(replace(raw, clock, clock + clock)) == none)
            assert(save_decode(replace(raw, clock, "storm_clock=6283.185307180,12\n")) != none,"rounded end-of-cycle saves wrap continuously")
            loop bad in ["nan,12", "0,21", "-1,12", "6284,12", "0,-2", "0,-0.5", "0", "0,0,0"]:
                assert(save_decode(replace(raw, clock, "storm_clock=" + bad + "\n")) == none)
            env = Env()
    mode = if writing: "writer" else: "reader"
    print("{mode}: encounter defeat/remaining respawn and five exact weather/first-frame resumes PASS")
run()

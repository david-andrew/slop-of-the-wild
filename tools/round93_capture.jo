build:
    opt = release
use '../game/main.jo'
use 'performance_output.jo'
use '../game/env.jo'
use '../game/player.jo'
use '../game/camera.jo'
from '../game/chars.jo' import __hero_capture, character_storm_fill
from '../game/shadows.jo' import shadow_frame

capture_frames = [loop f in split(env("R93_FRAMES") ?? "300", ","): to_int(f) ?? 300]
capture_draw = ():
    saved_camera=cam
    if env("R93_COMBAT_CASTLE") != none:
        # Draw-only inspection orbit. Production combat/input/AI still advance
        # with their normal camera, restored before the next simulation step.
        toward=normalize(vec3(-900-pl.pos.x,0,-1000-pl.pos.z))
        cam.override=true
        cam.blend=1.0
        cam.o_pos=pl.pos-toward*6.5+vec3(0,3.2,0)
        cam.o_target=pl.pos+toward*5.0+vec3(0,2.0,0)
        cam.o_fov=54.0
    draw()
    if not capture_frames.contains(frame_number()):
        cam=saved_camera
        return
    prefix = (env("R93_OUT") ?? "build/round93") + "/frame-{frame_number()}"
    assert(save_png(screenshot(), prefix+".png"))
    if env("R93_MASK") != none:
        schedule = shadow_frame
        loop mode in ["hidden", "mask"]:
            shadow_frame = schedule-1
            __hero_capture = mode
            draw()
            assert(save_png(screenshot(),prefix+"-"+mode+".png"))
        __hero_capture = ""
    if env("R93_TIMES") != none:
        actual=__frame_count
        loop tick in split(env("R93_TIMES")!,","):
            # Draw-only time samples: keep the title camera, simulation and
            # lighting fixed while exercising arbitrary real smoke phases.
            __frame_count=to_int(tick)!
            draw()
            assert(save_png(screenshot(),(env("R93_OUT")!)+"/sample-"+tick+".png"))
        __frame_count=actual
    cam=saved_camera
    print("round93 frame={frame_number()} hp={pl.hp} storm_fill={character_storm_fill(pl.pos,true)} wet={env.wet} sky={env.sky_amb} sun={env.sun_color}")
main = ():
    weather_rng_restore(rng(31))
    performance_output_run(update,capture_draw)

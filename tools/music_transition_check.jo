use '../game/audio_mix.jo'
use '../game/frametime.jo'
# Production sequencer + software mixer. No window or playback device.
use '../game/music.jo'
use '../game/player.jo'
use '../game/combat.jo'
use '../game/enemies.jo'
from '../game/music.jo' import __was_combat, __alert_t, __score_play
__audio_state = 2
piano_init()
master_volume(0.8)
sr = MIX_RATE
out = if args().len() > 1: args()[1] else: "build/music-transition-check"
mkdir(out)
__wav = (path: str, mixb: mut f32[], mixed: bool = false):
    if not mixed: audio_peak_guard(mixb)
    peak: f32 = 0.0
    energy = 0.0
    clipped = 0
    quiet = 0
    windows = 0
    window_energy = 0.0
    window_samples = sr / 10 * 2
    loop i in 0.. and v in mixb:
        peak = max(peak, abs(v))
        energy += f64(v) * f64(v)
        window_energy += f64(v) * f64(v)
        if abs(v) >= 1.0: clipped += 1
        if (i + 1) % window_samples == 0:
            if window_energy / f64(window_samples) < 0.000001: quiet += 1
            windows += 1
            window_energy = 0.0
    n = mixb.len() / 2
    b: u8[]
    w32 = (v: int):
        loop k in [0..4): b.push(u8((v >> (8 * k)) & 255))
    w16 = (v: int):
        loop k in [0..2): b.push(u8((v >> (8 * k)) & 255))
    loop c in "RIFF": b.push(c)
    w32(36 + n * 4)
    loop c in "WAVEfmt ": b.push(c)
    w32(16)
    w16(1)
    w16(2)
    w32(sr)
    w32(sr * 4)
    w16(4)
    w16(16)
    loop c in "data": b.push(c)
    w32(n * 4)
    g = 1.0                    # fixed export gain, so comparisons retain gameplay balance
    print("levels {path}: peak {peak:.6} RMS {sqrt(energy / f64(mixb.len())):.6} ({20.0 * log10(max(sqrt(energy / f64(mixb.len())), 0.000000001)):.2} dBFS) silence {100.0 * f64(quiet) / f64(max(windows, 1)):.1}% (-60dBFS/100ms) gain {g:.6} clipped {clipped}")
    loop v in mixb:
        q = int(clamp(f64(v) * g, -1.0, 1.0) * 32767.0)
        w16(q & 0xFFFF)
    assert(clipped == 0 and peak < 0.9, "music export must retain unclipped headroom")
    assert(write_bytes(path, b), "WAV export failed; create the output parent directory first")


# Verify game-owned automation, including sub-frame blocks and interrupted fades.
loop block in [127, 400, 800, 1600]:
    stop_all()
    score_voices.clear()
    seq.volume = 1.0
    music_duck = 1.0
    id = __score_play(Sound(fill(f32(0.2), sr * 2)), 1.0, 0.0, 1.0, true)
    __mix(block)
    previous = __mix_buf[__mix_buf.len()-1]
    max_step: f32 = 0.0
    loop iteration in [0..8):
        score_set_volume(id, if iteration < 3: 0.1 else: 0.7)
        __mix(block)
        loop sample in __mix_buf:
            max_step = max(max_step, abs(sample-previous))
            previous = sample
    assert(max_step < 0.0002, "score ramp remains continuous at variable block sizes and retargets")
    score_set_volume(id, 0.0)
    __mix(2000)
    assert(__mix_buf[3999] == 0.0, "release reaches actual digital silence")
    print("PASS game score ramp: {block}-sample blocks, max sample step {max_step:.7}")
loop sound in [drum_lo,drum_hi,combat_entry]:
    assert(abs(sound.samples[0]) < 0.000001 and abs(sound.samples[sound.samples.len()-1]) < 0.000001, "combat percussion starts and ends at zero")

loop escape in [false, true]:
    stop_all()
    score_voices.clear()
    laters.clear()
    enemies = [Enemy(kind = .bokoblin, pos = vec3(-680,235,1800), home = vec3(-680,235,1800), state = .idle)]
    fight = Fight()
    pl = Player(pos = vec3(-700,235,1800))
    seq = Seq(mood = .field_day, want = .field_day, volume = 1.0, rest = 30.0)
    seq.events = [Ev(0.1, 74, 0.35), Ev(1.7, 81, 0.3), Ev(3.0, 78, 0.38), Ev(5.0, 76, 0.3), Ev(7.3, 74, 0.3)]
    music_duck = 1.0
    music_duck_floor = 1.0
    music_duck_hold = 0.0
    __was_combat = false
    __alert_t = -100.0
    seed_random(7)
    name = if escape: "escape" else: "victory"
    mixb: f32[]
    trace = "seconds,mood,tier,volume,notes,voices,boundary_delta,boundary_db\n"
    switch_t = -1.0
    resumed_t = -1.0
    rest_seconds = 0.0
    changed = 0
    heard_alert = false
    heard_engaged = false
    silence_samples = 0
    max_delta = 0.0
    max_db = 0.0
    cpu_ms: f64[]
    loop frame in [0..2100):
        t = f64(frame) / 60.0
        fighting = frame >= 181 and frame < 919
        music_mood(if fighting: Mood.combat else: Mood.field_day)
        if frame == 181: alert_stab()
        fight.act = if frame >= 427 and fighting: Act.swing else: Act.idle
        enemies[0].state = if fighting: EState.chase else: (if escape: EState.idle else: EState.dead)
        if frame == 919 and escape: pl.pos.x -= 60.0
        # Main's nearby-foes flag is false after both a kill and a distance
        # escape. The production watcher must use remembered living pursuers.
        combat_watch(in_combat(), fighting)
        if frame == 919:
            assert((laters.len() == 0) == escape, "escape must not play a false victory stinger")
        # Compare gain changes at the SAME source sample: isolate discontinuity
        # introduced by a state transition, rather than ordinary piano oscillation.
        before = vec2(0,0)
        loop v in __voices:
            ip = int(v.pos)
            if ip * 2 + 3 >= v.sound.samples.len(): continue
            f = f32(v.pos - f64(ip))
            a = vec2(v.sound.samples[ip*2],v.sound.samples[ip*2+1])
            b = vec2(v.sound.samples[ip*2+2],v.sound.samples[ip*2+3])
            before += mix(a,b,f) * v.volume * vec2(1.0-max(v.pan,0.0),1.0+min(v.pan,0.0)) * 0.8
        old = seq.mood
        notes = music_note_count
        cpu_start = frame_thread_time()
        music_update(1.0 / 60.0)
        cpu_ms.push((frame_thread_time() - cpu_start) * 1000.0)
        jingles_update(1.0 / 60.0)
        if old == .combat and seq.mood == .field_day:
            switch_t = t
            rest_seconds = seq.rest
        if switch_t >= 0.0 and music_note_count > notes and resumed_t < 0.0:
            resumed_t = t
            assert(t - switch_t >= 6.98, "field leaves seven seconds after combat fade")
        after = vec2(0,0)
        loop v in __voices:
            ip = int(v.pos)
            if ip * 2 + 3 >= v.sound.samples.len(): continue
            f = f32(v.pos - f64(ip))
            a = vec2(v.sound.samples[ip*2],v.sound.samples[ip*2+1])
            b = vec2(v.sound.samples[ip*2+2],v.sound.samples[ip*2+3])
            after += mix(a,b,f) * v.volume * vec2(1.0-max(v.pan,0.0),1.0+min(v.pan,0.0)) * 0.8
        delta = f64(length(after-before))
        db = if length(before) > 0.003 and length(after) > 0.003: abs(20.0*log10(f64(length(after)/length(before)))) else: 0.0
        max_delta = max(max_delta,delta)
        max_db = max(max_db,db)
        if old != seq.mood: changed += 1
        if seq.mood == .combat and seq.combat_tier == .alert: heard_alert = true
        if seq.mood == .combat and seq.combat_tier == .engaged: heard_engaged = true
        __mix(sr / 60)
        # The late post-combat gap is truly silent score, with no frozen tail.
        if switch_t >= 0.0 and t > switch_t + rest_seconds - 1.4 and t < switch_t + rest_seconds - 0.1:
            loop v in __mix_buf:
                assert(abs(v) < 0.0001, "post-combat breath must be quiet before field returns")
                silence_samples += 1
        loop v in __mix_buf: mixb.push(v)
        trace += "{t:.6},{seq.mood},{seq.combat_tier},{seq.volume:.6},{music_note_count},{__voices.len()},{delta:.8},{db:.5}\n"
    assert(heard_alert and heard_engaged and silence_samples > sr, "both combat tiers and post-combat silence exercised")
    assert(changed == 2 and resumed_t > 0.0, "field -> alert -> engaged -> field completes")
    __wav("{out}/{name}.wav",mixb,true)
    assert(write_file("{out}/{name}.csv",trace))
    print("{name}: max boundary delta {max_delta:.6}, gain discontinuity {max_db:.3} dB; field resumes {resumed_t-switch_t:.3}s after handoff")

    assert(max_delta < 0.0001, "score transitions cannot cut a sample or introduce an onset click")
    assert(max_db < 3.0, "state handoffs cannot jump an audible existing signal by 3 dB")

    sort(cpu_ms)
    p99 = cpu_ms[int(ceil(f64(cpu_ms.len()) * 0.99)) - 1]
    print("PASS music_update CPU {name}: p99 {p99:.6} ms, worst {cpu_ms[cpu_ms.len()-1]:.6} ms")
    assert(p99 < 1.0, "music_update p99 CPU must stay below 1 ms through combat entry/exit")

# Full-size notes at fractional pitches cross many window wraps. Compare the
# production mixer against immutable source interpolation, including its largest
# native block, and require note allocation to remain independent of tail length.
loop pitch in [0.890898718, 1.0, 1.122462048]:
    stop_all()
    score_voices.clear()
    seq.volume = 1.0
    music_duck = 1.0
    source = Sound([loop i in [0..sr*4*2): f32(sin(f64(i/2)*0.017)*0.05)])
    id = __score_play(source, 0.7, 0.0, pitch, true)
    assert(__voices[0].sound.samples.len() < sr/2, "new notes allocate only a bounded window")
    position = 0.0
    error = 0.0
    loop iteration in [0..18):
        score_set_volume(id, 0.7)
        block = if iteration % 3 == 0: 8192 else: 800
        __mix(block)
        loop i in [0..block):
            ip = int(position)
            fraction = f32(position-f64(ip))
            sample = mix(source.samples[ip*2],source.samples[ip*2+2],fraction) * f32(0.7) * f32(0.8)
            error = max(error,abs(f64(__mix_buf[i*2]-sample)))
            position += pitch
    assert(error < 0.000001, "rolling score windows preserve pitched samples across wraps")
    print("PASS score source/ring equivalence pitch {pitch:.6}: max error {error:.9}")

# Mood handoffs and repeated cue attacks/recovery while long piano tails overlap.
stop_all()
score_voices.clear()
seq = Seq(mood = .forest, want = .forest, volume = 1.0)
pl = Player()
fight = Fight()
enemies.clear()
music_duck = 1.0
music_duck_floor = 1.0
music_duck_hold = 0.0
cpu_ms: f64[]
loop frame in [0..1800):
    if frame % 300 == 0: music_mood([Mood.forest,Mood.field_night,Mood.field_rain,Mood.snow,Mood.ruins,Mood.forest][frame/300])
    if frame % 120 == 0:
        loop midi in [48,55,62,69]: piano_play(midi,0.48,0.0,1.0,false,true)
    start = frame_thread_time()
    music_update(1.0/60.0)
    if frame % 90 == 30: music_cue_duck()
    cpu_ms.push((frame_thread_time()-start)*1000.0)
    __mix(sr/60)
    loop sample in __mix_buf: assert(abs(sample) < 0.9, "overlapping mood and duck fades retain headroom")
sort(cpu_ms)
p99 = cpu_ms[int(ceil(f64(cpu_ms.len())*0.99))-1]
print("PASS music_update plus duck CPU mood changes: p99 {p99:.6} ms, worst {cpu_ms[cpu_ms.len()-1]:.6} ms")
assert(p99 < 1.0,"music_update and ducking p99 CPU must stay below 1 ms through mood handoffs")

# Tiny targets, unfinished releases and largest native blocks used to expose
# stale guard/suffix samples multiplied by an inverse near-zero gain.
loop pitch in [0.890898718, 1.0, 1.122462048]:
    stop_all()
    score_voices.clear()
    seq.volume = 1.0
    music_duck = 1.0
    id = __score_play(Sound(fill(f32(0.02), sr * 40)), 1.0, 0.0, pitch, true)
    peak: f32 = 0.0
    loop target in [0.000000000001, 0.7, 0.0, 0.0000000001, 0.6, -1.0, 50.0, 1.0]:
        score_set_volume(id, target)
        __mix(127)
        score_set_volume(id, target * 0.9)
        __mix(8192)
        loop sample in __mix_buf: peak = max(peak, abs(sample))
        assert(abs(f64(__mix_buf[16383]) - 0.02 * clamp(target * 0.9, 0.0, 8.0) * 0.8) < 0.000001, "entire ring suffix and wrap guard follow the bounded target")
    assert(peak <= 0.128001, "tiny/negative/excessive targets cannot amplify ring samples")
    print("PASS bounded score ring pitch {pitch:.6}: peak {peak:.6}, tiny/interrupted targets and 8192-frame wraps")

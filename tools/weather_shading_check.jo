# Production cloud-aware projection, standing wade foam and visible Guardian endpoints.
# No GPU: checks values passed to the render paths and geometric clipping.
use '../game/shadows.jo'
use '../game/env.jo'
use '../game/gfx.jo'
use '../game/terrain.jo'
use '../game/shade.jo'
use '../game/water_render.jo'
use '../game/water.jo'
use '../game/fx.jo'
use '../game/physics.jo'
use '../game/player.jo'
use '../game/charshade.jo'
from '../game/chars.jo' import hero_storm_fill, character_weather_look
from '../game/water_render.jo' import __wader

check_weather_shading = ():
    vp = orthographic(-20.0, 20.0, -20.0, 20.0, 1.0, 1040.0) * look_at(vec3(100, 500, 100), vec3(0, 0, 0), vec3(0, 1, 0))
    loop cover in [0.42, 0.6, 0.74, 0.85, 0.95]:
        projection = shadow_weather_projection(vp, cover)
        loop point in [vec4(0, 0, 0, 1), vec4(10, 4, -15, 1), vec4(-20, 90, 200, 1)]:
            old = vp * point
            new = projection * point
            assert(length(old.xyz / old.w - new.xyz / new.w) < 0.00001, "weather must preserve shadow UV/depth")
            assert(abs(new.w - f32(1.0 + cover)) < 0.00001)
    assert(shadow_direct(0.42) == 1.0 and shadow_softness(0.42) == 1.0)
    assert(shadow_direct(0.74) < 0.3 and shadow_softness(0.74) > 4.0)
    assert(shadow_direct(0.85) == 0.0 and shadow_direct(0.95) == 0.0)
    assert(lightning_pulse(1.0) == 1.0 and lightning_pulse(0.963333) > 0.92, "strike frame must not start in the dim flicker")
    assert(lightning_pulse(0.0) == 0.0)
    particles.clear()
    emit_bolt(vec3(0, 10, 0), 0.22, 0.85, vec4(1, 1, 1, 1))
    assert(particles.len() == 1)
    fraction = particles[0].age / particles[0].life
    assert(clamp((1.0 - fraction) * 3.0, 0.0, 1.0) * clamp(fraction * 8.0, 0.0, 1.0) == 1.0, "bolt is fully opaque on emission, not one frame late")
    particles[0].age = 0.0
    particles = fill(particles[0], 6001)
    emit_bolt(vec3(0, 20, 0), 0.22, 0.85, vec4(1, 1, 1, 1))
    assert(particles.len() == 6001 and particles[6000].age == 0.0, "full pool rejects a bolt without changing an existing particle")
    particles.clear()
    # Solve the production electric profile's half-bright shoulder, then
    # project its width at the largest field FOV. Tall/near bolts must keep
    # the same six-pixel core as far horizontal strikes.
    lo = 0.0
    hi = 1.0
    loop k in [0..32):
        edge = (lo + hi) * 0.5
        profile = pow(f64(smoothstep(0.5, 0.0, f32(edge * 0.5))), 1.3)
        if profile >= 0.5: lo = edge
        else: hi = edge
    eye = vec3(0, 2, -5)
    minimum = 1000.0
    loop point in [vec3(0, 2, 1), vec3(0, 0, 70), vec3(0, 380, 70), vec3(300, 180, 500)]:
        range = f64(length(point - eye))
        pixels = lightning_halfwidth(point, eye) * 1080.0 / (tan(27.0 * PI / 180.0) * range) * lo
        minimum = min(minimum, pixels)
        assert(pixels >= 6.0, "trunk lightning core must exceed six pixels at 1080p, including its high branches")
    print("PASS lightning trunk projection: minimum {minimum:.3} px half-bright core at 1080p/54 degrees across near, far and high segments")
    previous = shadow_direct(0.42)
    loop i in [43..96):
        next = shadow_direct(f32(i) / 100.0)
        assert(next <= previous and previous - next < 0.05, "weather shadow strength changes continuously")
        previous = next
    loop k in [0..20):
        phase = f32(k) / 20.0
        motion = vec4(0, 0, 0, phase / 1.6)
        radius = 0.17 + 0.14 + phase * 0.65
        foam = water_wade_foam(vec2(radius, 0), motion, 0, 1)
        assert(foam >= (1.0 - phase) * 0.025, "small leg-contact rings survive zero velocity")
        assert(water_wade_foam(vec2(radius, 0), motion, 0, 0) == 0.0, "dry feet do not create foam")
        assert(water_wade_foam(vec2(3, 0), motion, 0, 1) == 0.0, "foam stays local to the feet")
        assert(water_wade_foam(vec2(0.266, -0.4), vec4(0, 3, 0, motion.w), 0, 1) > 0.20, "moving legs leave a V through every stroke phase")
    water_grid_set(fill(f32(1), 16), 4, -2.0, -2.0, 1.0)
    water_swimmer_update(1.0 / 60.0, vec3(0, 0.8, 0), vec3(0, 0, 0), false, -10000.0)
    assert(__wader.w > 0.99, "grounded wading queries the water map without swimming state")
    water_swimmer_update(1.0, vec3(0, 2, 0), vec3(0, 0, 0), false, -10000.0)
    assert(__wader.w == 0.0)
    colliders.clear()
    use_terrain = false
    pl = Player(pos = vec3(0, 0, 0))
    origin = vec3(0, 1, -10)
    target = vec3(0, 1, 2)
    hit = guardian_beam_end(origin, target)
    assert(abs(hit.z + 0.48) < 0.001, "tracking line stops at near side of Link")
    pl.pos = vec3(4, 0, 0)
    assert(length(guardian_beam_end(origin, target) - target) < 0.001, "miss ends at stored target")
    add_box(vec3(0, 1, -3), vec3(2, 2, 0.2), 0.0, false, .stone)
    assert(guardian_beam_end(origin, target).z < -3.1, "displayed beam stops at cover")
    # Hero fill darkens open storm meadows and lifts forest shade through both
    # weather/interior boundaries; crossing a material cell remains continuous.
    hf.n = 3
    hf.cell = 1.0
    hf.x0 = 0.0
    hf.z0 = 0.0
    hf.mat = fill(u8(0), 3 * 3 * 4)
    loop z in [0..3):
        loop x in [0..3): hf.mat[(z * 3 + x) * 4] = if x == 0: 0 else: 255
    env.storm_k = 1.0
    env.rain = 1.0
    env.indoor = 0.0
    assert(hero_storm_fill(vec3(0, 0, 1)) == 0.5, "open storm ground retains a dark hero silhouette")
    assert(abs(hero_storm_fill(vec3(1, 0, 1)) - 1.3) < 0.00001, "closed forest gets restrained fill")
    last_fill = 0.5
    loop k in [0..201):
        fill = hero_storm_fill(v3(f64(k) / 100.0, 0.0, 1.0))
        assert(fill >= last_fill and fill - last_fill < 0.031, "forest fill crosses cells continuously")
        last_fill = fill
    # Both the dark meadow and light canopy converge to normal fill indoors,
    # then return continuously as storm strength rises.
    loop pos in [vec3(0, 0, 1), vec3(1, 0, 1)]:
        env.indoor = 0.0
        env.storm_k = 1.0
        storm_fill = hero_storm_fill(pos)
        previous_fill = storm_fill
        loop k in [0..101):
            env.indoor = f64(k) / 200.0
            current_fill = hero_storm_fill(pos)
            delta = current_fill - previous_fill
            assert(delta * (storm_fill - 1.0) <= 0.0000001 and abs(delta) < 0.008, "interior fill fades smoothly toward normal")
            previous_fill = current_fill
        assert(hero_storm_fill(pos) == 1.0, "interiors retain normal fill")
        env.indoor = 0.0
        env.storm_k = 0.0
        assert(hero_storm_fill(pos) == 1.0, "rain/cloud/clear retain normal fill")
        previous_fill = 1.0
        loop k in [0..101):
            env.storm_k = f64(k) / 100.0
            current_fill = hero_storm_fill(pos)
            delta = current_fill - previous_fill
            assert(delta * (storm_fill - 1.0) >= -0.0000001 and abs(delta) < 0.0051, "weather fill ramps smoothly toward its habitat value")
            previous_fill = current_fill
        assert(abs(previous_fill - storm_fill) < 0.00001, "weather ramp reaches the full storm habitat value")
    env.rain = 0.0
    assert(hero_storm_fill(vec3(1, 0, 1)) == 1.0, "dry sky receives no storm fill")
    env.rain = 1.0
    env.storm_k = 1.0
    env.indoor = 0.0
    # Exercise the exact parameters sent by the shared production draw path.
    ordinary = CharParams(creature = 0.85, fill = 1.45, rim = 2.2)
    meadow = character_weather_look(vec3(0, 0, 1), ordinary)
    assert(meadow.fill == ordinary.fill and meadow.rim == ordinary.rim, "hero meadow darkening must not leak into NPC/creature draw parameters")
    forest = character_weather_look(vec3(1, 0, 1), ordinary)
    assert(abs(forest.fill - 1.81) < 0.00001 and abs(forest.rim - 2.74) < 0.00001, "NPC/creature canopy lift retains its previous fill and rim")
    hero = CharParams(hero_material = 1.0, fill = hero_storm_fill(vec3(0, 0, 1)))
    hero_look = character_weather_look(vec3(0, 0, 1), hero)
    assert(hero_look.fill < hero.fill and hero_look.rim < hero.rim, "hero retains its accepted open-storm silhouette adjustment")
    loop k in [0..201):
        pos = v3(f64(k) / 100.0, 0.0, 1.0)
        look = character_weather_look(pos, ordinary)
        assert(look.fill >= ordinary.fill and look.rim >= ordinary.rim, "shared figure fill never inherits the hero's negative meadow adjustment")
    env.indoor = 0.5
    indoor = character_weather_look(vec3(1, 0, 1), ordinary)
    assert(indoor.fill == ordinary.fill and indoor.rim == ordinary.rim, "shared figure canopy lift fades indoors")
    env.indoor = 0.0
    env.rain = 1.0
    hf.mat.clear()
    assert(hero_storm_fill(vec3(1, 0, 1)) == 1.0, "no material map receives no fill")
    print("PASS hero-only storm fill and shared creature/NPC isolation: bounded 0.5-1.3, continuous forest/weather/interior boundaries")
    print("PASS weather shading: weather projection, continuous shadow strength, instant bolt opacity/pool cap, stationary/moving/dry wading, Old Sentinel body/target/cover endpoints")
check_weather_shading()

# Sky/ambient separation. CPU only, production functions.
use '../game/env.jo'
use '../game/shade.jo'
use '../game/sky.jo'

loop hour in [18.4,18.6,18.9]:
    env=Env(hour=hour,time_scale=0,weather_t=1e9)
    env_update(0,false)
    u=SkyU(zenith=env.zenith,horizon=env.horizon,sun_dir=env.sun_dir,sun_color=env.sun_color,haze=env.haze)
    top=sky_color(normalize(vec3(0,0.8,-0.6)),u)
    horizon=sky_color(normalize(vec3(0,0.015,-1)),u)
    assert(top.z>top.x*1.25 and top.y>top.x,"evening overhead stays blue, not sepia/mauve")
    assert(horizon.x>horizon.y and horizon.y>horizon.z,"evening horizon stays amber/peach")
print("PASS golden gradient: blue overhead and amber horizon")

loop hour in [7.0,11.0]:
    env=Env(hour=hour,time_scale=0,weather=.storm,weather_t=1e9,clouds=0.95,rain=1,wet=1,storm_k=1)
    env_update(0,false)
    assert(luma(env.sky_amb)>0.55 and luma(env.ground_amb)>0.36,"daytime storm supplies forest diffuse floor")
    assert(max(env.sky_amb.x,env.sky_amb.z)/env.sky_amb.y<1.12,"storm bounce stays neutral")
    assert(length(env.sun_color)<0.00001,"closed storm retains no direct sun patch")
print("PASS storm: readable neutral diffuse floor without direct sunlight")

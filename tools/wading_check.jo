# Production shallow-water feedback: actual surface queries, entry/step cadence,
# world-anchored rings, V geometry and cosmetic RNG isolation. No render.
use '../game/water_render.jo'
use '../game/water.jo'
use '../game/fx.jo'
use '../game/terrain.jo'
from '../game/water_render.jo' import __wader, __was_wading, __was_swimming, __wade_ring_t

wading_check = ():
    hf = Heightfield(n=8,cell=1.0,x0=-4.0,z0=-4.0,h=fill(f32(0),64))
    water_grid_set(fill(f32(1), 64), 8, -4.0, -4.0, 1.0)
    __was_wading = false
    __was_swimming = false
    __wade_ring_t = 0.0
    water_swimmer_update(1.0 / 60.0, vec3(0, 1.1, 0), vec3(0, 0, 0), false, -10000.0)
    assert(not water_wade_enter and not water_wade_ring, "dry feet have no entry or footfall")
    water_swimmer_update(1.0 / 60.0, vec3(0, 0.8, 0), vec3(0, 0, 2), false, -10000.0)
    assert(water_wade_enter and water_wade_ring and water_wade_level() == 1.0)
    particles.clear()
    seed_random(911)
    expected = random()
    seed_random(911)
    fx_wade(vec3(0, 0.8, 0), water_wade_level(), vec3(0, 0, 2), true)
    assert(random() == expected, "wading must not change gameplay/weather RNG")
    assert(particles.len() == 12 and particles[0].kind == .ring and particles[1].kind == .ring)
    assert(particles[0].pos.y > 1.0 and particles[0].pos.y < 1.06 and particles[0].size < 0.8, "small rings sit at the queried surface")
    assert(abs(particles[0].pos.x - particles[1].pos.x) > 0.33 and abs(particles[0].pos.y - particles[1].pos.y) < 0.001, "entry rings start at separate leg contacts on one surface")
    assert(particles[0].water_bound and particles[1].water_bound, "footfall rings carry shore rejection")
    assert(wade_ring_wet(vec3(0,1.045,0),0.5), "ring fits entirely on the same water surface")
    assert(not wade_ring_wet(vec3(3,1.045,0),1.4), "expanding ring cannot cross the dry grid edge")
    assert(not wade_ring_wet(vec3(0,2.045,0),0.5), "ring cannot float above another surface")
    hf.h=fill(f32(1.1),64)
    assert(not wade_ring_wet(vec3(0,1.045,0),0.5), "stored water underneath dry grass is rejected")
    hf.h=fill(f32(0),64)
    anchor = particles[0].pos
    loop p in particles:
        if p.kind == .splash: assert(p.vel.y >= 0.68 and p.vel.y <= 0.92 and p.grav == 6.0)
    water_swimmer_update(0.1, vec3(0, 0.8, 0.2), vec3(0, 0, 2), false, -10000.0)
    assert(not water_wade_enter and not water_wade_ring, "one splash on entry; bounded cadence")
    fx_update(0.1)
    assert(particles[0].pos == anchor, "rings remain at the surface contact as Link moves")
    water_swimmer_update(0.2, vec3(0, 0.8, 0.6), vec3(0, 0, 2), false, -10000.0)
    assert(water_wade_ring and not water_wade_enter)
    water_swimmer_update(1.0, vec3(0, 0.8, 0.6), vec3(0, 0, 0), false, -10000.0)
    assert(not water_wade_ring, "standing retains shader rings without spawning footsteps")
    water_swimmer_update(0.1, vec3(0, -0.5, 0.6), vec3(0, 0, 2), true, 1.0)
    assert(not water_wade_enter and not water_wade_ring, "swimming owns deep-water feedback")
    water_swimmer_update(0.1, vec3(0, 0.8, 0.6), vec3(0, 0, 2), false, -10000.0)
    assert(not water_wade_enter, "leaving swimming cannot repeat the arrival splash")
    motion = vec4(0, 3, 0, 0.37)
    arm = water_wade_foam(vec2(0.266, -0.4), motion, 0, 1)
    inside = water_wade_foam(vec2(0, -0.4), motion, 0, 1)
    assert(arm > inside + 0.18, "V opens behind both legs")
    assert(abs(arm - water_wade_foam(vec2(-0.266, -0.4), motion, 0, 1)) < 0.001)
    assert(water_wade_foam(vec2(0.266, -0.4), motion, 0, 0) == 0.0)
    loop k in [0..20):
        stationary = vec4(0, 0, 0, f32(k) / 32.0)
        assert(water_wade_foam(vec2(1.3, 0), stationary, 0, 1) < 0.001, "standing cannot produce a large body-centred hoop")
    particles = fill(particles[0], 6000)
    age = particles[5999].age
    fx_wade(vec3(0, 0.8, 0), 1.0, vec3(0, 0, 2), true)
    assert(particles.len() == 6000 and particles[5999].age == age, "full pool cannot mutate an existing cue")
    print("PASS wading: shallow entry splash, anchored expanding footfall rings, bounded cadence, symmetric leg V, swim handoff, dry/pool rejection and unchanged gameplay RNG")

wading_check()

use '../game/music.jo'
use '../game/env.jo'
use '../game/audio_assets.jo'
from '../game/music.jo' import __root_for

# Source-level complements to the production trace checker: fragment shape,
# bounded pedal/rests, shared day/night material, and compatible shrine layers.
loop mood in [Mood.field_day, Mood.field_night, Mood.field_rain, Mood.field_golden, Mood.forest, Mood.snow, Mood.ruins, Mood.shrine]:
    seq = Seq(mood = mood, want = mood)
    phrase_n = 0
    music_motif_count = 0
    music_still = 0.0
    env.night = 0.0
    seed_random(70070)
    phrases = 0
    notes = 0
    glass = 0
    bass = 0
    loop seq.age < 1200.0:
        evs = p_phrase(mood)
        end = 0.0
        melody = 0
        loop e in evs:
            assert(e.midi >= 19 and e.midi <= 120, "playable transposed MIDI range")
            end = max(end, e.t)
            if not e.accompaniment:
                melody += 1
                if mood != .shrine: assert(e.midi > 72, "field leaves the middle empty")
            if e.glass:
                assert(mood == .shrine and e.gain <= 0.24, "glass is a finite shrine layer")
                glass += 1
        if melody > 0:
            assert(melody >= 2 and melody <= 7, "short authored fragments")
            phrases += 1
            notes += melody
        if mood != .shrine:
            low = low_phrase(mood)
            loop e in low:
                assert(e.hand == 1 and e.midi <= 43 and e.gain < 0.36, "quiet independent low hand")
                bass += 1
        assert(end <= 6.0, "fragment cannot become a continuous bed")
        rest = phrase_rest(mood)
        assert(rest >= 8.0 and rest <= (if mood == .shrine: 22.0 else: 13.0), "bounded random timer slots")
        seq.age += end + rest
    assert(phrases >= 24 and notes >= 60, "non-vacuous twenty-minute score")
    if mood == .shrine: assert(glass >= 20, "generative shrine layers participate")
    else: assert(bass >= 8, "independent bass participates")
    print("PASS {mood}: {phrases} authored gestures / {notes} melody notes, {bass} independent bass notes, {glass} glass layers")

# New glass bank participates in the same lossless prepared-asset format.
__audio_state = 2
piano_init()
assert(mkdir("build/music-harmony-check"))
asset = piano_asset()
assert(asset.groups.len() == 13 and asset.groups[12].len() == 1)
assert(audio_asset_write("build/music-harmony-check/piano.bin", 61, asset))
loaded = audio_asset_read("build/music-harmony-check/piano.bin", 61)!
assert(loaded.groups[12][0].samples == shrine_glass.samples, "prepared glass is lossless")
assert(duration(shrine_glass) == 4.0, "finite glass decay")
assert(abs(shrine_glass.samples[0]) < 0.000001 and abs(shrine_glass.samples[shrine_glass.samples.len()-1]) < 0.000001, "click-free glass endpoints")
print("PASS finite shrine glass and thirteen-group prepared piano asset round trip")

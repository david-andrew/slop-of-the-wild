# Regression contracts for dry overcast, gold daylight and the held spirit face.
# No device, rendering, asset generation or window is required.
use '../game/env.jo'
use '../game/shade.jo'
use '../game/gfx.jo'
use '../game/chars.jo'
use '../game/vegetation.jo'

loop cover in [0.74,0.85,0.95]:
    env=Env(hour=11,time_scale=0,weather=.cloudy,clouds=cover,rain=(if cover>0.74:0.75 else:0),weather_t=1e9)
    env_update(0,false)
    if cover>0.74: assert(length(env.sun_color)<0.00001,"closed wet deck has no direct sun")
    else: assert(luma(env.sun_color)>0.4,"dry overcast preserves broad directional shading")
    assert(luma(env.sky_amb)>0.4,"overcast retains diffuse daylight")
    assert(shadow_direct(f32(cover))==0,"no crisp direct shadow beneath a closed deck")
loop hour in [18.4,18.6,18.9]:
    env=Env(hour=hour,time_scale=0,weather=.clear,clouds=0.42,weather_t=1e9)
    env_update(0,false)
    assert(env.sun_color.y>env.sun_color.x*0.50 and env.sun_color.y<env.sun_color.x*0.65,"gold light retains green instead of red/magenta")
    assert(env.sky_amb.y>env.sky_amb.z*1.15,"shade ambient cannot turn cloth lavender")
    assert(env.haze.y>env.haze.z*1.4,"gold atmosphere")
# Camera and shadow passes use the same whole-instance clearance. A fern
# beside the lens has zero silhouette/caster, rather than transparent cards.
u=VegU(cam=vec3(),player=vec3(0,0,-5),low=1,height=2,radius=1)
inst=VInst(translation(vec3(0.2,0,0)),vec4(1,1,1,1))
v=Vertex3D(pos=vec3(1,1,0),normal=vec3(0,1,0))
visible=veg_vs(v,inst,u)
u.shadow_pass=1
caster=veg_vs(v,inst,u)
assert(visible.clearance>0.99 and caster.world==visible.world,"cleared plant casts no separate silhouette")
assert(visible.world==inst.model[3].xyz,"near fern scales entirely to its root")
inst.model=translation(vec3(8,0,0))
remote=veg_vs(v,inst,u)
assert(remote.clearance==0 and remote.world.y==1,"remote vegetation retains its full caster")
# Face features survive every intermediate transformation and still disappear
# completely with the final departure (no detached opaque head).
loop k in [0..101):
    old_man.spirit=f64(k)/100
    old_man.opacity=1-old_man.spirit*0.48
    assert(old_man_face_opacity()>=0.92 and old_man_face_opacity()<=1)
old_man.spirit=1
previous=1.0
loop k in [0..101):
    old_man.opacity=0.52*(1-f64(k)/100)
    a=old_man_face_opacity()
    assert(a<=previous and a>=0 and a>=old_man.opacity)
    previous=a
assert(previous==0,"face completes the farewell fade")
# A point light on level ground has circular falloff in world space.
origin=vec4(0,3.2,0,13)
reference=point_light(vec3(0.2,0.2,0.2),vec3(0,1,0),vec3(5,0,0),origin,vec3(1.6,0.66,0.3))
loop k in [0..32):
    a=f64(k)*TAU/32
    p=v3(cos(a)*5,0,sin(a)*5)
    assert(length(point_light(vec3(0.2,0.2,0.2),vec3(0,1,0),p,origin,vec3(1.6,0.66,0.3))-reference)<0.00001)
print("PASS atmosphere: dry overcast, gold ambient, camera/caster fade, readable spectral face/farewell, radial fire pool")

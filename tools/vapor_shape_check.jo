# Production vapor geometry and source-over opacity; no GPU or render window.
use '../game/fx.jo'
use '../game/gfx.jo'

u = PartU(mat4(), vec3(1,0,0), vec3(0,1,0), vec3(0,1.55,6), vec3(0,0,0), 0, near = 0)
loop age in [0.0,0.25,0.75,0.99]:
    loop size in [0.04,0.052,0.065]:
        s = f32(size * (1.0 + age * 0.15))
        breath = PInst(vec4(0,1.55,0,s), vec4(0.60,0.66,0.70,0.24), vec4(f32(age),17,1.7,0))
        left = part_vs(QuadV(vec2(-1,0)),breath,u).pos.xyz
        right = part_vs(QuadV(vec2(1,0)),breath,u).pos.xyz
        low = part_vs(QuadV(vec2(0,-1)),breath,u).pos.xyz
        high = part_vs(QuadV(vec2(0,1)),breath,u).pos.xyz
        assert(length(right-left) < 0.15, "cold exhale remains narrower than the head")
        assert(length(high-low) < 0.045, "mouth vapor is a thin wisp")
        assert(abs((high.y+low.y)*0.5-1.55) < 0.00001, "wisp stays centred at the mouth")
        center = part_fs(PartO(vec4(),vec2(0.5,0.5),breath.color,breath.data,vec4(0,0,0,6),s),u)
        edge = part_fs(PartO(vec4(),vec2(0.97,0.5),breath.color,breath.data,vec4(0,0,0,6),s),u)
        assert(center.w < 0.17 and edge.w < center.w * 0.10, "transparent vapor dissolves at its perimeter")
print("PASS breath: 12 size/age cases; mouth-centred wisps under 0.15m wide/0.045m high; transparent feathered edges")
particles.clear()
fx_steam(vec3(0,0,0))
assert(particles.len()==14, "steam retains the existing bounded burst")
loop p in particles:
    assert(p.kind==.steam and p.life<=0.85 and p.size<=0.18 and p.color.w<=0.20, "brief small transparent steam")
    assert(p.vel.y>0.75 and abs(p.vel.x)<0.17 and abs(p.vel.z)<0.17, "steam rises rather than expanding as a ball")
    s=f32(p.size*1.7)
    steam=PInst(vec4(p.pos,s),p.color,vec4(0.5,18,f32(p.rot),0))
    left=part_vs(QuadV(vec2(-1,0)),steam,u).pos.xyz
    right=part_vs(QuadV(vec2(1,0)),steam,u).pos.xyz
    low=part_vs(QuadV(vec2(0,-1)),steam,u).pos.xyz
    high=part_vs(QuadV(vec2(0,1)),steam,u).pos.xyz
    assert(length(high-low)>length(right-left)*2.6,"steam has a rising wisp silhouette")
fx_update(1.0)
assert(particles.len()==0,"dousing steam clears within a second")
print("PASS steam: 14 rising wisps, unchanged burst count, short lifetime and bounded size/opacity")

# Exercise the real cold-warning emitter, including mouth origin and lifetime.
use '../game/elements.jo'
from '../game/elements.jo' import __breath_t
use '../game/env.jo'
use '../game/player.jo'
use '../game/items.jo'
use 'tree_checks.jo'
from 'tree_checks.jo' import __tree_course
check_cold_emitter = ():
    __audio_state=2
    items_init()
    __tree_course()
    particles.clear()
    pl=Player(pos=vec3(0,310,0),face=0)
    env.night=0.8
    env.rain=0.0
    warm_t=0.0
    reset_breath = (): __breath_t=0.0
    reset_breath()
    elements_update(1.0/60.0,pl.pos)
    mouth=pl.pos+vec3(0,1.55,0)+forward_of(pl.face)*0.18
    breaths=0
    loop p in particles:
        if p.kind!=.breath: continue
        breaths+=1
        assert(length(p.pos-mouth)<0.05 and p.life<0.36 and p.size<0.053,"cold emitter stays at the mouth with a quick exhale")
        assert(length(p.vel)<0.29 and p.color.w<=0.24,"breath drifts briefly without becoming a glowing ball")
    assert(breaths==4,"one bounded mouth exhale")
    fx_update(0.4)
    loop p in particles: assert(p.kind!=.breath,"mouth exhale vanishes in under half a second")
    print("PASS cold emitter: four mouth-local wisps, restrained drift/opacity, expiry within 0.4s")

check_cold_emitter()

build:
    opt = release
use '../game/music.jo'
use '../game/gfx.jo'
from '../game/music.jo' import __score_piano_play, __score_play

__audio_state = 2
piano_init()
bytes = 0
hash = u64(1469598103934665603)
loop bank in [piano.soft,piano.notes,piano.forte,piano.short_soft,piano.short_notes,piano.short_forte,piano.restrained_soft]:
    assert(bank.len() == 21)
    loop s in bank:
        bytes += s.samples.len()*2
        scale_ptr = (&s.scale) as *u32
        scale_bits = scale_ptr[0]
        hash = (hash xor u64(scale_bits))*u64(1099511628211)
        loop v in s.samples: hash = (hash xor u64(int(v) & 65535))*u64(1099511628211)
assert(bytes < 110000000, "resident piano samples stay below 110 MB")
print("PASS PCM16 piano bank: {bytes} bytes ({f64(bytes)/1048576.0:.3} MiB), 147 finite stereo samples, hash {hash}")

# Per-note quantization error, including quiet tails and both signs.
source = Sound([loop i in [0..MIX_RATE*4): f32(sin(f64(i)*0.017)*0.021*exp(-f64(i)/24000.0))])
packed = piano_pack(source)
error = 0.0
loop i in [0..source.samples.len()): error = max(error, abs(f64(piano_sample(packed,i)-source.samples[i])))
assert(error <= f64(packed.scale)*0.501, "PCM16 rounding is bounded by half a per-note quantum")
print("PASS scaled quantization: max error {error:.9}, quantum {packed.scale:.9}")

# Exercise packed-source decoding at fractional pitches across 8192-frame ring
# wraps and a gain retarget; compare against the expanded source mixer path.
loop pitch in [0.890898718,1.0,1.122462048]:
    stop_all()
    score_voices.clear()
    seq = Seq(volume = 1.0)
    music_duck = 1.0
    a = __score_piano_play(packed,0.7,0.0,pitch,true)
    b = __score_play(piano_expand(packed),0.7,0.0,pitch,true)
    difference = 0.0
    loop iteration in [0..14):
        gain = if iteration < 5: 0.7 else: 0.22
        score_set_volume(a,gain)
        score_set_volume(b,gain)
        av = __voices[0]
        bv = __voices[1]
        loop i in [0..av.sound.samples.len()):
            difference = max(difference,abs(f64(av.sound.samples[i]-bv.sound.samples[i])))
        __mix(if iteration % 3 == 0: 8192 else: 800)
    assert(difference < 0.00000001, "packed and expanded pitched windows agree through wraps/fades")
    print("PASS packed ring pitch {pitch:.6}: max sample delta {difference:.9}")

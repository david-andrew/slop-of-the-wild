# Smoke parcels and golden wet pigment use production shader functions.
use '../game/malice.jo'
use '../game/malice_shape.jo'
use '../game/charshade.jo'
use '../game/shade.jo'
use '../game/gfx.jo'

u=MaliceU(mat4(),vec3(0,0,0),vec3(0,200,800),0,0,1,1)
maximum_step=0.0
loop k in [0..MALICE_SEGMENTS):
    v=MaliceV(f32(k)/f32(MALICE_SEGMENTS),vec2(0,0))
    previous=malice_vs(v,u)
    later=u
    later.time=0.016667
    next=malice_vs(v,later)
    if next.phase>previous.phase:
        # Turbulent banks circulate vertically in both directions.
        maximum_step=max(maximum_step,f64(length(next.pos.xyz-previous.pos.xyz)))
print("smoke maximum 60 Hz step: {maximum_step:.4}m")
assert(maximum_step<1.5,"world-scale smoke moves less than a panorama pixel per frame")
loop night in [0.0,1.0]:
    u.night=f32(night)
    lowest=f32(1)
    highest=f32(0)
    visible=0
    loop k in [0..192):
        i=MaliceO(vec4(),0.5,vec2(0,0),1,malice_parcel(f32(k)/192.0,0.0))
        c=malice_fs(i,u)
        assert(c.w>=0.0 and c.w<0.43,"bounded density instead of opaque tube surface")
        lowest=min(lowest,c.w)
        highest=max(highest,c.w)
        if c.w>0.10: visible+=1
        if night>0.0:
            # Crimson-magenta, never orange or brown.
            assert(c.x>c.y*3.0 and c.z>c.y,"night smoke glows crimson-magenta rather than orange")
            # Pre-alpha colour; parcels draw at most about 21% opacity.
            assert(luma(c.xyz)<0.22,"night energy is a dim glow")
        i.cross_section=vec2(1,1)
        assert(malice_fs(i,u).w==0.0,"no rectangular parcel edge")
        i.phase=0.0
        i.cross_section=vec2(0,0)
        assert(malice_fs(i,u).w==0.0,"recycled parcel fades invisibly at the source")
    assert(highest-lowest>0.05 and visible>40,"uneven density through a continuous smoky mass")
print("PASS malice: 288 circulating parcels; continuous advection, feathered edges, uneven density and dim crimson night energy")

pigment=vec3(0.72,0.64,0.34)
loop k in [0..101):
    wet=f32(k)/100.0
    lit=pigment*vec3(1.8,1.0,0.6)
    c=ch_fibre_wet(lit,pigment,wet,1)
    assert(abs(luma(c)-luma(lit))<0.00001,"golden wet response preserves lighting luminance")
    if k==100: assert(abs(c.y/c.x-pigment.y/pigment.x)<0.00001,"fully wet hair retains gold rather than warm light's amber")
print("PASS golden wet fibre: 101 wetness values, luminance preserved and golden fully wet hue")

# Production architecture fragment shader: a support at Link's depth must
# disappear completely, while the held shaft and its shadow remain solid.
# Caller owns one render lock.
use '../game/gfx.jo'
use '../game/build.jo'
use '../game/post.jo'

climb_fixture_vs = (v: FsVert, u: BuildU) -> BuildO:
    BuildO(vec4(v.pos,0,1),u.lift+vec3(v.pos.x*0.2,v.pos.y*0.1,0),vec3(0,0,1),vec4(0.45,0.25,0.12,1),vec4(0,0,0,u.char))

window("Climbing support regression",128,128)
sh = make_sh(shader(climb_fixture_vs,build_fs))
rt = make_target(128,128,false,false)
gl_delete_texture(rt.color.id)
rt.color = color_texture(128,128,GL_RGBA32F,GL_RGBA,GL_FLOAT,GL_NEAREST)
glBindFramebuffer(GL_FRAMEBUFFER,u32(rt.fbo))
glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,u32(rt.color.id),0)
assert(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
u = BuildU(cam = vec3(0,2,5),player = vec3(0,0,0),fade_width = 2.4,keep_center = vec2(-3,0),keep_radius = 1.0)
values = fill(f32(0),128*128*4)
loop mode in [0..8):
    bind_target(rt)
    glDisable(GL_DEPTH_TEST)
    glDisable(GL_BLEND)
    glDisable(GL_CULL_FACE)
    glClearColor(0,0,0,0)
    glClear(GL_COLOR_BUFFER_BIT)
    u.fade_width = if mode >= 3: 1.0 else: 2.4
    u.char = if mode == 1 or mode >= 4: 0.0 else: 1.0
    u.lift = vec3(0,0.9,0)
    if mode == 4: u.lift = vec3(0,2,4.5)
    if mode == 5: u.lift = vec3(0.5,1.5,2.5)
    if mode == 6: u.lift = vec3(6,1,0)
    if mode == 7:
        u.keep_radius=0.0
        u.fade_width=2.6
        u.lift=vec3(3,2,4)
    u.keep_center = if mode == 1: vec2(0,0) else: vec2(-3,0)
    u.shadow_pass = if mode == 2: 1.0 else: 0.0
    draw_fast(sh,fullscreen_mesh(),u)
    game_read_pixels_f32(0,0,128,128,data(values) as *u8)
    loop pixel in [0..128*128):
        alpha = values[pixel*4+3]
        if mode == 7: continue # masonry edge is checked for intermediate coverage below
        if mode == 0 or (mode >= 3 and mode <= 5): assert(alpha == 0.0,"climbing support leaves no ghost pigment or depth fragments")
        else: assert(alpha >= 0.85,"held shaft and support shadow retain full coverage")
    if mode == 7:
        removed=0
        retained=0
        loop pixel in [0..128*128):
            if values[pixel*4+3]==0.0: removed+=1
            else: retained+=1
        assert(removed>0 and retained>0,"masonry must soften its clearance edge")
print("PASS climb occluder: 65536 fully cleared support/body/lens/approach pixels; held stone, distant stone and shadows fully opaque")
glBindFramebuffer(GL_FRAMEBUFFER,0)
free_target(rt)

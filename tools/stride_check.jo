use '../game/clips.jo'
use '../game/skel.jo'
use '../game/player.jo'

# How fast each locomotion clip moves over the ground (the planted foot's speed under the body;
# the clips are in place), against the rate the game assumes when it plays the clip
# (game/clips.jo): any difference shows as feet sliding.
#   sloppy/bin/sloppy tools/stride_check.jo

m = load_model("assets/models/hero.mdl")
lib = load_humanoid_anims()
loop c in [("walk", WALK_SPEED), ("run", RUN_SPEED), ("sprint", SPRINT_SPEED), ("sneak", SNEAK_SPEED)]:
    v = clip_ground_speed(m, lib, c.0)
    rate = locomotion_rate(c.0, c.1)
    foot = v * rate
    print("{c.0:8} ground speed {v:.3} m/s   rate {rate:.3}   foot {foot:.3} / body {c.1:.3} m/s   slip {abs(foot - c.1) / c.1 * 100.0:.3}%")

# the stride cycle at the game's speeds: the time for one foot to come round again (a reference:
# 0.541 s, from Nintendo's own exploration footage, docs/MOVEMENT_REFERENCE.md)
loop c in [("run", RUN_SPEED), ("sprint", SPRINT_SPEED)]:
    ci_ = clip_index(lib, c.0)
    dur = clip_duration(lib, ci_)
    cycle = clip_stride_cycle(lib, c.0, c.1)
    print("{c.0:8} clip {dur:.3} s at rate 1, played at {locomotion_rate(c.0, c.1):.3}: one stride cycle {cycle:.3} s, {cycle * c.1:.3} m")

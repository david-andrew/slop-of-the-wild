const DT = 1.0 / 60.0
checks = 0
failures = 0
check = (ok: bool, name: str):
    checks += 1
    if not ok: failures += 1
    print("{(if ok: "PASS" else: "FAIL")} {name}")
keys = ():
    __key_down = fill(false, 128)
    __key_pressed = fill(false, 128)
    __key_released = fill(false, 128)
    __key_typed = fill(false, 128)
    __mouse_btn = fill(false, 8)
    __mouse_pressed = fill(false, 8)
    __pad_on = false
    __pad_axes = fill(0.0, 6)
    __pad_down = fill(false, 15)
    __pad_prev = fill(false, 15)
    act = Actions()
press = (k: Key):
    keys()
    __key_down[int(k)] = true
    __key_pressed[int(k)] = true
    input_update(DT, false)
menu = (tab: int, sel: int, k: Key):
    invui = InvUI(open = true, tab = tab, sel = sel, t = 1.0)
    press(k)
    assert(inventory_update(DT))
    invui.open = false

# @COOK_CALLBACK@
# @PICKUP_CALLBACK@

setup = ():
    __audio_state = 2
    items_init()
    hf.n = 64
    hf.cell = 1.0
    hf.x0 = -32.0
    hf.z0 = -32.0
    hf.h = fill(f32(0), 4096)
    hf.mat = fill(u8(0), 16384)
    areas = fill(u8(46), 4096)
    edge_sd = fill(f32(-100), 4096)
    burn_px = fill(u8(0), BURN_N * BURN_N * 4)
    water_grid_set(fill(f32(-10000), 4096), 64, -32.0, -32.0, 1.0)
    use_terrain = true
    env = Env(weather_t = 10000.0)
    env_update(0.0, false)
    pl = Player(pos = vec3(0, 0, 4), last_safe = vec3(0, 0, 4))
    pl.ground = ground_at(0.0, 4.0, 0.0, 0.5, RADIUS)
    story = Story(beat = .explore, title_done = true)
    # Actual save shrine records/zones, without building visual meshes.
    loop i in [0..4):
        r = srec[i]
        shrines.push(Shrine(r.name, vec3(f32(i * 5), 0, 20), 0.0, vec3(0, 0, 0)))
        srec[i].entry = i
        zones.push(Zone(r.key, r.o + r.lo, r.o + r.hi))
    keys()

plant = ():
    vmodels = [VModel("CommonTree", [], 8.0, 4.0)]
    root = vec3(0, 0, 0)
    c = add_cyl(root - vec3(0, 1, 0), 0.3, 4.0, true, .wood)
    places.push(VPlace(0, translation(root), vec4(1, 1, 1, 0), root, 4.0, 8.0, true, col = c))
    tree_colliders[c] = 0
prepare_case = (name: str):
    if name == "climb": add_box(vec3(0, 0, 0), vec3(10, 10, 1), 0.0, true, .rock)
    if name == "swim":
        wl = fill(f32(-10000), 4096)
        loop z in [0..64):
            loop x in [42..64): wl[z * 64 + x] = 4.0
        water_grid_set(wl, 64, -32.0, -32.0, 1.0)
    if name == "log-water" or name == "log-slope": plant()
    if name == "log-water": water_grid_set(fill(f32(1), 4096), 64, -32.0, -32.0, 1.0)
    if name == "log-slope":
        loop z in [0..64):
            loop x in [0..64): hf.h[z * 64 + x] = f32(-1.0 + f64(x) * 0.08)
    if name == "night":
        spawn_enemy(.stalkoblin, vec3(16, 0, 10))
        enemies[0].night_only = true
        enemies[0].state = .buried
    if name == "loot-death" or name == "loot-ground": spawn_enemy(.bokoblin, vec3(10, 0, 0), "boko_club")
    if name == "talus-climb":
        spawn_enemy(.talus, vec3(0, 0, 0))
        enemies[0].state = .chase
        talus_sync(enemies[0], false)
    if name == "shrine-crate":
        # Production crate transaction on a bounded course inside the Oman zone.
        o = srec[0].o
        __crates.push(crate_new(o, vec2(0, 0), vec2(0, -2), vec2(0, 0), []))

runtime = ():
    # Full inventory must leave the world pickup available, using main's transaction.
    inv.max_weapons = 1
    inv_add("branch")
    wi = spawn_item("travelers_sword", pl.pos + vec3(0, 0.3, 0))
    press(.e)
    field_pickup()
    check(witems[wi].alive and inv.weapons == ["branch"] and inv_full_name == "Wanderer's Sword", "full inventory does not delete pickup")
    inv = Inventory()
    inv_add("apple")
    pl.hp = 4
    menu(3, 0, .e)
    menu(3, 0, .n3)
    check(count_of("apple") == 0 and inv.slots == ["", "", ""], "last food cannot be rebound after consumption")
    # Opposed movement cancels, occupied bindings swap rather than double-fire.
    keys()
    loop k in [Key.w, Key.s, Key.a, Key.d]: __key_down[int(k)] = true
    input_update(DT, false)
    check(act.move == vec2(0, 0), "four opposed movement inputs cancel")
    input_rebind(0, .shift)
    press(.shift)
    check(act.jump and not act.sprint and input_bindings[1] == .space, "occupied binding swaps actions")
    input_controls_defaults()
    # Feed controller polling's disconnect result, including the trigger falling edge.
    keys()
    inv = Inventory()
    inv_add("travelers_bow")
    inv.arrows = 5
    __pad_on = true
    __pad_axes[5] = 1.0
    input_update(DT, false)
    combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    loop i in [0..40):
        input_update(DT, false)
        combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    __pad_on = false
    __pad_axes = fill(0.0, 6)
    __pad_down = fill(false, 15)
    input_update(DT, false)
    combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    check(inv.arrows == 5 and fight.act == .idle, "pad disconnect cancels drawn bow without firing")
    __pad_on = true
    __pad_axes[5] = 1.0
    loop i in [0..40):
        input_update(DT, false)
        combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    assert(fight.act == .aim)
    invui = InvUI(open = true, t = 1.0)
    __pad_on = false
    __pad_axes = fill(0.0, 6)
    loop i in [0..3):
        input_update(DT, false)
        assert(inventory_update(DT))
    invui.open = false
    input_update(DT, false)
    combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    check(inv.arrows == 5 and fight.act == .idle, "disconnect during paused aim remains cancelled on resume")
    inv = Inventory()
    inv_add("travelers_sword")
    fight = Fight()
    keys()
    __pad_on = true
    __pad_down[int(PadButton.x)] = true
    loop i in [0..100):
        input_update(DT, false)
        __pad_prev = __pad_down
        combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    assert(fight.act == .charge)
    __pad_on = false
    __pad_down = fill(false, 15)
    input_update(DT, false)
    combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
    check(fight.act == .idle, "pad disconnect cancels charged spin")
    # Paused shield edits must invalidate locomotion as well as combat equipment.
    loop air in [false, true]:
        inv = Inventory()
        inv_add("pot_lid")
        pl.state = if air: PState.air else: PState.surf
        pl.surfing = true
        pl.can_surf = true
        menu(1, 0, .x)
        check(not pl.surfing and pl.state == (if air: PState.air else: PState.ground), "drop sole shield during {(if air: "airborne" else: "ground")} surf")
    inv = Inventory()
    inv_add("pot_lid")
    inv_add("boko_shield")
    pl.state = .surf
    pl.surfing = true
    menu(1, 1, .e)
    check(pl.surfing and pl.state == .surf and equipped_shield() == "boko_shield", "equipping another shield preserves surf")
    menu(1, 1, .e)
    check(not pl.surfing and pl.state == .ground and equipped_shield() == "", "unequipping shield also ends surf")
    inv = Inventory()
    inv_add("branch")
    inv_add("travelers_sword")
    pl.state = .glide
    menu(0, 1, .e)
    check(pl.state == .glide and equipped_weapon() == "travelers_sword", "equipping weapon preserves glide")
    # Keh Namut floats high above the map: outdoor mountain chill must not reach it.
    pl = Player(pos = srec[KEH].o + vec3(0, 0, 0))
    use_terrain = false
    env = Env(hour = 23.0, night = 1.0, indoor = 1.0, weather = .storm, rain = 1.0)
    cold_dmg_t = 0.0
    loop i in [0..310): elements_update(DT, pl.pos)
    check(pl.hp == 12 and cold_dmg_t == 0.0, "night in Kay Nomut causes no mountain cold damage")
    lightning_warn = 0.25
    lightning_gear = GearTrace(id = "travelers_sword", kind = .weapon, index = 1)
    elements_update(DT, pl.pos)
    check(lightning_warn == 0.0, "entering shrine cancels Link lightning warning")
    before = pl.hp
    env.weather = .clear
    loop i in [0..240): env_update(DT, false)
    elements_update(DT, pl.pos)
    check(env.indoor == 1.0 and pl.hp == before and not lightning_begin(), "weather transition indoors stays harmless")
    s = PlateauSave(activated = fill(false, 4), completed = fill(false, 4), dropped = [WItem("torch", vec3(1, 2, 3), dropped = true, lit = true, el = Elem(burning = -1.0))])
    raw = save_encode(s)
    check(save_decode(raw) != none and save_encode(save_decode(raw)!) == raw, "dropped torch material state round trip")
    record = [loop line in split(raw, "\n"): if starts_with(line, "dropped="): line][0]
    fields = split(record, ",")
    loop index in [0, 1, 4, 10, 11, 12, 16, 17]:
        bad = [loop f in fields: f]
        bad[index] = match index:
            0: "dropped=unknown"
            1: "nan"
            4: "1001"
            10: "1.1"
            11: "-1"
            12: "2"
            16: "-0.5"
            _: "1.1"
        check(save_decode(replace(raw, record, join(bad, ","))) == none, "malformed drop field {index} rejected")
    check(save_decode(replace(raw, record + "\n", "")) != none, "legacy saves without drop records remain readable")
    witems = [WItem("apple", vec3(1, 0, 1))]
    save_apply(save_decode(raw)!)
    save_apply(save_decode(raw)!)
    check(witems.len() == 2 and witems[0].id == "apple" and witems[1].id == "torch", "restoring drops preserves placements and does not duplicate")

write_case = (name: str, path: str):
    save_init(path)
    assert(save_enabled)
    if name == "glide":
        pl.has_glider = true
        inv_add("paraglider")
        pl.state = .air
        pl.pos.y = 10
        pl.st_t = 0.3
        press(.space)
        player_update(DT)
        assert(pl.state == .glide)
    else if name == "climb":
        pl.pos = vec3(0, 0, 2.0)
        press(.w)
        loop i in [0..60):
            save_update(DT)
            player_update(DT)
        assert(pl.state == .climb)
    else if name == "swim":
        press(.d)
        loop i in [0..300):
            save_update(DT)
            player_update(DT)
            if pl.state == .swim: break
        assert(pl.state == .swim)
    else if name == "held" or name == "cook" or name == "held-drop":
        inv_add("pepper", 2)
        menu(3, 0, .j)
        menu(3, 0, .j)
        assert(inv.held.len() == 2 and available_of("pepper") == 0)
        if name == "cook":
            bonfires.push(Bonfire(pl.pos + vec3(0, 0, -1), pot = true, lit = true))
            cook_at_pot()
            assert(__cook_t > 0.0 and pl.state == .cutscene and count_of(pot_result(["pepper", "pepper"])) == 1)
        if name == "held-drop":
            cooking_drop_held()
            assert(count_of("pepper") == 0 and witems.len() == 2)
    else if name == "drop":
        inv_add("travelers_sword")
        menu(0, 0, .x)
        loop i in [0..120): items_physics(DT)
        assert(inv.weapons.len() == 0 and witems.len() == 1 and witems[0].resting)
    else if name == "shock":
        inv_add("travelers_sword")
        strike_at(pl.pos + vec3(0, 1.6, 0) + forward_of(pl.face) * 0.45)
        lit = false
        player_torch_update(DT, lit)
        assert(inv.weapons.len() == 0 and witems.len() == 1 and pl.hp < 12)
    else if name == "throw":
        inv_add("travelers_sword")
        press(.g)
        loop i in [0..20):
            combat_update(DT, (i: int) -> vec3: vec3(0, 0, -4), 0)
            act.throw_ = false
        assert(inv.weapons.len() == 0 and witems.len() == 1 and witems[0].thrown_by_player)
    else if name == "burning":
        inv_add("branch")
        held_id = "branch"
        held_revision = inv.weapon_revision
        held_el = Elem(heat = 1.0, burning = 4.5, wet = 0.2)
        lit = false
        player_torch_update(DT, lit)
        assert(held_el.burning > 4.0)
    else if name == "loot-death" or name == "loot-ground":
        assert(enemy_damage(enemies[0], 99.0, pl.pos))
        loop i in [0..(if name == "loot-death": 15 else: 120)):
            enemies_update(DT, false)
        assert(enemies[0].hp == 0 and enemies[0].state == (if name == "loot-death": EState.dead else: EState.gone))
    else if name == "log-water" or name == "log-slope":
        tree_fell(tree_record(0), pl.pos)
        pl.pos = v3(20.0, height_at(20.0, 20.0), 20.0)
        loop i in [0..150): trees_update(DT, pl.pos)
        assert(tree_states.len() == 1 and tree_states[0].phase == 2)
        t = tree_states[0]
        assert(write_file(path + ".oracle", "{t.pos.x:.6},{t.pos.y:.6},{t.pos.z:.6},{t.roll:.6},{t.el.wet:.6}"))
    else if name == "night":
        env.hour = 23.0
        env_update(0.0, false)
        enemies_update(DT, true)
        assert(enemies[0].state != .buried)
    else if name == "talus-climb":
        pl.pos = vec3(0, 0, 2)
        press(.w)
        loop i in [0..90):
            player_update(DT)
            if pl.state == .climb: break
        assert(pl.state == .climb and talus_owns(enemies[0], pl.climb_col))
    else if name == "shrine-crate":
        o = srec[0].o
        shrines[0].activated = true
        pl.pos = o + vec3(0, 0, 1.35)
        pl.last_safe = pl.pos
        save_update(0.0)
        press(.w)
        pl.move_dir = vec3(0, 0, -1)
        loop i in [0..60): crate_update(0, DT)
        assert(__crates[0].cell == vec2(0, -2))
        plate = Plate(o + vec3(0, 0, -2))
        plate_update(plate, [__crates[0].p.pos], DT)
        assert(plate.pressed)
        # Repeated pressure at the boundary must not push the crate into the wall.
        pl.pos.z -= 2
        loop i in [0..120): crate_update(0, DT)
        check(__crates[0].cell == vec2(0, -2), "crate cannot push past wall boundary")
    else if name == "title":
        story.title_done = false
        story.beat = .title
        story.t = 5.0
        pl.state = .cutscene
    else if name == "tower":
        story.beat = .tower_rise
        pl.state = .cutscene
    else if name == "orb-before" or name == "orb-after" or name == "orb-skip":
        shrine = if name == "orb-skip": 1 else: 0
        shrines[0].activated = true
        if shrine == 1:
            shrines[0].done = true
            shrines[1].activated = true
            story.orbs = 1
            inv_add("spirit_orb")
        pl.pos = srec[shrine].o + srec[shrine].monk + vec3(0, 0, 2)
        pl.last_safe = pl.pos
        shr_cur = shrine
        save_update(0.0)
        __monk_talk(shrine)
        press(.e)
        loop i in [0..(if name == "orb-before": 120 else: 250)):
            __monk_update(DT)
            if __trans.active: break
        assert(story.orbs == (if name == "orb-before": 0 else: (if shrine == 1: 2 else: 1)))
        check(__trans.active == (shrine == 1), "{name}: first ceremony ignores skip; repeat skips after award")
    else: assert(false, "unknown probe")
    __win_close = true
    save_update(0.0)
    check(file_exists(path), "{name}: native close saved")

read_case = (name: str, path: str):
    assert(save_decode(read_file(path)!) != none, "writer produced a valid save")
    pl.pos = vec3(25, 0, 25) # A failed load must not inherit the writer's anchor.
    save_init(path)
    check(pl.state == .ground and not pl.surfing and not cam.override, "{name}: fresh process restores control")
    if name == "held": check(inv.held.len() == 0 and count_of("pepper") == 2 and available_of("pepper") == 2, "held reservations safely returned")
    else if name == "held-drop": check(count_of("pepper") == 0 and witems.len() == 2 and witems[0].id == "pepper" and witems[1].id == "pepper", "released held ingredients remain two recoverable copies")
    else if name == "cook": check(count_of("pepper") == 0 and count_of(pot_result(["pepper", "pepper"])) == 1, "mid-cooking keeps one completed dish")
    else if name == "drop" or name == "shock" or name == "throw":
        check(inv.weapons.len() == 0 and witems.len() == 1 and witems[0].alive and witems[0].id == "travelers_sword", "{name}: relinquished equipment still recoverable")
        if witems.len() == 1:
            if name == "throw": check(witems[0].tossed and not witems[0].thrown_by_player and witems[0].damage == 0, "thrown equipment resumes physics without replaying damage")
            pl.pos = witems[0].pos - vec3(0, 0.3, 0)
            pl.state = .ground
            press(.e)
            field_pickup()
            check(inv.weapons == ["travelers_sword"] and not witems[0].alive, "{name}: restored equipment pickup works once")
            save_now()
            check(save_decode(read_file(path)!)!.dropped.len() == 0, "{name}: pickup removes saved drop")
            save_apply(save_decode(read_file(path)!)!)
            check(witems.len() == 0 and inv.weapons == ["travelers_sword"], "{name}: repeated restore cannot duplicate drops")
    else if name == "burning":
        left = held_el.burning
        lit = false
        player_torch_update(DT, lit)
        check(left > 4.0 and held_el.burning < left and lit, "burning weapon resumes original timer")
    else if name == "loot-death" or name == "loot-ground":
        loot = [loop w in witems: if w.alive and w.id == "boko_club": w]
        check(enemies[0].state == .gone and enemies[0].hp == 0 and loot.len() == 1, "{name}: defeated encounter retains one unclaimed weapon")
        count = witems.len()
        loop i in [0..180): enemies_update(DT, false)
        check(witems.len() == count and enemies[0].state == .gone, "{name}: resumed corpse cannot produce duplicate loot")
    else if name == "log-water" or name == "log-slope":
        t = tree_states[0]
        check("{t.pos.x:.6},{t.pos.y:.6},{t.pos.z:.6},{t.roll:.6},{t.el.wet:.6}" == read_file(path + ".oracle")! and places[0].felled and colliders[t.col].active, "{name}: physical log position, roll, wetness and collider restored")
        trees_update(DT, pl.pos)
        check(tree_states[0].phase == 2, "{name}: resumed log remains physical")
    else if name == "night":
        enemies_update(DT, env.night > 0.5)
        check(env.hour == 23.0 and enemies[0].state != .buried, "Stalkbonk emerges on first resumed night frame")
        env.hour = 7.0
        env_update(0.0, false)
        enemies_update(DT, false)
        check(enemies[0].state == .buried, "Stalkbonk retreats at resumed dawn")
    else if name == "talus-climb": check(length(pl.pos - enemies[0].pos) >= 5.0 and pl.ground.collider < 0, "Talus climb resumes safely outside moving body")
    else if name == "shrine-crate": check(zone_at(pl.pos + vec3(0, 1, 0)) == "" and __crates[0].cell == vec2(0, 0), "pressed-plate save returns outside reset puzzle")
    else if name == "swim": check(pl.pos.x > 8 and pl.pos.x < 10.5 and water_depth(f64(pl.pos.x), f64(pl.pos.z)) < 0.3 and pl.stamina == pl.stamina_max, "swim: latest dry bank restored in identical lake")
    else if name == "climb": check(abs(pl.pos.x) < 0.01 and pl.pos.z > 1.35 and pl.pos.z <= 2.0 and pl.pos.y == 0 and pl.stamina == pl.stamina_max, "climb: latest grounded anchor remains outside cliff")
    else if name == "title": check(not story.title_done and story.beat == .explore, "interrupted title can replay")
    else if name == "tower": check(story.tower_risen and hooks.tower_lift == 0.0 and length(vec2(pl.pos.x - TOWER.x, pl.pos.z - TOWER.z)) < 15, "interrupted tower completes at safe foot")
    else if name == "orb-before" or name == "orb-after" or name == "orb-skip":
        n = if name == "orb-before": 0 else: (if name == "orb-skip": 2 else: 1)
        shrine = if name == "orb-skip": 1 else: 0
        check(story.orbs == n and count_of("spirit_orb") == n and shrines[shrine].done == (n > 0) and zone_at(pl.pos + vec3(0, 1, 0)) == "", "{name}: reward atomic and exterior resume")
    else: check(length(pl.pos - vec3(0, 0, 4)) < 0.01 and pl.stamina == pl.stamina_max, "{name}: dry grounded anchor and refilled stamina")

setup()
assert(args().len() >= 2)
if args()[1] == "runtime": runtime()
else:
    assert(args().len() == 4)
    prepare_case(args()[2])
    if args()[1] == "write": write_case(args()[2], args()[3])
    else: read_case(args()[2], args()[3])
print("defect hunt: {checks - failures}/{checks} passed")
if failures > 0: exit(1)

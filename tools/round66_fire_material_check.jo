# Live fuel, persistent timber and material-preserving status feedback, headless.
use 'tree_checks.jo'
from 'tree_checks.jo' import __tree_course
use '../game/elements.jo'
use '../game/structures.jo'
use '../game/charshade.jo'
use '../game/fx.jo'
use '../game/gfx.jo'
use '../game/player.jo'
use '../game/items.jo'
use '../game/env.jo'
use '../game/terrain.jo'

__audio_state=2
items_init()
__tree_course()
camp_wood.clear()
pl.pos=vec3(20,0,20)
assert(ignite_at(vec3(0.5,0.1,0.5)))
assert(burn_value(0.5,0.5,2)>0.4 and burn_value(0.5,0.5,0)==0,"ignition wilts its own live fuel without declaring it spent")
assert(burn_value(-0.5,0.5,2)==0,"singe never marks an untouched neighbour")
flames[0].t=1.99
flames[0].life=6.0
seed_random(664)
elements_update(1.0/60.0,pl.pos)
assert(burn_value(0.5,0.5,2)>0.95,"live grass progressively darkens as fuel burns")
flames[0].life=0.0
elements_update(1.0/60.0,pl.pos)
assert(burn_value(0.5,0.5,0)>0.99 and burn_value(0.5,0.5,2)==0,"expiry swaps live singe for recoverable charcoal, with no permanent heat mask")
print("PASS live fuel: own-cell singe, progressive wilt, settled charcoal and heat removal")

view=vec3(0,0,1)
front=vec3(0,0,1)
edge=vec3(1,0,0)
cloth=vec3(0.14,0.20,0.28)
skin=vec3(0.50,0.32,0.21)
loop rim in [vec4(1,0.23,0.035,0.35),vec4(0.42,0.72,1,0.6)]:
    assert(ch_status_light(cloth,front,view,rim,0)==cloth,"status leaves front-facing base materials intact")
    lit_cloth=ch_status_light(cloth,edge,view,rim,0)
    lit_skin=ch_status_light(skin,edge,view,rim,0)
    assert(length((lit_skin-lit_cloth)-(skin-cloth))<0.00001,"rim retains cloth/skin pigment differences")
    assert(length(lit_cloth-cloth)>0.10,"heat/shock rim is visible at the silhouette")
    flash=ch_status_light(cloth,front,view,rim,0.12)
    assert(flash.z-cloth.z>flash.x-cloth.x and length(flash-cloth)<0.18,"brief shock flash is bounded and white-blue")
    assert(length((ch_status_light(skin,front,view,rim,0.12)-flash)-(skin-cloth))<0.00001,"flash preserves all material contrast")
pl=Player(pos=vec3(0,0,0))
burn_player(vec3(0,0,-1),1)
assert(player_element_hit and player_burn_t>0,"accepted burn suppresses generic salmon fill")
player_element_hit=false
pl=Player(pos=vec3(0,0,0))
shock_player(1,vec3(0,0,-1),1)
assert(player_element_hit and player_shock_t>0,"accepted shock suppresses generic orange fill")
print("PASS status light: visible additive rim/flash, preserved material contrast and production damage flags")

loop barrel in [false,true]:
    remains=camp_residue(barrel)
    assert(remains.idx.len()>100,"collapsed timber leaves real residual geometry")
    low=f32(100)
    high=f32(-100)
    loop vertex in remains.vs:
        low=min(low,vertex.pos.y)
        high=max(high,vertex.pos.y)
        assert(length(vertex.pos.xz)<0.65,"residue stays in the former prop footprint")
    assert(low>=0.0 and high>0.10 and high<0.30,"ring/staves and slats sit above ground with shallow relief")
print("PASS collapsed props: bounded charred ring/staves and separate crate slats")

u=PartU(mat4(),vec3(1,0,0),vec3(0,1,0),vec3(0,0,10),vec3(),0,near=0,time=0.4)
loop seed in [0.2,1.3,2.7,4.1]:
    root=part_fs(PartO(vec4(),vec2(0.5,0),vec4(1,0.5,0.1,1),vec4(0,-6,f32(seed),-1.6),vec4(0,0,0,10),0.5),u)
    heart=part_fs(PartO(vec4(),vec2(0.5,0.23),vec4(1,0.5,0.1,1),vec4(0,-6,f32(seed),-1.6),vec4(0,0,0,10),0.5),u)
    assert(root.w==0 and heart.w>0.2,"continuous flame has a feathered base and bright connected body")
print("PASS varied flame sheets: transparent ground seam, continuous roots across four silhouettes")

use '../game/sfx.jo'
use '../game/combat.jo'
use '../game/music.jo'
use '../game/player.jo'
use '../game/env.jo'
use '../game/gfx.jo'
use '../game/audio_assets.jo'
use 'music_event_paths.jo'
use 'creature_audio.jo'
use '../game/scene.jo'
use '../game/physics.jo'
from '../game/sfx.jo' import __echoes, __amb_k, __amb_cover, __amb_gust, __amb_snow, __amb_forest, __amb_ruins, __peck_t
from '../game/sfx.jo' import __sfx_variations_update, __sfx_rng, __sfx_drawing, __sfx_rustle_t, __sfx_draw_voice

# Offline, actual gameplay mixer/gains; never normalize individual exports.
# Run python3 tools/listen.py; fixed 45-second production-mixer clips and isolated shrine stems.
out_dir = if args().len() > 1: args()[1] else: "build/listen"
mkdir(out_dir)
__audio_state = 2
master_volume(0.8)
seed_random(51)
started = time()
sfx_init()
print("sfx init {time() - started:.6}s")
take_bytes = 0
loop bank in sfx_takes:
    loop take in bank.takes: take_bytes += take.samples.len() * 4
loop take in sfx.step_wood: take_bytes += take.samples.len() * 4
print("prebuilt SFX take payload {take_bytes} bytes")
gust_bytes = 0
loop bank in [sfx.wind_gust_takes, sfx.rain_gust_takes]:
    loop take in bank: gust_bytes += take.samples.len() * 4
print("spatial filters: {sfx_spatial.len()} takes, {sfx_spatial_bytes} bytes, {sfx_spatial_seconds:.6}s load; gust banks {sfx.wind_gust_takes.len() + sfx.rain_gust_takes.len()} takes, {gust_bytes} bytes")
piano_init()

wav = (name: str, samples: f32[]):
    peak = 0.0
    energy = 0.0
    clipped = 0
    loop v in samples:
        peak = max(peak, abs(f64(v)))
        energy += f64(v) * f64(v)
        if abs(v) >= 0.999: clipped += 1
    rms = sqrt(energy / f64(samples.len()))
    print("{name}: peak {peak:.6} ({20.0 * log10(max(peak, 0.000000001)):.2} dBFS), RMS {rms:.6} ({20.0 * log10(max(rms, 0.000000001)):.2} dBFS), clipped {clipped}; master 0.8, export gain 1.0")
    b: u8[]
    w16 = (v: int):
        loop k in [0..2): b.push(u8((v >> (k * 8)) & 255))
    w32 = (v: int):
        loop k in [0..4): b.push(u8((v >> (k * 8)) & 255))
    loop c in "RIFF": b.push(c)
    w32(36 + samples.len() * 2)
    loop c in "WAVEfmt ": b.push(c)
    w32(16)
    w16(1)
    w16(2)
    w32(MIX_RATE)
    w32(MIX_RATE * 4)
    w16(4)
    w16(16)
    loop c in "data": b.push(c)
    w32(samples.len() * 2)
    loop v in samples: w16(int(clamp(f64(v), -1.0, 1.0) * 32767.0) & 65535)
    assert(write_bytes("{out_dir}/{name}.wav", b), "WAV export failed; create the output parent directory first")

reset = ():
    stop_all()
    amb = Ambient()
    seq = Seq()
    seq.mood = .field_day
    seq.want = .field_day
    seq.volume = 1.0
    seq.rest = 2.0
    phrase_n = 0
    music_note_count = 0
    music_motif_count = 0
    music_still = 0.0
    music_hold = 0.0
    music_activity = 0.0
    music_duck = 1.0
    music_duck_floor = 1.0
    music_duck_hold = 0.0
    sfx_priority_gain = 1.0
    sfx_priority_hold = 0.0
    score_voices.clear()
    laters.clear()
    pl = Player()
    pl.pos = v3(-700.0, 235.0, 1800.0)
    fight = Fight()
    sfx_room = 0.0
    __echoes.clear()
    __amb_k = 0.0
    __amb_cover = 0.0
    __amb_gust = 0.0
    __amb_snow = 0.0
    __amb_forest = 0.0
    __amb_ruins = 0.0
    __peck_t = 5.0
    amb_lift = 0.0
    amb_biome = 0
    amb_opening = false
    sfx_room_size = 1.0
    shrine_hum = 0.0
    env.rain = 0.0
    env.night = 0.0
    env.gust = 1.0
    env.clouds = 0.0
    loop mut p in music_landmarks:
        p.last = 0.0
        p.inside = false
    seed_random(51)
    __sfx_rng = rng(51051)
    __sfx_drawing = false
    __sfx_rustle_t = 0.0
    __sfx_draw_voice = 0
    loop mut bank in sfx_takes: bank.last = -1

# Silence selected voices after production gain/duck updates to measure stems.
# Every stem follows the same seeded 45-second walking/music timeline.
render = (name: str):
    reset()
    seed_random(70070)
    __sfx_rng = rng(70070)
    music_step_n = 0
    long_field = name == "field_1200"
    long_shrine = name == "shrine_1200"
    long_score = long_field or long_shrine
    long_combat = name == "combat_120"
    insects = name == "night_insects"
    seconds = if long_score: 1200 else: (if long_combat: 120 else: 45)
    night = name == "field_night" or insects
    combat = name == "combat_engaged" or name == "low_health" or long_combat
    phrase_log = "time,pitches,onsets,harmony,figure,colour\n"
    bar_log = "time,bar\n"
    shrine = starts_with(name, "shrine")
    cave = name == "cave_exit"
    title = name == "title"
    stem = starts_with(name, "shrine_") and not long_shrine
    mixb: f32[]
    loop frame in [0..seconds * 60):
        t = f64(frame) / 60.0
        dt = 1.0 / 60.0
        indoor = if shrine: 1.0 else: (if cave: 1.0 - smoothstep(6.0, 16.0, t) else: 0.0)
        mood = if shrine: Mood.shrine else: (if night: Mood.field_night else: (if name == "rain": Mood.field_rain else: (if combat: Mood.combat else: (if title or (cave and t >= 10.0 and t < 32.0): Mood.title else: (if cave and t < 10.0: Mood.silent else: Mood.field_day)))))
        music_mood(mood)
        env.hour = if night: 23.0 else: 11.0
        env.night = if night: 1.0 else: 0.0
        env.rain = if name == "rain": 0.85 else: 0.0
        env.clouds = env.rain
        env.gust = if name == "rain": 2.0 else: 1.0
        env.indoor = indoor
        shrine_hum = if shrine: 0.35 else: 0.12
        sfx_room = indoor * (if shrine: 1.0 else: 0.7)
        sfx_room_size = if shrine: 1.0 else: 0.5
        amb_opening = title or cave
        amb_biome = 0
        pl.pos = if shrine: v3(0, -100, 0) else: v3(-700, 235, 1800)
        pl.ground.surf = if shrine or (cave and t < 16.0): .stone else: .grass
        pl.vel = if title: vec3(0, 0, 0) else: vec3(0, 0, 2.4)
        if mood == .combat: fight.act = .swing
        pl.hp = if name == "low_health": 4 else: 12
        pl.events.clear()
        # 12s walk, 9s listening rest, 12s walk, 12s rest.
        if not title and (t < 12.0 or (t >= 21.0 and t < 33.0)) and frame % 32 == 0: pl.events.push("step")
        music_player_events()
        old_mood = seq.mood
        old_phrase = phrase_n
        old_step = seq.combat_step
        music_update(dt)
        if long_combat and seq.combat_step > old_step and old_step % 16 == 0:
            bar_log = "{bar_log}{t:.6},{old_step / 16}\n"
        if long_score and (old_phrase != phrase_n or old_mood != seq.mood) and seq.events.len() > 0:
            signature = ""
            onsets = ""
            harmony = ""
            loop e in seq.events:
                if not e.accompaniment:
                    signature = "{signature}{e.midi}:"
                    onsets = "{onsets}{e.t:.6}:"
                else: harmony = "{harmony}{e.midi}:"
            phrase_log = "{phrase_log}{t:.6},{signature},{onsets},{harmony},{seq.figure_key},{seq.harmony_colour}\n"
        if (title and frame == 0) or (cave and frame == 600): title_cue()
        jingles_update(dt)
        amb_lift = if seq.events.len() == 0 and mood != .combat: 1.0 else: 0.0
        ambient_update(dt, indoor, f64(pl.pos.y), 0.0)
        if insects or long_combat:
            loop v in __voices:
                keep = insects and v.id == amb.crickets
                if long_combat:
                    loop s in score_voices:
                        if s.id == v.id: keep = true
                if not keep: set_volume(v.id, 0.0)
        if stem:
            loop v in __voices:
                score = false
                loop s in score_voices:
                    if s.id == v.id: score = true
                # Isolate ambience, score and direct/echoed stone footsteps.
                hum = v.id == amb.hum
                room = v.id == amb.room
                keep = if name == "shrine_hum": hum else: (if name == "shrine_room": room else: (if name == "shrine_music": score else: (if name == "shrine_bed": hum or room else: not score and not hum and not room)))
                if not keep: set_volume(v.id, 0.0)
        __mix(MIX_RATE / 60)
        loop v in __mix_buf: mixb.push(v)
    wav(name, mixb)
    if long_combat: assert(write_file("{out_dir}/{name}-bars.csv", bar_log))
    if long_score: assert(write_file("{out_dir}/{name}-phrases.csv", phrase_log))

music_event_source_check()
mode = if args().len() > 2: args()[2] else: "shrine"
if mode == "all":
    loop name in ["field_day", "field_night", "rain", "combat_engaged", "low_health", "shrine", "title", "cave_exit", "shrine_hum", "shrine_room", "shrine_steps", "shrine_music", "shrine_bed", "night_insects", "combat_120", "field_1200", "shrine_1200"]: render(name)
    loop name in ["boar", "fox", "crow", "bokoblin"]: wav("creature_{name}", creature_capture(name, out_dir))
else if mode == "creatures_before":
    loop name in ["boar", "fox", "crow", "bokoblin"]: wav("creature_{name}", creature_capture(name, out_dir, false))
else: render(mode)

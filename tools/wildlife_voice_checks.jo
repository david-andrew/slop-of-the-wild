use '../game/wildlife.jo'
use '../game/enemies.jo'
use '../game/player.jo'
use '../game/env.jo'
use '../game/elements.jo'
use '../game/combat.jo'

wildlife_voice_test_suite = ():
    animals.clear()
    bugs.clear()
    bonfires.clear()
    player_hits.clear()
    pl = Player(pos = vec3(60, 0, 0))
    env = Env(hour = 8.0, rain = 0.0)
    animals.push(Animal(.boar, vec3(0, 0, 0), vec3(0, 0, 0), voice_t = 0.0, seed = 0.37))
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 1 and wild_voices[0].kind == "boar_graze", "boar grazing grunt event")
    calls = 1
    loop f in [0..120):
        wildlife_update(1.0/60.0)
        calls += wild_voices.len()
    assert(calls == 1, "grazing calls stay sparse")
    pl.pos = vec3(1, 0, 0)
    animals[0].sense = 0.0
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 1 and wild_voices[0].kind == "boar_alarm", "alert emits one alarm squeal")
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 0, "alarm does not repeat while fleeing")
    animals[0].state = .charge
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 1 and wild_voices[0].kind == "boar_charge", "charge emits one snort")
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 0, "charge snort does not repeat")
    animals = [Animal(.fox, vec3(0, 0, 0), vec3(0, 0, 0))]
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 1 and wild_voices[0].kind == "fox_yip", "alerted fox yips")
    animals = [Animal(.sparrow, vec3(0, 0, 0), vec3(0, 0, 0))]
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 1 and wild_voices[0].kind == "bird_scatter", "scattering small bird chirps")
    animals[0].state = .dead
    wildlife_update(1.0/60.0)
    assert(wild_voices.len() == 0, "dead wildlife cannot call")
    animals.clear()
    print("wildlife voices: 9/9 passed; boar graze/alarm/charge, fox yip, bird scatter; grazing cooldown=8..17s")

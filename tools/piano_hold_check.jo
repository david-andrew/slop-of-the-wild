build:
    opt = release
use '../game/music.jo'
from '../game/music.jo' import __score_piano_play, __piano_short

# Compare the former whole-note PCM16 bake to the bounded live release. Quantizing
# the former faded sample adds at most half its quantum; the live bank is immutable.
__audio_state = 2
source = piano_pack(Sound([loop i in [0..MIX_RATE * 6): f32(sin(f64(i) * 0.017) * 0.021 * exp(-f64(i) / 240000.0))]))
original = [loop v in source.samples: v]
comparisons = 0
loop pitch in [0.890898718, 1.0, 1.122462048]:
    loop hold in [0.0, 0.12, 0.73, 2.75]:
        stop_all()
        score_voices.clear()
        seq = Seq(volume = 1.0)
        music_duck = 1.0
        legacy = __piano_short(source, hold * pitch, (hold + 0.65) * pitch)
        a = __score_piano_play(source, 0.7, 0.0, pitch, true, hold)
        b = __score_piano_play(legacy, 0.7, 0.0, pitch, true)
        assert(abs(score_voices[0].left - score_voices[1].left) < 0.00000001)
        loop iteration in [0..64):
            gain = if iteration < 5: 0.7 else: (if iteration < 13: 0.0 else: 0.22)
            score_set_volume(a, gain)
            score_set_volume(b, gain)
            av = __voices[0]
            bv = __voices[1]
            assert(av.sound.samples.len() <= (int(ceil(8192.0 * pitch)) + 3) * 2)
            loop i in [0..av.sound.samples.len()):
                assert(abs(f64(av.sound.samples[i] - bv.sound.samples[i])) <= f64(legacy.scale) * 0.501 + 0.00000001,
                    "hold/release matches former bake within its half-quantum rounding")
                comparisons += 1
            __mix(if iteration % 3 == 0: 8192 else: 800)
assert(source.samples == original, "held voices never mutate the shared bank")
# The public path retains only audible dynamic voices and source bank handles.
piano.ready = true
piano.soft = fill(source, PIANO_COUNT)
piano.notes = fill(source, PIANO_COUNT)
piano.forte = fill(source, PIANO_COUNT)
loop vel in [0.2, 0.5, 0.68, 0.8, 1.0]:
    stop_all()
    score_voices.clear()
    piano_play(74, vel, hold = 2.75)
    blend = piano_blend(vel)
    assert(score_voices.len() == int(blend.pp > 0.000001) + int(blend.mf > 0.000001) + int(blend.ff > 0.000001))
    loop v in score_voices:
        assert(data(v.packed.samples) == data(source.samples), "hold retains the compact source, no full-note allocation")
print("PASS held piano: {comparisons} ring samples, fractional pitches, release boundaries, wraps, interrupted gain ramps, immutable banks and audible layers")

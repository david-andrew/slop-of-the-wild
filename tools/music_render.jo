use '../game/music.jo'
use '../game/sfx.jo'
use '../game/env.jo'
use '../game/player.jo'
use '../game/combat.jo'
use '../game/enemies.jo'
use '../game/gfx.jo'
use 'music_event_paths.jo'
use '../game/physics.jo'
from '../game/music.jo' import __was_combat, __alert_t
from '../game/sfx.jo' import __sfx_rng, __sfx_drawing, __sfx_rustle_t
from '../game/sfx.jo' import __echoes, __amb_k, __amb_cover, __amb_gust, __amb_snow, __amb_forest, __amb_ruins, __peck_t

# Score exports at gameplay gains/pans; live route/mix exports use the actual sequencer and mixer.
# sloppy/bin/sloppy tools/music_render.jo [out_dir] [mood_seconds]
out_dir = if args().len() > 1: args()[1] else: "/tmp/botw_music"
SECS = if args().len() > 2: max(30.0, to_float(args()[2]) ?? 75.0) else: 75.0
mkdir(out_dir)
t_init = time()
piano_init()
__audio_state = 2                 # offline mixer; never open a playback device
master_volume(0.8)
bytes = 0
loop bank in [piano.soft, piano.notes, piano.forte, piano.short_soft, piano.short_notes, piano.short_forte]:
    loop s in bank: bytes += s.samples.len() * 4
print("piano bank {time() - t_init:.3}s, {piano.notes.len()} mf + {piano.soft.len()} pp + {piano.forte.len()} ff notes, {bytes} bytes resident samples")
sr = MIX_RATE

__wav = (path: str, mixb: mut f32[], mixed: bool = false):
    if not mixed: audio_peak_guard(mixb)
    peak: f32 = 0.0
    energy = 0.0
    clipped = 0
    quiet = 0
    windows = 0
    window_energy = 0.0
    window_samples = sr / 10 * 2
    loop i in 0.. and v in mixb:
        peak = max(peak, abs(v))
        energy += f64(v) * f64(v)
        window_energy += f64(v) * f64(v)
        if abs(v) >= 1.0: clipped += 1
        if (i + 1) % window_samples == 0:
            if window_energy / f64(window_samples) < 0.000001: quiet += 1
            windows += 1
            window_energy = 0.0
    n = mixb.len() / 2
    b: u8[]
    w32 = (v: int):
        loop k in [0..4): b.push(u8((v >> (8 * k)) & 255))
    w16 = (v: int):
        loop k in [0..2): b.push(u8((v >> (8 * k)) & 255))
    loop c in "RIFF": b.push(c)
    w32(36 + n * 4)
    loop c in "WAVEfmt ": b.push(c)
    w32(16)
    w16(1)
    w16(2)
    w32(sr)
    w32(sr * 4)
    w16(4)
    w16(16)
    loop c in "data": b.push(c)
    w32(n * 4)
    g = 1.0                    # fixed export gain, so comparisons retain gameplay balance
    print("levels {path}: peak {peak:.6} RMS {sqrt(energy / f64(mixb.len())):.6} ({20.0 * log10(max(sqrt(energy / f64(mixb.len())), 0.000000001)):.2} dBFS) silence {100.0 * f64(quiet) / f64(max(windows, 1)):.1}% (-60dBFS/100ms) gain {g:.6} clipped {clipped}")
    loop v in mixb:
        q = int(clamp(f64(v) * g, -1.0, 1.0) * 32767.0)
        w16(q & 0xFFFF)
    assert(clipped == 0 and peak < 0.9, "music export must retain unclipped headroom")
    assert(write_bytes(path, b), "WAV export failed; create the output parent directory first")

__put = (mixb: mut f32[], midi: int, at: f64, vel: f64, volume: f64 = 0.8, pan: f64 = 0.0, short: bool = false, restrained: bool = false):
    b = piano_blend(vel)
    soft = if restrained: piano.restrained_soft else: (if short: piano.short_soft else: piano.soft)
    notes = if short: piano.short_notes else: piano.notes
    forte = if short: piano.short_forte else: piano.forte
    if b.pp > 0.000001: __put_s(mixb, soft, midi, at, vel, volume, pan, b.pp)
    if b.mf > 0.000001: __put_s(mixb, notes, midi, at, vel, volume, pan, b.mf)
    if b.ff > 0.000001: __put_s(mixb, forte, midi, at, vel, volume, pan, b.ff)

__put_s = (mixb: mut f32[], bank: Sound[], midi: int, at: f64, vel: f64, volume: f64, pan: f64, layer: f64):
    k = clamp((midi - PIANO_LO + PIANO_STEP / 2) / PIANO_STEP, 0, bank.len() - 1)
    base = PIANO_LO + k * PIANO_STEP
    pitch = pow(2.0, f64(midi - base) / 12.0)
    s = bank[k].samples
    __put_sample(mixb, s, at, pitch, piano_gain(vel, volume) * layer * 0.8, pan)

__put_sample = (mixb: mut f32[], s: f32[], at: f64, pitch: f64, gain: f64, pan: f64):
    nf = s.len() / 2
    total = mixb.len() / 2
    start = int(at * f64(sr))
    pos = 0.0
    g = f32(gain)
    gl = g * f32(1.0 - max(pan, 0.0))
    gr = g * f32(1.0 + min(pan, 0.0))
    loop i in [start..total):
        ip = int(pos)
        if ip + 1 >= nf: break
        fr = f32(pos - f64(ip))
        mixb[i * 2] += (s[ip * 2] + (s[ip * 2 + 2] - s[ip * 2]) * fr) * gl
        mixb[i * 2 + 1] += (s[ip * 2 + 1] + (s[ip * 2 + 3] - s[ip * 2 + 1]) * fr) * gr
        pos += pitch

__render_mood = (m: Mood, seconds: f64, path: str):
    seed_random(7)
    phrase_n = 0
    seq = Seq()
    music_motif_count = 0
    music_still = 0.0
    mixb = fill(f32(0), int(seconds * f64(sr)) * 2)
    t = 2.0
    notes = 0
    lo = 200
    hi = 0
    motifs = 0
    figures = 0
    rest_lo = 100.0
    rest_hi = 0.0
    loop t < seconds - 12.0:
        seq.age = t
        evs = p_phrase(m)
        if phrase_used_motif: motifs += 1
        figures += 1
        last = 0.0
        loop e in evs:
            if e.glass: __put_sample(mixb, shrine_glass.samples, t + e.t, pow(2.0, f64(e.midi - 72) / 12.0), e.gain * music_vol * 0.8, 0.22)
            else: __put(mixb, e.midi, t + e.t, e.vel, field_gain(m) * e.gain, piano_pan(e.midi))
            notes += 1
            lo = min(lo, e.midi)
            hi = max(hi, e.midi)
            last = max(last, e.t)
        rest = phrase_rest(m)
        rest_lo = min(rest_lo, rest)
        rest_hi = max(rest_hi, rest)
        t += last + rest
    __wav(path, mixb)
    print("{m:12} {f64(notes) / seconds * 60.0:5.1} notes/min   {notes} notes, {figures} figures   rest {rest_lo:.1}-{rest_hi:.1}s   range {lo}-{hi}   motif x{motifs}")

loop m in [Mood.field_day, Mood.field_golden, Mood.field_night, Mood.field_rain, Mood.forest, Mood.snow, Mood.ruins, Mood.shrine]:
    __render_mood(m, SECS, "{out_dir}/{m}.wav")
env.night = 1.0
__render_mood(.shrine, SECS, "{out_dir}/shrine_night.wav")
env.night = 0.0
if SECS != 180.0: __render_mood(.field_day, 180.0, "{out_dir}/field_day_180.wav")

# JotW's original figures/timing, on our bank at the same quiet velocity/gain.
reference = [[0, 7, 14, 12, 7], [3, 10, 17, 14, 7], [-12, -5, 2, 0, -5], [-9, -2, 5, 3, -2]]
gaps = [0.42, 1.35, 0.72, 2.1, 0.9]
seed_random(7)
refmix = fill(f32(0), int(180.0 * f64(sr)) * 2)
tref = 2.0
refnotes = 0
loop tref < 168.0:
    phrase = reference[(refnotes / 5) % reference.len()]
    loop i in [0..phrase.len()):
        __put(refmix, 69 + phrase[i], tref, 0.35, 0.8, sin(f64(i) * 1.7) * 0.22)
        refnotes += 1
        if i + 1 < phrase.len(): tref += gaps[i]
    tref += 22.0 + random(0.0, 19.0)
__wav("{out_dir}/jotw_reference_180.wav", refmix)
print("jotw reference {f64(refnotes) / 3.0:.1} notes/min, {refnotes} notes, A4 root, all four figures, day gaps, 22-41s rests")

# Each combat tier uses the production hit generator, gains and pans.
loop tier in [CombatTier.alert, CombatTier.engaged, CombatTier.low_hp]:
    cb = fill(f32(0), int(50.0 * f64(sr)) * 2)
    cstep = 60.0 / COMBAT_BPM / 2.0
    cn = 0
    loop k in [0..int(40.0 / cstep)):
        at = 1.0 + f64(k) * cstep
        loop h in combat_step_hits(k, tier):
            if h.drum == 0:
                __put(cb, h.midi, at, h.vel, (if h.midi < 52: 0.55 else: 0.5) * combat_gain(tier), (if h.midi < 52: -0.2 else: 0.15), true, h.restrained)
                cn += 1
            else:
                ds = if h.drum == 1: drum_lo.samples else: drum_hi.samples
                pan = if h.drum == 1: -0.1 else: 0.1
                st = int(at * f64(sr)) * 2
                loop i in [0..min(ds.len(), cb.len() - st)):
                    pg = if i % 2 == 0: 1.0 - max(pan, 0.0) else: 1.0 + min(pan, 0.0)
                    cb[st + i] += ds[i] * f32(h.vel * pg * combat_gain(tier) * 0.8)
    loop i in [0..combat_entry.samples.len()): cb[int(f64(sr)) * 2 + i] += combat_entry.samples[i] * f32(COMBAT_ENTRY_LEVEL * COMBAT_GAIN * 0.8)
    __wav("{out_dir}/combat_{tier}.wav", cb)
    texture = if tier == .low_hp: "140ms damped bass, muted stabs" else: "260ms damped piano"
    print("combat {tier:8} {f64(cn) / 40.0 * 60.0:5.1} notes/min, {COMBAT_BPM} bpm, {texture}, quiet frame drum")
loop c in ["wake", "title", "tower", "tower_night", "discovery", "orb", "orb_night", "victory", "alert", "item", "secret"]:
    laters.clear()
    env.night = if c == "tower_night" or c == "orb_night": 1.0 else: 0.0
    match c:
        "wake": wake_cue()
        "title": title_cue()
        "tower", "tower_night": tower_cue()
        "discovery": discovery_jingle()
        "orb", "orb_night": orb_jingle()
        "alert": alert_stab()
        "item": item_jingle()
        "secret": secret_jingle()
        _: victory_stinger()
    last = 0.0
    loop l in laters: last = max(last, l.t)
    mixb = fill(f32(0), int((max(last, 10.0) + 12.0) * f64(sr)) * 2)
    loop l in laters: __put(mixb, l.midi, l.t + 0.5, l.vel, l.vol)
    __wav("{out_dir}/cue_{c}.wav", mixb)
    print("cue {c:10} {laters.len()} notes over {last:.1} s")


# Three minutes along a straight-line route at walking/running speed, without terrain physics.
# 0s mouth -> 30s fire -> 60s temple -> 120s tower -> 175s abbey; discoveries at 60/120/175s.
walk_pos = (t: f64) -> vec3:
    ts = [0.0, 30.0, 60.0, 120.0, 175.0, 180.0]
    ps = [v3(-1068.0, 235.0, 1845.0), v3(-946.0, 235.0, 1883.0),
        v3(-818.0, 235.0, 1950.0), v3(-560.0, 235.0, 1722.0),
        v3(-495.0, 235.0, 1990.0), v3(-480.0, 235.0, 2000.0)]
    loop i in [0..ts.len()-1):
        if t < ts[i + 1]: return mix(ps[i], ps[i + 1], f32((t - ts[i]) / (ts[i + 1] - ts[i])))
    ps[ps.len()-1]

# Reset every state affecting score or mix, so like-for-like exports remain reproducible.
render_reset = ():
    stop_all()
    seq = Seq()
    seq.mood = .field_day
    seq.want = .field_day
    seq.volume = 1.0
    seq.rest = 2.0
    phrase_n = 0
    music_note_count = 0
    music_motif_count = 0
    music_still = 0.0
    music_hold = 0.0
    music_activity = 0.0
    music_duck = 1.0
    music_duck_floor = 1.0
    music_duck_hold = 0.0
    sfx_priority_gain = 1.0
    sfx_priority_hold = 0.0
    score_voices.clear()
    laters.clear()
    loop mut p in music_landmarks:
        p.last = -180.0
        p.inside = false
    amb = Ambient()
    __amb_k = 0.0
    __amb_cover = 0.0
    __amb_snow = 0.0
    __amb_forest = 0.0
    __amb_ruins = 0.0
    __amb_gust = 0.0
    __peck_t = 5.0
    amb_lift = 0.0
    sfx_room = 0.0
    __echoes.clear()
    __was_combat = false
    __alert_t = -100.0
    __sfx_rng = rng(7707)
    __sfx_drawing = false
    __sfx_rustle_t = 0.0
    music_step_n = 0
    loop mut bank in sfx_takes: bank.last = -1
    amb_biome = 0
    shrine_hum = 0.35
    env.rain = 0.0
    env.clouds = 0.0
    env.night = 0.0
    env.gust = 1.0
    pl = Player()
    fight = Fight()
    enemies.clear()
    pl.pos = v3(-700.0, 235.0, 1800.0)
    seed_random(7)
    # (the process's first play() starts the audio, ~20 ms once; the game does it at load with the
    # ambient loops, so warm it here too rather than time it as a music update)
    stop(play(piano.notes[0], 0.0))

# Ten minutes of score/ambience state, not a physical traversal validation.
# Each landmark is left beyond its hysteresis radius before its repeat visit.
route_times = [0.0, 30.0, 60.0, 120.0, 180.0, 240.0, 270.0, 300.0, 330.0, 360.0, 420.0, 480.0, 540.0, 570.0, 600.0]
route_points = [v3(-1200.0, 235.0, 1820.0), v3(-1068.0, 235.0, 1845.0), v3(-946.0, 235.0, 1883.0),
    v3(-900.0, 235.0, 1600.0), v3(-1400.0, 310.0, 1500.0), v3(-818.0, 235.0, 1950.0),
    v3(-495.0, 235.0, 1990.0), v3(-450.0, 235.0, 2200.0), v3(-946.0, 235.0, 1883.0),
    v3(-1068.0, 235.0, 1845.0), v3(-900.0, 235.0, 1600.0), v3(-1400.0, 310.0, 1500.0),
    v3(-818.0, 235.0, 1950.0), v3(-560.0, 235.0, 1722.0), v3(-495.0, 235.0, 1990.0)]
route_pos = (t: f64) -> vec3:
    loop i in [0..route_times.len()-1):
        if t < route_times[i + 1]: return mix(route_points[i], route_points[i + 1], f32((t - route_times[i]) / (route_times[i + 1] - route_times[i])))
    route_points[route_points.len()-1]

# Explicit repeat/hysteresis boundaries independent of a lucky seeded route.
check_visits = ():
    render_reset()
    p = music_landmarks[0]
    at = v3(p.x, 235.0, p.z)
    outside = at + v3(p.radius * 1.31, 0.0, 0.0)
    check_at = (t: f64, pos: vec3):
        seq.age = t
        seq.landmark_t = 0.0
        seq.motif_pending = false
        pl.pos = pos
        music_landmark_update(1.0)
    check_at(0.0, at)
    assert(seq.motif_pending, "first visit requests motif")
    check_at(200.0, at)
    assert(not seq.motif_pending, "lingering does not retrigger")
    check_at(200.0, at + v3(p.radius * 1.29, 0.0, 0.0))
    check_at(201.0, at)
    assert(not seq.motif_pending, "1.29 radii does not rearm")
    check_at(201.0, outside)
    check_at(202.0, at)
    assert(seq.motif_pending, "1.31 radii rearms eligible repeat")
    check_at(250.0, outside)
    check_at(381.99, at)
    assert(not seq.motif_pending, "repeat before 180 seconds rejected")
    check_at(381.99, outside)
    check_at(382.0, at)
    assert(seq.motif_pending, "repeat at 180 seconds accepted")
    seq.want = .shrine
    check_at(600.0, outside)
    check_at(601.0, at)
    assert(not seq.motif_pending, "shrine suppresses outdoor landmarks")
    print("PASS: once per visit; hysteresis 1.29/1.31 radii; repeat cooldown 179.99/180s; shrine suppression")

render_live = (name: str, seconds: f64, ambience: bool = false):
    render_reset()
    mixb: f32[]
    costs: f64[]
    vmax = 0
    ambience_rng = rng(77)
    timeline = "seconds,mood,notes,motifs,figures,activity\n"
    motif_at = -1000.0
    motif_gap = 1000.0
    visits = fill(0, music_landmarks.len())
    previous_visit = fill(-180.0, music_landmarks.len())
    loop frame in [0..int(seconds * 60.0)):
        t = f64(frame) / 60.0
        dt = 1.0 / 60.0
        pl.pos = walk_pos(t)
        if name == "biome_route_600":
            pl.pos = route_pos(t)
            m = if t < 90.0: Mood.field_day else: (if t < 150.0: Mood.forest else: (if t < 210.0: Mood.snow else: (if t < 280.0: Mood.ruins else: (if t < 320.0: Mood.shrine else: (if t < 390.0: Mood.field_day else: (if t < 450.0: Mood.forest else: (if t < 510.0: Mood.snow else: (if t < 555.0: Mood.ruins else: Mood.field_night))))))))
            music_mood(m)
            amb_biome = if m == .forest: 1 else: (if m == .snow: 2 else: (if m == .ruins: 3 else: 0))
            env.night = if t >= 555.0: 1.0 else: 0.0
            env.rain = if t >= 390.0 and t < 450.0: 0.7 else: 0.0
            env.clouds = env.rain
            env.gust = 1.0 + env.rain * (1.1 + 0.4 * sin(t * 0.4))
        if name == "biome_route_180":
            m = if t < 30.0: Mood.field_day else: (if t < 65.0: Mood.forest else: (if t < 90.0: Mood.snow else: (if t < 110.0: Mood.ruins else: (if t < 150.0: Mood.field_golden else: Mood.field_night))))
            music_mood(m)
            amb_biome = if m == .forest or t >= 150.0: 1 else: (if m == .snow: 2 else: (if m == .ruins: 3 else: 0))
            env.hour = if t < 110.0: 11.0 else: (if t < 150.0: 18.4 else: 23.0)
            env.night = if t >= 150.0: 1.0 else: (if t >= 110.0: 0.35 else: 0.0)
            env.gust = 1.7 + sin(t * 0.19) * 1.1
            pl.pos = if t < 30.0: v3(-1030, 235, 1805) else: (if t < 65.0 or t >= 150.0: v3(-1040, 240, 1640) else: (if t < 90.0: v3(-1400, 370, 2180) else: (if t < 110.0: v3(-818, 235, 1950) else: v3(-1230, 235, 1650))))
        if name == "contexts":
            # exploration -> rain -> shrine -> combat -> shrine -> clear exploration.
            pl.pos = v3(-700.0, 235.0, 1800.0)
            m = if t < 20.0: Mood.field_day else: (if t < 40.0: Mood.field_rain else: (if t < 60.0: Mood.shrine else: (if t < 85.0: Mood.combat else: (if t < 105.0: Mood.shrine else: Mood.field_day))))
            music_mood(m)
            env.rain = if t >= 20.0 and t < 40.0: 1.0 else: 0.0
            env.clouds = env.rain
        if name == "stationary":
            pl.pos = v3(-700.0, 235.0, 1800.0)
            music_still = t
        if starts_with(name, "combat_"):
            pl.pos = v3(-700.0, 235.0, 1800.0)
            music_mood(.combat)
            # Use real threat/HP inputs, rather than forcing the sequencer tier.
            if name == "combat_engaged" or name == "combat_low_hp": fight.act = .swing
            if name == "combat_low_hp": pl.hp = 4
        old_notes = music_note_count
        old_motifs = music_motif_count
        old_mood = seq.mood
        start = time()
        music_update(dt)
        jingles_update(dt)
        costs.push((time() - start) * 1000.0)
        if old_motifs != music_motif_count:
            if motif_at >= 0.0:
                motif_gap = min(motif_gap, t - motif_at)
                assert(t - motif_at >= 89.98, "live motif start gap >= 90s")
            motif_at = t
        loop i in [0..music_landmarks.len()):
            if music_landmarks[i].last != previous_visit[i]:
                visits[i] += 1
                assert(music_landmarks[i].last - previous_visit[i] >= 179.98, "live repeat visit cooldown")
                previous_visit[i] = music_landmarks[i].last
        if name == "field_day_walk" and (frame == 3600 or frame == 7200 or frame == 10500): discovery_jingle()
        if name == "contexts" and frame == 5100: victory_stinger()
        if ambience:
            amb_lift = if seq.events.len() == 0 and seq.mood != .combat: 1.0 else: 0.0
            indoor = if seq.mood == .shrine: 1.0 else: 0.0
            fire = if name == "field_day_walk": clamp(1.0 - f64(length(pl.pos - v3(-946.0, 235.0, 1883.0))) / 12.0, 0.0, 1.0) * 0.5 else: 0.0
            # Keep the compared score identical; ambience otherwise consumes the score's RNG.
            score_rng = __global_rng
            __global_rng = ambience_rng
            ambient_update(dt, indoor, f64(pl.pos.y), fire)
            ambience_rng = __global_rng
            __global_rng = score_rng
        if old_notes != music_note_count or old_motifs != music_motif_count or old_mood != seq.mood:
            timeline = "{timeline}{t:.3},{seq.mood},{music_note_count},{music_motif_count},{phrase_n},{music_activity:.3}\n"
        vmax = max(vmax, __voices.len())
        __mix(MIX_RATE / 60)
        loop v in __mix_buf: mixb.push(v)
    if name == "biome_route_600":
        print("route visits temple/tower/fire/mouth/abbey {visits}; motif minimum start gap {motif_gap:.3}s")
        assert(visits[0] >= 2 and visits[2] >= 2 and visits[3] >= 2 and visits[4] >= 2, "route exercises repeat visits")
    suffix = if ambience: "_mix" else: (if starts_with(name, "combat_"): "_live" else: "")
    assert(write_file("{out_dir}/{name}{suffix}.csv", timeline), "timeline export failed")
    __wav("{out_dir}/{name}{suffix}.wav", mixb, true)
    if name == "contexts":
        starts = [0.0, 20.0, 40.0, 60.0, 85.0, 105.0]
        ends = [20.0, 40.0, 60.0, 85.0, 105.0, 125.0]
        labels = ["field", "rain", "shrine", "combat", "shrine_return", "field_return"]
        field_peak_db = 0.0
        field_rms_db = 0.0
        loop k in [0..starts.len()):
            energy = 0.0
            peak = 0.0
            first = int(starts[k] * f64(sr)) * 2
            last = int(ends[k] * f64(sr)) * 2
            loop i in [first..last):
                v = f64(mixb[i])
                energy += v * v
                peak = max(peak, abs(v))
            rms = sqrt(energy / f64(last - first))
            peak_db = 20.0 * log10(max(peak, 0.000000001))
            rms_db = 20.0 * log10(max(rms, 0.000000001))
            if k == 0:
                field_peak_db = peak_db
                field_rms_db = rms_db
            if k == 4:
                # This window includes the incoming shrine figure as well
                # as victory. Account for day's -2 dB context trim before
                # comparing their authored peak/RMS margins.
                return_lift = 20.0 * log10(field_gain(.shrine) / field_gain(.field_day))
                peak_delta = peak_db - field_peak_db - return_lift
                rms_delta = rms_db - field_rms_db - return_lift
                print("cue/field{suffix}: shrine-return peak {peak_delta:+.2} dB, RMS {rms_delta:+.2} dB after {return_lift:.1} dB context trim; limits +2/+4 dB")
                assert(peak_delta <= 2.0 and rms_delta <= 4.0, "shrine-return cue must stay within 2 dB peak / 4 dB RMS (including outgoing combat tails) of field")
            print("context {labels[k]}{suffix}: {starts[k]:.0}-{ends[k]:.0}s peak {20.0 * log10(max(peak, 0.000000001)):.2} dBFS RMS {20.0 * log10(max(rms, 0.000000001)):.2} dBFS; master 0.8/export 1.0")
    sort(costs)
    print("live {name}{suffix}: {f64(music_note_count) / seconds * 60.0:.1} notes/min, {music_note_count} notes, motif x{music_motif_count}; update+jingles ms median {costs[costs.len()/2]:.4} p99 {costs[int(f64(costs.len())*0.99)]:.4} max {costs[costs.len()-1]:.4}; max voices {vmax}")

# Continuous score/foley through the production mixer and event/cue dispatch.
# Deliberately overlap the outgoing context's tails with the incoming cue.
# No per-segment reset, normalization, forced tier or synthetic score notes.
render_encounter = (ambience: bool):
    render_reset()
    music_event_source_check()
    mixb: f32[]
    timeline = "seconds,event,mood,tier,hp,voices\n"
    ambience_rng = rng(77)
    seen = fill(false, 3)
    foley_rng = rng(7707)
    loop frame in [0..10800):
        t = f64(frame) / 60.0
        dt = 1.0 / 60.0
        pl.pos = v3(-700.0, 235.0, 1800.0)
        pl.state = .ground
        pl.ground.surf = if t < 80.0: Surf.grass else: Surf.stone
        pl.vel = if t < 20.0 or t >= 100.0: vec3(0, 0, 2) else: vec3(0, 0, 0)
        pl.hp = if t >= 60.0 and t < 80.0: 4 else: pl.hp_max
        fight.act = if t >= 40.0 and t < 80.0: Act.swing else: Act.idle
        enemies.clear()
        if t >= 20.0 and t < 80.0:
            enemies.push(Enemy(kind = .bokoblin, pos = pl.pos + v3(0.0, 0.0, (if t < 40.0: 28.0 else: 7.0)), state = .chase))
        fighting = in_combat()
        mood = if fighting: Mood.combat else: (if t >= 80.0 and t < 100.0 or t >= 140.0 and t < 160.0: Mood.shrine else: (if t >= 120.0 and t < 140.0: Mood.field_rain else: Mood.field_day))
        music_mood(mood)
        combat_watch(fighting, enemies.len() > 0)
        event = ""
        if frame == 1200:
            alert_stab()
            event = "notice+combat"
        if frame == 4800: event = "victory+shrine"
        if frame == 6000:
            orb_jingle()
            event = "orb+field"
        if frame == 7200:
            discovery_jingle()
            event = "discovery+rain"
        if frame == 8400: event = "shrine_return"
        if frame == 9600: event = "field_return"
        pl.events.clear()
        if length(pl.vel) > 0.0 and frame % 32 == 0: pl.events.push("step")
        if fighting and t >= 40.0 and frame % 72 == 0: pl.events.push("swing")
        if frame == 3600:
            pl.events.push("hurt")
            event = "hurt+low_hp"
        if fighting and t >= 40.0 and frame % 180 == 0: pl.events.push("block")
        if ambience:
            saved = __global_rng
            __global_rng = foley_rng
            music_player_events()
            foley_rng = __global_rng
            __global_rng = saved
        music_update(dt)
        jingles_update(dt)
        if t >= 21.0 and t < 40.0:
            assert(seq.mood == .combat and seq.combat_tier == .alert, "distant hunting uses alert tier")
            seen[0] = true
        if t >= 41.0 and t < 60.0:
            assert(seq.combat_tier == .engaged, "close fight escalates on beat")
            seen[1] = true
        if t >= 61.0 and t < 80.0:
            assert(seq.combat_tier == .low_hp, "real HP inputs sustain low-health tier")
            seen[2] = true
        env.rain = if mood == .field_rain: 0.7 else: 0.0
        env.clouds = env.rain
        if ambience:
            amb_lift = if seq.events.len() == 0 and seq.mood != .combat: 1.0 else: 0.0
            sfx_room = if mood == .shrine: 1.0 else: 0.0
            saved = __global_rng
            __global_rng = ambience_rng
            ambient_update(dt, sfx_room, f64(pl.pos.y), 0.0)
            ambience_rng = __global_rng
            __global_rng = saved
        if len(event) > 0:
            timeline = "{timeline}{t:.3},{event},{seq.mood},{seq.combat_tier},{pl.hp},{__voices.len()}\n"
            if frame == 4800 or frame == 6000 or frame == 7200:
                assert(laters.len() > 0 and seq.want != seq.mood, "cue scheduled on the same tick as context change")
        __mix(sr / 60)
        loop v in __mix_buf: mixb.push(v)
    assert(seen[0] and seen[1] and seen[2], "continuous sequence exercises every combat tier")
    suffix = if ambience: "_mix" else: ""
    __wav("{out_dir}/encounter_transitions{suffix}.wav", mixb, true)
    assert(write_file("{out_dir}/encounter_transitions{suffix}.csv", timeline))
    labels = ["field_steps", "alert", "engaged", "low_hp", "victory_shrine", "orb_field", "discovery_rain", "shrine_return", "field_return"]
    levels = "segment,start,end,peak_dbfs,rms_dbfs,peak_limit,rms_limit\n"
    field_peak = 0.0
    field_rms = 0.0
    loop k in [0..labels.len()):
        energy = 0.0
        peak = 0.0
        first = k * 20 * sr * 2
        last = first + 20 * sr * 2
        loop i in [first..last):
            v = f64(mixb[i])
            peak = max(peak, abs(v))
            energy += v * v
        pdb = 20.0 * log10(max(peak, 1e-9))
        rdb = 20.0 * log10(max(sqrt(energy / f64(last - first)), 1e-9))
        if k == 0:
            field_peak = pdb
            field_rms = rdb
        combat = k >= 1 and k <= 3
        cue = k == 4 or k == 5 or k == 6
        # All score/full mixes now use the shared master guard. Reserve
        # 0.5 dB sample headroom in score-only combat; the export audit meters
        # the actual -1 dBTP ceiling, including overlapping alert/entry voices.
        # The discovery/rain section contains the now +5 dB rain score;
        # compare it at its own gain, rather than the day score's -2 dB trim.
        rain_lift = if k == 6: 20.0 * log10(field_gain(.field_rain) / field_gain(.field_day)) else: 0.0
        peak_limit = if combat: (if ambience: -1.0 else: -1.5) else: (if cue: min(-1.5, field_peak + 4.0 + rain_lift) else: (if ambience: -1.0 else: field_peak + 4.0))
        # Keep the authored window width after the shared +4.5 dB combat
        # gain and +1.7 dB last-heart compensation; true peaks are metered
        # separately over every export, including score-only buffers.
        combat_lift = 4.5 + (if k == 3: 1.7 else: 0.0)
        rms_limit = if combat: (if ambience: [-26.0, -26.0, -24.0][k - 1] else: [-26.0, -28.0, -27.0][k - 1]) + combat_lift else: field_rms + 4.0 + rain_lift
        # Add the allowed continuous shrine bed in energy, not dB. Score-only
        # captures still enforce the original cue/tail margin; listen.py meters
        # the isolated bed at -30..-28 LUFS and checks full-context contrast.
        if ambience and (k == 4 or k == 7): rms_limit = 10.0 * log10(pow(10.0, rms_limit / 10.0) + pow(10.0, -28.0 / 10.0))
        print("encounter {labels[k]}{suffix}: peak {pdb:.2} / {peak_limit:.2}, RMS {rdb:.2} / {rms_limit:.2} dBFS; delta field {pdb - field_peak:+.2}/{rdb - field_rms:+.2} dB")
        assert(pdb <= peak_limit and rdb <= rms_limit, "encounter segment exceeds peak/RMS regression limit")
        # Low-health presence uses the score-only floor: random foley must not
        # be required to fill its authored bass rests and cue-ducked gaps.
        if combat: assert(rdb >= (if ambience: [-37.0, -33.0, -33.0][k - 1] else: [-38.0, -34.0, -33.0][k - 1]) + combat_lift, "combat score disappeared")
        if k == 7: assert(rdb < rms_limit, "outgoing combat/cue tails clear before shrine return")
        levels = "{levels}{labels[k]},{k * 20},{(k + 1) * 20},{pdb:.3},{rdb:.3},{peak_limit:.3},{rms_limit:.3}\n"
    assert(write_file("{out_dir}/encounter_levels{suffix}.csv", levels))
    print("PASS continuous encounter{suffix}: source-audited footsteps, alert/engaged/low-health, simultaneous victory/shrine + orb/field + discovery/rain, shrine and field return; fixed master 0.8/export 1.0")

seed_random(7)
sfx_init()
check_visits()
render_encounter(false)
render_encounter(true)
render_live("field_day_walk", 180.0)
render_live("field_day_walk", 180.0, true)
render_live("landmarks", 180.0)
render_live("contexts", 125.0)
render_live("contexts", 125.0, true)
render_live("stationary", 180.0)
render_live("combat_alert", 50.0)
render_live("combat_engaged", 50.0)
render_live("combat_low_hp", 50.0)
render_live("biome_route_180", 180.0)
render_live("biome_route_180", 180.0, true)
render_live("biome_route_600", 600.0)
render_live("biome_route_600", 600.0, true)
print("wrote {out_dir}/*.wav")

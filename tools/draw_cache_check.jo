# Caller owns flock /tmp/botw-render.lock. Exercise shared native mesh state,
# two shader programs, indexed/nonindexed draws and updated dynamic VBO storage.
use '../game/gfx.jo'
struct CacheVert:
    pos: vec2
    color: vec4
struct CacheU:
    gain: f32
struct CacheO:
    pos: vec4
    color: vec4
struct CacheInst:
    offset: vec2
cache_vs = (v: CacheVert, u: CacheU) -> CacheO:
    CacheO(vec4(v.pos, 0, 1), v.color * u.gain)
cache_fs = (v: CacheO, u: CacheU) -> vec4: v.color
cache_alt_vs = (v: CacheVert, u: CacheU) -> CacheO:
    CacheO(vec4(v.pos, 0, 1), v.color.bgra * u.gain)
cache_inst_vs = (v: CacheVert, i: CacheInst, u: CacheU) -> CacheO:
    CacheO(vec4(v.pos + i.offset, 0, 1), v.color * u.gain)
window("Plain draw VAO isolation", 32, 32)
a = make_sh(shader(cache_vs, cache_fs))
b = make_sh(shader(cache_alt_vs, cache_fs))
s = make_sh(shader(cache_inst_vs, cache_fs))
verts = [CacheVert(vec2(-1, -1), vec4(0.2, 0.4, 0.6, 1)), CacheVert(vec2(3, -1), vec4(0.2, 0.4, 0.6, 1)), CacheVert(vec2(-1, 3), vec4(0.2, 0.4, 0.6, 1))]
m = mesh(verts)
indexed = mesh(verts, [u32(0), u32(1), u32(2)])
instances = inst_buffer([CacheInst(vec2(0, 0))])
target = make_target(32, 32, false, false)
read = (sh: Shader, model: Mesh, fast: bool) -> u8[]:
    bind_target(target)
    glDisable(GL_DEPTH_TEST)
    glDisable(GL_CULL_FACE)
    glDisable(GL_BLEND)
    glClearColor(0, 0, 0, 0)
    glClear(GL_COLOR_BUFFER_BIT)
    if fast:
        draw_uniform_begin()
        draw_fast(sh, model, CacheU(0.25))
        draw_fast(sh, model, CacheU(0.5))
        draw_fast(sh, model, CacheU(0.5))
        draw_uniform_end()
    else: draw(sh, model, CacheU(0.5))
    pixels = fill(u8(0), 32 * 32 * 4)
    gl_read_pixels(0, 0, 32, 32, data(pixels))
    pixels
check = (sh: Shader, model: Mesh):
    expected = read(sh, model, false)
    assert(expected[3] >= 127 and expected[3] <= 129, "reference really rendered")
    actual = read(sh, model, true)
    loop i in [0..actual.len()): assert(actual[i] == expected[i], "cached/reference pixels differ")
loop i in [0..6):
    loop model in [m, indexed]:
        check(a, model)
        draw_static(s, model, instances, CacheU(0.25))
        check(b, model)
        check(a, model)
# Updating VBO storage and count must not leave cached geometry/count behind.
update_mesh(m, [CacheVert(vec2(-1, -1), vec4(0.6, 0.2, 0.4, 1)), CacheVert(vec2(1, -1), vec4(0.6, 0.2, 0.4, 1)), CacheVert(vec2(-1, 1), vec4(0.6, 0.2, 0.4, 1)), CacheVert(vec2(1, -1), vec4(0.6, 0.2, 0.4, 1)), CacheVert(vec2(1, 1), vec4(0.6, 0.2, 0.4, 1)), CacheVert(vec2(-1, 1), vec4(0.6, 0.2, 0.4, 1))])
assert(m.count == 6)
check(a, m)
check(b, m)
# A direct runtime write outside the scope must not leave stale cache state.
draw(a, m, CacheU(0.125))
check(a, m)
# Texture bindings are global GL state even when sampler uniforms are unchanged.
struct CacheTexU:
    tex: Texture
    gain: f32
tex_vs = (v: CacheVert, u: CacheTexU) -> CacheO: CacheO(vec4(v.pos, 0, 1), v.color)
tex_fs = (v: CacheO, u: CacheTexU) -> vec4: sample(u.tex, vec2(0.5, 0.5)) * u.gain
tex_sh = make_sh(shader(tex_vs, tex_fs))
red = bytes_texture(1, 1, [u8(255), 0, 0, 255], false, false)
blue = bytes_texture(1, 1, [u8(0), 0, 255, 255], false, false)
u = CacheTexU(red, 0.5)
bind_target(target)
draw(tex_sh, m, u)
expected = fill(u8(0), 32 * 32 * 4)
gl_read_pixels(0, 0, 32, 32, data(expected))
draw_uniform_begin()
draw_fast(tex_sh, m, CacheTexU(blue, 0.25))
draw_fast(tex_sh, m, u)
glActiveTexture(GL_TEXTURE0)
glBindTexture(GL_TEXTURE_2D, u32(blue.id))
draw_fast(tex_sh, m, u)
draw_uniform_end()
actual = fill(u8(0), 32 * 32 * 4)
gl_read_pixels(0, 0, 32, 32, data(actual))
assert(expected[0] >= 127 and expected[2] == 0)
loop i in [0..actual.len()): assert(actual[i] == expected[i], "texture binding restored inside cached scope")
print("draw cache: alternating shader/instanced VAOs, indexed and dynamic count/VBO storage update; identical RGBA bytes, scalar updates and external sampler binding interference PASS")

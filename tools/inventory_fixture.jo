# Every defined obtainable item together; render under flock /tmp/botw-render.lock.
# args: tab [selection]; SLOPPY_SCREENSHOT / SLOPPY_FRAMES control capture.
use '../game/gfx.jo'
use '../game/items.jo'
use '../game/inventory.jo'
use '../game/input.jo'
from '../game/inventory.jo' import __tab_items
use '../game/terrain.jo'
use '../game/worldgen.jo'
use '../game/structures.jo'
use '../game/interiors.jo'
use '../game/slate_map.jo'

inventory_fixture_fill = ():
    inv = Inventory(max_weapons = 32, max_shields = 32, max_bows = 32)
    loop d in idefs:
        if d.kind == .key:
            loop i in [0..4): assert(inv_add(d.id))
        else: assert(inv_add(d.id, 7))

items_init()
inventory_fixture_fill()
worldgen_load()
structures_pads()
sor_pads()
worldgen_finish()
find_shrines()
window("Full inventory", 1280, 720)
tab_ = if args().len() > 1: to_int(args()[1]) ?? 3 else: 3
sel_ = if args().len() > 2: to_int(args()[2]) ?? 0 else: 0
setup = ():
    map_known = true
    map_player = SOR_MOUTH
    map_cursor = vec2(f32((-818.0 - MAP_X0) / (MAP_X1 - MAP_X0)), f32((1950.0 - MAP_Z0) / (MAP_Z1 - MAP_Z0)))
    map_cursor_on = true
    invui = InvUI(open = true, tab = tab_, sel = sel_, t = 1.0, tab_t = 1.0)
    print("inventory fixture: tab={tab_} items={__tab_items(tab_).len()} definitions={idefs.len()}")
setup()
update = (dt: f64): pass
draw = ():
    glClearColor(0.10, 0.14, 0.17, 1)
    glClear(GL_COLOR_BUFFER_BIT)
    inventory_draw()

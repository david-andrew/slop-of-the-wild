# Minute-long observations and the actual drawn hoof transforms, no GPU needed.
use '../game/wildlife.jo'
use '../game/wildlife_motion.jo'
use '../game/gfx.jo'
use '../game/terrain.jo'
use '../game/player.jo'
use '../game/env.jo'

hf.n = 256
hf.x0 = -128.0
hf.z0 = -128.0
hf.cell = 1.0
hf.h = fill(f32(0), hf.n * hf.n)
hf.mat = fill(u8(0), hf.n * hf.n * 4)
env.hour = 8.0
pl.pos = vec3(-60, 0, 0)
# A constant straight walk measures stance-foot skating at small/large scales
# and all headings. Stance phases exclude lift/replant and speed transitions.
loop motion in [WState.walk, WState.flee]:
    speed = if motion == .walk: 0.8 else: 8.5
    hz = if motion == .walk: 60.0 else: 240.0
    worst = 0.0
    samples = 0
    clearance = 0.0
    loop slope in [-0.2, 0.0, 0.2]:
        loop z in [0..hf.n):
            loop x in [0..hf.n): hf.h[z * hf.n + x] = f32((f64(x) + hf.x0) * slope)
        loop seed in [0.0, 3.7, 19.2, 54.8]:
            loop heading in [0.0, 0.9, 2.1]:
                a = Animal(.boar, vec3(0, 0, 0), vec3(0, 0, 0), seed = seed, state = motion, face = heading, speed = speed)
                shape = boar_shape(seed)
                previous = fill(vec3(0, 0, 0), 4)
                phases = fill(0.0, 4)
                loop f in [0..240):
                    a.pos += forward_of(heading) * f32(speed / hz)
                    a.pos.y = f32(height_at(f64(a.pos.x), f64(a.pos.z)))
                    a.gait += speed / hz * (if motion == .walk: 15.0 else: 6.5) / f64(shape.z)
                    a.idle += 1.0 / hz
                    world = translation(a.pos) * rotation_y(PI - heading) * wild_ground_tilt(a) * scaling(shape)
                    pose = boar_pose(a)
                    loop i in [0..4):
                        leg = boar_leg(a, pose, i)
                        sole = transform_point(world * leg.lower, vec3(0, -0.145, 0))
                        off = (if motion == .walk: [0.0, PI, PI * 1.5, PI * 0.5] else: [0.0, 0.5, PI, PI + 0.5])[i]
                        ph = fract((a.gait + off) / TAU)
                        if f > 0 and ph > 0.05 and ph < (if motion == .walk: 0.57 else: 0.23) and phases[i] > 0.05 and phases[i] < ph:
                            worst = max(worst, f64(length(sole.xz - previous[i].xz)))
                            clearance = max(clearance, abs(f64(sole.y) - height_at(f64(sole.x), f64(sole.z)) - 0.035 * f64(shape.y)))
                            samples += 1
                        previous[i] = sole
                        phases[i] = ph
    print("boar {motion}: {samples} planted samples, worst drift/frame={worst:.6}m, sole clearance error={clearance:.6}m")
    assert(worst < 0.006 and clearance < 0.025, "walking soles stay grounded with bounded skating")

hf.h = fill(f32(0), hf.n * hf.n)
animals.clear()
loop k in [0..3):
    p = v3(f64(k) * 6.0, 0.0, 0.0)
    animals.push(Animal(.boar, p, p, seed = f64(k) * 1.73, idle = f64(k) * 3.4, t = f64(k) * 1.3, gait = f64(k), face = f64(k), hp = 8.0))
walk = fill(0, 3)
graze = fill(0, 3)
unequal = 0
loop f in [0..3600):
    wildlife_update(1.0 / 60.0)
    loop i in [0..3):
        if animals[i].state == .walk: walk[i] += 1
        if animals[i].state == .graze: graze[i] += 1
        assert(abs(f64(animals[i].pos.y)) < 0.001 and not animals[i].danger)
    if animals[0].state != animals[1].state or animals[1].state != animals[2].state: unequal += 1
loop i in [0..3):
    print("minute boar {i}: walk={walk[i]} graze={graze[i]} frames")
    assert(walk[i] > 300 and graze[i] > 900)
assert(unequal > 1800, "herd does not animate in unison")
print("PASS minute observation: {unequal}/3600 frames with different herd activities")

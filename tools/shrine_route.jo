# Headless end-to-end routes through the game's own collision shells, movement, combat,
# animation blade contacts, interactions and puzzle updates. No teleport/state shortcuts.
# Run with tools/shrine_route_check.sh, which isolates the environment and checks event order.
use '../game/shrines.jo'
use '../game/worldgen.jo'
use '../game/player.jo'
use '../game/input.jo'
use '../game/interact.jo'
use '../game/combat.jo'
use '../game/items.jo'
use '../game/camera.jo'
use '../game/physics.jo'
use '../game/structures.jo'
use '../game/env.jo'
use '../game/gfx.jo'
use '../game/chars.jo'
use '../game/story.jo'
use '../game/fx.jo'
use '../game/interiors.jo'
use '../game/water.jo'
use '../game/terrain.jo'
use '../game/weapon_tracks.jo'

const DT = 1.0 / 60.0
frames = 0
n = (to_int(env("BOTW_SHRINE") ?? "1") ?? 1) - 1
if n < 0 or n >= 4:
    eprint("FAIL: BOTW_SHRINE must be 1..4")
    exit(1)
loop key in ["BOTW_SHRINE_AT", "BOTW_SHRINE_STAGE", "BOTW_SHRINE_GIVE", "BOTW_SHRINE_CARRY", "BOTW_ENTER"]:
    if env(key) != none:
        eprint("FAIL: route requires a fresh lift start, unset {key}")
        exit(1)
o = srec[n].o
local = () -> vec3: pl.pos - o
fail = (message: str):
    eprint("FAIL {srec[n].name}: {message}; frame {frames}, local {local()}, state {pl.state}, HP {pl.hp}, stamina {pl.stamina:.1}")
    exit(1)
mark = (message: str): eprint("route: frame {frames}: {message}; {local()} {pl.state}")
tick = (a: Actions = Actions()):
    # Same update order as main.jo. Input comes directly from the scripted Actions.
    act = a
    cam_yaw_global = 0.0
    use_terrain = zone_at(pl.pos + vec3(0, 1, 0)) == ""
    shrines_update(DT)
    if pl.state == .ground and act.interact:
        u = usable_near(pl.pos, forward_of(pl.face))
        if u >= 0: use_it(u)
    player_update(DT)
    combat_update(DT, (i: int) -> vec3: scout_target_pos(), (if n == 0: 1 else: 0))
    hero_animate(DT, 0.0)
    hero_blade_hits()
    arrows_update(DT)
    chests_update(DT)
    fx_update(DT)
    frames += 1
    if pl.state == .dead: fail("player died")
wait = (count: int):
    loop k in [0..count): tick()
move = (x: f64, z: f64, radius: f64 = 0.18, budget: int = 1200, jump: bool = false, sprint: bool = false):
    loop k in [0..budget):
        p = local()
        d = vec2(f32(x) - p.x, p.z - f32(z))
        dist = f64(length(d))
        if dist < radius and pl.state == .ground:
            wait(if sprint: 1 else: 12)
            return
        stick = if dist < 0.65: 0.5 else: 1.0
        tick(Actions(move = normalize(d) * f32(stick), jump = jump and k == 0, jump_held = jump and k < 20, sprint = sprint))
    fail("could not reach {x},{z}")
press = (prompt: str):
    u = usable_near(pl.pos, forward_of(pl.face))
    if u < 0: fail("no usable for {prompt}")
    if usables[u].prompt != prompt: fail("wanted {prompt}, found {usables[u].prompt}")
    tick(Actions(interact = true))
    mark(prompt)
attack = ():
    loop j in [0..65): tick(Actions(attack = j == 0, attack_held = false))
fall = (x: f64, z: f64):
    hp = pl.hp
    mark("attempt pit crossing without bridge")
    loop k in [0..300):
        d = vec2(f32(x) - local().x, local().z - f32(z))
        tick(Actions(move = normalize(d)))
        if pl.state == .cutscene: break
    if pl.state != .cutscene: fail("did not fall into pit")
    checkpoint = srec[n].checkpoint
    wait(150)
    if pl.state != .ground or pl.hp != hp - 2 or length(pl.pos - checkpoint) > 0.15: fail("pit checkpoint recovery failed")
    mark("checkpoint recovered (-2 HP)")
chest = (id: str):
    press("Open")
    found = false
    loop c in chests:
        if c.content == id and c.opened: found = true
    if not found: fail("chest did not open: {id}")
    awarded = match item(id).kind:
        weapon: inv.weapons.contains(id)
        bow: inv.bows.contains(id)
        shield: inv.shields.contains(id)
        arrows: inv.arrows > 0
        _: count_of(id) > 0
    if not awarded: fail("chest did not award {id}")
    mark("chest verified {id}")

bar = (z: f64) -> int:
    loop i in 0.. and c in colliders:
        if c.surf == .metal and c.kind == 1 and abs(f64(c.pos.z - o.z) - z) < 0.1 and abs(f64(c.half.z) - 7.5) < 0.01: return i
    fail("missing rotating bar at {z}")
    -1
bar_point = (c: int, r: f64) -> vec3:
    colliders[c].pos + transform_dir(rotation_y(colliders[c].yaw), v3(0.0, 0.6, r)) - o
bar_move = (c: int, r: f64, radius: f64 = 0.22):
    loop k in [0..360):
        q = bar_point(c, r)
        d = vec2(q.x - local().x, local().z - q.z)
        if length(d) < f32(radius) and pl.state == .ground:
            mark("rotating bar waypoint {c}/{r}")
            return
        tick(Actions(move = normalize(d) * (if length(d) < 0.65: f32(0.5) else: f32(1))))
        if pl.state == .cutscene: fail("fell while riding bar")
    fail("could not ride bar to {r}")
angle_wait = (c: int, angle: f64):
    loop k in [0..3000):
        if abs(wrap_angle(colliders[c].yaw - angle)) < 0.03: return
        tick()
    fail("bar never aligned")

# Aim and strike the brake with normal movement/sword inputs; observe that the bar stops.
freeze_bar = (c: int, x: f64):
    last = colliders[c].yaw
    still = 0
    loop k in [0..120):
        d = vec2(f32(x) - local().x, local().z + 28.5)
        tick(Actions(move = (if length(d) > 0.8: normalize(d) * f32(0.5) else: vec2(0, 0)), attack = k % 30 == 15))
        if colliders[c].yaw == last: still += 1
        else: still = 0
        last = colliders[c].yaw
        if still >= 3:
            mark("clockwork brake verified stationary")
            return
    fail("sword did not freeze clockwork brake")

# Owa Daim releases first at step 121, then every 391 fixed steps (6.5 s rounded).
# Delays include drop/roll time plus a margin after passing each niche. Changing this
# timing must re-establish a no-hit route; the final HP assertion rejects bad windows.
boulder_wait = (delay: int):
    target = (121 + delay) % 391
    loop k in [0..500):
        if frames % 391 == target: return
        tick()
    fail("missed boulder window")

swim_to = (x: f64, z: f64, radius: f64 = 0.3):
    loop k in [0..1400):
        d = vec2(f32(x) - local().x, local().z - f32(z))
        if length(d) < f32(radius): return
        tick(Actions(move = normalize(d)))
    fail("could not swim to {x},{z}")
climb_up = (height: f64):
    mark("climbing wall")
    loop k in [0..900):
        if pl.state == .ground and f64(local().y) >= height - 0.05:
            mark("wall climbed to {height}")
            return
        tick(Actions(move = vec2(0, 1)))
    fail("could not climb to {height}")

worldgen_load()
# Surface materials are irrelevant inside; allocate them for the exterior return step.
hf.mat = fill(u8(0), hf.n * hf.n * 4)
find_shrines()
# The real exterior platforms provide collision at the return destination too.
loop s in shrines: shrine_exterior(s)
shrines_build()
items_init()
chars_init()
shrines_setup()
# Normal pre-entry gear: sword for the scout/crystals, pot lid for guarding.
# Starting hearts/stamina are the unmodified Player defaults; puzzles start untouched.
inv_add("travelers_sword")
inv_add("pot_lid")
seed_random(64)
tick()
wait(60)
mark("lift, fresh puzzle")
if n == 0:
    move(0.0, -4.5)
    fall(0.0, -12.0)
    # First crate: north twice, west five times, keeping the player at each pushing face.
    move(5.0, 0.8)
    move(5.0, -3.5)
    move(6.5, -3.0)
    move(6.5, -5.0)
    move(-3.8, -5.0)
    wait(100)
    move(0.0, -3.0)
    move(0.0, -22.0)
    mark("weighted bridge crossed")
    move(0.0, -31.8)
    move(0.0, -33.45, 0.22)
    loop k in [0..240):
        if scout_target_pos().y < -9000.0: break
        d = vec2(-local().x, local().z + 33.45)
        tick(Actions(move = (if length(d) > 0.18: normalize(d) else: vec2(0, 0)), attack = k % 30 == 0, lock = true))
    if scout_target_pos().y > -9000.0: fail("scout still alive")
    mark("scout verified dead")
    move(-7.9, -33.0)
    chest("travelers_bow")
    # Foundry: push the metal round the pier, then ride the weighted rising shuttle.
    move(-9.0, -28.0)
    move(-15.0, -28.0)
    move(-32.0, -28.0)
    move(-32.5, -35.0)
    crate = -1
    loop i in 0.. and c in colliders:
        if c.surf == .metal and abs(f64(c.pos.x - o.x) + 34.0) < 0.1 and abs(f64(c.pos.z - o.z) + 35.0) < 0.1: crate = i
    if crate < 0: fail("foundry crate missing")
    initial = colliders[crate].pos
    loop k in [0..90): tick(Actions(move = vec2(-1, 0)))
    if length(colliders[crate].pos - initial) > 0.01: fail("foundry pier allowed direct westward push")
    mark("foundry pier blocks direct push")
    move(-32.5, -33.4)
    move(-34.0, -33.4)
    # West is blocked by the pier. Walk to the south pushing face and clear its corner.
    move(-34.0, -37.6)
    move(-32.5, -37.5)
    move(-32.5, -39.0)
    move(-40.6, -39.0, 0.18, 2400)
    wait(90)
    mark("foundry metal delivered")
    shuttle = -1
    loop i in 0.. and c in colliders:
        if c.surf == .metal and abs(f64(c.half.x) - 2.0) < 0.01 and abs(f64(c.pos.z - o.z) + 39.0) < 0.1: shuttle = i
    if shuttle < 0: fail("foundry shuttle missing")
    # Observe one complete production cycle before boarding. Check both docks,
    # ascent/descent and monotonic motion instead of padding route duration.
    near_seen = false
    far_seen = false
    outbound = 0
    inbound = 0
    previous = colliders[shuttle].pos
    loop k in [0..1680):
        tick()
        current = colliders[shuttle].pos
        x = f64(current.x - o.x)
        y = f64(current.y - o.y)
        if x > -46.01 and abs(y + 0.6) < 0.01: near_seen = true
        if x < -59.99 and abs(y - 2.8) < 0.01: far_seen = true
        if current.x < previous.x - 0.001:
            if current.y < previous.y: fail("foundry outbound hoist descended")
            outbound += 1
        if current.x > previous.x + 0.001:
            if current.y > previous.y: fail("foundry return hoist ascended")
            inbound += 1
        previous = current
    if not near_seen or not far_seen or outbound < 500 or inbound < 500: fail("foundry cycle did not visit both docks and directions within 28 seconds")
    mark("foundry 28-second cycle verified, both directions")
    move(-43.0, -36.0)
    move(-44.5, -39.0)
    loop k in [0..2400):
        if colliders[shuttle].pos.x - o.x > -46.1: break
        tick()
    move(-46.2, -39.0)
    departure = frames
    loop k in [0..900):
        if colliders[shuttle].pos.x - o.x < -59.8: break
        tick()
    if local().y < 3.2: fail("did not ride rising metal shuttle")
    if frames - departure > 840: fail("foundry outbound ride exceeded dock plus 10-second crossing")
    mark("foundry outbound ride verified")
    move(-63.0, -39.0)
    chest("rusty_broadsword")
    mark("foundry high treasury reached")
    move(-61.0, -39.0)
    loop k in [0..2400):
        if colliders[shuttle].pos.x - o.x < -59.9: break
        tick()
    move(-58.8, -39.0)
    departure = frames
    loop k in [0..900):
        if colliders[shuttle].pos.x - o.x > -46.2: break
        tick()
    if frames - departure > 840: fail("foundry return ride exceeded dock plus 10-second crossing")
    mark("foundry return ride verified")
    move(-44.0, -39.0)
    move(-43.0, -27.0)
    move(-15.0, -27.0)
    move(-9.0, -28.0)
    mark("foundry shuttle returned")
    move(4.0, -32.8)
    move(4.0, -41.6)
    move(4.0, -43.0, 0.18, 600, true)
    move(4.0, -46.0, 0.18, 600, true)
    mark("crate ledge climbed")
    move(0.0, -45.0)
else if n == 1:
    # Each load comes from the original replenishing pad, then catches at the brazier.
    move(6.0, -2.7)
    press("Pick up")
    move(-4.8, -8.0)
    move(3.8, -10.0)
    press("Throw")
    move(-2.0, -4.0)
    wait(250)
    move(11.5, -10.0)
    chest("travelers_claymore")
    # Try the rolling chute while closed, recover on the dry rim, then time a new roll.
    move(11.5, -11.1)
    move(16.5, -11.1)
    move(25.0, -10.4)
    loop k in [0..840):
        if frames % 840 == 0: break
        tick()
    tick(Actions(move = vec2(1, 0)))
    attack()
    attack()
    move(24.0, -7.0)
    wait(360)
    mark("closed shutter roll recovered")
    move(25.0, -10.0)
    loop k in [0..840):
        if frames % 840 == 300: break
        tick()
    tick(Actions(move = vec2(1, 0)))
    attack()
    move(24.0, -7.0)
    wait(300)
    move(31.0, -10.0)
    loop k in [0..840):
        if frames % 840 == 365: break
        tick()
    # Walk through the ordinary opened shutter after the farther chain detonates.
    move(34.0, -10.0, 0.18, 600)
    move(62.0, -10.0)
    chest("arrow")
    mark("rolling bomb treasury reached")
    move(34.0, -10.0)
    loop k in [0..840):
        if frames % 840 == 365: break
        tick()
    move(30.0, -10.0, 0.18, 600)
    move(16.5, -11.1)
    move(11.5, -11.1)
    move(6.0, -2.7)
    press("Pick up")
    move(-4.8, -8.0)
    move(-2.0, -14.0)
    move(-2.0, -15.5)
    press("Throw")
    move(-5.0, -12.0)
    wait(220)
    move(0.0, -18.0)
    move(0.0, -23.0)
    move(-5.0, -23.0)
    fall(-5.0, -31.0)
    move(6.0, -2.7)
    press("Pick up")
    move(-4.8, -8.0)
    move(0.0, -23.0, 0.6, 600, false, true)
    move(5.8, -23.0, 0.6, 600, false, true)
    press("Throw")
    move(0.0, -21.0)
    wait(340)
    move(0.0, -39.0)
    mark("chain explosion bridge crossed")
    move(0.0, -49.5)
else if n == 2:
    move(-8.0, -3.0)
    fall(-8.0, -12.0)
    move(0.0, -4.3)
    first = bar(-13.5)
    second = bar(-28.5)
    angle_wait(first, PI - 0.15)
    bar_move(first, 0.0)
    mark("first hub reached")
    angle_wait(first, TAU - 0.45)
    bar_move(first, -7.1)
    bar_move(second, 0.0)
    mark("second hub reached")
    # Ride east to the optional island when the second bar points across the hall.
    angle_wait(second, -TAU - PI / 2.0 + 0.45)
    bar_move(second, -7.0)
    move(8.3, -28.5)
    chest("travelers_shield")
    mark("east island reached")
    move(8.5, -29.8)
    move(13.5, -29.8)
    move(15.5, -28.5)
    extra1 = -1
    extra2 = -1
    loop i in 0.. and c in colliders:
        if c.surf == .metal and c.kind == 1 and abs(f64(c.half.z) - 7.5) < 0.01:
            if abs(f64(c.pos.x - o.x) - 24.5) < 0.1: extra1 = i
            if abs(f64(c.pos.x - o.x) - 39.5) < 0.1: extra2 = i
    if extra1 < 0 or extra2 < 0: fail("missing clockwork bars")
    angle_wait(extra1, PI / 2.0 - 0.15)
    bar_move(extra1, 0.0)
    mark("clockwork first hub reached")
    bar_move(extra1, -1.2)
    angle_wait(extra1, PI / 2.0 - 0.18)
    # Face the brake above the hub; sword freezes its collider at this phase.
    freeze_bar(extra1, 24.5)
    mark("first clockwork brake struck")
    angle_wait(extra2, -PI / 2.0 + 0.14)
    bar_move(extra1, 7.2)
    bar_move(extra2, 0.0)
    mark("clockwork second hub reached")
    bar_move(extra2, 1.2)
    angle_wait(extra2, -PI / 2.0 + 0.18)
    freeze_bar(extra2, 39.5)
    mark("second clockwork brake struck")
    bar_move(extra2, -7.2)
    move(50.8, -28.5)
    chest("amber")
    mark("frozen clockwork treasury reached")
    # Opening the treasury deploys a return catwalk across the pit's southern edge.
    move(50.0, -34.0)
    move(15.5, -34.0)
    move(15.5, -28.5)
    move(13.5, -29.8)
    move(8.5, -29.8)
    move(8.3, -28.5)
    mark("clockwork island returned")
    # Wait clear of the rotating tip, then leave by the opposite tip at a safe boulder phase.
    move(11.5, -29.8)
    angle_wait(second, -TAU - PI * 1.5 + 0.6)
    move(8.3, -29.8)
    move(8.3, -28.5)
    bar_move(second, 0.0)
    mark("second hub regained")
    angle_wait(second, -TAU * 2.0 - PI + 0.45)
    bar_move(second, 7.2)
    move(5.0, -38.5)
    mark("turning bars crossed")
    boulder_wait(575)
    move(0.0, -41.0, 0.3, 600, false, true)
    move(0.0, -51.0, 0.3, 600, false, true)
    move(3.25, -51.0, 0.3, 600, false, true)
    mark("boulder niche 1")
    boulder_wait(450)
    move(0.0, -51.0, 0.3, 600, false, true)
    move(0.0, -61.0, 0.3, 600, false, true)
    move(3.25, -61.0, 0.3, 600, false, true)
    mark("boulder niche 2")
    boulder_wait(317)
    move(0.0, -61.0, 0.3, 600, false, true)
    move(0.0, -71.0, 0.3, 600, false, true)
    move(3.25, -71.0, 0.3, 600, false, true)
    mark("boulder niche 3")
    boulder_wait(184)
    move(0.0, -71.0, 0.3, 600, false, true)
    move(0.0, -80.0, 0.3, 600, false, true)
    move(8.0, -80.0)
    move(8.0, -78.0)
    move(10.0, -78.0)
else:
    # This hall has water, no abyss: fail by exhausting stamina at low water.
    hp = pl.hp
    swim_to(0.0, -10.0)
    if pl.state != .swim: fail("did not enter low pool")
    mark("low-water failed crossing")
    loop k in [0..2300):
        if pl.state == .ground and pl.hp < hp: break
        target = if (k / 250) % 2 == 0: vec2(4, -18) else: vec2(-4, -10)
        d = vec2(target.x - local().x, local().z - target.y)
        tick(Actions(move = normalize(d)))
    if pl.state != .ground or pl.hp != hp - 4 or local().z < -4.1: fail("drowning shore recovery failed")
    if length(pl.pos - pl.last_safe) > 0.15 or pl.stamina != pl.stamina_max: fail("shore checkpoint/stamina not restored")
    mark("shore recovered (-4 HP)")
    move(6.0, 1.0)
    move(6.0, 0.05)
    attack()
    wait(240)
    mark("south crystal struck")
    swim_to(-8.0, -14.0)
    # Swim into the west handholds, then use the actual climbing and mantle states.
    loop k in [0..240):
        if pl.state == .climb: break
        tick(Actions(move = vec2(-1, 0)))
    if pl.state != .climb: fail("could not grab west handholds")
    climb_up(3.6)
    move(-12.5, -14.0)
    chest("travelers_spear")
    # Frost cistern: raise, carry the floating crate over the high plate, drain, climb ice.
    move(-12.5, -15.0)
    move(-18.0, -15.0)
    move(-20.0, -14.0)
    move(-20.0, -18.3)
    attack()
    mark("frost cistern near valve struck")
    move(-20.0, -20.5)
    move(-40.0, -20.5)
    # Watch the actual float's collider until it rests over the raised plate.
    floating = -1
    loop i in 0.. and c in colliders:
        if c.surf == .metal and abs(f64(c.half.x) - 0.8) < 0.01 and abs(f64(c.pos.z - o.z) + 14.0) < 0.1 and c.pos.x - o.x < -23.0: floating = i
    if floating < 0: fail("frost cistern float missing")
    loop k in [0..1800):
        if colliders[floating].pos.x - o.x < -34.95: break
        tick()
    move(-40.0, -21.5)
    move(-40.0, -20.5)
    wait(30)
    # Aim using held movement until facing north; one displayed frame does not
    # guarantee the same facing after the physics integration step changes.
    loop k in [0..20):
        if abs(wrap_angle(pl.face)) < 0.03: break
        tick(Actions(move = vec2(0, 0.4)))
    move(-40.0, -20.15, 0.08)
    attack()
    wait(420)
    mark("frost cistern far valve struck")
    move(-37.5, -20.5)
    move(-37.5, -19.0, 0.18, 600, true)
    move(-40.5, -17.0, 0.18, 600, true)
    move(-40.5, -14.0, 0.18, 600, true)
    chest("opal")
    mark("ice stair treasury reached")
    move(-40.0, -19.0)
    move(-40.0, -21.2)
    move(-20.0, -21.2)
    move(-20.0, -14.0)
    move(-18.0, -15.0)
    move(-12.5, -15.0)
    move(-12.5, -14.0)
    mark("frost cistern niche returned")
    wait(150)
    swim_to(-8.0, -14.0)
    swim_to(-6.0, -25.5)
    # At high water, pushing toward the north ledge pulls up onto it.
    loop k in [0..240):
        if pl.state == .ground and local().y > -0.1: break
        tick(Actions(move = vec2(0, 1)))
    if pl.state != .ground or local().y < -0.1: fail("could not mantle north ledge")
    move(-6.0, -25.9)
    attack()
    wait(300)
    mark("north crystal struck, crate settled")
    move(0.0, -27.0)
    move(0.0, -38.5)
    loop k in [0..120):
        if pl.state == .climb: break
        tick(Actions(move = vec2(0, 1)))
    if pl.state != .climb: fail("could not grab balcony wall")
    climb_up(4.0)
    move(0.0, -41.5)
    mark("monk balcony climbed")
bonus = ["rusty_broadsword", "arrow", "amber", "opal"][n]
opened_bonus = 0
loop c in chests:
    if c.content == bonus and c.opened: opened_bonus += 1
if opened_bonus != 1: fail("bonus treasury must open exactly once")
if n == 0:
    copies = 0
    loop id in inv.weapons:
        if id == bonus: copies += 1
    if copies != 1: fail("foundry must award exactly one Rusty Broadsword")
else if n == 1:
    if inv.arrows != 10: fail("gallery must award exactly ten arrows")
else if n == 2:
    if count_of("amber") != 3: fail("clockwork must award exactly three Amber")
else:
    if count_of("opal") != 1: fail("cistern must award exactly one Opal")
if n == 2 and pl.hp != 10: fail("boulder route must avoid all hits")
press("Talk")
wait(750)
if story.orbs != 1 or count_of("spirit_orb") != 1 or not inv.keys.contains("spirit_orb"): fail("orb not awarded exactly once")
e = srec[n].entry
if e < 0 or not shrines[e].done: fail("shrine not marked complete")
if shr_cur >= 0 or pl.state != .ground or length(pl.pos - shrines[e].pos) > 3.0: fail("did not return to exterior lift")
mark("orb verified, exterior lift returned")
print("PASS {srec[n].name}: {frames} frames, {f64(frames) / 60.0:.2} simulated seconds")

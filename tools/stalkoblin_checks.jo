# Shared headless gameplay regressions; no animation callback is needed for a skull.
use '../game/enemies.jo'
use '../game/physics.jo'
use '../game/terrain.jo'
use '../game/worldgen.jo'
use '../game/water.jo'
use '../game/player.jo'
use '../game/items.jo'
use '../game/combat.jo'
use '../game/env.jo'
from '../game/enemies.jo' import __take_hit

stalk_checks = 0
stalk_check = (ok: bool, name: str):
    assert(ok, name)
    stalk_checks += 1
    print(name)

stalk_course = ():
    enemies.clear()
    player_hits.clear()
    witems.clear()
    loop mut c in colliders: c.active = false
    hf.n = 64
    hf.cell = 1.0
    hf.x0 = -32.0
    hf.z0 = -32.0
    hf.h = fill(f32(0), 4096)
    hf.mat = fill(u8(0), 16384)
    areas = fill(u8(46), 4096)
    edge_sd = fill(f32(-100), 4096)
    water_grid_set(fill(f32(-10000), 4096), 64, -32.0, -32.0, 1.0)
    use_terrain = true
    items_init()
    fight = Fight()
    pl = Player(pos = vec3(0, 0, 2), face = 0.0)
    e = spawn_enemy(.stalkoblin, vec3(0, 0, 0))
    enemies[e].alert = 1.0
    enemies[e].face = PI

stalkoblin_test_suite = ():
    stalk_checks = 0
    loop hz in [30, 60, 120]:
        stalk_course()
        # A qualifying production blade contact pops the head even if damage exceeds body HP.
        player_hits = [PHit(vec3(0, 1, 0), pl.pos, vec3(0, 0, -1), 30.0, 2.0, false, 1, vec3(-0.6, 1, 0), vec3(0.6, 1, 0))]
        enemies_take_hits()
        stalk_check(enemies[0].skull_out and enemy_alive(enemies[0]), "torso blade pops skull without killing at {hz}Hz")
        player_hits.clear()
        start = enemies[0].skull_pos
        pl.pos = vec3(15, 0, 15)
        loop frame in [0..hz): enemies_update(1.0 / f64(hz), true)
        stalk_check(enemies[0].skull_out and length(enemies[0].skull_pos - start) > 1.0 and abs(enemies[0].skull_roll) > 1.0, "skull rolls independently beyond old animation timeout at {hz}Hz")
        body = enemies[0].pos
        hp = enemies[0].hp
        loop hit in [2..7):
            __take_hit(enemies[0], 100.0, pl.pos, 2.0, false)
        stalk_check(enemies[0].hp == hp and enemy_alive(enemies[0]), "headless body blows cannot kill at {hz}Hz")
        recovered = -1
        loop frame in [0..hz*10):
            enemies_update(1.0 / f64(hz), true)
            if not enemies[0].skull_out:
                recovered = frame
                break
        stalk_check(recovered >= 0 and length(enemies[0].pos - body) > 0.5, "body seeks and physically reassembles at {hz}Hz")
        print("Stalkbonk {hz}Hz recovery={(f64(recovered)/f64(hz)):.3}s body displacement={length(enemies[0].pos-body):.3}m roll={enemies[0].skull_roll:.3}")
        # Detach again, then direct the actual next blade into the skull sphere.
        __take_hit(enemies[0], 10.0, pl.pos, 2.0, false)
        skull = enemies[0].skull_pos
        player_hits = [PHit(skull, skull + vec3(0, 0, 1), vec3(0, 0, -1), 2.0, 2.0, false, 22, skull + vec3(-0.4, 0, 0), skull + vec3(0.4, 0, 0))]
        enemies_take_hits()
        stalk_check(enemies[0].skull_hp == 0.0 and enemies[0].state == .dead and length(enemies[0].vel) == 0.0, "skull blade destruction collapses body at {hz}Hz")
        player_hits.clear()
        loop frame in [0..hz*2): enemies_update(1.0 / f64(hz), true)
        stalk_check(enemies[0].state == .gone, "destroyed skull cannot reform at {hz}Hz")
    loop hz in [1, 30, 60, 120]:
        stalk_course()
        pl.pos = vec3(15, 0, 15)
        __take_hit(enemies[0], 1.0, vec3(-2, 0, 0), 2.0, false)
        add_box(vec3(1, 0, 0), vec3(0.025, 3, 8), 0.0, false, .stone)
        loop frame in [0..hz*3): stalk_skull_step(enemies[0], 1.0 / f64(hz))
        stalk_check(enemies[0].skull_pos.x < 0.70 and enemies[0].skull_pos.y >= 0.28, "thin wall and floor stop rolling skull at {hz}Hz")
        print("Stalkbonk wall {hz}Hz skull={enemies[0].skull_pos}")
    stalk_course()
    pl.pos = vec3(15, 0, 15)
    __take_hit(enemies[0], 20.0, vec3(-2, 0, 0), 2.0, false)
    enemies[0].skull_pos = vec3(4, 0.29, 0)
    enemies[0].skull_vel = vec3(0, 0, 0)
    add_box(vec3(2, 0, 0), vec3(0.05, 3, 6), 0.0, false, .stone)
    loop f in [0..900): enemies_update(1.0/60.0, true)
    stalk_check(enemies[0].skull_out and enemies[0].skull_reforms == 1 and enemy_alive(enemies[0]), "unreachable skull stays separate through body collapse/reform")
    stalk_course()
    __take_hit(enemies[0], 20.0, pl.pos, 2.0, false)
    enemies[0].skull_pos = vec3(4, 0.29, 0)
    body_arrow = Arrow(vec3(0, 0.9, -2), vec3(0, 0, -1), 20.0, prev = vec3(0, 0.9, 2))
    enemy_arrow_hit(body_arrow, 0)
    stalk_check(enemy_alive(enemies[0]), "arrow into headless torso does not kill")
    skull_arrow = Arrow(vec3(4, 0.29, -2), vec3(0, 0, -1), 2.0, prev = vec3(4, 0.29, 2))
    stalk_check(enemy_arrow_distance(skull_arrow, 0) >= 0.0, "detached skull is an arrow target")
    wall = add_box(vec3(4, 0, 0.8), vec3(1, 2, 0.05))
    # The projectile dispatcher chooses world collision before the farther skull.
    hit = raycast(skull_arrow.prev, skull_arrow.pos - skull_arrow.prev, 4.0)
    stalk_check(hit.hit and enemy_arrow_distance(skull_arrow, 0) < 0.0, "cover precedes skull projectile target")
    colliders[wall].active = false
    enemy_arrow_hit(skull_arrow, 0)
    stalk_check(enemies[0].state == .dead, "arrow destroys detached skull")
    stalk_course()
    __take_hit(enemies[0], 20.0, pl.pos, 2.0, false)
    enemies[0].skull_pos = vec3(4, 0.29, 0)
    w = spawn_item("travelers_sword", vec3(4, 0.29, 2))
    witems[w].damage = 2
    witems[w].thrown_by_player = true
    enemies_take_hits()
    witems[w].pos = vec3(4, 0.29, -2)
    enemies_take_hits()
    stalk_check(enemies[0].state == .dead and not witems[w].thrown_by_player, "thrown drawn weapon sweep destroys skull")
    stalk_course()
    pl.pos = vec3(15, 0, 15)
    spawn_enemy(.stalkoblin, vec3(8, 0, 0))
    loop mut e in enemies:
        __take_hit(e, 20.0, pl.pos, 2.0, false)
        e.skull_vel = vec3(0, 0, 0)
        e.skull_age = 1.0
    enemies[0].skull_pos = vec3(8, 0.29, 0)
    enemies[1].skull_pos = vec3(0, 0.29, 0)
    stalk_choose_skulls()
    stalk_check(enemies[0].skull_pos.x == 0.0 and enemies[1].skull_pos.x == 8.0, "headless neighbours seek another body's nearer skull")
    loop f in [0..90): enemies_update(1.0/60.0, true)
    stalk_check(not enemies[0].skull_out and not enemies[1].skull_out, "both bodies pick up exchanged skulls")
    stalk_course()
    print("Stalkbonk gameplay: {stalk_checks}/{stalk_checks} passed; physical skull rates=1/30/60/120Hz")

# Caller owns the render lock. LOD 2 of a 4x4 checker must be its average.
struct ProbeVertex:
    pos: vec2
struct ProbeParams:
    tex: Texture
struct ProbeOut:
    pos: vec4
    uv: vec2
probe_vs = (v: ProbeVertex, u: ProbeParams) -> ProbeOut:
    ProbeOut(vec4(v.pos, 0, 1), v.pos * 0.5 + vec2(0.5, 0.5))
probe_fs = (i: ProbeOut, u: ProbeParams) -> vec4:
    sample_lod(u.tex, vec2(0.125, 0.125), 2.0)
window("Upstream texture probe", 64, 64)
fbo = gl_create_framebuffer()
outtex = gl_create_texture()
glBindTexture(GL_TEXTURE_2D, u32(outtex))
gl_tex_image(16, 16, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, null, 0)
glBindFramebuffer(GL_FRAMEBUFFER, u32(fbo))
glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(outtex), 0)
glViewport(0, 0, 16, 16)
glDisable(GL_DEPTH_TEST)
glDisable(GL_CULL_FACE)
glDisable(GL_BLEND)
checker = fill(u8(0), 4 * 4 * 4)
loop y in [0..4):
    loop x in [0..4):
        checker[(y*4+x)*4] = if (x+y)%2 == 0: u8(255) else: u8(0)
        checker[(y*4+x)*4+3] = 255
t = gl_create_texture()
glBindTexture(GL_TEXTURE_2D, u32(t))
gl_tex_image(4, 4, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, data(checker), checker.len())
glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST)
glGenerateMipmap(GL_TEXTURE_2D)
glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR)
sh = make_shader(shader(probe_vs, probe_fs))
tri = mesh([ProbeVertex(vec2(-1,-1)), ProbeVertex(vec2(3,-1)), ProbeVertex(vec2(-1,3))])
draw(sh, tri, ProbeParams(Texture(t, 4, 4)))
px = fill(u8(0), 16 * 16 * 4)
gl_read_pixels(0, 0, 16, 16, data(px))
print("LOD 2 red: {px[0]}; expected 128 (+/-1)")
assert(abs(int(px[0])-128) <= 1, "generate and sample the full mip pyramid")

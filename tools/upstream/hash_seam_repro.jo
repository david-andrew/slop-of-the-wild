# Unadapted float hash; full RGBA8 readback avoids the separate cropped/type bug.
# Caller owns flock /tmp/botw-render.lock. Compare SLOPPY_VULKAN=1 and 0.
hash12 = (p: vec2) -> f32:
    q = fract(p * 0.1031)
    q = q + vec2(dot(q, vec2(q.y + 33.33, q.x + 33.33)), dot(q, vec2(q.y + 33.33, q.x + 33.33)))
    fract((q.x + q.y) * q.x * 1.37 + q.y * 0.71)

vnoise = (p: vec2) -> f32:
    i = floor(p)
    f = p - i
    u = f * f * (vec2(3, 3) - f * 2.0)
    a = hash12(i)
    b = hash12(i + vec2(1, 0))
    c = hash12(i + vec2(0, 1))
    d = hash12(i + vec2(1, 1))
    lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y)


struct Vertex:
    pos: vec2
struct Params:
    unused: f32
struct Varying:
    pos: vec4
    uv: vec2
vs = (v: Vertex, u: Params) -> Varying:
    Varying(vec4(v.pos, 0, 1), v.pos * 0.5 + vec2(0.5, 0.5))
fs = (i: Varying, u: Params) -> vec4:
    p = vec2(-420, 580) + i.uv * 10.0
    n = vnoise(p)
    vec4(n, n, n, 1)
window("Float hash contraction seam", 512, 512)
source = shader(vs, fs)
program = make_shader(source)
triangle = mesh([Vertex(vec2(-1, -1)), Vertex(vec2(3, -1)), Vertex(vec2(-1, 3))])
fbo = gl_create_framebuffer()
tex = gl_create_texture()
glBindTexture(GL_TEXTURE_2D, u32(tex))
gl_tex_image(512, 512, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, null, 0)
glBindFramebuffer(GL_FRAMEBUFFER, u32(fbo))
glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(tex), 0)
glViewport(0, 0, 512, 512)
glDisable(GL_DEPTH_TEST)
glDisable(GL_CULL_FACE)
glDisable(GL_BLEND)
draw(program, triangle, Params(0))
pixels = fill(u8(0), 512 * 512 * 4)
gl_read_pixels(0, 0, 512, 512, data(pixels))
worst = 0
loop y in [0..512):
    loop x in [0..512):
        at = (y * 512 + x) * 4
        if x > 0: worst = max(worst, abs(int(pixels[at]) - int(pixels[at - 4])))
        if y > 0: worst = max(worst, abs(int(pixels[at]) - int(pixels[at - 512 * 4])))
print("maximum adjacent red jump: {worst}/255; expected <= 11/255")
assert(worst <= 11, "continuous noise must agree at shared lattice corners")

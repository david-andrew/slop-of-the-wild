# Caller owns the render lock. Defaults to 240 frames; use PROBE_FRAMES for longer runs.
# Set SLOPPY_VSYNC=0 (mailbox) or 1 (FIFO) and optionally SLOPPY_VULKAN=0.
# Intervals include runtime work and desktop scheduling, not scanout.
window("Standalone pacing probe", 512, 512)
previous = 0.0
intervals: f64[]
presents: f64[]
limit = to_int(env("PROBE_FRAMES") ?? "240") ?? 240
seconds = to_float(env("PROBE_SECONDS") ?? "0") ?? 0.0
started = time()
draw = ():
    now = time()
    if previous > 0:
        intervals.push((now-previous)*1000)
        presents.push(__last_present*1000)
    previous = now
    glClearColor(0.1, 0.2, 0.3, 1)
    glClear(GL_COLOR_BUFFER_BIT)
    if (seconds > 0.0 and now-started >= seconds) or (seconds <= 0.0 and intervals.len() >= limit):
        intervals.sort()
        presents.sort()
        n = intervals.len()
        print("interval p50/p99/worst ms: {intervals[(n+1)/2-1]:.3}/{intervals[(n*99+99)/100-1]:.3}/{intervals[n-1]:.3}; present worst ms: {presents[n-1]:.3}")
        exit(0)

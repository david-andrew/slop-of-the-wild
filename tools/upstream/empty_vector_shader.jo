# Caller owns the render lock. Vulkan accepts this; GLSL ES emits invalid vec4().
# Replacing the empty constructor with vec4(0, 0, 0, 0) is the passing control.
struct ProbeVertex:
    pos: vec2
struct ProbeParams:
    reject: f32
struct ProbeOut:
    pos: vec4
probe_vs = (v: ProbeVertex, u: ProbeParams) -> ProbeOut:
    ProbeOut(vec4(v.pos, 0, 1))
probe_fs = (i: ProbeOut, u: ProbeParams) -> vec4:
    if u.reject > 0.0:
        discard()
        return vec4()
    vec4(1, 0, 0, 1)

window("Empty shader vector constructor", 64, 64)
sh = make_shader(shader(probe_vs, probe_fs))
tri = mesh([ProbeVertex(vec2(-1,-1)), ProbeVertex(vec2(3,-1)), ProbeVertex(vec2(-1,3))])
glDisable(GL_DEPTH_TEST)
glDisable(GL_CULL_FACE)
draw(sh, tri, ProbeParams(0))
print("PASS empty-vector shader creation and draw")

# Compare outdoor hero diffuse against the production environment shader with
# identical material, normal and shadow. This measures lighting, not the albedo
# contrast between a white shirt and green terrain. No window or GPU.
use '../game/charshade.jo'
use '../game/env.jo'
use '../game/gfx.jo'
use '../game/shade.jo'
low=10.0
high=0.0
cases=0
weights=vec3(0.2126,0.7152,0.0722)
loop hour in [11.0,18.6,22.0]:
    loop weather in [Weather.cloudy,Weather.rain,Weather.storm]:
        env=Env(hour=hour,weather=weather,clouds=(if weather==.cloudy:0.74 else:(if weather==.rain:0.85 else:0.95)),rain=(if weather==.cloudy:0.0 else:1.0),storm_k=(if weather==.storm:1.0 else:0.0))
        env_update(0.0,false)
        scene=char_scene(mat4(),vec3(),env.light_dir,env.sun_color,env.sky_amb,env.ground_amb,vec3(),0,0,mat4(),mat4(),mat4(),Texture(),Texture(),Texture())
        scene.environment_sun=env.sun_color
        scene.environment_sky=env.sky_amb
        scene.environment_ground=env.ground_amb
        u=ch_uniforms(scene,CharParams(environment=1,hero_material=1),mat4(),Texture(),0,Texture(),false)
        l=normalize(env.light_dir)
        loop pigment in [vec3(0.72,0.64,0.34),vec3(0.4,0.19,0.10),vec3(0.35,0.344,0.321),vec3(0.55,0.38,0.27)]:
            loop n in [vec3(0,1,0),vec3(0,0,1),vec3(1,0,0),vec3(-1,0,0),vec3(0,0,-1)]:
                loop shadow in [0.0,0.5,1.0]:
                    # Include overbright legacy fill and severe attenuation;
                    # both must retain pigment yet meet the exposure envelope.
                    loop gain in [0.25,1.0,3.0]:
                        v=normalize(vec3(0.3,0.6,1))
                        c=ch_light(pigment,n,v,l,u,f32(shadow),0)*f32(gain)
                        ref=paint_light(pigment,n,l,v,env.sun_color,env.sky_amb,env.ground_amb,f32(shadow),0.45)
                        loop shade in [0.0,0.5,1.0]:
                            u.environment_shade=f32(shade)
                            bounded=ch_environment_bound(c,pigment,n,v,l,f32(shadow),u)
                            ratio=f64(dot(bounded,weights)/dot(ref,weights))
                            assert(ratio>=0.84999 and ratio<=1.15001,"outdoor diffuse within 15% of equivalent environmental illumination")
                            low=min(low,ratio)
                            high=max(high,ratio)
                            indoor=u
                            indoor.environment=0
                            assert(length(ch_environment_bound(c,pigment,n,v,l,f32(shadow),indoor)-c)<0.00001,"indoor/local material response untouched")
                            cases+=1
print("PASS hero lighting: {cases} pigment/normal/shadow/exposure cases over overcast/dusk/night; linear Rec.709 environment ratio {low:.5}..{high:.5}; indoor bypass exact")

# First-time observation test: the explorer stays at each stage threshold and
# scans one full turn using the production chase camera, without route waypoints,
# movement, carried items, or looking toward a known target. Three seconds budget.
# Stage presets only remove already-completed barriers; they supply no camera aim.
use '../game/shrines.jo'
use '../game/gfx.jo'
use '../game/build.jo'
use '../game/physics.jo'
use '../game/worldgen.jo'
use '../game/terrain.jo'
use '../game/structures.jo'
use '../game/items.jo'
use '../game/story.jo'
use '../game/player.jo'
use '../game/camera.jo'
use '../game/input.jo'
use '../game/render.jo'
from '../game/build.jo' import __named_b, __bchunks
from '../game/shrines.jo' import __enter_now, __preset, __rune_sites, __float_mast, __profile_roof, __cracks

worldgen_load()
hf.mat = fill(u8(0), hf.n * hf.n * 4)
items_init()
find_shrines()
shrines_build()
shrines_setup()
checks = 0
fails = 0

blocks = (eye: vec3, target: vec3, a: vec3, b: vec3, c: vec3) -> bool:
    d = target - eye
    e1 = b - a
    e2 = c - a
    p = cross(d, e2)
    det = f64(dot(e1, p))
    if abs(det) < 0.000001: return false
    t = eye - a
    u = f64(dot(t, p)) / det
    if u < 0.0 or u > 1.0: return false
    q = cross(t, e1)
    v = f64(dot(d, q)) / det
    if v < 0.0 or u + v > 1.0: return false
    along = f64(dot(e2, q)) / det
    along > 0.015 and along < 1.0 - 0.6 / f64(length(d))
mesh_blocks = (b: Builder, a: vec3, target: vec3) -> bool:
    loop j in [0..b.idx.len() / 3):
        k = j * 3
        if blocks(a, target, b.verts[int(b.idx[k])].pos, b.verts[int(b.idx[k + 1])].pos, b.verts[int(b.idx[k + 2])].pos): return true
    false
named_blocks = (name: str, eye: vec3, target: vec3) -> bool:
    if not named_visible(name): return false
    mesh_blocks(__named_b.get(name) ?? Builder(), eye, target)

# Intact fracture meshes must remain opaque to discovery, including the wall
# behind the chain-room probe's chase camera. Hidden buffers remain allocated.
loop crack in __cracks:
    c = colliders[crack.col]
    across = if c.half.x > c.half.z: vec3(0, 0, 2) else: vec3(2, 0, 0)
    eye = crack.center + vec3(0, 1.5, 0) + across
    target = crack.center + vec3(0, 1.5, 0) - across
    assert(named_blocks(crack.name, eye, target), "intact fracture wall must block discovery")

visible = (id: int, target: vec3) -> bool:
    a = view_pos()
    f = normalize(view_target() - a)
    right = normalize(cross(f, vec3(0, 1, 0)))
    up = cross(right, f)
    delta = target - a
    depth = f64(dot(delta, f))
    if depth < 0.5: return false
    half = tan(view_fov() * PI / 360.0)
    if abs(f64(dot(delta, right))) > depth * half * 16.0 / 9.0 or abs(f64(dot(delta, up))) > depth * half: return false
    # Reject tiny distant objects even when mathematically inside the frustum.
    if atan2(0.4, f64(length(delta))) < PI / 360.0: return false
    if raycast(a, normalize(delta), max(0.01, f64(length(delta)) - 0.6), true, false).hit: return false
    loop key, b in __named_b:
        if contains(key, srec[id].key) and not contains(key, "_rune_") and not contains(key, "_circuit_") and not contains(key, "_signal_"):
            if named_blocks(key, a, target): return false
    loop key, b in __bchunks:
        if mesh_blocks(b, a, target): return false
    true

discover = (id: int, stage: int, name: str, spot: vec3, targets: vec3[]):
    __enter_now(id)
    __preset(id, stage)
    if id == JABAIJ and stage == 1:
        eye = srec[id].o + v3(0, 2.6, -16.8)
        target = srec[id].o + v3(0, 2, -35.5)
        assert(mesh_blocks(__named_b["ja_baij_crack_n"], eye, target), "retain the north wall mesh at its doorway")
        assert(not named_blocks("ja_baij_crack_n", eye, target), "completed north wall must be culled from discovery")
    pl.pos = srec[id].o + spot
    pl.face = 0.0
    cam = Cam()
    cam.yaw = 0.0
    # Publish the active chamber's draw state before applying renderer culling;
    # entry/setup initially hides its architecture, lamps and control cues.
    shrines_update(0.0)
    assert(named_visible(srec[id].key + "_architecture"), "active chamber architecture must participate in discovery")
    camera_snap()
    found = fill(-1, targets.len())
    loop frame in [0..180):
        act = Actions(look = vec2(0.04, 0))
        camera_update(1.0 / 60.0)
        loop k in [0..targets.len()):
            if found[k] >= 0: continue
            # Inspect the near face of a solid control, rather than its hidden centre.
            target = srec[id].o + targets[k]
            face = target + normalize(view_pos() - target) * 0.65
            if visible(id, face): found[k] = frame
    checks += targets.len()
    loop k in [0..targets.len()):
        if found[k] < 0:
            fails += 1
            print("FAIL discovery {srec[id].name} {name} object {k + 1}: unseen after 3.00 s at {spot}; target {targets[k]}")
        else: print("PASS discovery {srec[id].name} {name} object {k + 1}: {f64(found[k]) / 60.0:.2} s")

discover(OMAN, 0, "entrance crate/plate/bridge", vec3(0, 0.1, 0), [v3(5, 1.3, -1), v3(-5, 0.12, -5), v3(0, 4.7, -12)])
discover(OMAN, 1, "scout hall crate/ledge", vec3(0, 0, -25.5), [v3(4, 1.3, -35), v3(0, 3.4, -44)])
discover(OMAN, 1, "foundry crate/plate signal", vec3(-30, 0, -29), [v3(-34, 1.3, -35), v3(-42, 5.2, -39.8)])
discover(JABAIJ, 0, "entrance barrels/fire/crack", vec3(0, 0.1, 0), [v3(6, 0.7, -4), v3(-6, 1.3, -8), v3(0, 2, -19.1)])
discover(JABAIJ, 1, "chain barrel/pedestal/pillar", vec3(0, 0, -22), [v3(7, 0.7, -24.4), v3(3, 0.7, -30.5), v3(0, 2, -35.5)])
discover(JABAIJ, 1, "gallery barrel/shutter/fire", vec3(20, 0, -10), [v3(26, 0.7, -10), v3(31.5, 2.7, -10), v3(29, 1, -11.8)])
discover(OWA, 0, "entrance first hub", vec3(0, 0.1, 0), [v3(0.6, 0.4, -13.5)])
discover(OWA, 0, "hub second bar", vec3(0, 0.1, -13.5), [v3(0.6, 0.4, -28.5)])
discover(OWA, 1, "boulder stair/refuge cue", vec3(0, 0, -39), [v3(0, 1.5, -48), v3(1.9, 3.1, -50.7)])
discover(OWA, 0, "clockwork first brake", vec3(14, 0, -28.5), [v3(24.5, 1.45, -28.5)])
discover(KEH, 0, "entrance valve/crate/inflow", vec3(0, 0.1, 0), [v3(6, 1.45, -1), v3(-4, -2, -14), v3(11.3, 2.7, -21)])
discover(KEH, 1, "north valve/plate/gate", vec3(0, 0, -25.5), [v3(-6, 1.45, -27), v3(9, -1, -21), v3(0, 2, -29.4)])
discover(KEH, 1, "cistern near valve/float mast", vec3(-18, 3.6, -14), [v3(-20, 5.05, -19.5), v3(-25.4, 4.1, -14)])
discover(OMAN, 1, "foundry working plate", vec3(-34, 0, -39), [v3(-42, 0.12, -39)])
discover(OWA, 1, "refuge mouth", vec3(0, 1.9, -49), [v3(3, 4, -51)])
discover(KEH, 1, "cistern working float", vec3(-22, 3.6, -19.5), [v3(-26, 1.2, -14)])
# The three new discovery targets must exist as rendered geometry, so an
# unobstructed point in empty space cannot pass after its signal is deleted.
marker_exists = (id: int, group: int, target: vec3):
    b = __named_b.get(srec[id].key + "_rune_{group}") ?? Builder()
    close = 0
    loop v in b.verts:
        if length(v.pos - srec[id].o - target) < 0.9: close += 1
    assert(close >= 16, "discovery signal must exist at its observed position")
marker_exists(OMAN, 3, v3(-42, 5.2, -39.8))
marker_exists(OWA, 1, v3(1.9, 3.1, -50.7))
assert(__float_mast.count > 200, "cistern float must retain its visible status mast")
# A geometry deletion or a broken proximity update must fail even if the
# nominal marker position is still an unobstructed point in empty space.
loop id in [0..4):
    __enter_now(id)
    loop k in [0..4):
        name = srec[id].key + "_rune_{k}"
        b = __named_b.get(name) ?? Builder()
        assert(b.idx.len() >= 132, "each trial interaction must retain its engraved slop swirl cue")
        loop j in [0..b.idx.len() / 3):
            a = b.verts[int(b.idx[j * 3])]
            bb = b.verts[int(b.idx[j * 3 + 1])]
            c = b.verts[int(b.idx[j * 3 + 2])]
            assert(dot(cross(bb.pos - a.pos, c.pos - a.pos), a.normal) > 0.0, "floor and wall runes must face the explorer")
        pl.pos = srec[id].o + srec[id].monk
        shrines_update(0.0)
        far = length(hooks.named_glow.get(name) ?? vec3(0, 0, 0))
        pl.pos = srec[id].o + __rune_sites[id][k] + vec3(0, 0.2, 0)
        shrines_update(0.0)
        near = length(hooks.named_glow.get(name) ?? vec3(0, 0, 0))
        assert(not (hooks.named_hidden.get(name) ?? true) and near > far * 2.0, "working rune must brighten when Link approaches")
    print("PASS rune cues {srec[id].name}: four engraved controls brighten within 2 m")
# The visibility scanner is deliberately two-sided for occlusion. Separately
# verify roof winding so the production culler cannot remove the room's soffit.
loop id in [0..4):
    name = "discovery_roof_fixture_{id}"
    begin_named(name)
    __profile_roof(srec[id].o, -10.0, 10.0, -2.0, 2.0, 8.0)
    end_named()
    b = __named_b.get(name) ?? Builder()
    assert(b.idx.len() >= 144, "shrine must retain its profiled ceiling")
    loop k in [0..b.idx.len() / 3):
        a = b.verts[int(b.idx[k * 3])]
        bb = b.verts[int(b.idx[k * 3 + 1])]
        c = b.verts[int(b.idx[k * 3 + 2])]
        assert(dot(cross(bb.pos - a.pos, c.pos - a.pos), a.normal) > 0.0, "ceiling winding must match its inward normal")
    print("PASS ceiling culling {srec[id].name}: inward soffit and riser faces")
print("{(if fails == 0: "PASS" else: "FAIL")} first-time discovery: {checks - fails}/{checks} objects visible within a 3 s camera scan; {fails} failures")
exit(if fails == 0: 0 else: 1)

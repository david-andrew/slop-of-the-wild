# Shared lattice corners must survive shader inlining without a hash discontinuity.
# Caller owns flock /tmp/botw-render.lock. Run on Vulkan and OpenGL.
use '../game/gfx.jo'
use '../game/shade.jo'
struct SeamU:
    unused: f32
struct SeamO:
    pos: vec4
    uv: vec2
seam_vs = (v: FsVert, u: SeamU) -> SeamO:
    SeamO(vec4(v.pos, 0, 1), v.pos * 0.5 + vec2(0.5, 0.5))
seam_fs = (i: SeamO, u: SeamU) -> vec4:
    p = vec2(-420, 580) + i.uv * 10.0
    n = vnoise(p)
    vec4(n, n, n, 1)
window("Noise lattice continuity", 512, 512)
source = shader(seam_vs, seam_fs)
sh = make_sh(source)
target = make_target(512, 512, false, false)
gl_delete_texture(target.color.id)
target.color = color_texture(512, 512, GL_RGBA32F, GL_RGBA, GL_FLOAT, GL_NEAREST)
glBindFramebuffer(GL_FRAMEBUFFER, u32(target.fbo))
glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, u32(target.color.id), 0)
assert(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
bind_target(target)
glDisable(GL_DEPTH_TEST)
glDisable(GL_CULL_FACE)
glDisable(GL_BLEND)
draw_fast(sh, fullscreen_mesh(), SeamU(0))
pixels = fill(f32(-1), 512 * 512 * 4)
game_read_pixels_f32(0, 0, 512, 512, data(pixels) as *u8)
worst = f32(0)
loop y in [0..512):
    loop x in [0..512):
        at = (y * 512 + x) * 4
        assert(pixels[at + 3] == 1.0, "continuity probe must render every pixel")
        if x > 0: worst = max(worst, abs(pixels[at] - pixels[at - 4]))
        if y > 0: worst = max(worst, abs(pixels[at] - pixels[at - 512 * 4]))
# Cubic interpolation has slope <=1.5 per cell; the 10/512 step bounds a
# continuous field by 0.0293. Leave room for raster/float rounding, while
# rejecting the old nearly-one shared-corner discontinuity.
assert(worst < 0.04, "float hash must agree at shared noise lattice corners")
print("PASS noise lattice continuity: 262144 RGB32F samples, max adjacent error {worst:.9}")
glBindFramebuffer(GL_FRAMEBUFFER, 0)
free_target(target)

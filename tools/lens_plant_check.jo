# Camera clearance for whole grass blades and modeled low-plant fragments.
use '../game/shade.jo'
assert(lens_plant_fade(0.0)==1.0 and lens_plant_fade(0.85)==1.0)
assert(lens_plant_fade(1.0)>0.8,"most coverage is gone within one metre of the lens")
assert(lens_plant_fade(1.4)<0.000001 and lens_plant_fade(10.0)==0.0)
assert(lens_plant_distance(vec3(),1.8,vec3(0.5,1.6,0))==0.5,"raised lens measures the tall stem, not its distant root")
assert(lens_plant_distance(vec3(),0.5,vec3(0,2,0))==1.5,"short grass below the lens keeps its height")
previous=f32(1)
loop k in [0..201):
    coverage=lens_plant_fade(f32(k)*0.01)
    assert(coverage>=0 and coverage<=previous,"coverage fades continuously toward the lens")
    assert(previous-coverage<0.03,"no hard popping boundary")
    previous=coverage
print("PASS near-lens foliage: fully hidden at 85cm, >80% removed at 1m, unchanged past 1.4m")

use '../game/vegetation.jo'
use '../game/gfx.jo'
u=VegU(cam=vec3(),low=1,height=2,radius=1)
base=vec3(0,0,2)
assert(vegetation_unit_fade(base,2,1,u)==1,"near fern clears completely")
u.low=0
u.wood=1
u.tree=1
assert(vegetation_unit_fade(base,2,1,u)==1,"bark and canopy clear as one tree")
a=vegetation_unit_fade(vec3(0,0,5.5),8,1,u)
u.leaves=1
assert(vegetation_unit_fade(vec3(0,0,5.5),8,1,u)==a,"leaf cards share the bark's clearance")
u.cam=vec3(0,6,0)
assert(vegetation_unit_fade(vec3(0,0,2),8,1,u)==1,"raised camera clears the whole crown")
u.wood=0
u.tree=0
assert(vegetation_unit_fade(base,2,1,u)==0,"rocks retain their narrow fragment clearance")
loop low in [0..2):
    u.low=f64(low)
    u.wood=f64(1-low)
    u.cam=vec3()
    previous=f32(0)
    loop k in [0..501):
        fade=vegetation_unit_fade(vec3(0,0,f32(k)*0.02),2,1,u)
        scale=vegetation_unit_scale(fade)
        assert(scale>=previous-0.00001 and scale<=1,"whole silhouette grows monotonically into view")
        assert(scale-previous<0.06,"clearance eases without a hard size switch")
        previous=scale
    assert(previous==1,"distant models retain their size")
# Different vertices and materials of one instance use the same root capsule.
v=Vertex3D(pos=vec3(0,1,0),normal=vec3(0,1,0))
inst=VInst(translation(vec3(0,0,5.5)),vec4(1,1,1,1))
u=VegU(cam=vec3(),wood=1,tree=1,height=8,radius=1)
bark=veg_vs(v,inst,u)
u.leaves=1
v.pos=vec3(2,7,1)
leaves=veg_vs(v,inst,u)
assert(bark.clearance==leaves.clearance,"trunk and distant crown card clear as one unit")
print("PASS modeled clearance: whole trees/plants scale smoothly; no fragment transparency; rocks retained")

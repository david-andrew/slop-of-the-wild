# Included by live_audio_check.py after copying main's production event dispatcher.
# Scripted game state/event inputs, actual sequencing, dispatch, spatial filters and mixer.
# No offline score synthesis or per-export normalization.
from '../../game/sfx.jo' import __sfx_rng

capture = ():
    out = args()[1]
    mode = args()[2]
    seconds = to_float(args()[3]) ?? 180.0
    __audio_state = 2
    master_volume(0.8)
    sfx_init()
    piano_init()
    seed_random(610061)
    __sfx_rng = rng(610610)
    seq = Seq(mood = .field_rain, want = .field_rain, volume = 1.0, rest = 2.0)
    pl = Player(pos = vec3(-700, 235, 1800))
    fight = Fight()
    sc.cam = pl.pos + vec3(0, 1.6, 2)
    sc.fwd = vec3(0, 0, -1)
    loop mut p in music_landmarks: p.last = 10000.0

    # Raw f32 and per-frame statistics stream to disk, bounding the ten-minute capture's memory.
    open_out = (path: str) -> int:
        fd = syscall(2, data(__zstr(path)), 0x241, 0x1A4)
        assert(fd >= 0)
        fd
    raw = open_out("{out}/{mode}.f32")
    csv = open_out("{out}/{mode}-frames.csv")
    events = open_out("{out}/{mode}-events.csv")
    line = (fd: int, s: str): __write_fd(fd, data(s), len(s))
    line(csv, "time,layer,energy,peak,above40,samples\n")
    line(events, "time,kind,sample,pitch\n")
    labels = ["music", "wind", "rain", "fire", "footsteps", "cues", "wildlife", "other"]
    tags: {int: int} = {}
    previous_positions: {int: f64} = {}
    identities: (*f32)[]
    seen = 0
    phase_rng = rng(6111)
    # Live grass-fire source query on a small deterministic terrain patch.
    hf.n = 16
    hf.cell = 1.0
    hf.x0 = -708.0
    hf.z0 = 1792.0
    hf.h = fill(f32(235), hf.n * hf.n)
    bonfires.clear()
    flames.clear()
    loop cell in [136, 137, 138, 139]: flames.push(Flame(cell, life = 1000.0))

    if mode == "biome": worldgen_load()
    boundary_count = 0
    clipped_samples = 0
    overloaded_samples = 0
    previous_mood = Mood.silent

    # Identify the resolved take, not its source handle or pitch. Also unwrap spatial colours.
    source_of = (s: Sound) -> Sound:
        loop colour in sfx_spatial:
            if data(s.samples) == data(colour.far.samples) or data(s.samples) == data(colour.wall.samples): return colour.source
        s
    is_step = (s: Sound) -> bool:
        loop bank in sfx_takes:
            foot = false
            loop sample in [sfx.step_grass[0], sfx.step_stone[0], sfx.step_snow[0]]:
                if data(bank.sources[0].samples) == data(sample.samples): foot = true
            if foot:
                loop sample in bank.takes:
                    if data(sample.samples) == data(s.samples): return true
        loop sample in sfx.step_wood:
            if data(sample.samples) == data(s.samples): return true
        false
    is_bird = (s: Sound) -> bool:
        loop sample in sfx.birds:
            if data(sample.samples) == data(s.samples): return true
        false

    loop frame in [0..int(seconds * 60.0)):
        dt = 1.0 / 60.0
        t = f64(frame) * dt
        biome = mode == "biome"
        field = mode == "field" or biome
        isolated = mode == "engaged" or mode == "low_hp"
        combat = isolated or (not field and t >= 90.0 and t < 150.0)
        shelter = not field and not isolated and t >= 150.0
        env.rain = if field or isolated: 0.0 else: (if t < 60.0 or t >= 85.0: 1.0 else: 0.15)
        env.clouds = env.rain
        env.gust = 1.7 + sin(t * 0.19) * 1.1
        env.night = 0.0
        env.hour = 11.0
        env.indoor = if shelter: 0.75 else: 0.0
        amb_biome = if field or (t >= 60.0 and t < 90.0): 1 else: 0
        fire_close = if not field and not isolated and t >= 30.0 and t < 150.0: fire_audio_level(pl.pos) else: 0.0
        fight.act = if combat: .swing else: .idle
        pl.hp = if mode == "low_hp" or (not field and not isolated and t >= 120.0): 4 else: 12
        pl.ground.surf = .grass
        pl.vel = if shelter or isolated: vec3(0, 0, 0) else: vec3(0, 0, 3)
        music_mood(if combat: Mood.combat else: (if field: Mood.forest else: (if shelter: Mood.ruins else: Mood.field_rain)))
        if biome:
            # Two continuous 3 m/s boundary walks, out and back. The fixture
            # reset at 60 s joins distant courses; neither crossing teleports.
            # Forest radius and area.u8 snow boundary match production data.
            leg = if t < 60.0: t else: t - 60.0
            offset = min(leg, 60.0 - leg) * 3.0
            pl.pos = if t < 60.0: v3(-900.0 - offset, 235.0, 1640.0) else: v3(-935.0 - offset, 340.0, 2180.0)
            sc.cam = pl.pos + vec3(0, 1.6, 2)
            forest = hypot(f64(pl.pos.x) + 1050.0, f64(pl.pos.z) - 1640.0) < 130.0
            snow = is_snow_area(f64(pl.pos.x), f64(pl.pos.z))
            want = if snow: Mood.snow else: (if forest: Mood.forest else: Mood.field_day)
            amb_biome = if snow: 2 else: (if forest: 1 else: 0)
            pl.ground.surf = if snow: .snow else: .grass
            # Long production piano tails ensure every crossing interrupts a
            # sounding note, including the release/recovery ring at +0.9 s.
            if frame % 120 == 0: piano_play(62, 0.48, 0.0, 1.0, false, true)
            if want != previous_mood:
                if previous_mood != .silent:
                    sounding = false
                    loop v in score_voices:
                        if v.left > 0.0 and v.applied > 0.001: sounding = true
                    assert(sounding, "biome boundary must change mood mid-note")
                    boundary_count += 1
                line(events, "{t:.6},boundary_{want},{pl.pos.x:.3}:{pl.pos.z:.3},1\n")
                previous_mood = want
            music_mood(want)
        old_phrase = phrase_n
        # Same order as main: music, gameplay event dispatch, ambient preparation, mixer.
        jingles_update(dt)
        music_update(dt)
        if phrase_n != old_phrase:
            signature = ""
            loop e in seq.events:
                if not e.accompaniment: signature = "{signature}{e.midi}:"
            line(events, "{t:.6},phrase,{signature},1\n")
        pl.events.clear()
        enemy_events.clear()
        elem_events.clear()
        wild_calls.clear()
        # Cadence from player.jo's speed / 1.2 walking rule, dispatched by main verbatim.
        if not shelter and not isolated and frame % 24 == 0: pl.events.push("step")
        if mode == "scenario" and frame == 5400: enemy_events.push(EEvent("notice", pl.pos + vec3(0, 1, -3)))
        if combat and frame >= 60:
            phase = (frame - 60) % 240
            if phase == 0: enemy_events.push(EEvent("windup", pl.pos + vec3(0, 1, -3)))
            if phase == 32: enemy_events.push(EEvent("enemy_hit", pl.pos + vec3(0, 1, -2)))
            if phase == 72: pl.events.push("parry")
            if phase == 110: enemy_events.push(EEvent("windup_heavy", pl.pos + vec3(0, 1, -3)))
            if phase == 160: enemy_events.push(EEvent("enemy_hit_big", pl.pos + vec3(0, 1, -2)))
            if phase == 200: pl.events.push("hurt")
            kind = if enemy_events.len() > 0: enemy_events[0].kind else: ""
            loop e in pl.events:
                if e != "step": kind = e
            if kind != "": line(events, "{t:.6},cue_{kind},0,1\n")
        before_events = __voice_id
        play_events()
        loop voice in __voices:
            if voice.id > before_events: tags[voice.id] = if combat: 5 else: 4
        if not field and not isolated and t >= 60.0 and t < 90.0 and frame % 420 == 0:
            animal = Animal(.boar, pl.pos + vec3(3, 0, -3), pl.pos, seed = f64(frame % 3) + 0.7)
            before_wild = __voice_id
            wild_voice(animal, "boar_graze")
            animal.kind = .sparrow
            wild_voice(animal, "bird_scatter")
            loop voice in __voices:
                if voice.id > before_wild: tags[voice.id] = 6
        score_rng = __global_rng
        __global_rng = phase_rng
        amb_lift = if seq.events.len() == 0 and not combat: 1.0 else: 0.0
        sfx_room = env.indoor * 0.7
        sfx_room_size = 0.5
        ambient_update(dt, env.indoor, 235.0, fire_close, 0.0, shelter)
        phase_rng = __global_rng
        __global_rng = score_rng
        # Score-owned rings identify piano/cue voices independently of bank storage.
        loop v in score_voices: tags[v.id] = 0
        tags[amb.wind] = 1
        tags[amb.wind_gust] = 1
        tags[amb.rain] = 2
        tags[amb.rain_gust] = 2
        tags[amb.fire] = 3
        loop voice in __voices:
            source = source_of(voice.sound)
            if is_step(source): tags[voice.id] = 4
            if not tags.has(voice.id): tags[voice.id] = if is_bird(source): 6 else: 7
            wrapped = voice.looping and previous_positions.has(voice.id) and voice.pos < previous_positions[voice.id]
            previous_positions[voice.id] = voice.pos
            if voice.id > seen or wrapped:
                kind = if is_step(source): "step" else: (if is_bird(source): "bird" else: (if voice.id == amb.wind_gust: "gust" else: "voice"))
                ptr = data(source.samples)
                id = -1
                loop i in 0.. and p in identities:
                    if p == ptr: id = i
                if id < 0:
                    id = identities.len()
                    identities.push(ptr)
                line(events, "{t:.6},{kind},{id},{voice.pitch:.6}\n")
        seen = __voice_id
        # Render each stem through the production mixer from the same voice positions.
        # Only the final full mix advances the live voices; no normalization, remade notes or RNG.
        saved: Voice[]
        loop v in __voices: saved.push(v)
        sum = fill(f32(0), MIX_RATE / 60 * 2)
        loop layer in [0..labels.len()):
            __voices.clear()
            loop v in saved:
                if tags[v.id] == layer: __voices.push(v)
            capture_linear_mix(MIX_RATE / 60)
            energy = 0.0
            peak = 0.0
            above = 0
            loop i in 0.. and v in __mix_buf:
                sum[i] += v
                energy += f64(v) * f64(v)
                peak = max(peak, abs(f64(v)))
                if abs(v) > 0.01: above += 1
            line(csv, "{t:.6},{labels[layer]},{energy:.12},{peak:.9},{above},{__mix_buf.len()}\n")
        prepeak = 0.0
        overload = 0
        loop v in sum:
            prepeak = max(prepeak, abs(f64(v)))
            if abs(v) >= 1.0: overload += 1
        overloaded_samples += overload
        loop mut sample in sum:
            if abs(sample) > 1.0: sample = f32(tanh(f64(sample)))
        __voices.clear()
        loop v in saved: __voices.push(v)
        __mix(MIX_RATE / 60)
        error = 0.0
        loop i in [0..sum.len()): error = max(error, abs(f64(sum[i] - __mix_buf[i])))
        assert(error < 0.000001, "linear stems plus release soft clip reproduce the actual mixed samples")
        loop sample in __mix_buf:
            if abs(sample) >= 1.0: clipped_samples += 1
        line(csv, "{t:.6},preclip,0,{prepeak:.9},{overload},{__mix_buf.len()}\n")
        __write_fd(raw, data(__mix_buf) as *u8, __mix_buf.len() * 4)
    assert(clipped_samples == 0 and overloaded_samples == 0, "live production mix must have zero clipped or pre-limiter overloaded samples")
    if mode == "biome": assert(boundary_count >= 4, "both biome boundary walks must cross out and back mid-note")
    print("PASS live headroom {mode}: clipped {clipped_samples}, pre-limiter overloads {overloaded_samples}, mid-note biome boundaries {boundary_count}")
    loop fd in [raw, csv, events]: syscall(3, fd)
    print("PASS {mode}: {seconds}s production full mix/stems; sample sum verified, {music_note_count} notes")

capture()

use 'enemy_spacing_checks.jo'
use '../game/camera.jo'
use '../game/enemies.jo'
use '../game/combat.jo'
use '../game/player.jo'

# Both attackers have sufficient radial capsule spacing, but share a screen ray.
# Their low alert values also exercise combat entered by a hit/recoil transition.
spacing_course()
cam.shown = true
cam.shown_pos = vec3(0,3,6)
cam.shown_target = vec3(0,1,0)
a = spawn_enemy(.blue_bokoblin,vec3(0,0,-3.0),"boko_spear")
b = spawn_enemy(.blue_bokoblin,vec3(0,0,-6.0),"boko_club")
enemies[a].state = .windup
enemies[b].state = .attack
enemies[a].alert = 0.0
enemies[b].alert = 0.0
fight.target = a
selected = enemies[a].pos
loop pass_ in [0..8): enemies_separate()
f = normalize(cam.shown_target-cam.shown_pos)
r = normalize(cross(f,vec3(0,1,0)))
d0 = enemies[a].pos+vec3(0,1.3,0)-cam.shown_pos
d1 = enemies[b].pos+vec3(0,1.3,0)-cam.shown_pos
z0 = f64(dot(d0,f))
z1 = f64(dot(d1,f))
gap = abs(f64(dot(d0,r))/z0-f64(dot(d1,r))/z1)
assert(gap >= 2.7/min(z0,z1)-0.00001, "committed attackers retain distinct projected lanes")
assert(length(enemies[a].pos-selected)<0.001, "selected attacker retains its contact root")
assert(enemies[a].state == .windup and enemies[b].state == .attack, "lane correction never cancels committed attacks")
print("PASS simultaneous low-alert windup/attack lanes: gap {gap:.6}, selected root retained")
